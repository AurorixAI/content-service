APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_v1
REDIS_URL=redis://localhost:6379

# ── Vertex AI (OCR + Gemini pipeline) ─────────────────────────────────────
# 1. Create GCP project, enable Vertex AI API, create service account + JSON key
# 2. Save key locally, e.g. secrets/gcp-vertex.json (never commit)
# 3. Set paths below and restart: docker compose up -d --build content-worker

VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
GOOGLE_CREDENTIALS_PATH=/absolute/path/to/your-service-account-key.json

# Not used when Vertex ADC is configured — leave empty
GEMINI_API_KEY=

MATHPIX_APP_ID=
MATHPIX_APP_KEY=

PIPELINE_CACHE_DIR=/app/data/pipeline_cache
PIPELINE_QUALITY=high
TEXTBOOKS_DIR=./textbooks
