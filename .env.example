# Content Service — Environment Variables
# Copy to .env and fill in real values

# App
APP_ENV=development  # development | production | testing
DEBUG=false

# Database — content service owns only this DB
DATABASE_URL=postgresql://algo:algo_password@localhost:5432/algo_content

# Redis — ARQ async job queue
REDIS_URL=redis://localhost:6379

# Internal service-to-service auth — required on every request to
# /api/v1/content/*. Same shared secret configured for diagnostic-service
# and exam-service (their content_client sends it as X-Internal-Service-Token).
# Requests without a matching token get 403; if this is left blank, ALL
# requests get 503 (fails closed, never falls back to no-auth).
INTERNAL_SERVICE_TOKEN=

# ── AI / OCR pipeline ─────────────────────────────────────────────────────────
# Option A: Gemini API key (simpler, direct API)
GEMINI_API_KEY=

# Option B: Google Vertex AI (for production / higher quotas)
# 1. Create GCP project, enable Vertex AI API
# 2. Create a service account + download JSON key
# 3. Set paths below (never commit the key file)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
GOOGLE_CREDENTIALS_PATH=

# Mathpix OCR (optional fallback for complex math rendering)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Pipeline settings
PIPELINE_CACHE_DIR=/app/data/pipeline_cache
PIPELINE_QUALITY=high
TEXTBOOKS_DIR=./textbooks
