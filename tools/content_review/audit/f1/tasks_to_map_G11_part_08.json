[{"id": "G11_TB_10_2_10_3_п", "current_skill": "G11_S02_01", "q": "Какими условиями задаётся множество $M$, на котором равносильны ($a>0$, $a \\neq 1$) уравнения: $\\dfrac{2\\tg x}{1-\\tg^{2}x}=\\varphi(x)$ и $\\tg 2x=\\varphi(x)$?", "key": "$x \\neq \\dfrac{\\pi}{2} + \\pi k$, $x \\neq \\dfrac{\\pi}{4} + \\dfrac{\\pi k}{2}$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_4*_14_a", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\dfrac{3}{(2x+6)(x-1)}+\\dfrac{5}{(3x+5)(x-1)}=\\dfrac{1}{x-1}$", "key": "$-2{,}5$"}, {"id": "G11_TB_10_4*_14_b", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\dfrac{1}{(3x+5)(x-1)}+\\dfrac{7}{(x+7)(x-1)}=\\dfrac{1}{x-1}$", "key": "$-\\dfrac{7}{3}$"}, {"id": "G11_TB_10_6*_10_34_2", "current_skill": "G11_S02_01", "q": "Решите уравнение:\n$\\log_{3}{(x-5)} + \\log_{3}{(x+1)} = \\log_{3}{(3x+3)}$", "key": "$x = 8$"}, {"id": "G11_TB_10_6*_10_34_3", "current_skill": "G11_S02_01", "q": "Решите уравнение:\n$\\log_{5}(x-6) + \\log_{5}(2x+11) = \\log_{5}(3x+4)$", "key": "$x = 7$"}, {"id": "G11_TB_10_6*_10_34_4", "current_skill": "G11_S02_01", "q": "Решите уравнение:\n$\\log_{4}{(2x+6)}+\\log_{4}{(3x-14)}=\\log_{4}{(3x+1)}$", "key": "$x = 5$"}, {"id": "G11_TB_11_2_11_5_е", "current_skill": "G11_S02_01", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\dfrac{x^{2}-5x}{\\lg x} > \\dfrac{-6}{\\lg x}$, $x^{2}-5x > -6$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Умножение на функцию $\\lg x$. Равносильны на множестве, где $\\lg x > 0$, т.е. $x > 1$."}, {"id": "G11_TB_11_4*_11_20_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{x^{2}}{1-\\cos x} < \\dfrac{x+2}{1-\\cos x}$", "key": "$(-1; 2) \\setminus \\{0\\}$"}, {"id": "G11_TB_11_4*_11_20_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{x^{2}}{\\cos x - 1} > \\dfrac{-x + 2}{\\cos x - 1}$", "key": "$(-2; 1) \\setminus \\{0\\}$"}, {"id": "G11_TB_11_4*_11_20_в", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{x^{2}}{1-\\sin x}<\\dfrac{2x+3}{1-\\sin x}$", "key": "$x \\in \\left(-1; \\dfrac{\\pi}{2}\\right) \\cup \\left(\\dfrac{\\pi}{2}; 3\\right)$"}, {"id": "G11_TB_11_4*_11_20_г", "current_skill": "G11_S02_01", "q": "Решите неравенство:\n$\\dfrac{x^{2}}{\\sin x - 1} > \\dfrac{x + 2}{\\sin x - 1}$", "key": "$(-1; 2) \\setminus \\left\\{\\dfrac{\\pi}{2}\\right\\}$"}, {"id": "G11_TB_11_5*_11_24_б", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{7}(x^{2}-4) > \\log_{7}(3x+6)$", "key": "$x \\in (5; +\\infty)$"}, {"id": "G11_TB_11_5*_11_24_г", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{25}}(x^{2}-4x) > \\log_{\\frac{1}{25}}(2x-5)$", "key": "$x \\in (4; 5)$"}, {"id": "G11_TB_11_5*_11_26_б", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{\\log_{9}(5x-4)}{\\log_{0{,}4}0{,}064}<0$", "key": "$x \\in \\left(\\dfrac{4}{5}; 1\\right)$"}, {"id": "G11_TB_11_5*_11_28_б", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{2}{\\sqrt{x+3}} + x < \\dfrac{2}{\\sqrt{x+3}} + 4$", "key": "$x \\in (-3; 4)$"}, {"id": "G11_TB_11_6*_11_41_б", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{11}\\left(\\dfrac{1}{4x-7}\\right) > \\log_{11}\\left(\\dfrac{1}{5x-14}\\right)$", "key": "$x \\in (7; +\\infty)$"}, {"id": "G11_TB_11_6*_11_41_г", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{13}\\left(\\dfrac{1}{3x-22}\\right) > \\log_{13}\\left(\\dfrac{1}{4x-13}\\right)$", "key": "$x \\in \\left(\\dfrac{22}{3}; +\\infty\\right)$"}, {"id": "G11_TB_11_6*_11_44_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{x}\\left(\\dfrac{7x-2}{2-x}\\right)<0$", "key": "$x \\in \\left(\\dfrac{1}{2}; 1\\right)$"}, {"id": "G11_TB_11_6*_11_44_б", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{x}\\left(\\dfrac{3x-1}{14x-5}\\right) > 0$", "key": "$x \\in (0; \\dfrac{1}{3}) \\cup (\\dfrac{4}{11}; 1)$"}, {"id": "G11_TB_13_1*_12_18_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x-2)(x^{2}-2x+11)}{x-7}>0$", "key": "$(-\\infty; 2) \\cup (7; +\\infty)$"}, {"id": "G11_TB_13_1*_12_18_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x-3)(x^{2}-5x+8)}{x+1}<0$", "key": "$(-1; 3)$"}, {"id": "G11_TB_13_1*_12_18_в", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x-3)(x^{2}-\\pi x+5)}{x-4}>0$", "key": "$(-\\infty; 3) \\cup (4; +\\infty)$"}, {"id": "G11_TB_13_1*_12_18_г", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x+1)(x^{2}-ex+4)}{x+5}<0$", "key": "$(-5; -1)$"}, {"id": "G11_TB_13_1*_12_21_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x-2)^{4}(1+\\log_{0{,}5}x)}{2x-7}\\le0$", "key": "$(0; 2] \\cup (3{,}5; +\\infty)$"}, {"id": "G11_TB_13_1*_12_21_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(3x-1)^{2}(x-3)}{2^{x}-4}\\le0$", "key": "$\\{\\dfrac{1}{3}\\} \\cup (2; 3]$"}, {"id": "G11_TB_13_1*_12_21_c", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x-4)^{2}(2+\\log_{\\frac{1}{3}}x)}{x-1}\\le 0$", "key": "$(0; 1) \\cup \\{4\\} \\cup [9; +\\infty)$"}, {"id": "G11_TB_13_1*_12_21_d", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{(x^{2}-11x+10)(\\lg x-1)}{(2^{x}-2)^{2}}\\le 0$", "key": "$(0; 1) \\cup \\{10\\}$"}, {"id": "G11_TB_13_1*_12_22_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\left(\\dfrac{2^{x-1}+6\\cdot4^{x}+1}{3\\cdot4^{x}-10\\cdot2^{x-1}-28}\\ge-1\\right)$", "key": "$(-\\infty; 1] \\cup (2; +\\infty)$"}, {"id": "G11_TB_13_1*_12_22_б", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\left(\\dfrac{5\\cdot2^{x-1}-2\\cdot4^{x}-26}{3\\cdot4^{x}-7\\cdot2^{x-1}-34}\\ge1\\right)$", "key": "$[1; 2)$"}, {"id": "G11_TB_14_2_14_19_e", "current_skill": "G11_S02_01", "q": "Является ли вторая система следствием первой системы:\n$$\n\\begin{cases}\n\\log_{7}(x+y) + \\log_{7}(x-y) = 1; \\\\\n\\dfrac{x}{y} - \\dfrac{y}{x} = \\dfrac{7}{12}\n\\end{cases}\n$$\nи\n$$\n\\begin{cases}\n\\log_{7}((x+y)(x-y)) = 1; \\\\\n\\dfrac{x}{y} - \\dfrac{y}{x} = \\dfrac{7}{12}\n\\end{cases}\n$$", "key": "да"}, {"id": "G11_TB_14_2_14_6", "current_skill": "G11_S02_01", "q": "Равносильны ли системы:\n$$\\begin{cases} \\sin x = \\cos y; \\\\ \\tg x = \\tg y \\end{cases}$$ и $$\\begin{cases} \\tg x = \\tg y; \\\\ \\sin x = \\cos y \\end{cases}$$", "key": "Да, равносильны, так как отличаются только порядком уравнений."}, {"id": "G11_TB_15_1*_15_1_1", "current_skill": "G11_S02_01", "q": "Решите уравнение с параметром $a$: $\\dfrac{a-1}{2ax+3}=1$.", "key": "Для $a=0$ и $a=1$ корней нет; для каждого $a\\neq 0$ и $a\\neq 1$ единственный корень $x_{0}=\\dfrac{a-4}{2a}$."}, {"id": "G11_TB_15_2*_15_2", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите уравнение: $\\dfrac{x^{2}-1}{x-1}=a$", "key": "При $a=2$: решений нет; при $a \\neq 2$: $x = a - 1$"}, {"id": "G11_TB_15_2*_15_3", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите уравнение: $\\dfrac{x-1}{x^{2}-1}=a$", "key": "При $a=0$ и $a=\\dfrac{1}{2}$: решений нет; при остальных $a$: $x=\\dfrac{1-a}{a}$"}, {"id": "G11_TB_15_2*_15_4", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите уравнение: $\\dfrac{a+10}{ax+5}=2$", "key": "При $a=0$: $x \\in \\mathbb{R}$; при $a=-10$: решений нет; при остальных $a$: $x = \\dfrac{1}{2}$."}, {"id": "G11_TB_15_2*_15_6", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите уравнение: $\\dfrac{a-5}{4ax+1}=1$", "key": "При $a=0$ и $a=5$: решений нет; при остальных $a$: $x=\\dfrac{a-6}{4a}$"}, {"id": "G11_TB_15_2*_15_7", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите уравнение: $\\dfrac{a}{x-3} + \\dfrac{x}{x+3} = \\dfrac{17}{x^{2}-9}$", "key": "При $a\\in(7;11)$: решений нет; при $a=7$: $x=-2$; при $a=11$: $x=-4$; при $a=\\dfrac{17}{6}$: $x=-\\dfrac{17}{6}$; при ост"}, {"id": "G11_TB_15_3*_15_17_1", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите неравенство: $\\dfrac{x^{2}-a^{2}}{x-1}>0$", "key": "При $a<-1$: $x \\in (a; 1) \\cup (-a; +\\infty)$; при $a=-1$: $x \\in (-1; 1) \\cup (1; +\\infty)$; при $-1<a<0$: $x \\in (a; -"}, {"id": "G11_TB_15_3*_15_17_2", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите неравенство: $\\dfrac{x^{2}-a^{2}}{x+2}<0$", "key": "При $a<-2$: $x \\in (-\\infty; a) \\cup (-2; -a)$; при $a=-2$: $x \\in (-\\infty; -2) \\cup (-2; 2)$; при $-2<a<0$: $x \\in (-\\"}, {"id": "G11_TB_15_3*_15_22_2", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $a$ решите неравенство: $\\log_{a}(x-3) \\geq \\log_{a}(15-2x)$", "key": "При $a > 1$: $x \\in [6; 7{,}5)$. При $0 < a < 1$: $x \\in (3; 6]$. При $a \\leq 0$ или $a = 1$: решений нет."}, {"id": "G11_TB_17_1_4", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{3}(x^{2} - 2) = \\log_{3}(4x - 5)$.", "key": "$3$"}, {"id": "G11_TB_17_2_17_2_1", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{2}{(x-5)} > 3$.", "key": "$(13; +\\infty)$"}, {"id": "G11_TB_17_2_17_2_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{2}}(x-5)>3$.", "key": "$(5; 5\\dfrac{1}{8})$"}, {"id": "G11_TB_17_2_17_2_4", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{x}(2x+3) < 2$.", "key": "$(0; 1) \\cup (3; +\\infty)$"}, {"id": "G11_TB_17_2_1_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{0{,}2} x > -1$", "key": "$0 < x < 5$"}, {"id": "G11_TB_17_2_1_3", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{0{,}5} x < 1$", "key": "$x > 0{,}5$"}, {"id": "G11_TB_17_2_2_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{3}}(5x-1) > -2$", "key": "$0{,}2 < x < 2$"}, {"id": "G11_TB_17_2_2_4", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{4}}(2x+1) > -1$", "key": "$-0{,}5 < x < 1{,}5$"}, {"id": "G11_TB_17_2_3_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{3}}(3x+1) > \\log_{\\frac{1}{3}}(x+3)$", "key": "$\\dfrac{-1}{3} < x < 1$"}, {"id": "G11_TB_17_2_3_3", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{0{,}2} x < \\log_{0{,}2} (3x-6)$", "key": "$2 < x < 3$"}, {"id": "G11_TB_17_2_3_4", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{4}(2x-1) \\leq \\log_{4}(x+3)$", "key": "$0{,}5 < x \\leq 4$"}, {"id": "G11_TB_17_2_4_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{1}{3 - \\lg x} + \\dfrac{1}{1 + \\lg x} > 1$", "key": "$0{,}1 < x < 10$ или $10 < x < 1000$"}, {"id": "G11_TB_17_2_4_3", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{3}}^{2}x - 4 \\leq 0$", "key": "$x \\in \\left[\\dfrac{1}{9}; 9\\right]$"}, {"id": "G11_TB_17_2_4_4", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{1}{2}}^{2}x + \\log_{\\frac{1}{2}}x - 2 \\geq 0$", "key": "$x \\in \\left(0; \\dfrac{1}{2}\\right] \\cup [4; +\\infty)$"}, {"id": "G11_TB_1_2_1_4_1", "current_skill": "G11_S02_01", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\phi(x)=x^{2}$, $g(x)=\\log_{5} x$. Запишите сложную функцию: $f(\\phi(x))$", "key": "$7^{x^{2}}$"}, {"id": "G11_TB_1_2_1_4_3", "current_skill": "G11_S02_01", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\phi(x)=x^{2}$, $g(x)=\\log_{5} x$. Запишите сложную функцию: $f(g(x))$", "key": "$7^{\\log_{5} x}$"}, {"id": "G11_TB_1_2_1_4_7", "current_skill": "G11_S02_01", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\phi(x)=x^{2}$, $g(x)=\\log_{5} x$. Запишите сложную функцию: $f(g(\\phi(x)))$", "key": "$7^{\\log_{5}(x^{2})}$"}, {"id": "G11_TB_1_2_1_4_8", "current_skill": "G11_S02_01", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\phi(x)=x^{2}$, $g(x)=\\log_{5} x$. Запишите сложную функцию: $f(g(f(x)))$", "key": "$7^{\\log_{5} (7^{x})}$"}, {"id": "G11_TB_1_3_1_8_4", "current_skill": "G11_S02_01", "q": "Найдите область определения функции:\n$y = \\dfrac{x^{2} - 9}{x^{2} - 4}$", "key": "$(-\\infty; -2) \\cup (-2; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_27_2_31_1", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{\\sin x}(3\\sin x - \\cos x) = 0$", "key": "$x = \\arcsin \\dfrac{3}{5} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_37_1", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{5}{2-x} > 1 + \\dfrac{3}{x+2}$", "key": "$x \\in (-8; -2) \\cup (0; 2)$"}, {"id": "G11_TB_27_2_37_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{5}{x+4} < 1 + \\dfrac{1}{4-x}$", "key": "$x \\in (-\\infty; -4) \\cup (0; 4) \\cup (6; +\\infty)$"}, {"id": "G11_TB_27_2_37_3", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{2}{3-x}>1-\\dfrac{3}{x+2}$", "key": "$x \\in (-2; 3)$"}, {"id": "G11_TB_27_2_37_4", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{7}{x+5} < 1 + \\dfrac{2}{5-x}$", "key": "$x \\in (-\\infty; -5) \\cup (0; 5) \\cup (9; +\\infty)$"}, {"id": "G11_TB_27_2_67_4", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $c$ решите уравнение $(2^{-x}+4+3c)(5-c-2^{-x})=0$.", "key": "$x = -\\log_{2}(-4 - 3c)$ при $c < \\dfrac{-4}{3}$; $x = -\\log_{2}(5 - c)$ при $c < 5$; при остальных $c$ решений нет"}, {"id": "G11_TB_6_6_6_1", "current_skill": "G11_S02_01", "q": "Решите неравенство методом интервалов: $\\dfrac{x^{2}-2x+1}{(2-x)x} \\leq 0$", "key": "$x \\in (-\\infty; 0) \\cup \\{1\\} \\cup (2; +\\infty)$"}, {"id": "G11_TB_8_2_8_4", "current_skill": "G11_S02_01", "q": "Объясните, в результате какого преобразования переход от первого уравнения ко второму приводит к появлению посторонних корней. Подберите корень второго уравнения, посторонний для первого уравнения:\n$\\dfrac{2\\operatorname{tg} x}{1+\\operatorname{tg}^{2}x}=0$, $\\sin 2x=0$", "key": "Применение формулы синуса двойного угла; $x = \\dfrac{\\pi}{2} + \\pi k$"}, {"id": "G11_TB_8_4_15_г", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{5}(x^{2}+2\\dfrac{2}{3}x)=0$", "key": "$x = -3$; $x = \\dfrac{1}{3}$"}, {"id": "G11_TB_8_4_16_а", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{11}\\left(\\dfrac{x+20}{x}\\right)=\\dfrac{\\log_{2}41}{\\log_{2}11}$", "key": "$x = 0{,}5$"}, {"id": "G11_TB_8_4_17_в", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{5}(4^{x} - 3 \\cdot 2^{x}) = \\log_{5}(3 \\cdot 2^{x} - 8)$", "key": "$x = 2$"}, {"id": "G11_TB_8_4_17_г", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{4}(9^{x} - 5 \\cdot 3^{x}) = \\log_{4}(7 \\cdot 3^{x} - 27)$", "key": "$x = 2$"}, {"id": "G11_TB_9_1_8_34_b", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{2}\\left(\\dfrac{12}{-3-x}\\right) = \\log_{2}(1-x)$", "key": "$x = -5$"}, {"id": "G11_TB_9_1_8_36_a", "current_skill": "G11_S02_01", "q": "Решите уравнение: $2\\log_{4}{(x+1)} = \\log_{4}{(4x+9)}$", "key": "$4$"}, {"id": "G11_TB_9_1_8_36_d", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{6}(x+2) + \\log_{6}(x-3) = \\log_{6}(2x^{2} - 5x - 6)$", "key": "$x = 4$"}, {"id": "G11_TB_9_1_8_36_f", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\lg(x+2) - \\lg(x-3) = \\lg\\left(\\dfrac{5x+4}{x}\\right)$", "key": "$x=4$"}, {"id": "G11_TB_9_1_8_38_c", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\lg(x+5)+\\lg(x-4)=\\lg(x+16)$", "key": "$x = 6$"}, {"id": "G11_TB_9_1_8_38_d", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\lg(x-3)+\\lg(x+4)=\\lg(7x-20)$", "key": "$x = 4$"}, {"id": "G11_TB_9_2_3", "current_skill": "G11_S02_01", "q": "Решим уравнение $\\lg(x^{2}-4)=\\lg(6x+4)$.", "key": "$3 + \\sqrt{17}$"}, {"id": "G11_TB_9_3_9_13_в", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\lg(25-x^{2})=\\lg(2x-10)$", "key": "нет решений"}, {"id": "G11_TB_9_3_9_14_г", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\lg(x^{2}+21x)+\\operatorname{tg}\\left(\\pi\\dfrac{x}{2}\\right)=2+\\operatorname{tg}\\left(\\pi\\dfrac{x}{2}\\right)$", "key": "$4$"}, {"id": "G11_TB_9_4*_9_23_a", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\dfrac{\\sin 2x}{x}=0$", "key": "$x = \\dfrac{\\pi k}{2}, k \\in \\mathbb{Z}, k \\neq 0$"}, {"id": "G11_TB_9_4*_9_27_в", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{x}(x+2)=2$", "key": "$x = 2$"}, {"id": "G11_TB_9_4*_9_27_г", "current_skill": "G11_S02_01", "q": "Решите уравнение: $\\log_{x}(x+6)=2$", "key": "$x = 3$"}, {"id": "G11_TB_9_7*_9_57_1", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{\\log_{2}(x-3)}{\\log_{0{,}5}(x+2)} > 0$", "key": "$x \\in (3; 4)$"}, {"id": "G11_TB_9_7*_9_57_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}3}(x-3)}{\\lg(x+4)} > 0$", "key": "$x \\in (3; 4)$"}, {"id": "G11_TB_9_7*_9_57_3", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}2}(x+2)}{\\log_{5}(3-x)} > 0$", "key": "$x \\in (-2; -1) \\cup (2; 3)$"}, {"id": "G11_TB_?_165_r", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{2x-1}{x-3} < x+3$", "key": "$x \\in (-2; 3) \\cup (4; +\\infty)$"}, {"id": "G11_TB_?_165_v", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{2x-1}{x+5}<1$", "key": "$x \\in (-5; 6)$"}, {"id": "G11_TB_?_166_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{5}{2-x} > 1 + \\dfrac{3}{x+2}$", "key": "$x \\in (-8; -2) \\cup (0; 2)$"}, {"id": "G11_TB_?_166_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{5}{x+4} < 1 + \\dfrac{1}{4-x}$", "key": "$x \\in (-\\infty; -4) \\cup (0; 4) \\cup (6; +\\infty)$"}, {"id": "G11_TB_?_166_r", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{7}{x+5} < 1 + \\dfrac{2}{5-x}$", "key": "$x \\in (-\\infty; -5) \\cup (0; 5) \\cup (9; +\\infty)$"}, {"id": "G11_TB_?_166_v", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{2}{3-x} > 1 - \\dfrac{3}{x+2}$", "key": "$x \\in (-2; 3)$"}, {"id": "G11_TB_?_167_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{x+1}{x-2} > \\dfrac{3}{x-2} - \\dfrac{1}{2}$", "key": "$x \\in (-\\infty; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_?_167_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{x+4}{x+2} < \\dfrac{2}{x+2} + \\dfrac{1}{7}$", "key": "$x \\in \\varnothing$"}, {"id": "G11_TB_?_168_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{1+\\dfrac{2}{x}}{1+\\dfrac{3}{x}}\\geqslant 0$", "key": "$x \\in (-\\infty; -3) \\cup [-2; 0) \\cup (0; \\infty)$"}, {"id": "G11_TB_?_168_v", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{1-\\dfrac{4}{x}}{1+\\dfrac{3}{x}}\\le 0$", "key": "$x \\in (-3; 0) \\cup (0; 4]$"}, {"id": "G11_TB_?_169_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{1}{x^{2}+8x-9} \\ge \\dfrac{1}{3x^{2}-5x+2}$", "key": "$x \\in (-\\infty; -9) \\cup \\left(\\dfrac{2}{3}; 1\\right) \\cup \\left[\\dfrac{11}{2}; +\\infty\\right)$"}, {"id": "G11_TB_?_169_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{1}{3x^{2}+11x+10}\\ge\\dfrac{1}{2-x-x^{2}}$", "key": "$x \\in (-\\infty; -2) \\cup \\left(\\dfrac{-5}{3}; -1\\right] \\cup (1; \\infty)$"}, {"id": "G11_TB_?_176_b", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{2}(2x-5) < -\\log_{2}3$", "key": "$x \\in (2{,}5; \\dfrac{8}{3})$"}, {"id": "G11_TB_?_177_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $3\\log_{8}(3x+2)<2$", "key": "$x \\in \\left(\\dfrac{-2}{3}; \\dfrac{2}{3}\\right)$"}, {"id": "G11_TB_?_177_v", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{\\frac{\\sqrt{10}}{3}}(1-3x) < 2$", "key": "$x \\in \\left( -\\dfrac{1}{27}; \\dfrac{1}{3} \\right)$"}, {"id": "G11_TB_?_178_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{0{,}4}(3{,}5-5x) > 2\\log_{0{,}4}0{,}2 - 1$", "key": "$x \\in (0{,}68; 0{,}7)$"}, {"id": "G11_TB_?_179_a", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{0{,}5}(2-7x) > -2$", "key": "$x \\in \\left(\\dfrac{-2}{7}; \\dfrac{2}{7}\\right)$"}, {"id": "G11_TB_?_207_2", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{\\lg(2x+9)}{\\lg\\left((2x+3)^{2}\\right)} \\le 1$", "key": "$x \\in (-4{,}5; -2{,}5] \\cup (-2; -1{,}5) \\cup (-1{,}5; -1) \\cup [0; +\\infty)$"}, {"id": "G11_TB_?_212_1", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{1}{\\log_{\\frac{1}{2}}(2x^{2}-1)} > \\dfrac{1}{\\log_{\\frac{1}{4}}x} + \\dfrac{1}{\\log_{\\frac{1}{3}}x}$", "key": "$x \\in (1; +\\infty)$"}, {"id": "G11_TB_?_216", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\dfrac{\\log_{2} x - 3}{6 \\log_{x} 2 - 1} \\le 2$", "key": "$x \\in \\left[\\dfrac{1}{8}; 1\\right) \\cup (1; 16] \\cup (64; +\\infty)$"}, {"id": "G11_TB_?_217_1", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\log_{(x-2)}x\\le\\log_{(x-2)}4$", "key": "$x \\in (3; 4]$"}, {"id": "G11_TB_?_242_d", "current_skill": "G11_S02_01", "q": "Для каждого значения параметра $c$ решите уравнение: $(2^{-x}+4+3c)(5-c-2^{-x})=0$.", "key": "При $c < \\dfrac{-4}{3}$: $x = -\\log_{2}(-4 - 3c)$, $x = -\\log_{2}(5 - c)$; при $\\dfrac{-4}{3} \\leq c < 5$: $x = -\\log_{2"}, {"id": "G11_TB_?_48_а", "current_skill": "G11_S02_01", "q": "Укажите область определения функции: $y = \\dfrac{x-2}{x^{2}-4}$", "key": "$x \\in (-\\infty; -2) \\cup (-2; 2) \\cup (2; \\infty)$"}, {"id": "G11_TB_?_48_б", "current_skill": "G11_S02_01", "q": "Укажите область определения функции: $y = \\dfrac{x+3}{x^{2}-9}$", "key": "$x \\in (-\\infty; -3) \\cup (-3; 3) \\cup (3; \\infty)$"}, {"id": "G11_TB_§16_16_10.1", "current_skill": "G11_S02_01", "q": "Найдите область определения функции $y=\\log_{0{,}5}(x+1)$.", "key": "$(-1; +\\infty)$"}, {"id": "G11_TB_§16_16_10.2", "current_skill": "G11_S02_01", "q": "Найдите область определения функции $y=\\log_{5}(x^{2}-4)$.", "key": "$(-\\infty; -2)\\cup(2; +\\infty)$"}, {"id": "G11_TB_§16_16_10.3", "current_skill": "G11_S02_01", "q": "Найдите область определения функции $y=\\log_{7}(9-x^{2})$.", "key": "$(-3; 3)$"}, {"id": "G11_TB_§16_16_15.1", "current_skill": "G11_S02_01", "q": "Решите неравенство $\\log_{0{,}5}x<-2$.", "key": "$x>4$"}, {"id": "G11_TB_§16_16_15.2", "current_skill": "G11_S02_01", "q": "Решите неравенство $\\log_{\\frac{1}{2}}(x+1)\\ge-1$.", "key": "$-1<x\\le1$"}, {"id": "G11_TB_§16_1_4", "current_skill": "G11_S02_01", "q": "Найдите область определения функции: $y = \\log_{5{,}2}(3x - x^{2})$.", "key": "$x \\in (0; 3)$"}, {"id": "G11_TB_§16_1_5", "current_skill": "G11_S02_01", "q": "Найдите область определения функции: $y = \\log_{\\frac{3}{8}}(2x^{2} + 1)$.", "key": "$x \\in \\mathbb{R}$"}, {"id": "G11_TB_§19_3_3", "current_skill": "G11_S02_01", "q": "Решите неравенство: $\\left|x-2\\right|^{\\log_{3}(x-2)}\\le\\left|x-2\\right|^{\\log_{3}(8-x)}$", "key": "$x \\in [3; 5]$"}]