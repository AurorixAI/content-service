[{"id": "G11_TB_10_2_10_3_з", "current_skill": "G11_S02_03", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\log_{a} f(x) + \\log_{a} g(x) = \\varphi(x)$ и $\\log_{a} (f(x)g(x)) = \\varphi(x)$?", "key": "$f(x) > 0, g(x) > 0$"}, {"id": "G11_TB_10_2_10_3_л", "current_skill": "G11_S02_03", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\log_{a}(f(x))^{2}=\\phi(x)$ и $2\\log_{a}|f(x)|=\\phi(x)$?", "key": "$f(x) \\neq 0$"}, {"id": "G11_TB_10_2_10_3_м", "current_skill": "G11_S02_03", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $2\\log_{a} f(x)=\\varphi(x)$ и $\\log_{a} (f(x))^{2}=\\varphi(x)$?", "key": "$f(x) > 0$"}, {"id": "G11_TB_10_2_10_3_н", "current_skill": "G11_S02_03", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $a^{\\log_{a} f(x)} = \\varphi(x)$ и $f(x) = \\varphi(x)$?", "key": "$f(x) > 0$"}, {"id": "G11_TB_10_4*_15_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{2\\sqrt{0{,}5-x}}{(x-4)(x+1)} = \\dfrac{\\sqrt{0{,}5-x}}{(x-2)(x+2)}$", "key": "$x=0{,}5$; $x=-4$"}, {"id": "G11_TB_10_4*_15_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{4\\sqrt{x-10}}{(x-4)(x+3)} = \\dfrac{3\\sqrt{x-10}}{(x-3)(x-2)}$", "key": "$10; 12$"}, {"id": "G11_TB_10_4*_18_в", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{\\sqrt{3x+5}-\\sqrt{x}}{\\sqrt{x^{2}+1}+\\sqrt{x}}=\\dfrac{\\sqrt{x^{2}+1}-\\sqrt{x}}{\\sqrt{3x+5}+\\sqrt{x}}$", "key": "$4$"}, {"id": "G11_TB_10_4*_19_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{2\\sin x}{\\sqrt{-x^{2}+4x-3}}=\\dfrac{1}{\\sqrt{-x^{2}+4x-3}}$", "key": "$\\dfrac{5\\pi}{6}$"}, {"id": "G11_TB_10_4*_19_в", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{2\\cos x}{\\sqrt{\\pi^{2}-4x^{2}}}=\\dfrac{\\sqrt{2}}{\\sqrt{\\pi^{2}-4x^{2}}}$", "key": "$x = \\pm \\dfrac{\\pi}{4}$"}, {"id": "G11_TB_10_4*_19_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{2\\cos x}{\\sqrt{\\pi^{2}-x^{2}}} = \\dfrac{-1}{\\sqrt{\\pi^{2}-x^{2}}}$", "key": "$\\pm \\dfrac{2\\pi}{3}$"}, {"id": "G11_TB_10_4*_3", "current_skill": "G11_S02_03", "q": "Решите уравнение $$x^2-2x+\\log_2x=3+\\log_2x.$$ Укажите все действительные решения.", "key": "$3$"}, {"id": "G11_TB_10_4*_4", "current_skill": "G11_S02_03", "q": "Решите уравнение $$3^{\\log_3(2x-5)}=x^2-4x+1.$$ Укажите все действительные решения.", "key": "$3+\\sqrt3$"}, {"id": "G11_TB_10_5*_10_24_а", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\lg(x^{2}-4)=\\lg(x-1)$", "key": "$x = \\dfrac{1 + \\sqrt{13}}{2}$"}, {"id": "G11_TB_10_5*_10_24_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{2}(x^{2}-9)=\\log_{2}(2-x)+1$", "key": "$-1 - \\sqrt{14}$"}, {"id": "G11_TB_10_5*_10_24_в", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\lg{3x^{2}} = \\lg{(2x+1)}$", "key": "$1; \\dfrac{-1}{3}$"}, {"id": "G11_TB_10_5*_10_24_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{2}(16-x^{2}) = \\log_{2}(1+x) + 1$", "key": "$-1 + \\sqrt{15}$"}, {"id": "G11_TB_10_5*_10_27_а", "current_skill": "G11_S02_03", "q": "Решите уравнение: $x^{2} + 2x + \\log_{2}(x+1) = 15 + \\log_{2}(x+1)$", "key": "$3$"}, {"id": "G11_TB_10_5*_10_27_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $x^{2} - 6x - \\log_{3}(1 - x) = 7 - \\log_{3}(1 - x)$", "key": "$-1$"}, {"id": "G11_TB_10_5*_10_27_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $x^{2} - \\log_{5}(-x) = -6x - \\log_{5}(-x)$", "key": "$-6$"}, {"id": "G11_TB_10_5*_4", "current_skill": "G11_S02_03", "q": "Решим уравнение $\\log_{x+3}(8-x)=2\\log_{x+3}(x+4).$", "key": "$-1$"}, {"id": "G11_TB_10_6*_10_33_2", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\sqrt{\\dfrac{x-5}{x+1}} + \\sqrt{\\dfrac{x+1}{x-5}} = \\dfrac{10}{\\sqrt{(x+1)(x-5)}}$", "key": "$-3; 7$"}, {"id": "G11_TB_10_6*_10_34_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{2}(x+2) + \\log_{2}(3x+2) = \\log_{2}(5x+22)$", "key": "$x = 2$"}, {"id": "G11_TB_10_6*_10_35_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{5}(x-5)^{2}=2\\log_{5}\\sqrt{x}$", "key": "$x = \\dfrac{11 \\pm \\sqrt{21}}{2}$"}, {"id": "G11_TB_10_6*_10_35_2", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{3}(x-3)^{2}=2\\log_{3}\\sqrt{x}$", "key": "$x = \\dfrac{7 \\pm \\sqrt{13}}{2}$"}, {"id": "G11_TB_10_6*_10_35_3", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\lg(x-2)^{2}=2\\lg\\sqrt{3-x}$", "key": "$x = \\dfrac{3 - \\sqrt{5}}{2}; x = \\dfrac{3 + \\sqrt{5}}{2}$"}, {"id": "G11_TB_10_6*_10_35_4", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\lg(x-1)^{2}=2\\lg\\sqrt{2-x}$", "key": "$x = \\dfrac{1 - \\sqrt{5}}{2}; x = \\dfrac{1 + \\sqrt{5}}{2}$"}, {"id": "G11_TB_10_6*_10_37_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\lg(x-1)+\\sqrt{9-x^{2}}=\\lg(x-1)+\\sqrt{x+5}$", "key": "$\\dfrac{-1 + \\sqrt{17}}{2}$"}, {"id": "G11_TB_10_6*_10_40_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{2}(8x^{2} - x) \\cdot \\log_{4x}(8x - 1) = 2$", "key": "$x = \\dfrac{5}{8}$"}, {"id": "G11_TB_10_6*_10_41_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{3}(5x^{2} - x) \\cdot \\log_{3x}(5x - 1) = 1$", "key": "$x = 0{,}8$; $x = \\dfrac{3 + \\sqrt{69}}{30}$"}, {"id": "G11_TB_10_6*_10_41_2", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{4}(20x^{2} - x) \\cdot \\log_{16x}(20x - 1) = 2$", "key": "$x = \\dfrac{17}{20}; x = \\dfrac{1+\\sqrt{6}}{40}$"}, {"id": "G11_TB_10_6*_10_43_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$(x^{2}+1)^{\\sqrt{8x-x^{2}-15}} = (2x+9)^{\\sqrt{8x-x^{2}-15}}$", "key": "$3; 4; 5$"}, {"id": "G11_TB_10_6*_10_43_2", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$(x^{2}-8)^{\\sqrt{24x-4x^{2}-35}}=(7x-20)^{\\sqrt{24x-4x^{2}-35}}$", "key": "$x = 3$; $x = 3{,}5$"}, {"id": "G11_TB_10_6*_10_44_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\dfrac{1}{\\sqrt{x-1}} = (x-1)^{\\log_{\\frac{1}{25}}(8+2x-x^{2})}$", "key": "$x = 2$; $x = 3$"}, {"id": "G11_TB_10_6*_10_44_2", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\dfrac{1}{\\sqrt{2x-1}} = (2x-1)^{\\log_{\\frac{1}{4}}(1+7x-2x^{2})}$", "key": "$1; \\dfrac{7+\\sqrt{41}}{4}$"}, {"id": "G11_TB_10_6*_10_45_1", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{1}{\\sqrt{1 - x^{2}}} = (1 - x^{2})^{-\\frac{\\sin^{2} x}{\\sin x + 1}}$", "key": "$-\\dfrac{\\pi}{6}$; $0$"}, {"id": "G11_TB_10_6*_10_45_2", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{1}{\\sqrt{4 - x^{2}}} = (4 - x^{2})^{-\\frac{\\cos^{2} x}{\\cos x + 1}}$", "key": "$-\\sqrt{3}$; $0$; $\\sqrt{3}$"}, {"id": "G11_TB_10_6*_10_45_3", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{1}{\\sqrt{2 - x^{2}}} = (2 - x^{2})^{-\\frac{\\sin^{2} x}{\\sin x + 1}}$", "key": "$-1; 1; -\\dfrac{\\pi}{6}$"}, {"id": "G11_TB_10_6*_10_45_4", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{1}{\\sqrt{2 - x^{2}}} = (2 - x^{2})^{-\\frac{\\cos^{2} x}{\\cos x + 1}}$", "key": "$-1; 0; 1$"}, {"id": "G11_TB_10_6*_10_46_1", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{|x|}(1+x) = \\log_{|x|}(x^{2} - 5)$", "key": "$x=3$"}, {"id": "G11_TB_10_6*_10_46_2", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\log_{|x|}(9+x) = \\log_{|x|}(x^{2}+7)$", "key": "$x=2$"}, {"id": "G11_TB_11_2_11_5_в", "current_skill": "G11_S02_03", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\log_{3}{\\operatorname{tg}{x}} > \\log_{3}{\\sqrt{3}}$, $\\operatorname{tg}{x} > \\sqrt{3}$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Потенцирование. Равносильны на множестве, где $\\operatorname{tg}{x} > 0$."}, {"id": "G11_TB_11_2_11_5_г", "current_skill": "G11_S02_03", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\log_{0{,}2}(x^{2}+3) > \\log_{0{,}2} 4x$, $x^{2}+3 < 4x$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Потенцирование (основание $0 < a < 1$). Равносильны на множестве, где $x^{2} + 3 > 0$ и $4x > 0$, т.е. $x > 0$."}, {"id": "G11_TB_11_2_11_5_ж", "current_skill": "G11_S02_03", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\dfrac{x^{2}-5x}{\\lg x} > \\dfrac{-6}{\\lg x}$, $x^{2}-5x<-6$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Умножение на функцию $\\lg x$. Равносильны на множестве, где $\\lg x < 0$, т.е. $0 < x < 1$."}, {"id": "G11_TB_11_2_11_5_з", "current_skill": "G11_S02_03", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\log_{2} x + \\log_{2} (x+1) > 1$, $\\log_{2} (x^{2}+x) > 1$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Применение формулы суммы логарифмов. Равносильны на множестве, где $x>0$ и $x+1>0$, т.е. $x>0$."}, {"id": "G11_TB_11_4*_11_18_a", "current_skill": "G11_S02_03", "q": "Решите неравенство:\n$\\dfrac{x^{2}}{\\sqrt{x^{2}-16}} > \\dfrac{5x-5}{\\sqrt{x^{2}-16}}$", "key": "$(-\\infty; -4) \\cup (4; +\\infty)$"}, {"id": "G11_TB_11_4*_11_18_b", "current_skill": "G11_S02_03", "q": "Решите неравенство:\n$\\dfrac{x^{2}}{\\sqrt{5x-x^{2}}}>\\dfrac{7x-3}{\\sqrt{5x-x^{2}}}$", "key": "$(0; \\dfrac{7 - \\sqrt{37}}{2})$"}, {"id": "G11_TB_11_4*_11_18_в", "current_skill": "G11_S02_03", "q": "Решите неравенство:\n$\\dfrac{x^{2}}{\\sqrt{3x-x^{2}-2}} < \\dfrac{3-6x}{\\sqrt{3x-x^{2}-2}}$", "key": "$\\varnothing$"}, {"id": "G11_TB_11_4*_11_18_г", "current_skill": "G11_S02_03", "q": "Решите неравенство:\n$\\dfrac{x^{2}}{\\sqrt{5-4x-x^{2}}}<\\dfrac{11-4x}{\\sqrt{5-4x-x^{2}}}$", "key": "$(-5; 1)$"}, {"id": "G11_TB_11_4*_11_22_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{2}{\\sqrt{\\sin x}} > \\dfrac{x^{2} - x}{\\sqrt{\\sin x}}$", "key": "$x \\in (0; 2)$"}, {"id": "G11_TB_11_4*_11_22_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{6}{\\sqrt{\\cos x}} > \\dfrac{x^{2}+x}{\\sqrt{\\cos x}}$", "key": "$x \\in \\left(-\\dfrac{\\pi}{2}; \\dfrac{\\pi}{2}\\right)$"}, {"id": "G11_TB_11_5*_11_24_а", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{25}(x^{2}-7) > \\log_{25}(x-1)$", "key": "$x \\in (3; +\\infty)$"}, {"id": "G11_TB_11_5*_11_25_а", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\dfrac{\\sqrt{10}}{3}}(1-3x) < 2$", "key": "$x \\in \\left(-\\dfrac{1}{27}; \\dfrac{1}{3}\\right)$"}, {"id": "G11_TB_11_5*_11_25_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\dfrac{\\sqrt{6}}{3}}(2x-1) > 2$", "key": "$x \\in \\left(\\dfrac{1}{2}; \\dfrac{5}{6}\\right)$"}, {"id": "G11_TB_11_5*_11_25_в", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{0{,}5}(x^{2}-1) > -2$", "key": "$x \\in (-\\sqrt{5}; -1) \\cup (1; \\sqrt{5})$"}, {"id": "G11_TB_11_5*_11_26_в", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}2}(2-5x)}{\\log_{5} 625} > 0$", "key": "$x \\in \\left(\\dfrac{1}{5}; \\dfrac{2}{5}\\right)$"}, {"id": "G11_TB_11_5*_11_26_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{0{,}6} 0{,}216 \\cdot \\log_{5} (5-2x) < 0$", "key": "$x \\in (2; 2{,}5)$"}, {"id": "G11_TB_11_5*_11_27_а", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{31}(8x-9)^{2} > \\log_{31}(9x-11)^{2}$", "key": "$x \\in \\left(\\dfrac{20}{17}; \\dfrac{11}{9}\\right) \\cup \\left(\\dfrac{11}{9}; 2\\right)$"}, {"id": "G11_TB_11_5*_11_28_а", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{1}{\\sqrt{x+2}} + x < \\dfrac{1}{\\sqrt{x+2}} + 5$", "key": "$x \\in (-2; 5)$"}, {"id": "G11_TB_11_5*_11_28_в", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{3}{\\sqrt{x+4}} + x > \\dfrac{3}{\\sqrt{x+4}} + 3$", "key": "$x \\in (3; +\\infty)$"}, {"id": "G11_TB_11_5*_11_28_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{4}{\\sqrt{x+5}} + x > \\dfrac{4}{\\sqrt{x+5}} + 2$", "key": "$x \\in (2; +\\infty)$"}, {"id": "G11_TB_11_5*_11_33*_а", "current_skill": "G11_S02_03", "q": "Решите неравенство: $4 \\log_{x}{3} > \\log_{3}{x} - 3$", "key": "$x \\in (0; \\dfrac{1}{3}) \\cup (1; 81)$"}, {"id": "G11_TB_11_6*_11_35_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $3\\sqrt{\\dfrac{x-1}{x-4}} - \\sqrt{\\dfrac{x-4}{x-1}} < \\dfrac{5}{\\sqrt{(x-4)(x-1)}}$", "key": "$x \\in (-3; 1)$"}, {"id": "G11_TB_11_6*_11_35_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $4\\sqrt{\\dfrac{x+2}{x+3}} + \\sqrt{\\dfrac{x+3}{x+2}} > \\dfrac{9}{\\sqrt{(x+2)(x+3)}}$", "key": "$x \\in (-\\infty; -4) \\cup (-0{,}4; +\\infty)$"}, {"id": "G11_TB_11_6*_11_37_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{13x+25}}{|x-2|} > \\dfrac{\\sqrt{11x+23}}{|x-2|}$", "key": "$x \\in (-1; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_11_6*_11_37_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{9x+45}}{|x+2|} < \\dfrac{\\sqrt{7x+15}}{|x+2|}$", "key": "$\\varnothing$"}, {"id": "G11_TB_11_6*_11_40_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\lg(x+1)+\\lg(x-8)>\\lg(2x-8)$", "key": "$x \\in (9; +\\infty)$"}, {"id": "G11_TB_11_6*_11_40_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{2}(x+1) + \\log_{2}(3x-1) > \\log_{2}(9x+5)$", "key": "$x \\in (3; +\\infty)$"}, {"id": "G11_TB_11_6*_11_40_в", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\frac{1}{2}}(3x+1) + \\log_{\\frac{1}{2}}(2x-1) < \\log_{\\frac{1}{2}}(5x-1)$", "key": "$x \\in (1; +\\infty)$"}, {"id": "G11_TB_11_6*_11_40_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\frac{1}{3}}(4x+1) + \\log_{\\frac{1}{3}}(2x-1) < \\log_{\\frac{1}{3}}(10x+7)$", "key": "$x \\in (2; +\\infty)$"}, {"id": "G11_TB_11_6*_11_42*_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $2\\lg(x-1)<\\lg(x+1)$", "key": "$x \\in (1; 3)$"}, {"id": "G11_TB_11_6*_11_43*_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{x^{2}-4}-|\\sin x|}{\\sqrt{3x}+|\\sin x|} < \\dfrac{\\sqrt{3x}-|\\sin x|}{\\sqrt{x^{2}-4}+|\\sin x|}$", "key": "$x \\in [2; 4)$"}, {"id": "G11_TB_11_6*_11_44_в", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{x}\\left(\\dfrac{6x-1}{13x-7}\\right)<0$", "key": "$x \\in \\left(\\dfrac{7}{13}; \\dfrac{6}{7}\\right) \\cup (1; +\\infty)$"}, {"id": "G11_TB_11_6*_11_44_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{x}\\left(\\dfrac{16x-11}{5x-1}\\right) > 0$", "key": "$x \\in \\left(\\dfrac{11}{16}; \\dfrac{10}{11}\\right) \\cup (1; +\\infty)$"}, {"id": "G11_TB_11_6*_11_45*_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $2 + \\log_{\\sqrt{x^{2} - 2x - 3}} \\left( \\dfrac{x+4}{x+1} \\right) > \\log_{x^{2} - 2x - 3} (x^{2} - 2x - 2)^{2}$", "key": "$x \\in (3; 1+\\sqrt{5}) \\cup \\left(\\dfrac{10}{3}; +\\infty\\right)$"}, {"id": "G11_TB_11_6*_11_46*_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $(4-x)^{x^{2}-9} - \\sin^{2} 10^{\\circ} < (4-x)^{\\frac{1}{\\log_{\\cos 10^{\\circ}} \\sqrt{4-x}}}$", "key": "$x \\in (-3; 3) \\cup (3; 4)$"}, {"id": "G11_TB_12_1_11_57_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{12-x-x^{2}}}{2x+7} \\le \\dfrac{\\sqrt{12-x-x^{2}}}{x-5}$", "key": "$x \\in [-4; -3{,}5) \\cup \\{3\\}$"}, {"id": "G11_TB_12_1_11_57_b", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{8-2x-x^{2}}}{2x+9} \\ge \\dfrac{\\sqrt{8-2x-x^{2}}}{x-5}$", "key": "$x \\in [-4; 2]$"}, {"id": "G11_TB_12_1_11_57_g", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{6+x-x^{2}}}{2x+5} \\ge \\dfrac{\\sqrt{6+x-x^{2}}}{x+4}$", "key": "$x \\in [-2; -1] \\cup \\{3\\}$"}, {"id": "G11_TB_12_1_11_58_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{(2x+3)\\sqrt{x-2}}{x-6{,}6}\\geq\\dfrac{5\\sqrt{x-2}}{x-5}$", "key": "$x \\in [2; 5) \\cup (6{,}6; +\\infty)$"}, {"id": "G11_TB_12_1_11_58_b", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{3x+1}{(2x+1)\\sqrt{2-x}} \\leq \\dfrac{1}{(x+1)\\sqrt{2-x}}$", "key": "$x \\in (-1; \\dfrac{-2}{3}] \\cup (-0{,}5; 0]$"}, {"id": "G11_TB_12_1_11_58_g", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{1}{(x+1)\\sqrt{9-x}} \\leq \\dfrac{4-x}{(8-x)\\sqrt{9-x}}$", "key": "$x \\in (-\\infty; -1) \\cup \\{2\\} \\cup (8; 9)$"}, {"id": "G11_TB_12_1_11_58_v", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{(2x-7)\\sqrt{x-1}}{x-3} \\geq \\dfrac{9\\sqrt{x-1}}{5-x}$", "key": "$x \\in [1; 3) \\cup (5; +\\infty)$"}, {"id": "G11_TB_12_1_11_59_g", "current_skill": "G11_S02_03", "q": "Решите неравенство: $7 \\leq \\left(\\dfrac{1}{49}\\right)^{\\frac{2}{x}} \\cdot \\left(\\dfrac{1}{343}\\right)^{\\frac{1}{x^{2}}}$", "key": "$x \\in [-3; -1]$"}, {"id": "G11_TB_12_1_11_61_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\lg x + \\lg(x+3) \\leq 1$", "key": "$x \\in (0; 2]$"}, {"id": "G11_TB_12_1_11_61_b", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{2}{x} + \\log_{2}{(x-2)} \\leq 3$", "key": "$x \\in (2; 4]$"}, {"id": "G11_TB_12_1_11_61_g", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\frac{1}{3}}(x+6) + \\log_{\\frac{1}{3}} x \\geq -3$", "key": "$x \\in (0; 3]$"}, {"id": "G11_TB_12_1_11_61_v", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\frac{1}{9}}(x+8) + \\log_{\\frac{1}{9}} x \\geq -1$", "key": "$x \\in (0; 1]$"}, {"id": "G11_TB_12_1_11_64_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{6x}(x^{2}-17x+60)\\leq 1$", "key": "$x \\in (0; \\dfrac{1}{6}) \\cup [3; 5) \\cup (12; 20]$"}, {"id": "G11_TB_12_1_11_64_b", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{12x}(x^{2}-19x+84)\\leq 1$", "key": "$x \\in (0; \\dfrac{1}{12}) \\cup [3; 7) \\cup (12; 28]$"}, {"id": "G11_TB_12_1_11_64_g", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{7x}(x^{2}-16x+60)\\geq 1$", "key": "$x \\in \\left(\\dfrac{1}{7}; 3\\right] \\cup [20; +\\infty)$"}, {"id": "G11_TB_12_1_11_64_v", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{6x}(x^{2}-15x+54) \\geq 1$", "key": "$x \\in \\left(\\dfrac{1}{6}; 3\\right] \\cup [18; +\\infty)$"}, {"id": "G11_TB_13_1*_12_19_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{(2^{x}-8)(\\lg x-1)}{(\\log_{\\frac{1}{2}}x+1)\\sqrt{12-x}}>0$", "key": "$(0; 2) \\cup (3; 10)$"}, {"id": "G11_TB_13_1*_12_19_b", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{(3^{x}-81)(\\log_{2}x-2)}{(\\log_{\\frac{1}{3}}x+1)\\sqrt{5-x}}<0$", "key": "$(3; 4) \\cup (4; 5)$"}, {"id": "G11_TB_13_1*_12_19_в", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\left(\\dfrac{2^{\\log_{2}(x-1)}\\cdot(\\log_{0{,}2}x+1)}{|x-4|\\sqrt{6-x}}>0\\right)$", "key": "$(1; 4) \\cup (4; 5)$"}, {"id": "G11_TB_13_1*_12_19_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\left(\\dfrac{10^{\\lg|x-3|}\\cdot(\\log_{0{,}25}x+1)}{(\\log_{2}x-3)\\sqrt{8-x}}<0\\right)$", "key": "$(0; 3) \\cup (3; 4)$"}, {"id": "G11_TB_13_1*_12_23_a", "current_skill": "G11_S02_03", "q": "Решите неравенство: $2^{\\sqrt{x^{2}-9}}(x-5)\\log_{6}(9-x)<0$", "key": "$x \\in (-\\infty; -3] \\cup [3; 5) \\cup (8; 9)$"}, {"id": "G11_TB_13_1*_12_23_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $3^{\\sqrt{x^{2}-16}}(6-x)\\log_{2}(12+x)>0$", "key": "$(-11; -4] \\cup [4; 6)$"}, {"id": "G11_TB_13_2*_13_1_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $2003\\sqrt[4]{x^{2}-4}+2004\\sqrt{4-x^{2}}=\\operatorname{tg}\\dfrac{\\pi x}{2}$", "key": "$x=2$; $x=-2$"}, {"id": "G11_TB_13_2*_13_2_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $9^{\\sqrt{1-x^{2}}}-2=\\lg(1+\\sqrt{x^{2}-1})+x$", "key": "$x = -1$"}, {"id": "G11_TB_13_2*_13_3_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\sqrt{x^{2}-x-6}+10^{\\sqrt{4-x^{2}}}+5\\lg(12+x)\\leqslant 6$", "key": "$x = -2$"}, {"id": "G11_TB_13_2*_13_4_а", "current_skill": "G11_S02_03", "q": "Решите неравенство: $(\\sqrt{x^{2}-81}+2)\\log_{3}|x|+\\dfrac{9}{x}(\\sqrt{81-x^{2}}+1)>4$", "key": "$x = 9$"}, {"id": "G11_TB_13_2*_13_4_б", "current_skill": "G11_S02_03", "q": "Решите неравенство: $(\\sqrt{x^{2}-16}+1)\\log_{3}(x^{2}-7)-\\dfrac{x}{2}(\\sqrt{16-x^{2}}+3)<0$", "key": "$x = 4$"}, {"id": "G11_TB_13_2*_13_4_г", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\sqrt{x^{2}+7x+10}<\\lg(-5x+\\sqrt{-x^{2}-5x-6})$", "key": "$x = -2$"}, {"id": "G11_TB_14_2_14_12", "current_skill": "G11_S02_03", "q": "Решите систему уравнений:\n\n$$\n\\begin{cases}\ny + x^{2} = 3 \\\\\n1 + 2\\log_{3}(x+1) = \\log_{3}y\n\\end{cases}\n$$", "key": "$x = 0, y = 3$"}, {"id": "G11_TB_14_2_14_19_a", "current_skill": "G11_S02_03", "q": "Является ли вторая система следствием первой системы:\n$$\\begin{cases} x^{2}+2y+\\lg x=5+\\lg x; \\\\ x+y=1 \\end{cases}$$ и $$\\begin{cases} x^{2}+2y=5; \\\\ x+y=1 \\end{cases}$$", "key": "да"}, {"id": "G11_TB_14_2_14_19_c", "current_skill": "G11_S02_03", "q": "Является ли вторая система следствием первой системы: $\\begin{cases} \\dfrac{\\sqrt{x}}{y}+\\dfrac{\\sqrt{y}}{x}=\\dfrac{35}{36}, \\\\ \\sqrt{x}+\\sqrt{y}=y-x \\end{cases}$ и $\\begin{cases} x\\sqrt{x}+y\\sqrt{y}=\\dfrac{35}{36}xy, \\\\ \\sqrt{x}+\\sqrt{y}=y-x \\end{cases}$", "key": "да"}, {"id": "G11_TB_14_2_14_19_d", "current_skill": "G11_S02_03", "q": "Является ли вторая система следствием первой системы:\n$\\log_{2}(x+2y)=\\log_{2}(2x+y)$; $x^{2}-y-2=0$ и $x+2y=2x+y$; $x^{2}-y-2=0$", "key": "да"}, {"id": "G11_TB_14_2_14_5", "current_skill": "G11_S02_03", "q": "Докажите, что система уравнений не имеет действительных решений:\n$\\sqrt{2-x}+7=x+y$; $\\log_{2}(x-2)+\\sqrt{y-1}=0$", "key": "Доказательство: из первого уравнения $x \\le 2$, из второго $x > 2$, система несовместна."}, {"id": "G11_TB_15_1*_14_42_a", "current_skill": "G11_S02_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n2\\log_{1-x}(-xy-2x+y+2)+\\log_{2+y}(x^{2}-2x+1)=6, \\\\\n\\log_{1-x}(y+5)-\\log_{2+y}(x+4)=1\n\\end{cases}\n$$", "key": "$x=-2$; $y=1$"}, {"id": "G11_TB_15_1*_14_42_b", "current_skill": "G11_S02_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\log_{1+x}(y^{2} - 2y + 1) + \\log_{1-y}(x^{2} + 2x + 1) = 4, \\\\\n\\log_{1+x}(2y + 1) + \\log_{1-y}(2x + 1) = 2\n\\end{cases}\n$$", "key": "$x=\\dfrac{-2}{5}; y=\\dfrac{2}{5}$"}, {"id": "G11_TB_15_1*_14_42_c", "current_skill": "G11_S02_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n2\\log_{3+x}(xy+x+3y+3)+\\log_{1+y}(x^{2}+6x+9)=6, \\\\\n\\log_{3+x}(0{,}5-y)+\\log_{1+y}(3x+8)=1\n\\end{cases}\n$$", "key": "$x = -2{,}5; y = -0{,}5$"}, {"id": "G11_TB_15_1*_14_44_b", "current_skill": "G11_S02_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\sqrt{\\dfrac{1}{\\lg x}} + \\sqrt[4]{y} = 2, \\\\\n\\sqrt{\\sqrt{\\dfrac{y}{\\lg x}}} - z^{2} = 1\n\\end{cases}\n$$", "key": "$x = 10; y = 1; z = 0$"}, {"id": "G11_TB_15_3*_15_19_1", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\dfrac{\\sqrt{x-a}}{x-1} \\ge 0$", "key": "При $a < 1$: $x = a$ или $x > 1$; при $a = 1$: $x > 1$; при $a > 1$: $x \\ge a$"}, {"id": "G11_TB_15_3*_15_19_3", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\dfrac{x+3}{\\sqrt{x-a}} \\ge 0$", "key": "При $a<-3$: $x \\in [-3; +\\infty)$; при $a=-3$: $x \\in (-3; +\\infty)$; при $a>-3$: $x \\in (a; +\\infty)$"}, {"id": "G11_TB_15_3*_15_19_4", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\dfrac{x-4}{\\sqrt{x-a}} \\le 0$", "key": "При $a<4$: $x \\in (a; 4]$; при $a=4$: $x \\in \\varnothing$; при $a>4$: $x \\in \\varnothing$"}, {"id": "G11_TB_15_3*_15_21_1", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\log_{2}(x-a) \\geq \\log_{2}(13-x)$", "key": "При $a < 13$: $x \\in \\left[ \\dfrac{a+13}{2}; 13 \\right)$; при $a \\geq 13$: решений нет"}, {"id": "G11_TB_15_3*_15_21_2", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\log_{3}(x-a) \\geq \\log_{3}(11-x)$", "key": "При $a<11$: $x \\in \\left[ \\dfrac{a+11}{2}; 11 \\right)$; при $a=11$: $x \\in \\varnothing$; при $a>11$: $x \\in \\varnothing$"}, {"id": "G11_TB_15_3*_15_21_3", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\log_{4}(x-a) \\leq \\log_{4}(9-x)$", "key": "При $a < 9$: $x \\in (a; \\dfrac{a+9}{2}]$; при $a \\geq 9$: решений нет"}]