[{"id": "G11_TB_§1_1_8_г", "current_skill": "G11_S02_01", "q": "Найдите область определения функции: $y=\\dfrac{x^{2}-9}{x^{2}-4}$", "key": "$(-\\infty; -2) \\cup (-2; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_§3_10_1", "current_skill": "G11_S02_01", "q": "Найдите область определения функции: $y = (2x^{3} - 4x)^{5}$", "key": "$(-\\infty; +\\infty)$"}, {"id": "G11_TB_§3_10_3", "current_skill": "G11_S02_01", "q": "Найдите область определения функции: $y = \\dfrac{1}{2x - 8}$", "key": "$x \\ne 4$"}, {"id": "G11_TB_10_2_10_2_б", "current_skill": "G11_S02_02", "q": "Определите множество: $M$, на котором равносильны уравнения: $\\sqrt{x}=1$ и $x^{2}=1$", "key": "$x \\ge 0$"}, {"id": "G11_TB_10_2_10_2_в", "current_skill": "G11_S02_02", "q": "Определите множество: $M$, на котором равносильны уравнения: $x^{3}+2x^{2}-1=0$ и $\\sqrt{x}(x^{3}+2x^{2}-1)=0$", "key": "$x > 0$"}, {"id": "G11_TB_10_2_10_2_г", "current_skill": "G11_S02_02", "q": "Определите множество: $M$, на котором равносильны уравнения: $x^{2}+5x+\\sqrt{x}=\\sqrt{x}-4$ и $x^{2}+5x+4=0$", "key": "$x \\ge 0$"}, {"id": "G11_TB_10_2_10_3_б", "current_skill": "G11_S02_02", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\sqrt{f(x)}=\\varphi(x)$ и $f(x)=\\varphi^{2}(x)$?", "key": "$f(x) \\ge 0$, $\\varphi(x) \\ge 0$"}, {"id": "G11_TB_10_2_10_3_в", "current_skill": "G11_S02_02", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\sqrt{f(x)}\\sqrt{g(x)}=\\varphi(x)$ и $\\sqrt{f(x)g(x)}=\\varphi(x)$?", "key": "$f\\ge 0, g\\ge 0$"}, {"id": "G11_TB_10_2_10_3_д", "current_skill": "G11_S02_02", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a \\neq 1)$ уравнения: $f(x)+\\sqrt{g(x)}=\\varphi(x)+\\sqrt{g(x)}$ и $f(x)=\\varphi(x)$?", "key": "$g(x) \\geq 0$"}, {"id": "G11_TB_10_2_10_3_е", "current_skill": "G11_S02_02", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\sqrt{(f(x))^{2}} = \\varphi(x)$ и $f(x) = \\varphi(x)$?", "key": "$f(x) \\ge 0$"}, {"id": "G11_TB_10_3*_10_11_а", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x-4} \\cdot \\sqrt{x+4} = \\sqrt{6}$", "key": "$\\sqrt{22}$"}, {"id": "G11_TB_10_3*_10_11_б", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x-3} \\cdot \\sqrt{x+3} = \\sqrt{5}$", "key": "$\\sqrt{14}$"}, {"id": "G11_TB_10_3*_10_11_в", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x-5} \\cdot \\sqrt{x+5} = \\sqrt{2}$", "key": "$3\\sqrt{3}$"}, {"id": "G11_TB_10_3*_10_11_г", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x-2} \\cdot \\sqrt{x+2} = \\sqrt{8}$", "key": "$2\\sqrt{3}$"}, {"id": "G11_TB_10_3*_10_5_а", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt[4]{x+1} = \\sqrt[4]{2x-5}$", "key": "$6$"}, {"id": "G11_TB_10_3*_10_5_б", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt[4]{x-1} = \\sqrt[4]{2x+5}$", "key": "нет решений"}, {"id": "G11_TB_10_3*_10_5_г", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{2x-9} = \\sqrt{4x+3}$", "key": "нет решений"}, {"id": "G11_TB_10_3*_10_6_г", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{4x^{2}-11} = \\sqrt{13x+31}$", "key": "$-2; 5{,}25$"}, {"id": "G11_TB_10_6*_10_32_1", "current_skill": "G11_S02_02", "q": "Решите уравнение:\n$\\sqrt{2x+1}=2\\sqrt{x-1}+1$", "key": "$4-2\\sqrt{2}$"}, {"id": "G11_TB_10_6*_10_32_3", "current_skill": "G11_S02_02", "q": "Решите уравнение:\n$\\sqrt{6x-3} - 2\\sqrt{x} = 1$", "key": "$4+2\\sqrt{3}$"}, {"id": "G11_TB_10_6*_10_36_1", "current_skill": "G11_S02_02", "q": "Решите уравнение:\n$\\lg(8x+11)+\\sqrt{x}=\\lg(x^{2}+2)+\\sqrt{x}$", "key": "$x = 9$"}, {"id": "G11_TB_10_6*_10_36_2", "current_skill": "G11_S02_02", "q": "Решите уравнение:\n$\\lg(x+8)+\\sqrt{-x}=\\lg(x^{2}+2)+\\sqrt{-x}$", "key": "$x = -2$"}, {"id": "G11_TB_10_6*_10_37_2", "current_skill": "G11_S02_02", "q": "Решите уравнение:\n$\\lg(1-x)+\\sqrt{25-x^{2}}=\\lg(1-x)+\\sqrt{x+16}$", "key": "$\\dfrac{-1 - \\sqrt{37}}{2}$"}, {"id": "G11_TB_11_2_11_5_д", "current_skill": "G11_S02_02", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\sin x + \\sqrt{x} > \\sin 2x + \\sqrt{x}$, $\\sin x > \\sin 2x$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Приведение подобных членов (вычитание $\\sqrt{x}$). Равносильны на множестве $x \\geq 0$."}, {"id": "G11_TB_11_2_11_5_и", "current_skill": "G11_S02_02", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\sqrt{x}\\sqrt{x+1} < \\sqrt{2}$, $\\sqrt{x^{2}+x} < \\sqrt{2}$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Применение формулы произведения корней. Равносильны на множестве, где $x \\geq 0$ и $x + 1 \\geq 0$, т.е. $x \\geq 0$."}, {"id": "G11_TB_11_3*_11_10_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{3-x} > x-1$", "key": "$(-\\infty; 2)$"}, {"id": "G11_TB_11_3*_11_10_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{5-x} > x-3$", "key": "$(-\\infty; 4)$"}, {"id": "G11_TB_11_3*_11_10_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{6-x} > 3x-4$", "key": "$(-\\infty; 2)$"}, {"id": "G11_TB_11_3*_11_10_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{4-x} > 2x-5$", "key": "$(-\\infty; 3)$"}, {"id": "G11_TB_11_3*_11_11_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{6x+7} > x+2$", "key": "$(-1; 3)$"}, {"id": "G11_TB_11_3*_11_11_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{5x+6} > x+2$", "key": "$(-1; 2)$"}, {"id": "G11_TB_11_3*_11_11_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{6x-2} > x+1$", "key": "$(1; 3)$"}, {"id": "G11_TB_11_3*_11_11_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{5x-1} > x+1$", "key": "$(1; 2)$"}, {"id": "G11_TB_11_3*_11_12_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{-x^{2}-5x} > \\sqrt{-x-3}$", "key": "$x \\in \\left(-2-\\sqrt{7}; -3\\right]$"}, {"id": "G11_TB_11_3*_11_12_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-x} > \\sqrt{3x-1}$", "key": "$(2 + \\sqrt{3}; +\\infty)$"}, {"id": "G11_TB_11_3*_11_12_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-6x} > \\sqrt{-x-1}$", "key": "$(-\\infty; -1]$"}, {"id": "G11_TB_11_3*_11_12_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-7x} > \\sqrt{-x-2}$", "key": "$(-\\infty; -2]$"}, {"id": "G11_TB_11_3*_11_14_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{6x-3} < |x+1|$", "key": "$[\\dfrac{1}{2}; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_11_3*_11_14_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{5x-1} > |3x-1|$", "key": "$(\\dfrac{2}{9}; 1)$"}, {"id": "G11_TB_11_3*_11_14_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{7x+2} > |x+2|$", "key": "$(1; 2)$"}, {"id": "G11_TB_11_3*_11_15_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x} < \\sqrt[3]{3x-2}$", "key": "$(1; 4 + 2\\sqrt{3})$"}, {"id": "G11_TB_11_3*_11_6_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{3x-2}<x$", "key": "$[\\dfrac{2}{3}; 1) \\cup (2; +\\infty)$"}, {"id": "G11_TB_11_3*_11_6_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{5x-4} < x$", "key": "$[\\dfrac{4}{5}; 1) \\cup (4; +\\infty)$"}, {"id": "G11_TB_11_3*_11_6_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{6x-5}<x$", "key": "$[\\dfrac{5}{6}; 1) \\cup (5; +\\infty)$"}, {"id": "G11_TB_11_3*_11_7_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{2x-1} < x$", "key": "$[\\dfrac{1}{2}; 1) \\cup (1; +\\infty)$"}, {"id": "G11_TB_11_3*_11_7_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{6x-9} < x$", "key": "$[\\dfrac{3}{2}; 3) \\cup (3; +\\infty)$"}, {"id": "G11_TB_11_3*_11_8_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x+1} < x-1$", "key": "$(3; +\\infty)$"}, {"id": "G11_TB_11_3*_11_8_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x+4} < x+2$", "key": "$(0; +\\infty)$"}, {"id": "G11_TB_11_3*_11_8_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x+4} < x-2$", "key": "$(5; +\\infty)$"}, {"id": "G11_TB_11_3*_11_9_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{2x+1} > x-1$", "key": "$[\\dfrac{-1}{2}; 4)$"}, {"id": "G11_TB_11_3*_11_9_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x+4} > x-2$", "key": "$[-4; 5)$"}, {"id": "G11_TB_11_3*_11_9_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{3x+4} > x-2$", "key": "$[\\dfrac{-4}{3}; 7)$"}, {"id": "G11_TB_11_6*_11_36_a", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\left(\\dfrac{1}{25}\\right)^{\\frac{2x-5}{2}} > \\left(\\dfrac{1}{5}\\right)^{\\sqrt{6x^{2}-31x+25}}$", "key": "$x \\in (-\\infty; 1] \\cup (5{,}5; +\\infty)$"}, {"id": "G11_TB_11_6*_11_36_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\left(\\dfrac{1}{36}\\right)^{x-3} < \\left(\\dfrac{1}{6}\\right)^{\\sqrt{5x^{2} - 41x + 36}}$", "key": "$x \\in [7{,}2; 17)$"}, {"id": "G11_TB_11_6*_11_39_a", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x+3} \\cdot \\sqrt{x+8} > 2x+4$", "key": "$x \\in [-3; 1)$"}, {"id": "G11_TB_11_6*_11_39_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x+3} \\cdot \\sqrt{x+6} < x+4$", "key": "$x \\in [-3; -2)$"}, {"id": "G11_TB_11_6*_11_39_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{2x+3} \\cdot \\sqrt{3x+7} > 2x+4$", "key": "$x \\in (-1; +\\infty)$"}, {"id": "G11_TB_11_6*_11_39_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{2x-1} \\cdot \\sqrt{3x-2} < 4x-3$", "key": "$x \\in (1; +\\infty)$"}, {"id": "G11_TB_11_7*_11_53_1", "current_skill": "G11_S02_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $$\\sqrt{\\sin^{2}{x}+\\sin{2x}-3\\cos^{2}{x}} > \\cos{x} - \\sin{x}, \\quad x \\in \\left(\\dfrac{\\pi}{4}; \\dfrac{5\\pi}{4}\\right).$$", "key": "$\\left(\\dfrac{\\pi}{4}; \\pi - \\arctg 3\\right]$"}, {"id": "G11_TB_12_1_11_55_a", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2}-4x+3)\\sqrt{x-2}\\geq 0$", "key": "$x \\in \\{2\\} \\cup [3; +\\infty)$"}, {"id": "G11_TB_12_1_11_55_b", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2}-3x-10)\\sqrt{3-x}\\geq 0$", "key": "$x \\in (-\\infty; -2] \\cup \\{3\\}$"}, {"id": "G11_TB_12_1_11_55_g", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2}+x-6)\\sqrt{x+5}\\leq 0$", "key": "$x \\in \\{-5\\} \\cup [-3; 2]$"}, {"id": "G11_TB_12_1_11_56_a", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-9}(x+8)\\geq 0$", "key": "$x \\in [-8; -3] \\cup [3; +\\infty)$"}, {"id": "G11_TB_12_1_11_56_g", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x+7)\\sqrt{x^{2}-25}\\leq 0$", "key": "$x \\in (-\\infty; -7] \\cup \\{-5\\} \\cup \\{5\\}$"}, {"id": "G11_TB_12_1_11_56_v", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-16}(x-5)\\geq 0$", "key": "$x \\in \\{-4\\} \\cup \\{4\\} \\cup [5; +\\infty)$"}, {"id": "G11_TB_12_1_11_63_b", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{4\\lg{x} - 16} \\geq 7 - \\lg{x}$", "key": "$x \\in [10^{5}; +\\infty)$"}, {"id": "G11_TB_12_1_11_63_g", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{12\\lg{x} - 8} \\leq 1 - 3\\lg{x}$", "key": "$\\varnothing$"}, {"id": "G11_TB_12_1_11_63_v", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{9\\lg{x}-3} \\leq 1-4\\lg{x}$", "key": "$\\varnothing$"}, {"id": "G11_TB_13_1*_12_20_a", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2}-4x)\\sqrt{9-x^{2}}\\leq 0$", "key": "$\\{-3\\} \\cup [0; 3]$"}, {"id": "G11_TB_13_1*_12_20_b", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2} - x - 30)\\sqrt{x^{2} - 4} \\le 0$", "key": "$[-5; -2] \\cup [2; 6]$"}, {"id": "G11_TB_13_1*_12_20_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2}-6x+8)\\sqrt{x^{2}-9} \\ge 0$", "key": "$(-\\infty; -3] \\cup \\{3\\} \\cup [4; +\\infty)$"}, {"id": "G11_TB_13_1*_12_20_г", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(x^{2}-x-12)\\sqrt{x^{2}-4} \\ge 0$", "key": "$(-\\infty; -3] \\cup \\{-2\\} \\cup \\{2\\} \\cup [4; +\\infty)$"}, {"id": "G11_TB_13_2*_13_2_а", "current_skill": "G11_S02_02", "q": "Решите уравнение: $5^{\\sqrt{16-x^{2}}}+3=\\lg(1+\\sqrt{x^{2}-16})+x$", "key": "$x=4$"}, {"id": "G11_TB_13_2*_13_3_а", "current_skill": "G11_S02_02", "q": "Решите неравенство: $e^{\\sqrt{1-x^{2}}}+\\sqrt{x^{2}-7x-8}\\geq -6$", "key": "$x = -1$"}, {"id": "G11_TB_13_2*_13_3_б", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\pi^{\\sqrt{4-x^{2}}}+\\sqrt{x^{2}-x-6}\\ge 6$", "key": "$x \\in \\varnothing$"}, {"id": "G11_TB_13_2*_13_3_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-4x-5}+\\lg(1+\\sqrt{8x-2x^{2}+10})\\le 6$", "key": "$x \\in \\{-1; 5\\}$"}, {"id": "G11_TB_13_2*_13_4_в", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{x^{2}-7x+10} > \\lg(\\sqrt{7x-x^{2}-10}+2)$", "key": "Решений нет"}, {"id": "G11_TB_13_5*_13_28_а", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt[3]{3x-1} - \\sqrt[4]{19-x} = 0$", "key": "$3$"}, {"id": "G11_TB_14_1_14_3.1", "current_skill": "G11_S02_02", "q": "Среди пар чисел $(1; 1)$, $(1; 5)$ и $(5; 1)$ найдите решения системы $\\begin{cases}\\sqrt{2-x}+\\sqrt{2-y}=x+y,\\\\ \\sqrt{x-1}+\\sqrt{y-1}+x-y=0.\\end{cases}$", "key": "$(1; 1)$"}, {"id": "G11_TB_14_1_14_3.2", "current_skill": "G11_S02_02", "q": "Среди пар чисел $(1; 1)$, $(1; 5)$ и $(5; 1)$ найдите решения системы $\\begin{cases}\\sqrt{x^{2}+y^{2}-1}=5,\\\\ xy+x+y=11.\\end{cases}$", "key": "$(1; 5)$ и $(5; 1)$"}, {"id": "G11_TB_14_2_14_19_b", "current_skill": "G11_S02_02", "q": "Является ли вторая система следствием первой системы:\n$$\\begin{cases} \\sqrt{x+1}=y-x; \\\\ 2xy-y^{2}=55 \\end{cases}$$ и $$\\begin{cases} x+1=y^{2}-2xy+x^{2}; \\\\ 2xy-y^{2}=55 \\end{cases}$$", "key": "да"}, {"id": "G11_TB_14_2_14_2_1", "current_skill": "G11_S02_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\sqrt{x+y-1}=1,\\\\\n\\sqrt{y-x+2}=2x-2.\n\\end{cases}\n$$", "key": "$(\\dfrac{3}{2}; \\dfrac{1}{2})$"}, {"id": "G11_TB_14_3_14_21_a", "current_skill": "G11_S02_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\sqrt{x - y + 3} = 2, \\\\\n\\sqrt{y - x + 10} = y + 1\n\\end{cases}\n$$", "key": "$x=3; y=2$"}, {"id": "G11_TB_14_3_4_1", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(2^{x}-2)\\sqrt{x^{2}-x-6}\\geq 0$", "key": "$x \\in \\{-2\\} \\cup [3; +\\infty)$"}, {"id": "G11_TB_14_3_4_2", "current_skill": "G11_S02_02", "q": "Решите неравенство: $(3^{x-2}-1)\\sqrt{x^{2}-2x-8}\\leq 0$", "key": "$x \\in (-\\infty; -2] \\cup \\{4\\}$"}, {"id": "G11_TB_15_1*_15_1_2", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите уравнение: $\\sqrt{x-a} = \\sqrt{2x-1+a}$.", "key": "Для каждого $a \\leq \\dfrac{1}{3}$ единственное решение $x_{0} = 1 - 2a$; для каждого $a > \\dfrac{1}{3}$ решений нет."}, {"id": "G11_TB_15_2*_15_8", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите уравнение: $\\sqrt{x^{2}-6x-a}=x-3$", "key": "При $a = -9$: $x \\geq 3$; при $a \\neq -9$: нет решений"}, {"id": "G11_TB_15_3*_15_18_1", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $(x-a) \\cdot \\sqrt{x-1} \\geq 0$", "key": "Если $a<1$: $x\\in[1; +\\infty)$; если $a=1$: $x\\in[1; +\\infty)$; если $a>1$: $x\\in\\{1\\}\\cup[a; +\\infty)$"}, {"id": "G11_TB_15_3*_15_18_2", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $(x-a) \\cdot \\sqrt{x-2} \\leq 0$", "key": "Если $a < 2$: $x = 2$; если $a = 2$: $x = 2$; если $a > 2$: $x \\in [2; a]$"}, {"id": "G11_TB_15_3*_15_18_3", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $(x-3) \\cdot \\sqrt{x-a} \\geq 0$", "key": "Если $a<3$: $x\\in\\{a\\}\\cup[3; +\\infty)$; если $a=3$: $x\\in[3; +\\infty)$; если $a>3$: $x\\in[a; +\\infty)$"}, {"id": "G11_TB_15_3*_15_18_4", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $(x-4) \\cdot \\sqrt{x-a} \\leq 0$", "key": "Если $a < 4$: $x \\in [a; 4]$; если $a = 4$: $x = 4$; если $a > 4$: $x = a$"}, {"id": "G11_TB_15_3*_15_20_1", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $\\sqrt{x-a} \\geq \\sqrt{3-x}$", "key": "При $a < 3$: $x \\in \\left[ \\dfrac{a+3}{2}; 3 \\right]$; при $a = 3$: $x = 3$; при $a > 3$: решений нет."}, {"id": "G11_TB_15_3*_15_20_2", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $\\sqrt{x+a} \\geq \\sqrt{13-x}$", "key": "При $a < -13$: $x \\in \\varnothing$; при $a = -13$: $x = 13$; при $a > -13$: $x \\in \\left[ \\dfrac{13-a}{2}; 13 \\right]$"}, {"id": "G11_TB_15_3*_15_20_3", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $\\sqrt{x-a} \\leq \\sqrt{23-x}$", "key": "Если $a < 23$, то $x \\in [a; \\dfrac{a+23}{2}]$; если $a = 23$, то $x = 23$; если $a > 23$, то решений нет."}, {"id": "G11_TB_15_3*_15_20_4", "current_skill": "G11_S02_02", "q": "Для каждого значения параметра $a$ решите неравенство: $\\sqrt{x-a} \\leq \\sqrt{33-x}$", "key": "Если $a < 33$, то $x \\in [a; \\dfrac{a+33}{2}]$; если $a = 33$, то $x = 33$; если $a > 33$, то решений нет."}, {"id": "G11_TB_15_4*_15_44_a", "current_skill": "G11_S02_02", "q": "При каких значениях параметра $a$ система уравнений\n$$\n\\begin{cases}\nx+\\sqrt{y-a-2}=0; \\\\\ny^{2}-x^{2}=a(2x+a)\n\\end{cases}\n$$\nимеет два различных решения?", "key": "$a \\in (-1; -\\dfrac{7}{8})$"}, {"id": "G11_TB_1_2_1_2_1", "current_skill": "G11_S02_02", "q": "Выпишите основные элементарные функции $f(x)$ и $g(x)$, с помощью которых задана сложная функция $f(g(x)) = \\sqrt{\\lg{x}}$.", "key": "$f(x) = \\sqrt{x}$, $g(x) = \\lg x$"}, {"id": "G11_TB_1_3_1_10_1", "current_skill": "G11_S02_02", "q": "Найдите область изменения функции:\n$y = \\sqrt{1 - x^{2}}$", "key": "$[0; 1]$"}, {"id": "G11_TB_1_3_1_14_1", "current_skill": "G11_S02_02", "q": "Имеет ли наибольшее (наименьшее) значение функция: $y=\\sqrt{x-1}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Наименьшее: $y = 0$ при $x = 1$. Наибольшего нет."}, {"id": "G11_TB_1_3_1_8_1", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y = \\sqrt{x - 1}$", "key": "$[1; +\\infty)$"}, {"id": "G11_TB_1_3_1_8_2", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y = \\sqrt[3]{x+1}$", "key": "$(-\\infty; +\\infty)$"}, {"id": "G11_TB_1_3_1_8_3", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y = \\sqrt{x^{2} - 1}$", "key": "$(-\\infty; -1] \\cup [1; +\\infty)$"}, {"id": "G11_TB_1_3_1_9_1", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y=\\log_{2}|x|$", "key": "$(-\\infty; 0) \\cup (0; +\\infty)$"}, {"id": "G11_TB_1_3_1_9_2", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y = |\\log_{2}{x}|$", "key": "$(0; +\\infty)$"}, {"id": "G11_TB_1_3_1_9_4", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y = 2^{\\sqrt{x}}$", "key": "$[0; +\\infty)$"}, {"id": "G11_TB_1_3_1_9_5", "current_skill": "G11_S02_02", "q": "Найдите область определения функции:\n$y = \\sqrt{2^{x}}$", "key": "$(-\\infty; +\\infty)$"}, {"id": "G11_TB_27_2_26_1", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(2x-7)\\sqrt{3x^{2}-5x-2}=0$", "key": "$-\\dfrac{1}{3}$; $2$; $3{,}5$"}, {"id": "G11_TB_27_2_26_2", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(2x-3)\\sqrt{4x^{2}-5x-9}=0$", "key": "$-1$; $2{,}25$"}, {"id": "G11_TB_27_2_26_3", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(3x^{2}-8x-11)\\sqrt{3x-5}=0$", "key": "$\\dfrac{5}{3}$; $\\dfrac{11}{3}$"}, {"id": "G11_TB_27_2_26_4", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(4x^{2}+3x-22)\\sqrt{3x-15}=0$", "key": "$5$"}, {"id": "G11_TB_27_2_28_1", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(\\sin x + \\cos x - \\sqrt{2})\\sqrt{-11x - x^{2} - 30} = 0$", "key": "$-6; -5; \\dfrac{\\pi}{4} - 2\\pi$"}, {"id": "G11_TB_27_2_28_2", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(\\cos x + \\sin x + \\sqrt{2}) \\sqrt{-x^{2} - 7x - 12} = 0$", "key": "$-4; -3$"}, {"id": "G11_TB_27_2_29_1", "current_skill": "G11_S02_02", "q": "Решите уравнение: $(2\\sin^{2}x-3\\sin x+1)\\sqrt{\\tg x}=0$", "key": "$x = \\pi k, \\ x = \\dfrac{\\pi}{6} + 2\\pi k, \\ k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_29_3", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{4x-x^{2}-3}\\left(\\sqrt{2}\\cos x-\\sqrt{1+\\cos 2x}\\right)=0$", "key": "$x \\in \\left[1; \\dfrac{\\pi}{2}\\right] \\cup \\{3\\}$"}, {"id": "G11_TB_27_2_2_7", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x^{4}-3x-1}=x^{2}-1$", "key": "$2$"}, {"id": "G11_TB_27_2_2_8", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x^{4}+x-9}=x^{2}-1$", "key": "$-2{,}5; 2$"}, {"id": "G11_TB_27_2_2_9", "current_skill": "G11_S02_02", "q": "Решите уравнение: $\\sqrt{x(x-2)(x+3)} = 3 - x$", "key": "$x = \\sqrt[3]{9}$"}, {"id": "G11_TB_27_2_38_1", "current_skill": "G11_S02_02", "q": "Решите неравенство: $\\sqrt{12x-11}<\\sqrt{10x-9}$", "key": "$x \\in \\left[\\dfrac{11}{12}; 1\\right)$"}]