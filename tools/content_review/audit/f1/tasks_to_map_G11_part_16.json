[{"id": "G11_TB_§16_5_б", "current_skill": "G11_S04_03", "q": "Учитывая возрастание или убывание соответствующей логарифмической функции, сравните значения: $\\log_{\\frac{1}{5}}7$ и $\\log_{\\frac{1}{5}}3$.", "key": "$\\log_{\\frac{1}{5}} 7 < \\log_{\\frac{1}{5}} 3$"}, {"id": "G11_TB_§19_17_2", "current_skill": "G11_S04_03", "q": "Сравните числа: $(\\sqrt{2})^{\\sqrt{5}}$ и $(\\sqrt{3})^{\\sqrt{2}}$", "key": "$(\\sqrt{2})^{\\sqrt{5}} < (\\sqrt{3})^{\\sqrt{2}}$"}, {"id": "G11_TB_§1_1_14_в", "current_skill": "G11_S04_03", "q": "Имеет ли наибольшее (наименьшее) значение функция $y = x^{3}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Ни наибольшего, ни наименьшего значения нет."}, {"id": "G11_TB_§1_1_41_2", "current_skill": "G11_S04_03", "q": "Докажите, что функция $y=|x|$ на промежутке $(-\\infty; 0]$ убывает.", "key": "При $x_{1} < x_{2} \\le 0$ имеем $|x_{1}| = -x_{1}$, $|x_{2}| = -x_{2}$, и $-x_{1} > -x_{2}$, поэтому $y(x_{1}) > y(x_{2}"}, {"id": "G11_TB_§1_1_44.1", "current_skill": "G11_S04_03", "q": "При каких значениях $k$ функция $y=kx+b$ является возрастающей?", "key": "$k>0$"}, {"id": "G11_TB_§1_1_44.2", "current_skill": "G11_S04_03", "q": "При каких значениях $k$ функция $y=kx+b$ является убывающей?", "key": "$k<0$"}, {"id": "G11_TB_§1_1_45.1", "current_skill": "G11_S04_03", "q": "При каких значениях $a$ функция $y=a(x-x_{0})^{2}+y_{0}$ является возрастающей на промежутке $[x_{0}; +\\infty)$?", "key": "$a>0$"}, {"id": "G11_TB_§1_1_45.2", "current_skill": "G11_S04_03", "q": "При каких значениях $a$ функция $y=a(x-x_{0})^{2}+y_{0}$ является убывающей на промежутке $[x_{0}; +\\infty)$?", "key": "$a<0$"}, {"id": "G11_TB_§1_1_45.3", "current_skill": "G11_S04_03", "q": "При каких значениях $a$ функция $y=a(x-x_{0})^{2}+y_{0}$ является возрастающей на промежутке $(-\\infty; x_{0}]$?", "key": "$a<0$"}, {"id": "G11_TB_§1_1_45.4", "current_skill": "G11_S04_03", "q": "При каких значениях $a$ функция $y=a(x-x_{0})^{2}+y_{0}$ является убывающей на промежутке $(-\\infty; x_{0}]$?", "key": "$a>0$"}, {"id": "G11_TB_§1_1_46_1", "current_skill": "G11_S04_03", "q": "Докажите, что функция $y = \\log_{\\frac{1}{2}} x$ строго монотонна на полной области определения.", "key": "Функция $y=\\log_{\\frac{1}{2}}x$ определена при $x>0$. Так как основание $0<\\dfrac{1}{2}<1$, логарифмическая функция стро"}, {"id": "G11_TB_§1_1_48_5", "current_skill": "G11_S04_03", "q": "Укажите промежутки монотонности функции $y = \\sqrt{x^{2} + 6x + 9} - \\sqrt{x^{2} - 6x + 9}$.", "key": "$x \\in [-3; 3]$"}, {"id": "G11_TB_13_2*_13_1_б", "current_skill": "G11_S05_01", "q": "Решите уравнение: $3\\sqrt{-x^{2}+11x-30}-4\\sqrt[4]{x^{2}-7x+6}=\\sin\\pi x$", "key": "$x = 6$"}, {"id": "G11_TB_13_2*_13_2_г", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt[6]{x^{5}-32}+\\sqrt[6]{x^{5}+32}=2$", "key": "$2$"}, {"id": "G11_TB_13_3*_13_12_a", "current_skill": "G11_S05_01", "q": "Докажите, что не имеет корней уравнение: $x^{6}+2x^{5}+2x^{4}+2x^{3}+2x^{2}+2x+2=0$", "key": "Левая часть равна $x^{4}(x+1)^{2} + x^{2}(x+1)^{2} + (x+1)^{2} + 1 \\ge 1 > 0$ при любом $x$, поэтому корней нет."}, {"id": "G11_TB_13_3*_13_12_b", "current_skill": "G11_S05_01", "q": "Докажите, что не имеет корней уравнение: $x^{6}+2x^{5}+2x^{4}+2x^{3}+2x^{2}+4x+4=0$", "key": "Левая часть равна $x^{4}(x+1)^{2} + x^{2}(x+1)^{2} + (x+2)^{2}$; сумма неотрицательна и равна нулю, только если одноврем"}, {"id": "G11_TB_13_3*_13_13_c", "current_skill": "G11_S05_01", "q": "Решите уравнение: $3 - \\lg(x^{2} - 10x + 26) = \\sqrt{x^{2} - 10x + 34}$", "key": "$5$"}, {"id": "G11_TB_13_3*_13_13_d", "current_skill": "G11_S05_01", "q": "Решите уравнение: $2 - \\lg(1 + |x - 6|) = \\sqrt{x^{2} - 12x + 40}$", "key": "$6$"}, {"id": "G11_TB_13_3*_13_14_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $x^{2} - \\pi x + \\dfrac{\\pi^{2}}{4} = \\sin x - 1$", "key": "$\\dfrac{\\pi}{2}$"}, {"id": "G11_TB_13_3*_13_14_c", "current_skill": "G11_S05_01", "q": "Решите уравнение: $x^{2} + 2\\pi x + \\pi^{2} = \\sin x - 1$", "key": "нет корней"}, {"id": "G11_TB_13_3*_13_7_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $9^{x} - 2 \\cdot 6^{x} + 2 \\cdot 4^{x} - 2 \\cdot 2^{x} + 1 = 0$", "key": "$0$"}, {"id": "G11_TB_13_3*_13_7_b", "current_skill": "G11_S05_01", "q": "Решите уравнение: $25^{x} - 5 \\cdot 10^{x} + 29 \\cdot 4^{x-1} - 4 \\cdot 2^{x} + 4 = 0$", "key": "$1$"}, {"id": "G11_TB_13_3*_13_9_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\log_{2}(x^{2}+2x+2)+\\log_{3}(x^{6}+2x^{5}+x^{4}+1)=0$", "key": "$-1$"}, {"id": "G11_TB_13_3*_13_9_b", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\log_{4}(x^{2}+4x+5)+\\log_{5}(x^{6}+4x^{5}+4x^{4}+1)=0$", "key": "$-2$"}, {"id": "G11_TB_13_3*_13_9_c", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\log_{6}(x^{2}+6x+10)+\\log_{7}^{2}(\\sqrt[3]{x+2}+2)=0$", "key": "$-3$"}, {"id": "G11_TB_13_4*_13_17_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $2\\cos^{2}(x \\sin x) = 2 + |\\log_{2}(x^{2} - 4x + 1)|$", "key": "$x = 0$"}, {"id": "G11_TB_13_4*_13_17_б", "current_skill": "G11_S05_01", "q": "Решите уравнение: $3\\sin^{2}\\left(\\pi\\dfrac{x}{2} \\cdot \\sin\\left(\\pi\\dfrac{x}{2}\\right)\\right) = 3 + \\log_{3}(x^{2} - 6x + 10)$", "key": "$x = 3$"}, {"id": "G11_TB_13_4*_13_22_в", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{3\\log_{2}^{2}x+5}+\\sqrt{\\log_{2}^{4}x+1}=2\\sqrt[4]{(3\\log_{2}^{2}x+5)(\\log_{2}^{4}x+1)}$", "key": "$x = 4, x = \\dfrac{1}{4}$"}, {"id": "G11_TB_13_4*_13_23_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\tg^{2}{x} + \\ctg^{2}{x} = 2 \\sin^{2}{\\sqrt{\\dfrac{5\\pi^{2}}{16} - x^{2}}}$", "key": "$x = \\pm \\dfrac{\\pi}{4}$"}, {"id": "G11_TB_13_4*_13_26_a", "current_skill": "G11_S05_01", "q": "Решите неравенство: $|\\sin x| + \\dfrac{1}{|\\sin x|} \\leq 2 - x^{2} - \\pi x - \\dfrac{\\pi^{2}}{4}$", "key": "$x = -\\dfrac{\\pi}{2}$"}, {"id": "G11_TB_13_4*_13_26_в", "current_skill": "G11_S05_01", "q": "Решите неравенство: $|\\tg x| + \\dfrac{1}{|\\tg x|} \\leq 2 - x^{2} + \\pi \\dfrac{x}{2} - \\dfrac{\\pi^{2}}{16}$", "key": "$x = \\dfrac{\\pi}{4}$"}, {"id": "G11_TB_14_2_14_9", "current_skill": "G11_S05_01", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx^{2} - 4x - 2y - 1 = 0 \\\\\ny^{2} - 2x + 6y + 14 = 0\n\\end{cases}\n$$", "key": "$x = 3, y = -2$"}, {"id": "G11_TB_14_3_14_22_б", "current_skill": "G11_S05_01", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\sqrt{7x+y} + \\sqrt{y+x} = 6,\\\\\n\\sqrt{y+x} - y + x = 2\n\\end{cases}\n$$", "key": "$x=2; y=2$"}, {"id": "G11_TB_15_1*_14_39_a", "current_skill": "G11_S05_01", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\ny^{3} - 6x^{2} + 12x - 8 = 0,\\\\\nz^{3} - 6y^{2} + 12y - 8 = 0,\\\\\nx^{3} - 6z^{2} + 12z - 8 = 0\n\\end{cases}\n$$", "key": "$x=2$; $y=2$; $z=2$"}, {"id": "G11_TB_15_1*_14_45", "current_skill": "G11_S05_01", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\dfrac{3+2\\cos(x-y)}{2} = \\sqrt{3+2x-x^{2}} \\cos^{2}\\left(\\dfrac{x-y}{2}\\right) + \\sin^{2}\\left(\\dfrac{x-y}{2}\\right), \\\\\nz^{2}+2x^{2}-2z-1=4(x-1)\n\\end{cases}\n$$", "key": "$x=1$; $y=1-\\dfrac{\\pi}{2}+\\pi k$, $k\\in Z$; $z=1$"}, {"id": "G11_TB_15_3*_15_14_1", "current_skill": "G11_S05_01", "q": "Для каждого значения параметра $a$ решите неравенство: $x^{2}+ax+4 \\geq 0$", "key": "$x \\in (-\\infty; \\infty)$ при $|a| \\leq 4$; $x \\in (-\\infty; \\dfrac{-a - \\sqrt{a^{2} - 16}}{2}] \\cup [\\dfrac{-a + \\sqrt{"}, {"id": "G11_TB_15_3*_15_14_2", "current_skill": "G11_S05_01", "q": "Для каждого значения параметра $a$ решите неравенство: $x^{2}+ax+9<0$", "key": "При $a \\in (-\\infty; -6) \\cup (6; +\\infty)$: $x \\in \\left( \\dfrac{-a - \\sqrt{a^{2} - 36}}{2}; \\dfrac{-a + \\sqrt{a^{2} - "}, {"id": "G11_TB_15_3*_15_14_3", "current_skill": "G11_S05_01", "q": "Для каждого значения параметра $a$ решите неравенство: $x^{2} - ax + 4 > 0$", "key": "При $a \\in (-4; 4)$: $x \\in (-\\infty; +\\infty)$; при $a = -4$: $x \\in (-\\infty; -2) \\cup (-2; +\\infty)$; при $a = 4$: $x"}, {"id": "G11_TB_15_3*_15_14_4", "current_skill": "G11_S05_01", "q": "Для каждого значения параметра $a$ решите неравенство: $x^{2}-ax+9 \\le 0$", "key": "Если $a \\in (-\\infty; -6) \\cup (6; +\\infty)$, то $x \\in \\left[ \\dfrac{a - \\sqrt{a^{2} - 36}}{2}; \\dfrac{a + \\sqrt{a^{2} "}, {"id": "G11_TB_15_4*_15_39_a", "current_skill": "G11_S05_01", "q": "При каких значениях параметра $a$ неравенство $\\sqrt{x^{2}-10x+26} \\geq \\dfrac{2a^{2}-4a-3}{a^{2}-2a-8}$ выполняется для всех $x$?", "key": "$a \\in (-2; 4)$"}, {"id": "G11_TB_15_4*_15_40_a", "current_skill": "G11_S05_01", "q": "Найдите все значения параметра $a$, при каждом из которых неравенство $a^{2}+a-\\sin^{2}x-2a\\cos x>1$ выполняется для любого значения $x$.", "key": "$a \\in (-\\infty; \\dfrac{-3 - \\sqrt{13}}{2}) \\cup (\\dfrac{1 + \\sqrt{5}}{2}; +\\infty)$"}, {"id": "G11_TB_15_4*_15_40_b", "current_skill": "G11_S05_01", "q": "Найдите все значения параметра $a$, при каждом из которых неравенство $|3\\sin^{2}x+2a\\sin x\\cos x+\\cos^{2}x+a|\\leq 3$ выполняется для любого значения $x$.", "key": "$a \\in \\left[-\\dfrac{12}{5}; 0\\right]$"}, {"id": "G11_TB_15_4*_15_43", "current_skill": "G11_S05_01", "q": "Найдите все значения параметра $a$, при каждом из которых множество решений неравенства $2x^{2}-3x+a+12\\leq 0$ не пусто и содержится среди решений неравенства $x^{2}+10x+a\\leq 0$.", "key": "$a \\in (-\\infty; -264] \\cup \\left[-11; -\\dfrac{87}{8}\\right]$"}, {"id": "G11_TB_18_2*_18_4_б", "current_skill": "G11_S05_01", "q": "Найдите все корни уравнения: $x^{3}-3x^{2}+4=0$.", "key": "$x=-1$, $x=2$ (кратности $2$)"}, {"id": "G11_TB_27_2_2_6", "current_skill": "G11_S05_01", "q": "Решите уравнение: $x + 2\\sqrt{x - 6} = 6$", "key": "$6$"}, {"id": "G11_TB_27_2_5_3", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{x^{2}+x+4}+\\sqrt{x^{2}+x+1}=\\sqrt{2x^{2}+2x+9}$", "key": "$-1; 0$"}, {"id": "G11_TB_9_5_9_40_б", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt[4]{x^{2}-x-3}+\\sqrt{x^{2}-x+5}=\\sqrt[4]{2x+1}+\\sqrt{2x+9}$", "key": "$x = 4$"}, {"id": "G11_TB_9_5_9_41_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{x^{2}+4}+\\sqrt[4]{x^{2}+5}+\\sqrt[6]{x^{2}+6}=\\sqrt{4x}+\\sqrt[4]{4x+1}+\\sqrt[6]{4x+2}$", "key": "$x = 2$"}, {"id": "G11_TB_9_5_9_41_б", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{x+1} + \\sqrt[4]{2x+3} + \\sqrt[6]{3x+7} = \\sqrt{2x} + \\sqrt[4]{4x+1} + \\sqrt[6]{6x+4}$", "key": "$x = 1$"}, {"id": "G11_TB_9_5_9_42_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $e^{x^{2}-4x+5}+\\sqrt[3]{x^{2}-4x+5}=e^{2x^{2}-3x+7}+\\sqrt[3]{2x^{2}-3x+7}$", "key": "нет действительных корней"}, {"id": "G11_TB_9_5_9_42_б", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\pi^{x^{2}+1000}+\\sqrt[9]{x^{2}+1000}=\\pi^{2002x-1001}+\\sqrt[9]{2002x-1001}$", "key": "$x = 1$, $x = 2001$"}, {"id": "G11_TB_?_135_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\dfrac{\\sqrt{21 + x} + \\sqrt{21 - x}}{\\sqrt{21 + x} - \\sqrt{21 - x}} = \\dfrac{21}{x}$", "key": "$-21; 21$"}, {"id": "G11_TB_?_138_b", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{7x + 1002} - \\sqrt{8x - 1000} = \\dfrac{1}{\\sqrt{7x + 1002}} - \\dfrac{1}{\\sqrt{8x - 1000}}$", "key": "$2002$"}, {"id": "G11_TB_?_138_d", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{x^{2} + 1} - \\sqrt{2x^{2} - 4x + 5} = \\dfrac{1}{\\sqrt{2x^{2} - 4x + 5}} - \\dfrac{1}{\\sqrt{x^{2} + 1}}$", "key": "$x = 2$"}, {"id": "G11_TB_?_138_g", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{x^{2} + 3} + \\dfrac{1}{\\sqrt{x^{2} + 3}} = \\sqrt{x^{2} + x + 2} + \\dfrac{1}{\\sqrt{x^{2} + x + 2}}$", "key": "$x = 1$"}, {"id": "G11_TB_?_140_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $2^{x - 3} + 2^{3 - x} = -x^{2} + 6x - 7$", "key": "$x=3$"}, {"id": "G11_TB_?_140_b", "current_skill": "G11_S05_01", "q": "Решите уравнение: $2^{x - 2} + 2^{2 - x} = -x^{2} + 4x - 2$", "key": "$x=2$"}, {"id": "G11_TB_?_33_1", "current_skill": "G11_S05_01", "q": "О первых шести членах возрастающей арифметической прогрессии известно, что сумма пятых степеней всех этих членов равна нулю, а сумма их четвёртых степеней равна $49$. Найдите первый член этой прогрессии.", "key": "$-\\dfrac{5}{2}\\sqrt[4]{\\dfrac{56}{101}}$"}, {"id": "G11_TB_?_57_а", "current_skill": "G11_S05_01", "q": "Найдите наименьшее значение функции: $y = \\dfrac{x^{4} - 2x^{3} + 3x^{2} - 2x + 2}{x^{2} - x + 1}$.", "key": "$2$"}, {"id": "G11_TB_?_57_б", "current_skill": "G11_S05_01", "q": "Найдите наибольшее значение функции: $y = \\dfrac{x^{4} - 2x^{3} + 5x^{2} - 4x + 5}{x - 2 - x^{2}}$.", "key": "$\\dfrac{-65}{28}$"}, {"id": "G11_TB_?_58_б", "current_skill": "G11_S05_01", "q": "Функция $f(x)$ удовлетворяет следующему условию: для любых чисел $a$ и $b$ выполняется равенство $f\\left(\\dfrac{a+2b}{3}\\right)=\\dfrac{f(a)+2f(b)}{3}$. Найдите значение функции $f(1999)$, если: $f(1)=2$ и $f(4)=8$", "key": "$3998$"}, {"id": "G11_TB_?_59_a", "current_skill": "G11_S05_01", "q": "Докажите, что: $p^{2} > 4q$, если известно, что $1 + p + q < 0$", "key": "Из $1 + p + q < 0$ следует $q < -1 - p$, поэтому $p^{2} - 4q > p^{2} + 4 + 4p = (p + 2)^{2} \\ge 0$, т. е. $p^{2} > 4q$."}, {"id": "G11_TB_?_59_б", "current_skill": "G11_S05_01", "q": "Докажите, что: $b^{2} > 4ac$, если известно, что $(a+b+c)(a-b+c) < 0$", "key": "$(a + b + c)(a - b + c) = (a + c)^{2} - b^{2} < 0$, поэтому $b^{2} > (a + c)^{2} \\ge 4ac$, так как $(a + c)^{2} - 4ac = "}, {"id": "G11_TB_?_82_в", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt{x^{2} + x + 4} + \\sqrt{x^{2} + x + 1} = \\sqrt{2x^{2} + 2x + 9}$", "key": "$-1; 0$"}, {"id": "G11_TB_?_82_г", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt[4]{629-x}+\\sqrt[4]{77+x}=8$", "key": "$4; 548$"}, {"id": "G11_TB_?_89_a", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt[3]{3x+20} + \\sqrt[3]{5x+4} = \\sqrt[3]{2x+19} + \\sqrt[3]{6x+5}$", "key": "$x = -3; x = -1; x = 5$"}, {"id": "G11_TB_?_89_b", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt[3]{x+6} + \\sqrt[3]{7x+10} = \\sqrt[3]{2x+15} + \\sqrt[3]{6x+1}$", "key": "$x=-9; x=-2; x=1$"}, {"id": "G11_TB_?_89_г", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\sqrt[3]{4x+6} + \\sqrt[3]{5x+12} = \\sqrt[3]{3x+10} + \\sqrt[3]{6x+8}$", "key": "$x = -2; x = -1; x = 4$"}, {"id": "G11_TB_§1_1_49_3", "current_skill": "G11_S05_01", "q": "Укажите промежутки знакопостоянства функции $y=9-x^{2}$.", "key": "$y>0$ при $x \\in (-3; 3)$; $y<0$ при $x \\in (-\\infty; -3) \\cup (3; +\\infty)$"}, {"id": "G11_TB_§20_1_8", "current_skill": "G11_S05_01", "q": "Решите уравнение: $\\log_{2}(1+x^{2}) = \\log_{2} x + 2x - x^{2}$", "key": "$x=1$"}, {"id": "G11_TB_§20_6_1", "current_skill": "G11_S05_01", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx + 2^{x} = y + 2^{y}, \\\\\nx^{2} + 3y = 10\n\\end{cases}\n$$", "key": "$x=2$, $y=2$ и $x=-5$, $y=-5$"}, {"id": "G11_TB_10_1_9_71_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{\\log_{5}(x+1)} + 3^{\\log_{5}(x+1)} < \\sqrt{\\log_{5}\\left(\\dfrac{2}{x}\\right)} + 3^{\\log_{5}\\left(\\frac{2}{x}\\right)}$", "key": "$x \\in (0; 1)$"}, {"id": "G11_TB_10_1_9_72_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{\\log_{3}\\left(\\dfrac{3}{x}\\right)} + \\log_{3}(7) \\cdot \\log_{7}\\left(\\dfrac{3}{x}\\right) > \\sqrt{\\log_{3}\\left(\\dfrac{5-2x}{x}\\right)} + \\log_{3}(7) \\cdot \\log_{7}\\left(\\dfrac{5-2x}{x}\\right)$", "key": "$x \\in (1; \\dfrac{5}{3}]$"}, {"id": "G11_TB_10_1_9_72_в", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(3x-2)^{\\frac{1}{4}}+\\log_{7}(3x-2)+3^{\\frac{3x-2}{4}}>(-2x+3)^{\\frac{1}{4}}+\\log_{7}(-2x+3)+3^{\\frac{-2x+3}{4}}$", "key": "$x \\in (1; \\dfrac{3}{2})$"}, {"id": "G11_TB_10_1_9_73_а", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(x+2)^{\\frac{1}{5}}+\\pi^{x+2} > \\left(\\dfrac{x-1}{2x}\\right)^{\\frac{1}{5}}+\\pi^{\\frac{x-1}{2x}}$", "key": "$x \\in (-1; -\\dfrac{1}{2}) \\cup (0; +\\infty)$"}, {"id": "G11_TB_10_1_9_73_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(\\pi-3)^{x-5} - (x-5)^{\\frac{1}{3}} > (\\pi-3)^{\\frac{x-9}{2x}} - \\left(\\dfrac{x-9}{2x}\\right)^{\\frac{1}{3}}$", "key": "$x \\in (-\\infty; 0) \\cup (1; 4{,}5)$"}, {"id": "G11_TB_10_2_6_3", "current_skill": "G11_S05_02", "q": "Решите уравнение: $x^{9} - 170x^{2} - x + 170 = 0$", "key": "$-1$; $1$; $2$"}, {"id": "G11_TB_10_5*_10_26*_а", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\dfrac{1}{\\sqrt{x-2}} = (x-2)^{\\cos x}$", "key": "$3$; $\\dfrac{2\\pi}{3} + 2\\pi n$; $\\dfrac{4\\pi}{3} + 2\\pi n$, $n \\in \\mathbb{Z}$, $n \\ge 0$"}, {"id": "G11_TB_11_1_10_51_a", "current_skill": "G11_S05_02", "q": "Найдите все решения уравнения: $x^{4}+x^{3}+x^{2}-3x=0$, принадлежащие промежутку $[-2;0]$.", "key": "$x = 0$"}, {"id": "G11_TB_11_1_10_51_b", "current_skill": "G11_S05_02", "q": "Найдите все решения уравнения: $x^{4}+x^{3}+x^{2}-14x=0$, принадлежащие промежутку $[3;7]$.", "key": "Нет решений"}, {"id": "G11_TB_11_3*_11_15_в", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{x+1} > \\sqrt[3]{2x+1}$", "key": "$[-1; 0) \\cup \\left(\\dfrac{1+\\sqrt{5}}{2}; +\\infty\\right)$"}, {"id": "G11_TB_11_3*_11_6_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{4x-3} < x$", "key": "$[\\dfrac{3}{4}; 1) \\cup (3; +\\infty)$"}, {"id": "G11_TB_11_3*_11_7_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $2\\sqrt{x-1} < x$", "key": "$[1; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_11_3*_11_7_г", "current_skill": "G11_S05_02", "q": "Решите неравенство: $2\\sqrt{2x-4} < x$", "key": "$[2; 4) \\cup (4; +\\infty)$"}, {"id": "G11_TB_11_3*_11_9_а", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{x+1} > x-1$", "key": "$[-1; 3)$"}, {"id": "G11_TB_11_5*_11_30_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(2\\sqrt{x}-1)^{2}<2x^{2}-4\\sqrt{x}-125$", "key": "$x \\in (9; +\\infty)$"}, {"id": "G11_TB_11_5*_11_30_г", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(3\\sqrt{x}-2)^{2} < 4x^{2} - 12\\sqrt{x} - 5$", "key": "$x \\in (3; +\\infty)$"}, {"id": "G11_TB_11_5*_11_31*_г", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\tg x \\cdot \\ctg x < 2\\cos x$", "key": "$x \\in \\left(-\\dfrac{\\pi}{3} + 2\\pi k; 2\\pi k\\right) \\cup \\left(2\\pi k; \\dfrac{\\pi}{3} + 2\\pi k\\right), k \\in \\mathbb{Z}"}, {"id": "G11_TB_11_6*_11_43*_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{\\sqrt{x^{2}+1}-|\\cos x|}{\\sqrt{2x}+|\\cos x|} > \\dfrac{\\sqrt{2x}-|\\cos x|}{\\sqrt{x^{2}+1}+|\\cos x|}$", "key": "$x \\in [0; 1) \\cup (1; +\\infty)$"}, {"id": "G11_TB_11_6*_11_47", "current_skill": "G11_S05_02", "q": "ИССЛЕДУЕМ. При каких значениях параметра $a$ все решения неравенства $\\log_{a}(x-2) > \\log_{a}(8-x)$ содержатся в интервале $(1; 5)$?", "key": "$a \\in (0; 1)$"}, {"id": "G11_TB_11_7*_11_48_1", "current_skill": "G11_S05_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $(\\sin x - \\dfrac{1}{2})(\\sin x + \\dfrac{\\sqrt{2}}{2}) > 0$, $(0; \\pi)$", "key": "$(\\dfrac{\\pi}{6}; \\dfrac{5\\pi}{6})$"}, {"id": "G11_TB_11_7*_11_48_2", "current_skill": "G11_S05_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $(\\cos x + \\dfrac{1}{2})(\\cos x - \\dfrac{\\sqrt{3}}{2}) > 0$, $(-\\dfrac{\\pi}{2}; \\dfrac{\\pi}{2})$", "key": "$(-\\dfrac{\\pi}{6}; \\dfrac{\\pi}{6})$"}, {"id": "G11_TB_11_7*_11_50_1", "current_skill": "G11_S05_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $x^{4}+x^{3}+x^{2}-3x>0$, $[-2; 2]$", "key": "$[-2; 0) \\cup (1; 2]$"}, {"id": "G11_TB_11_7*_11_50_2", "current_skill": "G11_S05_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $x^{4}+x^{3}+x^{2}-14x<0$, $[1; 3]$", "key": "$[1; 2)$"}, {"id": "G11_TB_11_7*_11_51_2", "current_skill": "G11_S05_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $\\sin 2x - \\dfrac{\\sqrt{3}}{2} < \\sqrt{3} \\sin x - \\cos x$, $[0; \\pi]$", "key": "$(\\dfrac{\\pi}{6}; \\pi]$"}, {"id": "G11_TB_11_7*_11_53_2", "current_skill": "G11_S05_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $\\sqrt{\\sin^{2}{x} - 2\\sin{2x} + 3\\cos^{2}{x}} > \\sin{x} - \\cos{x}$, $\\left( \\dfrac{5\\pi}{4}; \\dfrac{9\\pi}{4} \\right)$.", "key": "$\\left(\\pi + \\arctg 3; \\dfrac{9\\pi}{4}\\right)$"}, {"id": "G11_TB_12_1_11_63_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{4\\lg{x} - 24} \\geq 9 - \\lg{x}$", "key": "$x \\in [10^{7}; +\\infty)$"}, {"id": "G11_TB_12_3_12_16_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(x+2) \\cdot 2^{2-|x-2|} - x < (x+1) \\cdot |2^{x} - 1| + 2^{x} + 1$", "key": "$(-1; 0) \\cup (2; +\\infty)$"}, {"id": "G11_TB_12_3_12_16_b", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(x+2) \\cdot 4^{1-|x-1|} - x < (x+1) \\cdot |4^{x} - 1| + 4^{x} + 1$", "key": "$(-1; 0) \\cup (1; +\\infty)$"}, {"id": "G11_TB_13_2*_13_2_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[4]{x^{3}+8}+\\sqrt[4]{x^{3}-8}=2$", "key": "$x = 2$"}, {"id": "G11_TB_13_2*_13_5_а", "current_skill": "G11_S05_02", "q": "Решите неравенство: $3^{\\sqrt{\\sin x - 1}} + \\log_{3}(x^{2} + 3) > \\cos x + 2$", "key": "$x = \\dfrac{\\pi}{2} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_13_4*_13_16_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $|\\lg(x-3)|+2=|\\cos(\\pi x)+1|$", "key": "$x = 4$"}, {"id": "G11_TB_13_4*_13_16_b", "current_skill": "G11_S05_02", "q": "Решите уравнение: $|\\lg(x-2)|+1=-\\cos(\\pi x)$", "key": "$x = 3$"}, {"id": "G11_TB_13_4*_13_16_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $|\\lg(x-5)|+2=\\sqrt{4-(x-6)^{2}}$", "key": "$x = 6$"}, {"id": "G11_TB_13_4*_13_19_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\log_{2}(x+4) < -1 - x$", "key": "$-4 < x < -2$"}, {"id": "G11_TB_13_4*_13_20_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $3\\cos^{2}x \\geq 3 + |\\log_{5}(x^{2} - 4x + 1)|$", "key": "$x = 0$"}, {"id": "G11_TB_13_4*_13_21_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\left(\\dfrac{2}{3}\\right)^{x} + \\left(\\dfrac{3}{2}\\right)^{x} = 2 - \\sin^{2}\\left(\\dfrac{2001x}{2002}\\right)$", "key": "$x = 0$"}, {"id": "G11_TB_13_4*_13_21_б", "current_skill": "G11_S05_02", "q": "Решите уравнение: $(\\log_{2}3)^{x} + (\\log_{3}2)^{x} = 2 - \\cos^{2}\\left(\\dfrac{\\pi x + \\pi}{2}\\right)$", "key": "$x = 0$"}, {"id": "G11_TB_13_4*_13_21_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\left(\\dfrac{4}{3}\\right)^{x-1} + \\left(\\dfrac{3}{4}\\right)^{x-1} = 1 + \\cos(2\\pi x)$", "key": "$x = 1$"}, {"id": "G11_TB_13_5*_13_29_а", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[4]{x^{3}-7}+\\sqrt[3]{x^{4}-8}=3$", "key": "$2$"}, {"id": "G11_TB_13_5*_13_29_б", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[5]{x^{3}+5} + \\sqrt[3]{x^{4}-17} = 6$", "key": "$3$"}, {"id": "G11_TB_13_5*_13_29_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x^{3}+8} + \\sqrt{8-x^{3}} = 4$", "key": "$-2$; $2$"}, {"id": "G11_TB_13_5*_13_29_г", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[4]{x-1} + \\sqrt[4]{3-x} = 2$", "key": "$2$"}, {"id": "G11_TB_13_5*_13_30_а", "current_skill": "G11_S05_02", "q": "Решите уравнение: $x^{5} + x^{3} + 1 - \\sqrt{10 - x} = 0$", "key": "$1$"}, {"id": "G11_TB_13_5*_13_30_б", "current_skill": "G11_S05_02", "q": "Решите уравнение: $x^{5} + x^{3} - 37 - \\sqrt{25 - 8x} = 0$", "key": "$2$"}, {"id": "G11_TB_13_5*_13_31_б", "current_skill": "G11_S05_02", "q": "Решите уравнение: $x^{\\frac{3}{2}}(1-x) = \\dfrac{6}{25} \\sqrt{\\dfrac{3}{5}}$", "key": "$\\dfrac{3}{5}$"}, {"id": "G11_TB_13_5*_13_32_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $10x^{5} + 25x^{3} + 39x + 11 - 11\\cos 2x > 0$", "key": "$x > 0$"}, {"id": "G11_TB_13_5*_13_33_а", "current_skill": "G11_S05_02", "q": "Решите неравенство: $3x^{5} + 10x^{3} + 15^{x} + \\lg x - 28 > 0$", "key": "$x > 1$"}]