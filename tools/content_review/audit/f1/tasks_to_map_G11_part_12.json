[{"id": "G11_TB_15_3*_15_21_4", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\log_{5}(x-a) \\leq \\log_{5}(7-x)$", "key": "При $a < 7$: $x \\in (a; \\dfrac{a+7}{2}]$; при $a \\geq 7$: $x \\in \\varnothing$"}, {"id": "G11_TB_15_3*_15_22_3", "current_skill": "G11_S02_03", "q": "Для каждого значения параметра $a$ решите неравенство: $\\log_{a}(4-x) \\geq \\log_{a}(3x-15)$", "key": "При любом значении параметра $a$ решений нет"}, {"id": "G11_TB_15_4*_15_37_a", "current_skill": "G11_S02_03", "q": "При каких значениях параметра $b$ уравнение $\\log_{2x+1}(3x^{2}-bx-0{,}25b)=2$ имеет два различных корня?", "key": "$b \\in (-\\infty; -4)$"}, {"id": "G11_TB_17_1_1", "current_skill": "G11_S02_03", "q": "Решите уравнение $\\lg(x-2)-\\dfrac{1}{2}\\lg(3x-6)=\\lg 2$.", "key": "$14$"}, {"id": "G11_TB_17_1_17_1_2", "current_skill": "G11_S02_03", "q": "Решите логарифмическое уравнение: $\\log_{3}(x^{2}-2)=\\log_{3}(4x-5)$", "key": "$x = 3$"}, {"id": "G11_TB_17_2_1", "current_skill": "G11_S02_03", "q": "Решите неравенство $\\log_{0{,}2}(x-1) + \\log_{0{,}2}(x+3) \\geq -1$.", "key": "$(1; 2]$"}, {"id": "G11_TB_17_2_2", "current_skill": "G11_S02_03", "q": "Решите неравенство $\\log_{\\frac{1}{3}}\\log_{2}\\dfrac{x-1}{2-x}>-1$.", "key": "$(\\dfrac{3}{2}; \\dfrac{17}{9})$"}, {"id": "G11_TB_17_2_3_1", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\lg(2x-1) > \\lg(x+2)$", "key": "$x > 3$"}, {"id": "G11_TB_17_2_5_3", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{2}(x^{2}-x-12)<3$", "key": "$-4 < x < -3$ или $4 < x < 5$"}, {"id": "G11_TB_17_2_5_4", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\pi}{(x+1)} + \\log_{\\pi}{x} \\geq \\log_{\\pi}{2}$", "key": "$x \\geq 1$"}, {"id": "G11_TB_17_2_6_1", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{3} \\log_{2} \\log_{0{,}5} x \\geq 0$", "key": "$0 < x \\le \\dfrac{1}{4}$"}, {"id": "G11_TB_17_2_6_2", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{x} \\sqrt{x+12} > 1$", "key": "$1 < x < 4$"}, {"id": "G11_TB_17_2_6_4", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{\\frac{2x-1}{x-3}}3<0$", "key": "$(-2; 0{,}5)$"}, {"id": "G11_TB_1_2_1_4_5", "current_skill": "G11_S02_03", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\phi(x)=x^{2}$, $g(x)=\\log_{5} x$. Запишите сложную функцию: $g(\\phi(f(x)))$", "key": "$\\log_{5} ((7^{x})^{2})$"}, {"id": "G11_TB_1_2_1_4_6", "current_skill": "G11_S02_03", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\phi(x)=x^{2}$, $g(x)=\\log_{5} x$. Запишите сложную функцию: $\\phi(g(f(x)))$", "key": "$(\\log_{5} (7^{x}))^{2}$"}, {"id": "G11_TB_1_3_1_10_4", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции:\n$y = \\dfrac{30}{\\sqrt{100 - x^{2}}}$, $X = [-8; 1]$", "key": "$[3; 5]$"}, {"id": "G11_TB_1_3_1_10_5", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции:\n$y = \\dfrac{1}{\\sqrt{1 - x^{2}}}$, $X = \\left( -\\dfrac{\\sqrt{2}}{2}; 0 \\right)$", "key": "$(1; \\sqrt{2})$"}, {"id": "G11_TB_1_3_1_10_6", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции:\n$y=\\log_{2}\\sqrt{x^{2}-1}$", "key": "$(-\\infty; +\\infty)$"}, {"id": "G11_TB_1_3_1_10_8", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции:\n$y = \\log_{2} \\sqrt{1 - x^{2}}$.", "key": "$(-\\infty; 0]$"}, {"id": "G11_TB_1_3_1_14_5", "current_skill": "G11_S02_03", "q": "Имеет ли наибольшее (наименьшее) значение функция:\n$y = \\dfrac{1}{\\sqrt{1 - x^{2}}}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Наименьшее: $y = 1$ при $x = 0$. Наибольшего нет."}, {"id": "G11_TB_1_3_1_8_5", "current_skill": "G11_S02_03", "q": "Найдите область определения функции:\n$y = \\dfrac{1}{\\sqrt{x^{2} - x}}$", "key": "$(-\\infty; 0) \\cup (1; +\\infty)$"}, {"id": "G11_TB_1_3_1_8_6", "current_skill": "G11_S02_03", "q": "Найдите область определения функции:\n$y = \\sqrt{\\dfrac{x^{2} + x}{x + 4}}$.", "key": "$(-4; -1] \\cup [0; +\\infty)$"}, {"id": "G11_TB_1_3_1_9_3", "current_skill": "G11_S02_03", "q": "Найдите область определения функции:\n$y=\\log_{2}(\\tg x)$", "key": "$(\\pi k; \\dfrac{\\pi}{2} + \\pi k), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_1_3_1_9_6", "current_skill": "G11_S02_03", "q": "Найдите область определения функции:\n$y = \\sqrt{x^{2} - 1} + \\sqrt{1 - x^{2}}$.", "key": "$\\{-1; 1\\}$"}, {"id": "G11_TB_27_2_29_2", "current_skill": "G11_S02_03", "q": "Решите уравнение: $(2\\cos^{2}x - \\cos x - 1)\\sqrt{\\ctg x} = 0$", "key": "$x = \\dfrac{\\pi}{2} + \\pi n$; $x = -\\dfrac{2\\pi}{3} + 2\\pi n$, $n \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_40_2", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{1}{\\sqrt{x + 2\\sqrt{x-1}}} + \\dfrac{1}{\\sqrt{x - 2\\sqrt{x-1}}} > 2$", "key": "$x \\in (1; 2) \\cup (2; \\dfrac{5 + \\sqrt{5}}{2})$"}, {"id": "G11_TB_27_2_41_1", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\dfrac{5x-3}{\\sqrt{7x-4}} < 1$", "key": "$x \\in \\left(\\dfrac{4}{7}; \\dfrac{37+\\sqrt{69}}{50}\\right)$"}, {"id": "G11_TB_8_4_14_а", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{2}(x^{2}-3x) = \\log_{2}(x-3)$", "key": "$x \\in \\varnothing$"}, {"id": "G11_TB_8_4_14_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{4}(x^{2}-5x)=\\log_{4}(x-9)$", "key": "$x \\in \\varnothing$"}, {"id": "G11_TB_8_4_14_в", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{5}(x^{2}+13x)=\\log_{5}(9x+5)$", "key": "$x = 1$"}, {"id": "G11_TB_8_4_14_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{6}(x^{2}-x)=\\log_{6}(6x-10)$", "key": "$x = 2; x = 5$"}, {"id": "G11_TB_8_4_17_а", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{3}(2 \\cdot 3^{x} - 5) = \\log_{3}(3^{x} + 4)$", "key": "$x = 2$"}, {"id": "G11_TB_8_4_17_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{7}(2 \\cdot 4^{x} - 3) = \\log_{7}(4^{x} + 1)$", "key": "$x = 1$"}, {"id": "G11_TB_8_4_19_а", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{2}{\\cos{2x}} = \\log_{2}{\\cos{x}}$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_4_19_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{\\frac{1}{2}} \\cos 2x = \\log_{\\frac{1}{2}} (\\cos x + \\sin x)$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_4_19_в", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{\\frac{1}{3}} \\cos 2x = \\log_{\\frac{1}{3}} (\\cos x - \\sin x)$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_4_19_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{0,2} \\cos 2x = \\log_{0,2} (\\sin x - \\cos x)$", "key": "$x = \\pi + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_4_20", "current_skill": "G11_S02_03", "q": "При каких значениях параметра $a$ уравнение $\\lg(x^{2}+3x+a)=\\lg(x+1)^{2}$ не имеет корней?", "key": "$a = 2$"}, {"id": "G11_TB_8_4_4", "current_skill": "G11_S02_03", "q": "Решите уравнение $$3^{\\log_3(x^2-4x+3)}=2x-5.$$ Укажите все действительные решения.", "key": "$4$"}, {"id": "G11_TB_8_4_5", "current_skill": "G11_S02_03", "q": "Решите уравнение $$\\dfrac{1}{(\\log_x2)^2}-2\\log_2x=0.$$ Укажите все действительные решения.", "key": "$4$"}, {"id": "G11_TB_8_4_6", "current_skill": "G11_S02_03", "q": "Решите уравнение $$\\dfrac{2\\tan x}{1+\\tan^2x}=\\sin^2(2x).$$ Укажите все действительные решения.", "key": "$x=\\pi k$ или $x=\\dfrac\\pi4+\\pi n,\\quad k,n\\in\\mathbb Z$"}, {"id": "G11_TB_8_5_8_24", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$\\operatorname{tg}\\dfrac{\\pi x}{2} + x^{2} - 7x = \\operatorname{tg}\\dfrac{\\pi x}{2} - 6$", "key": "$6$"}, {"id": "G11_TB_8_5_8_28", "current_skill": "G11_S02_03", "q": "Решите уравнение:\n$10^{\\lg(x^{2}+5x-1)} = 3x + 2$", "key": "$1$"}, {"id": "G11_TB_9_1_8_34_d", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\log_{3}(x^{2} - \\sqrt{x^{2} - 4} + 1) = \\log_{3}(x^{3} - \\sqrt{x^{2} - 4} - 6x + 1)$", "key": "$x=3; x=-2$"}, {"id": "G11_TB_9_1_8_35_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\dfrac{x-1}{x-2}+\\sqrt{x}} = \\sqrt{\\dfrac{2x-2}{x-6}+\\sqrt{x}}$", "key": "$1$"}, {"id": "G11_TB_9_1_8_35_b", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\dfrac{x+3}{x-3}+\\sqrt{x}} = \\sqrt{\\dfrac{2x-6}{x-4}+\\sqrt{x}}$", "key": "$5; 6$"}, {"id": "G11_TB_9_1_8_35_c", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\dfrac{x+1}{x-3}+3} \\cdot \\operatorname{tg}\\left(\\pi\\dfrac{x}{4}\\right) = \\sqrt{\\dfrac{x+4}{3x-8}+3} \\cdot \\operatorname{tg}\\left(\\pi\\dfrac{x}{4}\\right)$", "key": "$x = 1$; $x = 4k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_1_8_35_d", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\dfrac{x-3}{x+2} - \\operatorname{tg}\\left(\\pi \\dfrac{x}{4}\\right)} = \\sqrt{\\dfrac{x-3}{2x+3} - \\operatorname{tg}\\left(\\pi \\dfrac{x}{4}\\right)}$", "key": "$3$"}, {"id": "G11_TB_9_1_8_36_e", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\lg(x-2) - \\lg(x+3) = \\lg\\left(\\dfrac{x}{5x+3}\\right)$", "key": "$x=3$"}, {"id": "G11_TB_9_1_8_37_c", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{\\sqrt{7x-21}}{\\sqrt{x+2}} = \\dfrac{\\sqrt{5x-17}}{2}$", "key": "$5$"}, {"id": "G11_TB_9_1_8_37_d", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\dfrac{\\sqrt{3x-7}}{\\sqrt{x+3}}=\\sqrt{3-4x}$", "key": "нет решений"}, {"id": "G11_TB_9_1_8_38_b", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\lg(x-4) + \\lg(x-6) = \\lg 8$", "key": "$8$"}, {"id": "G11_TB_9_1_8_41_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\log_{2}(x+2)+\\log_{2}(x+1)}=\\sqrt{\\log_{2}(x-2)+\\log_{2}(2x-1)}$", "key": "$x = 8$"}, {"id": "G11_TB_9_1_8_41_b", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\log_{3}{(2x-1)}+\\log_{3}{(x-4)}}=\\sqrt{2\\log_{3}{(x-2)}}$", "key": "$x = 5$"}, {"id": "G11_TB_9_1_8_41_c", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\log_{2}{(\\sin x)}+2}=\\sqrt{1-\\log_{2}{(\\cos x)}}$", "key": "$\\dfrac{\\pi}{4} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_1_8_41_d", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sqrt{\\log_{2}(-\\cos x)+3}=\\sqrt{2-\\log_{2}(-\\sin x)}$", "key": "$x = -\\dfrac{3\\pi}{4} + 2\\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_1_8_42", "current_skill": "G11_S02_03", "q": "Докажите, что при любом значении параметра $a$ уравнение $\\lg{x}+\\lg{(x-2a)}=\\lg{4}$ имеет единственный корень.", "key": "На ОДЗ $x > 0$, $x > 2a$ уравнение равносильно $x^{2} - 2ax - 4 = 0$; его корни $a \\pm \\sqrt{a^{2} + 4}$, причём $a - \\s"}, {"id": "G11_TB_9_3_9_13_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\lg(x^{2}-17)=\\lg(11x-45)$", "key": "$7$"}, {"id": "G11_TB_9_3_9_13_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\lg(x^{2}-5x-24)=\\lg(8-x)$", "key": "$-4$"}, {"id": "G11_TB_9_3_9_17_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $(x^{2} - 7x + 12) \\log_{31}(x + 5) = 0$", "key": "$-4; 3; 4$"}, {"id": "G11_TB_9_3_9_17_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $(x^{2}+3x-4) \\log_{32}(3x+7)=0$", "key": "$-2$; $1$"}, {"id": "G11_TB_9_3_9_18_a", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\sin x \\cdot \\log_{11}(4-x^{2})=0$", "key": "$0; -\\sqrt{3}; \\sqrt{3}$"}, {"id": "G11_TB_9_3_9_18_б", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\cos x \\cdot \\log_{12}(9 - x^{2}) = 0$", "key": "$-2\\sqrt{2}$; $-\\dfrac{\\pi}{2}$; $\\dfrac{\\pi}{2}$; $2\\sqrt{2}$"}, {"id": "G11_TB_9_3_9_18_в", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\tg x \\cdot \\log_{13}(x^{2}-x-6)=0$", "key": "$x = \\pi n, n \\in \\mathbb{Z}, n \\neq 0; x = \\dfrac{1 \\pm \\sqrt{29}}{2}$"}, {"id": "G11_TB_9_3_9_18_г", "current_skill": "G11_S02_03", "q": "Решите уравнение: $\\ctg x \\cdot \\log_{14}(x^{2}+x-12)=0$", "key": "$x = \\dfrac{\\pi}{2} + \\pi n, n \\in \