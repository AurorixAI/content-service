[{"id": "G11_TB_?_219", "current_skill": "G11_S02_03", "q": "Решите неравенство: $\\log_{2} \\log_{\\frac{1}{2}} \\dfrac{3x+4}{4x+8} \\le 0$", "key": "$x \\in (-\\infty; -4) \\cup [0; +\\infty)$"}, {"id": "G11_TB_?_50_а", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\sqrt{\\dfrac{\\sqrt{17-15x-2x^{2}}}{x+3}}$", "key": "$x \\in \\{-8{,}5\\} \\cup (-3; 1]$"}, {"id": "G11_TB_?_50_б", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y = \\sqrt{\\dfrac{-4x^{2} + 4x + 3}{\\sqrt{2x^{2} - 7x + 3}}}$", "key": "$x \\in [-0{,}5; 0{,}5)$"}, {"id": "G11_TB_?_51_а", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y = \\sqrt{20 + 8x - x^{2}} + \\sqrt[6]{x - 4}$", "key": "$x \\in [4; 10]$"}, {"id": "G11_TB_?_51_б", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\dfrac{\\sqrt{33+8x-x^{2}}}{\\sqrt[4]{x-5}}$", "key": "$x \\in (5; 11]$"}, {"id": "G11_TB_?_52_а", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\sqrt{(x^{4}-4x^{2}+3)\\cdot|2x-3|}$", "key": "$x \\in (-\\infty; -\\sqrt{3}] \\cup [-1; 1] \\cup \\{1{,}5\\} \\cup [\\sqrt{3}; \\infty)$"}, {"id": "G11_TB_?_53_а", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\dfrac{1}{\\lg(2x-5)}$", "key": "$x \\in (2{,}5; 3) \\cup (3; +\\infty)$"}, {"id": "G11_TB_?_53_б", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\dfrac{1}{\\lg(2x+3)}$", "key": "$x \\in (-1{,}5; -1) \\cup (-1; \\infty)$"}, {"id": "G11_TB_?_53_в", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y = \\sqrt{2x^{2} - 7x} + \\dfrac{1}{\\lg(2x + 3)}$", "key": "$x \\in (-1{,}5; -1) \\cup (-1; 0] \\cup [3{,}5; +\\infty)$"}, {"id": "G11_TB_?_53_г", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y = \\sqrt{2x^{2} - 5x} + \\dfrac{1}{\\lg(2x + 1)}$", "key": "$x \\in (-0{,}5; 0) \\cup [2{,}5; +\\infty)$"}, {"id": "G11_TB_?_54_а", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\sqrt{\\log_{2}(x^{2}-2x-2)}$", "key": "$x \\in (-\\infty; -1] \\cup [3; \\infty)$"}, {"id": "G11_TB_?_54_б", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\sqrt{\\log_{4}(x^{2}-4x-4)}$", "key": "$x \\in (-\\infty; -1] \\cup [5; +\\infty)$"}, {"id": "G11_TB_?_55_а", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y = \\sqrt{x^{2} - x - 2} + \\log_{3+x}(9 - x^{2})$", "key": "$x \\in (-3; -2) \\cup (-2; -1] \\cup [2; 3)$"}, {"id": "G11_TB_?_55_б", "current_skill": "G11_S02_03", "q": "Укажите область определения функции: $y=\\sqrt{12-x-x^{2}}\\cdot\\log_{3-x}(\\pi^{2}-x^{2})$", "key": "$x \\in (-\\pi; 2) \\cup (2; 3)$"}, {"id": "G11_TB_§16_16_11.1", "current_skill": "G11_S02_03", "q": "Найдите область определения функции $y=\\log_{0{,}2}(5-x)$.", "key": "$(-\\infty; 5)$"}, {"id": "G11_TB_§16_16_11.2", "current_skill": "G11_S02_03", "q": "Найдите область определения функции $y=\\log_{6}(x^{2}+4)$.", "key": "$\\mathbb{R}$"}, {"id": "G11_TB_§16_16_11.3", "current_skill": "G11_S02_03", "q": "Найдите область определения функции $y=\\lg(x^{2}-2x-3)$.", "key": "$(-\\infty; -1)\\cup(3; +\\infty)$"}, {"id": "G11_TB_§16_16_26.1", "current_skill": "G11_S02_03", "q": "Решите неравенство $\\log_{0{,}5}(x^{2}-3x)\\ge-2$.", "key": "$[-1;\\,0)\\cup(3;\\,4]$"}, {"id": "G11_TB_§16_16_26.2", "current_skill": "G11_S02_03", "q": "Решите неравенство $\\log_{2}(x^{2}-2x)\\le3$.", "key": "$[-2;\\,0)\\cup(2;\\,4]$"}, {"id": "G11_TB_§16_16_28.1", "current_skill": "G11_S02_03", "q": "Найдите область определения функции $y=\\log_{2}(x^{2}-5x+6)$.", "key": "$(-\\infty; 2)\\cup(3; +\\infty)$"}, {"id": "G11_TB_§16_16_28.2", "current_skill": "G11_S02_03", "q": "Найдите область определения функции $y=\\log_{5}(x^{2}-2x-8)$.", "key": "$(-\\infty; -2)\\cup(4; +\\infty)$"}, {"id": "G11_TB_§16_16_28.3", "current_skill": "G11_S02_03", "q": "Найдите область определения функции $y=\\lg(x^{2}+4x-5)$.", "key": "$(-\\infty; -5)\\cup(1; +\\infty)$"}, {"id": "G11_TB_§16_16_29.1", "current_skill": "G11_S02_03", "q": "Решите уравнение $\\log_{3}(x+2)+\\log_{3}(x-2)=2$.", "key": "$\\sqrt{13}$"}, {"id": "G11_TB_§16_16_29.2", "current_skill": "G11_S02_03", "q": "Решите уравнение $\\log_{5}(x+3)+\\log_{5}(x-2)=\\log_{5}6$.", "key": "$3$"}, {"id": "G11_TB_§16_16_30.1", "current_skill": "G11_S02_03", "q": "Решите неравенство $\\log_{\\frac{1}{2}}(x+2)+\\log_{\\frac{1}{2}}(x-2)<-2$.", "key": "$x>2\\sqrt{2}$"}, {"id": "G11_TB_§16_16_30.2", "current_skill": "G11_S02_03", "q": "Решите неравенство $\\log_{0{,}5}(x+1)+\\log_{0{,}5}(x-1)\\ge-1$.", "key": "$1<x\\le\\sqrt{3}$"}, {"id": "G11_TB_§16_1_10", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{x}(2x - x^{2})$.", "key": "$x \\in (0; 1) \\cup (1; 2)$"}, {"id": "G11_TB_§16_1_11", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{2x-3}(5x - x^{2})$.", "key": "$x \\in (1{,}5; 2) \\cup (2; 5)$"}, {"id": "G11_TB_§16_1_2", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{\\frac{1}{3}}(x^{2} + 3)$", "key": "$\\mathbb{R}$"}, {"id": "G11_TB_§16_1_3", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{7} (x^{2} - x)$", "key": "$(-\\infty; 0) \\cup (1; +\\infty)$"}, {"id": "G11_TB_§16_1_7", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{0{,}2} \\left( \\dfrac{x-6}{x+2} \\right)$.", "key": "$x \\in (-\\infty; -2) \\cup (6; +\\infty)$"}, {"id": "G11_TB_§16_1_8", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{\\sqrt{7}} \\left( \\dfrac{x^{2} - 5x + 6}{x - 3} \\right)$.", "key": "$x \\in (2; 3) \\cup (3; +\\infty)$"}, {"id": "G11_TB_§16_1_9", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{3{,}1} \\left( \\dfrac{|x| + 5}{|x| - 3} \\right)$.", "key": "$x \\in (-\\infty; -3) \\cup (3; +\\infty)$"}, {"id": "G11_TB_§1_1_10_г", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции: $y = \\dfrac{30}{\\sqrt{100 - x^{2}}}$, $X = [-8; 1]$.", "key": "$[3; 5]$"}, {"id": "G11_TB_§1_1_10_д", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции: $y = \\dfrac{1}{\\sqrt{1 - x^{2}}}$, $X = \\left( -\\dfrac{\\sqrt{2}}{2}; 0 \\right)$", "key": "$(1; \\sqrt{2})$"}, {"id": "G11_TB_§1_1_10_е", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции: $y = \\log_{2} \\sqrt{x^{2} - 1}$", "key": "$(-\\infty; +\\infty)$"}, {"id": "G11_TB_§1_1_10_ж", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции: $y = \\dfrac{1}{\\sqrt{1 - x^{2}}}, X = \\left[ -\\dfrac{\\sqrt{3}}{2}; \\dfrac{\\sqrt{3}}{2} \\right]$", "key": "$[1; 2]$"}, {"id": "G11_TB_§1_1_10_з", "current_skill": "G11_S02_03", "q": "Найдите область изменения функции: $y = \\log_{2} \\sqrt{1 - x^{2}}$", "key": "$(-\\infty; 0]$"}, {"id": "G11_TB_§1_1_14_б", "current_skill": "G11_S02_03", "q": "Имеет ли наибольшее (наименьшее) значение функция $y = \\sqrt{x^{2} - 1}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Наименьшее значение: $y=0$ при $x=\\pm 1$; наибольшего значения нет."}, {"id": "G11_TB_§1_1_14_д", "current_skill": "G11_S02_03", "q": "Имеет ли наибольшее (наименьшее) значение функция $y=\\dfrac{1}{\\sqrt{1-x^{2}}}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Наименьшее значение: $y=1$ при $x=0$; наибольшего значения нет."}, {"id": "G11_TB_§1_1_8_д", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\dfrac{1}{\\sqrt{x^{2} - x}}$", "key": "$(-\\infty; 0) \\cup (1; +\\infty)$"}, {"id": "G11_TB_§1_1_8_е", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\sqrt{\\dfrac{x^{2} + x}{x + 4}}$", "key": "$(-4; -1] \\cup [0; +\\infty)$"}, {"id": "G11_TB_§1_1_9_в", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\log_{2} \\tg x$", "key": "$(\\pi k; \\dfrac{\\pi}{2} + \\pi k), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_§1_1_9_е", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\sqrt{x^{2} - 1} + \\sqrt{1 - x^{2}}$", "key": "$\\{-1; 1\\}$"}, {"id": "G11_TB_§20_13", "current_skill": "G11_S02_03", "q": "Найдите все значения параметра $a$, при которых система уравнений $\\lg(4+y)=\\lg x$, $a-y=\\dfrac{1}{2}(x+a)^{2}$ имеет решения.", "key": "$a \\in \\left[-\\dfrac{9}{4}; 4\\right)$"}, {"id": "G11_TB_§20_6", "current_skill": "G11_S02_03", "q": "Решите уравнение $\\log_{2}(1+\\sqrt{x-2})+\\log_{\\frac{1}{3}}(1-|x^{2}-4|)=0$.", "key": "$2$"}, {"id": "G11_TB_§2_5_4", "current_skill": "G11_S02_03", "q": "Решите неравенство методом интервалов: $\\dfrac{\\sqrt{2x-2}-2}{x^{2}-16}\\geq 0$", "key": "$x \\in [1; 3] \\cup (4; +\\infty)$"}, {"id": "G11_TB_§2_6_1", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\sqrt[4]{\\dfrac{x-5}{2-\\sqrt{x+2}}}$", "key": "$x \\in (2; 5]$"}, {"id": "G11_TB_§2_6_2", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = (x - \\sqrt{2x - 1})^{\\frac{-1}{3}}$", "key": "$x \\in \\left[\\dfrac{1}{2}; 1\\right) \\cup (1; +\\infty)$"}, {"id": "G11_TB_§2_6_4", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\left( \\dfrac{5 - \\sqrt{x - 3}}{x - 4} \\right)^{\\frac{1}{2}}$", "key": "$x \\in (4; 28]$"}, {"id": "G11_TB_§3_10_4", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\dfrac{1}{\\sqrt{x^{2} - 4}}$", "key": "$x \\in (-\\infty; -2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_§3_10_6", "current_skill": "G11_S02_03", "q": "Найдите область определения функции: $y = \\sqrt{\\dfrac{1}{x} - 2}$", "key": "$0 < x \\le \\dfrac{1}{2}$"}, {"id": "G11_TB_1_3_1_10_2", "current_skill": "G11_S02_04", "q": "Найдите область изменения функции:\n$y = \\sqrt{1 - x^{2}}$, $X = [0; \\dfrac{\\sqrt{3}}{2}]$", "key": "$[\\dfrac{1}{2}; 1]$"}, {"id": "G11_TB_1_3_1_10_3", "current_skill": "G11_S02_04", "q": "Найдите область изменения функции:\n$y = \\sqrt{1 - x^{2}}$, $X = \\left[ -\\dfrac{\\sqrt{3}}{2}; 1 \\right]$", "key": "$[0; 1]$"}, {"id": "G11_TB_1_3_1_10_7", "current_skill": "G11_S02_04", "q": "Найдите область изменения функции:\n$y = \\dfrac{1}{\\sqrt{1 - x^{2}}}$, $X = \\left[ -\\dfrac{\\sqrt{3}}{2}; \\dfrac{\\sqrt{3}}{2} \\right]$", "key": "$[1; 2]$"}, {"id": "G11_TB_§13_4_2", "current_skill": "G11_S02_04", "q": "Найдите область значений функции: $y = -5^{x}$", "key": "$(-\\infty; 0)$"}, {"id": "G11_TB_§13_4_3", "current_skill": "G11_S02_04", "q": "Найдите область значений функции: $y = 7^{x} - 2$", "key": "$(-2; +\\infty)$"}, {"id": "G11_TB_§1_1_10_б", "current_skill": "G11_S02_04", "q": "Найдите область изменения функции: $y = \\sqrt{1 - x^{2}}$, $X = [0; \\dfrac{\\sqrt{3}}{2}]$", "key": "$[\\dfrac{1}{2}; 1]$"}, {"id": "G11_TB_§1_1_10_в", "current_skill": "G11_S02_04", "q": "Найдите область изменения функции: $y = \\sqrt{1 - x^{2}}$, $X = \\left[ -\\dfrac{\\sqrt{3}}{2}; 1 \\right]$", "key": "$[0; 1]$"}, {"id": "G11_TB_10_5*_10_26*_б", "current_skill": "G11_S02_05", "q": "Решите уравнение: $(x^{2}+2)^{\\sin x} = (x^{2}+2)^{\\cos x}$", "key": "$\\dfrac{\\pi}{4} + \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_13_2*_13_1_а", "current_skill": "G11_S02_05", "q": "Решите уравнение: $5\\sqrt{-x^{2}+9x-14}-2\\sqrt[4]{x^{2}-5x-14}-1=\\sin\\dfrac{\\pi x}{2}$", "key": "$x=7$"}, {"id": "G11_TB_13_2*_13_1_в", "current_skill": "G11_S02_05", "q": "Решите уравнение: $2001\\sqrt[4]{x^{2}-9}+2002\\sqrt{9-x^{2}}=\\cos\\dfrac{\\pi x}{2}$", "key": "$x=3$; $x=-3$"}, {"id": "G11_TB_13_2*_13_5_б", "current_skill": "G11_S02_05", "q": "Решите неравенство: $4^{\\sqrt{\\cos x - 1}} + \\log_{3} \\dfrac{x}{2\\pi} > \\cos x + 1$", "key": "$x = 2\\pi k$, $k \\ge 4$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_13_3*_13_10_a", "current_skill": "G11_S02_05", "q": "Решите неравенство: $(x^{2}+4x-21)^{2}+\\lg(x^{2}-6x+10)\\leq 0$", "key": "$3$"}, {"id": "G11_TB_13_3*_13_10_b", "current_skill": "G11_S02_05", "q": "Решите неравенство: $(x^{2}-3x-4)^{2}+\\lg(x^{2}-8x+17)\\leq 0$", "key": "$4$"}, {"id": "G11_TB_13_3*_13_11_a", "current_skill": "G11_S02_05", "q": "Решите неравенство: $\\sqrt{x^{2}-8x+15}+\\lg(x^{2}-10x+26)\\leq 0$", "key": "$5$"}, {"id": "G11_TB_13_3*_13_11_b", "current_skill": "G11_S02_05", "q": "Решите неравенство: $\\sqrt{x^{2}-6x+8}+\\lg(x^{2}-8x+17)\\leq 0$", "key": "$4$"}, {"id": "G11_TB_13_3*_13_13_a", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\lg(x^{2}+1)+1=\\cos(\\pi x)$", "key": "$0$"}, {"id": "G11_TB_13_3*_13_13_b", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\lg(1+|x-2|)+2=|1+\\cos(\\pi x)|$", "key": "$2$"}, {"id": "G11_TB_13_3*_13_14_b", "current_skill": "G11_S02_05", "q": "Решите уравнение: $x^{2} - 4\\pi x + 4\\pi^{2} = \\cos x - 1$", "key": "$2\\pi$"}, {"id": "G11_TB_13_3*_13_14_d", "current_skill": "G11_S02_05", "q": "Решите уравнение: $x^{2} - 2\\pi x + \\pi^{2} = \\cos x - 1$", "key": "нет решений"}, {"id": "G11_TB_13_3*_13_15_a", "current_skill": "G11_S02_05", "q": "Решите уравнение: $2\\cos^{2}(x\\sin(\\pi x)) = 2 + \\log_{2}(x^{2} - 4x + 5)$", "key": "$2$"}, {"id": "G11_TB_13_3*_13_15_b", "current_skill": "G11_S02_05", "q": "Решите уравнение: $3\\sin^{2}\\left(\\dfrac{\\pi x}{2} \\cdot \\sin\\left(\\dfrac{\\pi x}{2}\\right)\\right) = 3 + \\log_{3}(x^{2} - 6x + 10)$", "key": "$3$"}, {"id": "G11_TB_13_3*_13_6_a", "current_skill": "G11_S02_05", "q": "Решите уравнение: $(\\log_{2}(x-5)-\\sin(\\pi x))^{2}+(x-6)^{2}=0$", "key": "$6$"}, {"id": "G11_TB_13_3*_13_8_a", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\sqrt{x^{2}-5x-14} + |\\log_{0{,}6}(x^{2}-14x+50)| = 0$", "key": "$7$"}, {"id": "G11_TB_13_3*_13_8_b", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\sqrt{x^{2}-8x+15}+|\\log_{0{,}7}(x^{2}-10x+26)|=0$", "key": "$5$"}, {"id": "G11_TB_13_3*_13_9_d", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\log_{8}(x^{2}+8x+17)+\\log_{9}^{2}(\\sqrt[5]{x-28}+3)=0$", "key": "$-4$"}, {"id": "G11_TB_14_1_13_36_a", "current_skill": "G11_S02_05", "q": "Решите уравнение: $2\\sin^{8}2x - 5\\cos^{7}4x = 7$", "key": "$x = \\dfrac{\\pi}{4} + \\dfrac{\\pi k}{2}, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_36_b", "current_skill": "G11_S02_05", "q": "Решите уравнение: $5\\sin^{7}3x + 2\\cos^{4}2x = 7$", "key": "$x = \\dfrac{3\\pi}{2} + 2\\pi m, m \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_36_g", "current_skill": "G11_S02_05", "q": "Решите уравнение: $7\\sin^{4}3x + 4\\cos^{8}2x = 11$", "key": "$x = \\dfrac{\\pi}{2} + \\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_36_v", "current_skill": "G11_S02_05", "q": "Решите уравнение: $3\\sin^{3}2x-7\\cos^{4}4x=-10$", "key": "$x = -\\dfrac{\\pi}{4} + \\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_37_a", "current_skill": "G11_S02_05", "q": "Решите неравенство: $3\\sin^{8}2x - 8\\cos^{7}4x \\ge 11$", "key": "$x = \\dfrac{\\pi}{4} + \\dfrac{\\pi k}{2}, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_37_b", "current_skill": "G11_S02_05", "q": "Решите неравенство: $11\\sin^{7}3x - 2\\cos^{4}2x \\le -13$", "key": "$x = \\dfrac{\\pi}{2} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_37_g", "current_skill": "G11_S02_05", "q": "Решите неравенство: $13\\sin^{4}3x + 2\\cos^{8}2x \\ge 15$", "key": "$x = \\dfrac{\\pi}{2} + \\pi t, t \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_37_v", "current_skill": "G11_S02_05", "q": "Решите неравенство: $5\\sin^{7}2x - 9\\cos^{4}4x \\le -14$", "key": "$x = -\\dfrac{\\pi}{4} + \\pi k,\\ k \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_13_38_a", "current_skill": "G11_S02_05", "q": "Решите неравенство: $7\\sin^{3}2x - 10\\cos^{5}4x + 13\\cos^{7}8x \\ge 30$", "key": "$x = \\dfrac{\\pi}{4} + \\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_1_1_2", "current_skill": "G11_S02_05", "q": "Решите уравнение: $5^{x} = -1$", "key": "корней нет"}, {"id": "G11_TB_14_2_14_4", "current_skill": "G11_S02_05", "q": "Докажите, что система уравнений не имеет действительных решений:\n$$\\begin{cases} x-2y=3 \\\\ x^{2}+y^{2}+1=0 \\end{cases}$$", "key": "Второе уравнение равносильно $x^{2} + y^{2} = -1$, а сумма квадратов действительных чисел неотрицательна, поэтому уже вт"}, {"id": "G11_TB_14_3_1_3", "current_skill": "G11_S02_05", "q": "Решите неравенство: $3^{x} > 0$", "key": "$x \\in \\mathbb{R}$"}, {"id": "G11_TB_14_3_1_4", "current_skill": "G11_S02_05", "q": "Решите неравенство: $(\\dfrac{1}{3})^{x} < 0$", "key": "$\\emptyset$"}, {"id": "G11_TB_15_1*_14_44_a", "current_skill": "G11_S02_05", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\tg^{2}x + \\ctg^{2}x = 2\\sin^{2}y, \\\\\n\\sin^{2}y + \\cos^{2}z = 1\n\\end{cases}\n$$", "key": "$$x = \\dfrac{\\pi}{4} + \\dfrac{\\pi k}{2}, k \\in \\mathbb{Z}; y = \\dfrac{\\pi}{2} + \\pi n, n \\in \\mathbb{Z}; z = \\dfrac{\\pi}"}, {"id": "G11_TB_15_4*_15_28_a", "current_skill": "G11_S02_05", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n\\sin 2x \\cos y = -a^{2} - 1, \\\\\n\\sin y \\cos 2x = a.\n\\end{cases}\n$$", "key": "$a=0$, $x=\\dfrac{\\pi}{4}+\\pi k$, $y=\\pi+2\\pi n$; $a=0$, $x=-\\dfrac{\\pi}{4}+\\pi k$, $y=2\\pi n$; $a\\neq 0$, решений нет"}, {"id": "G11_TB_15_4*_15_28_b", "current_skill": "G11_S02_05", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n\\sin 3x \\cdot \\cos 2y = -a^{2} - 1,\\\\\n\\sin 2y \\cdot \\cos 3x = a + 1\n\\end{cases}\n$$", "key": "Нет решений"}, {"id": "G11_TB_15_4*_15_29_a", "current_skill": "G11_S02_05", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a^{2} - a) \\sin\\left(\\dfrac{x}{2}\\right) + 2 \\cos y = a + 5,\\\\\n3 \\sin\\left(\\dfrac{x}{2}\\right) + \\cos y = 4.\n\\end{cases}\n$$", "key": "При $a=-1$ и при $a=3$: $\\sin\\left(\\dfrac{x}{2}\\right)=1$, $\\cos y=1$, то есть $x=\\pi+4\\pi k$, $y=2\\pi n$, $k,n \\in \\mat"}, {"id": "G11_TB_15_4*_15_29_b", "current_skill": "G11_S02_05", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a^{2}+a) \\sin\\left(\\dfrac{y}{2}\\right) + 2\\cos x = 3a+1,\\\\\n3\\sin\\left(\\dfrac{y}{2}\\right) + \\cos x = -4.\n\\end{cases}\n$$", "key": "При $a=-3$ и при $a=-1$: $x=\\pi+2\\pi k$, $y=-\\pi+4\\pi n$, $k,n \\in \\mathbb{Z}$; при остальных $a$ решений нет"}, {"id": "G11_TB_15_4*_15_30_a", "current_skill": "G11_S02_05", "q": "При каких значениях параметра $a \\neq -3$ уравнение $2 \\sin 2x = \\dfrac{a-1}{a+3}$ не имеет корней?", "key": "$a \\in (-7; -3) \\cup (-3; \\dfrac{-5}{3})$"}, {"id": "G11_TB_15_4*_15_30_b", "current_skill": "G11_S02_05", "q": "При каких значениях параметра $a \\neq 2$ уравнение $3 \\cos x = \\dfrac{a+5}{a-2}$ не имеет корней?", "key": "$a \\in (0{,}25; 2) \\cup (2; 5{,}5)$"}, {"id": "G11_TB_15_4*_15_39_b", "current_skill": "G11_S02_05", "q": "При каких значениях параметра $a$ неравенство $\\sqrt{x^{2}+8x+20} \\leq \\dfrac{2a^{2}-4a-3}{a^{2}-2a-8}$ не имеет решений?", "key": "$a \\in (-2; 4)$"}, {"id": "G11_TB_1_3_1_11_1", "current_skill": "G11_S02_05", "q": "В таблице указаны функция и её область определения. $$\\begin{array}{ll}\n\\text{а) }\\sqrt{1-x^2}&[-1;1]\\\\\n\\text{б) }\\sqrt{1-x^2}&[0;\\sqrt3/2]\\\\\n\\text{в) }\\sqrt{1-x^2}&[-\\sqrt3/2;1]\\\\\n\\text{г) }30/\\sqrt{100-x^2}&[-8;1]\\\\\n\\text{д) }1/\\sqrt{1-x^2}&(-\\sqrt2/2;0)\\\\\n\\text{е) }\\log_2\\sqrt{x^2-1}&(-\\infty;-1)\\cup(1;+\\infty)\\\\\n\\text{ж) }1/\\sqrt{1-x^2}&[-\\sqrt3/2;\\sqrt3/2]\\\\\n\\text{з) }\\log_2\\sqrt{1-x^2}&(-1;1)\n\\end{array}$$ Укажите все функции, ограниченные снизу.", "key": "а, б, в, г, д, ж"}, {"id": "G11_TB_1_3_1_11_2", "current_skill": "G11_S02_05", "q": "В таблице указаны функция и её область определения. $$\\begin{array}{ll}\n\\text{а) }\\sqrt{1-x^2}&[-1;1]\\\\\n\\text{б) }\\sqrt{1-x^2}&[0;\\sqrt3/2]\\\\\n\\text{в) }\\sqrt{1-x^2}&[-\\sqrt3/2;1]\\\\\n\\text{г) }30/\\sqrt{100-x^2}&[-8;1]\\\\\n\\text{д) }1/\\sqrt{1-x^2}&(-\\sqrt2/2;0)\\\\\n\\text{е) }\\log_2\\sqrt{x^2-1}&(-\\infty;-1)\\cup(1;+\\infty)\\\\\n\\text{ж) }1/\\sqrt{1-x^2}&[-\\sqrt3/2;\\sqrt3/2]\\\\\n\\text{з) }\\log_2\\sqrt{1-x^2}&(-1;1)\n\\end{array}$$ Укажите все функции, ограниченные сверху.", "key": "а, б, в, г, д, ж, з"}, {"id": "G11_TB_1_3_1_11_3", "current_skill": "G11_S02_05", "q": "В таблице указаны функция и её область определения. $$\\begin{array}{ll}\n\\text{а) }\\sqrt{1-x^2}&[-1;1]\\\\\n\\text{б) }\\sqrt{1-x^2}&[0;\\sqrt3/2]\\\\\n\\text{в) }\\sqrt{1-x^2}&[-\\sqrt3/2;1]\\\\\n\\text{г) }30/\\sqrt{100-x^2}&[-8;1]\\\\\n\\text{д) }1/\\sqrt{1-x^2}&(-\\sqrt2/2;0)\\\\\n\\text{е) }\\log_2\\sqrt{x^2-1}&(-\\infty;-1)\\cup(1;+\\infty)\\\\\n\\text{ж) }1/\\sqrt{1-x^2}&[-\\sqrt3/2;\\sqrt3/2]\\\\\n\\text{з) }\\log_2\\sqrt{1-x^2}&(-1;1)\n\\end{array}$$ Укажите все функции, ограниченные и сверху, и снизу.", "key": "а, б, в, г, д, ж"}, {"id": "G11_TB_1_3_1_12_3", "current_skill": "G11_S02_05", "q": "Покажите, что на полной области определения функция:\n$y = \\log_{2}{x}$ не является ограниченной.", "key": "Для любого $M$ при $x = 2^{M+1}$ получаем $\\log_{2} x = M + 1 > M$, а для любого $m$ при $x = 2^{m-1}$ — $\\log_{2} x = m"}, {"id": "G11_TB_8_4_18_г", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\log_{5}(25^{x}+5^{x}-5)=x+1$", "key": "$x = 1$"}, {"id": "G11_TB_9_5_9_39_б", "current_skill": "G11_S02_05", "q": "Решите уравнение: $\\log_{0,2} \\sin x - 5^{\\sin x} - \\sqrt{\\sin x} = \\log_{0,2} (-\\cos x) - 5^{-\\cos x} - \\sqrt{-\\cos x}$", "key": "$x = \\dfrac{3\\pi}{4} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_?_217_2", "current_skill": "G11_S02_05", "q": "Решите неравенство: $2\\log_{\\pi}\\sin x \\cdot \\log_{\\pi}\\sin 2x - \\log_{\\pi}^{2}\\sin 2x \\le \\log_{\\pi}^{2}\\sin x$", "key": "$x \\in \\left(2\\pi k; \\dfrac{\\pi}{2} + 2\\pi k\\right), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_§12_12", "current_skill": "G11_S02_05", "q": "Найдите все значения $a$, при которых уравнение $7-2\\cos x = a(1+\\operatorname{tg}^{2}x)$ имеет хотя бы один корень.", "key": "$a \\in (0; 9]$"}, {"id": "G11_TB_§13_4_1", "current_skill": "G11_S02_05", "q": "Найдите область значений функции: $y = 3^{x} + 1$", "key": "$(1; +\\infty)$"}, {"id": "G11_TB_§13_4_4", "current_skill": "G11_S02_05", "q": "Найдите область значений функции: $y = -\\left(\\dfrac{1}{6}\\right)^{x}$", "key": "$(-\\infty; 0)$"}, {"id": "G11_TB_§1_1_12_a", "current_skill": "G11_S02_05", "q": "Покажите, что на полной области определения функция $y = x^{2}$ не является ограниченной сверху.", "key": "Для любого числа $M > 0$ при $x = \\sqrt{M} + 1$ получаем $x^{2} > M$, т. е. никакое число $M$ не ограничивает функцию св"}, {"id": "G11_TB_§1_1_12_б", "current_skill": "G11_S02_05", "q": "Покажите, что на полной области определения функция $y = \\dfrac{-1}{x^{2}}$ не является ограниченной снизу.", "key": "Для любого числа $M < 0$ при $x = \\dfrac{1}{\\sqrt{1 - M}}$ получаем $y = -(1 - M) = M - 1 < M$, т. е. никакое число $M$ "}, {"id": "G11_TB_§1_1_12_в", "current_skill": "G11_S02_05", "q": "Покажите, что на полной области определения функция $y = \\log_{2} x$ не является ограниченной.", "key": "Для любого $M > 0$ при $x = 2^{M + 1}$ имеем $\\log_{2} x = M + 1 > M$, а для любого $M < 0$ при $x = 2^{M - 1}$ имеем $\\"}, {"id": "G11_TB_§1_1_7", "current_skill": "G11_S02_05", "q": "Докажите, что функция $y = 1 - x$ ограничена на множестве $X = [-1; 1]$.", "key": "Для всех $x \\in [-1; 1]$ имеем $-1 \\le -x \\le 1$, поэтому $0 \\le 1 - x \\le 2$, т. е. функция ограничена на $X$ снизу чис"}, {"id": "G11_TB_§20_7", "current_skill": "G11_S02_05", "q": "При каких значениях параметра $a$ неравенство $\\log_{\\frac{2a-15}{5}}\\left(\\dfrac{\\sin x+\\sqrt{3}\\cos x+a-5}{5}\\right)>0$ выполняется для любых значений $x$?", "key": "$a \\in (7{,}5; 8) \\cup (12; +\\infty)$"}, {"id": "G11_TB_10_3*_10_4*", "current_skill": "G11_S03_01", "q": "Докажите утверждение о возведении уравнения в чётную степень: возведение уравнения $f(x) = g(x)$ в чётную степень $2m$ ($m \\in \\mathbb{N}$) приводит к уравнению $(f(x))^{2m} = (g(x))^{2m}$, равносильному исходному на том множестве $M$, на котором обе функции $f$ и $g$ неотрицательны.", "key": "Каждый корень исходного уравнения — корень нового; обратно, если $x_{0} \\in M$ и $(f(x_{0}))^{2m} = (g(x_{0}))^{2m}$, то"}, {"id": "G11_TB_11_2_11_5_а", "current_skill": "G11_S03_01", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $\\sin x > \\cos x$, $\\sin^{2} x > \\cos^{2} x$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Возведение в квадрат. Равносильны на множестве, где $\\sin x \\geq 0$ и $\\cos x \\geq 0$."}, {"id": "G11_TB_11_2_11_5_б", "current_skill": "G11_S03_01", "q": "Объясните, в результате какого преобразования из первого неравенства получено второе: $x^{4} > 5$, $x > \\sqrt[4]{5}$. Выясните, на каком множестве равносильны первое и второе неравенства.", "key": "Извлечение корня четвёртой степени. Равносильны на множестве $x \\geq 0$."}, {"id": "G11_TB_13_5*_13_32_а", "current_skill": "G11_S03_01", "q": "Решите неравенство: $12x^{5}+10x^{3}+35x-17\\sin 2x>0$", "key": "$x > 0$"}, {"id": "G11_TB_1_3_1_12_1", "current_skill": "G11_S03_01", "q": "Покажите, что на полной области определения функция: $y = x^{2}$ не является ограниченной сверху", "key": "Для любого $M>0$ можно взять $x=\\sqrt{M+1}$, тогда $x^{2}=M+1>M$."}]