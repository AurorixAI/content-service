[{"id": "G11_TB_17_1_5_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\lg 2 + \\lg(4^{x-2} + 9) = 1 + \\lg(2^{x-2} + 1)$", "key": "$x = 2$; $x = 4$"}, {"id": "G11_TB_17_1_5_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{7}(6+7^{-x})=1+x$", "key": "$x = 0$"}, {"id": "G11_TB_17_1_5_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}\\left(2(4 \\cdot 3^{x} - 6)\\right) - \\log_{2}(9^{x} - 6) = 1$", "key": "$x = \\log_{3} 4$"}, {"id": "G11_TB_17_1_8_3", "current_skill": "G11_S01_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\log_{2}{x} + \\log_{2}{y} = 2, \\\\\n\\log_{2}{(x + y - 3)} = 1\n\\end{cases}\n$$", "key": "$(1; 4)$, $(4; 1)$"}, {"id": "G11_TB_17_2_1_1", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\log_{3} x > 2$", "key": "$x > 9$"}, {"id": "G11_TB_17_2_1_4", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\lg x < 2$", "key": "$0 < x < 100$"}, {"id": "G11_TB_17_2_2_1", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\log_{2}(3x-2)>2$", "key": "$x > 2$"}, {"id": "G11_TB_17_2_2_3", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\log_{5}(3x-2)<2$", "key": "$\\dfrac{2}{3} < x < 9$"}, {"id": "G11_TB_18_2*_18_3_а", "current_skill": "G11_S01_03", "q": "Найдите все корни уравнения: $2x^{2}+5x+2=0$.", "key": "$x = \\dfrac{-1}{2}, x = -2$"}, {"id": "G11_TB_18_2*_18_4_а", "current_skill": "G11_S01_03", "q": "Найдите все корни уравнения: $x^{3}-5x^{2}+8x-4=0$.", "key": "$x=1$, $x=2$ (кратности $2$)"}, {"id": "G11_TB_21_1_2_15_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $A_{x}^{2}=20$", "key": "$x=5$"}, {"id": "G11_TB_21_1_2_15_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{A_{x}^{5}}{A_{x}^{3}} = 6$", "key": "$x=6$"}, {"id": "G11_TB_21_1_3_20°", "current_skill": "G11_S01_03", "q": "Сколько необходимо взять элементов, чтобы число размещений из них по $4$ было в $12$ раз больше, чем число размещений из них по $2$?", "key": "$6$"}, {"id": "G11_TB_21_1_3_21_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $A_{x}^{2}=42$", "key": "$x=7$"}, {"id": "G11_TB_21_1_3_21_2", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$A_{x}^{3} = 56x$", "key": "$x = 9$"}, {"id": "G11_TB_21_1_3_21_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $A_{x+1}^{2}=30$", "key": "$x=5$"}, {"id": "G11_TB_21_1_3_22_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $C_{x-3}^{2}=21$", "key": "$x=10$"}, {"id": "G11_TB_21_1_3_23*_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{A_{x}^{5}+A_{x}^{3}}{A_{x}^{3}}=43$", "key": "$x=10$"}, {"id": "G11_TB_21_1_3_23*_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{A_{x}^{7} - A_{x}^{5}}{A_{x}^{5}} = 89$", "key": "$x = 15$"}, {"id": "G11_TB_21_1_3_23*_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $12C_{x}^{1} + C_{x+4}^{2} = 162$", "key": "$x = 8$"}, {"id": "G11_TB_21_1_3_24*_1", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$\\dfrac{A_{x}^{4} \\cdot P_{x-4}}{P_{x-2}} = 42$", "key": "$x=7$"}, {"id": "G11_TB_21_1_3_24*_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{A_{x+1}^{n+1} \\cdot P_{x-n}}{P_{x-1}} = 90$", "key": "$x = 9$ (при любом целом $n$, $0 \\le n \\le 9$)"}, {"id": "G11_TB_21_1_3_24*_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{P_{x+2}}{A_{x}^{n} \\cdot P_{x-n}} = 132$", "key": "$x = 10$ (при любом целом $n$, $0 \\le n \\le 10$)"}, {"id": "G11_TB_27_2_1", "current_skill": "G11_S01_03", "q": "Решите графически систему $2x - y = 3$, $x + y = 3$", "key": "$(2; 1)$"}, {"id": "G11_TB_27_2_1_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x = \\sqrt{10x + 24}$", "key": "$12$"}, {"id": "G11_TB_27_2_27_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(7\\sin x - 4\\sqrt{3})(7\\sin x - 5\\sqrt{2}) = 0$", "key": "$x = (-1)^{n}\\arcsin\\dfrac{4\\sqrt{3}}{7} + \\pi n$, $n \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_27_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(5\\cos x - 3\\sqrt{3})(5\\cos x - 2\\sqrt{6}) = 0$", "key": "$x = \\pm \\arccos\\left(\\dfrac{2\\sqrt{6}}{5}\\right) + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_2_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{x+7}=4x-5$", "key": "$2$"}, {"id": "G11_TB_27_2_2_5", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x + 3\\sqrt{x - 5} = 5$", "key": "$5$"}, {"id": "G11_TB_27_2_31_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[3]{\\dfrac{2+x}{x}} - \\sqrt[3]{\\dfrac{2-6x}{x}} = 1$", "key": "$-1; \\dfrac{2}{7}$"}, {"id": "G11_TB_27_2_32_1", "current_skill": "G11_S01_03", "q": "Найдите наибольший корень уравнения: $(\\sqrt[3]{4-\\sqrt{15}})^{x}+(\\sqrt[3]{4+\\sqrt{15}})^{x}=8$", "key": "$3$"}, {"id": "G11_TB_27_2_32_2", "current_skill": "G11_S01_03", "q": "Найдите наибольший корень уравнения: $(2\\sqrt{3}-2)^{x}+2^{x+1}=2(\\sqrt{3}+1)^{x}$", "key": "$1$"}, {"id": "G11_TB_27_2_89", "current_skill": "G11_S01_03", "q": "Тете сейчас $40$ лет. Она вчетверо старше, чем была ее племянница тогда, когда тете было столько лет, сколько сейчас племяннице. Каков возраст племянницы?", "key": "$25$"}, {"id": "G11_TB_7_1_2", "current_skill": "G11_S01_03", "q": "Решим уравнение $\\sqrt[3]{12x^{2}-28x+8}=2-x$.", "key": "$-8; 0; 2$"}, {"id": "G11_TB_7_1_3", "current_skill": "G11_S01_03", "q": "Решим уравнение $(x-5)^{11}=(2x+4)^{11}$.", "key": "$-9$"}, {"id": "G11_TB_7_1_4", "current_skill": "G11_S01_03", "q": "Решим уравнение $5^{x^{2}-2x}=5^{x-2}$.", "key": "$1; 2$"}, {"id": "G11_TB_7_2_7_3_1", "current_skill": "G11_S01_03", "q": "Объясните, почему равносильны уравнения: $x + 5 = 2x - 3$ и $x - 2x + 5 = -3$.", "key": "Перенос члена $2x$ из правой части в левую с противоположным знаком."}, {"id": "G11_TB_7_2_7_3_5", "current_skill": "G11_S01_03", "q": "Объясните, почему равносильны уравнения: $x=1$ и $x^{3}=1$", "key": "Второе уравнение получено из первого возведением в нечётную степень $3$, а функция $t^{3}$ строго возрастает на всей пря"}, {"id": "G11_TB_8_1_7_18_2", "current_skill": "G11_S01_03", "q": "Объясните, почему равносильны неравенства: $3x > 6$ и $x > 2$.", "key": "Неравенства равносильны, потому что второе получено из первого делением обеих частей на положительное число $3$, а при д"}, {"id": "G11_TB_8_3_8_10_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{\\log_{3}^{2} x + 5} = 1 - \\log_{3} x$", "key": "$x = \\dfrac{1}{9}$"}, {"id": "G11_TB_8_3_8_10_д", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{3 \\cdot 4^{x} - 2^{x} + 2} = 2^{x} + 1$", "key": "$-1$; $0$"}, {"id": "G11_TB_8_3_8_7_а", "current_skill": "G11_S01_03", "q": "Возведите уравнение во вторую степень, решите полученное уравнение, проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $\\sqrt{x}=x-2$", "key": "$x = 4$"}, {"id": "G11_TB_8_3_8_7_б", "current_skill": "G11_S01_03", "q": "Возведите уравнение во вторую степень, решите полученное уравнение, проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $\\sqrt{3x}=2x-3$", "key": "$x = 3$"}, {"id": "G11_TB_8_3_8_7_в", "current_skill": "G11_S01_03", "q": "Возведите уравнение во вторую степень, решите полученное уравнение, проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $\\sqrt{2x-1}=x$", "key": "$x = 1$"}, {"id": "G11_TB_8_3_8_9_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{2x+5}=x+1$", "key": "$x = 2$"}, {"id": "G11_TB_8_3_8_9_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{3x+7}=2x+3$", "key": "$-0{,}25$"}, {"id": "G11_TB_8_4_15_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{3}(x^{2}-2x)=1$", "key": "$x = -1; x = 3$"}, {"id": "G11_TB_8_4_15_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(x^{2}+2x)=3$", "key": "$x = -4; x = 2$"}, {"id": "G11_TB_8_4_15_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{7}(x^{2}+1{,}5x)=0$", "key": "$x = -2; x = 0{,}5$"}, {"id": "G11_TB_8_4_16_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{5}\\left(\\dfrac{x+10}{x}\\right) = \\dfrac{\\log_{11} 21}{\\log_{11} 5}$", "key": "$x = 0{,}5$"}, {"id": "G11_TB_8_4_18_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{3}(9^{x} - 3^{x+1} + 3) = x$", "key": "$x = 0; x = 1$"}, {"id": "G11_TB_8_4_18_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(4^{x}+2^{x+1}-8)=x+2$", "key": "$x = 2$"}, {"id": "G11_TB_8_5_8_22", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$5(7-3\\sqrt{x})-3(2x-5\\sqrt{x})=41$", "key": "нет корней"}, {"id": "G11_TB_8_5_8_23", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$(x+2\\sqrt{x})^{2}-4x\\sqrt{x}=-3$", "key": "нет решений"}, {"id": "G11_TB_8_5_8_25", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$\\dfrac{x-1}{x^{2}+x-2}=-3$", "key": "$\\dfrac{-7}{3}$"}, {"id": "G11_TB_8_5_8_32", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$\\sqrt{2x-3}+\\sqrt{4x+1}=4$", "key": "$2$"}, {"id": "G11_TB_9_1_8_36_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $2\\log_{5}(x-1) = \\log_{5}(7-x)$", "key": "$3$"}, {"id": "G11_TB_9_1_8_38_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\lg(2x)-\\lg(x+4)=\\lg(0{,}4)$", "key": "$x = 1$"}, {"id": "G11_TB_9_1_8_39_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(\\sqrt{x+3}) + \\log_{2}(\\sqrt{x+6}) = 1$", "key": "$-2$"}, {"id": "G11_TB_9_1_8_40_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(x+1)=\\log_{4}(5x+1)$", "key": "$x=0;\\ x=3$"}, {"id": "G11_TB_9_3_9_13_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\lg(x^{2}-7x+14)=\\lg(3x-16)$", "key": "нет решений"}, {"id": "G11_TB_9_3_9_19_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(4^{5-x}-2^{x-1})\\log_{3}x=0$", "key": "$1$; $\\dfrac{11}{3}$"}, {"id": "G11_TB_9_3_9_20_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sin x(\\tg x-1)=0$", "key": "$x = \\pi k; \\ x = \\dfrac{\\pi}{4} + \\pi k$"}, {"id": "G11_TB_9_3_9_20_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(\\tg x+1)\\cos x=0$", "key": "$x = -\\dfrac{\\pi}{4} + \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_3_9_20_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\tg x (\\sin x - 1) = 0$", "key": "$x = \\pi k$"}, {"id": "G11_TB_?_131_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(7\\sin x - 4\\sqrt{3})(7\\sin x - 5\\sqrt{2}) = 0$", "key": "$x = (-1)^{n}\\arcsin\\dfrac{4\\sqrt{3}}{7} + \\pi n$, $n \\in \\mathbb{Z}$"}, {"id": "G11_TB_?_139", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\left(\\dfrac{8}{7}\\right)^{\\frac{1}{y^{2}}} = \\left(\\dfrac{7}{8}\\right)^{-\\frac{1}{|2 - y^{2}|}}$", "key": "$y=-1$; $y=1$"}, {"id": "G11_TB_?_141_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{\\log_{7} 4} + 5 \\cdot 2^{\\log_{7} x} - 4 = 0$", "key": "$7^{\\log_{2}\\frac{\\sqrt{41}-5}{2}}$"}, {"id": "G11_TB_?_141_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{\\log_{5} 9} + 7 \\cdot 3^{\\log_{5} x} - 11 = 0$", "key": "$5^{\\log_{3}\\frac{\\sqrt{93}-7}{2}}$"}, {"id": "G11_TB_?_142_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2} \\left(\\dfrac{x + 2}{5}\\right) + \\log_{2} \\left(\\dfrac{5}{x}\\right) = 1$", "key": "$2$"}, {"id": "G11_TB_?_142_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2} \\left(\\dfrac{x + 3}{5}\\right) + \\log_{2} \\left(\\dfrac{5}{x + 1}\\right) = 1$", "key": "$1$"}, {"id": "G11_TB_?_210_1", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\left(\\dfrac{1}{5}\\right)^{1-x} \\cdot 5^{\\sqrt{-x}} > \\dfrac{1}{25}$", "key": "$x \\in \\left(-\\dfrac{3+\\sqrt{5}}{2}; 0\\right]$"}, {"id": "G11_TB_?_238", "current_skill": "G11_S01_03", "q": "При каких значениях $c \\in \\mathbb{R}$ для действительных корней $x_{1}$ и $x_{2}$ уравнения $x^{2}+(4c-c^{2}-1)x+2c^{2}-1=0$ выполняется равенство $x_{1}+x_{2}=6$?", "key": "$\\{-1\\}$"}, {"id": "G11_TB_?_56_а", "current_skill": "G11_S01_03", "q": "Найдите координаты общих точек графиков функции: $y=\\sqrt{x+7}$ и $y-x-1=0$", "key": "$(2, 3)$"}, {"id": "G11_TB_?_56_б", "current_skill": "G11_S01_03", "q": "Найдите координаты общих точек графиков функции: $y=\\sqrt{x-4}$ и $y-2x+9=0$", "key": "$(5, 1)$"}, {"id": "G11_TB_?_62", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{8x-3}{7} - \\dfrac{3x+1}{10} = 2$", "key": "$3$"}, {"id": "G11_TB_?_63", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(2-3x)^{2}+(1+4x)^{2}=(5x+1)(5x-1)$", "key": "$1{,}5$"}, {"id": "G11_TB_?_64_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(21x+44)^{2}-25(21x+44)+46=0$", "key": "$-2; -1$"}, {"id": "G11_TB_?_64_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(19x+40)^{2}-23(19x+40)+42=0$", "key": "$-2; -1$"}, {"id": "G11_TB_?_64_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(17x+36)^{2}-21(17x+36)+38=0$", "key": "$-2; -1$"}, {"id": "G11_TB_?_64_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(15x+32)^{2}-19(15x+32)+34=0$", "key": "$-2; -1$"}, {"id": "G11_TB_?_65_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(x+97)^{2}+34(x+97)+120=0$", "key": "$-127$; $-101$"}, {"id": "G11_TB_?_65_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(x+79)^{2}+43(x+79)+120=0$", "key": "$-119; -82$"}, {"id": "G11_TB_?_65_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(x+93)^{2}+35(x+93)+150=0$", "key": "$-123; -98$"}, {"id": "G11_TB_?_65_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(x+86)^{2}+44(x+86)+160=0$", "key": "$-126; -90$"}, {"id": "G11_TB_?_8", "current_skill": "G11_S01_03", "q": "Найдите натуральные числа $n$, для которых $(\\mathrm{\\text{НОД}}(n;4))^{2}=n$, где $\\mathrm{\\text{НОД}}(n;4)$ — наибольший общий делитель чисел $n$ и $4$.", "key": "$1; 16$"}, {"id": "G11_TB_?_81_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{2} - 8x + 10 = (\\sqrt{7x - 40})^{2}$", "key": "$10$"}, {"id": "G11_TB_?_85_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{2x^{2}-8x+5}=x-2$", "key": "$2+\\sqrt{3}$"}, {"id": "G11_TB_?_87_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{3x+6} - \\sqrt{-10-5x} - 0{,}5x = 1$", "key": "$x = -2$"}, {"id": "G11_TB_?_88_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[3]{297-3x} + \\sqrt{x-18} = 9$", "key": "$27; 99; 342$"}, {"id": "G11_TB_?_89_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[3]{2x+5}+\\sqrt[3]{5x+16}=\\sqrt[3]{x+8}+\\sqrt[3]{6x+13}$", "key": "$x=-3; x=-2; x=3$"}, {"id": "G11_TB_?_90_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[3]{x-1} + \\sqrt[3]{2x+4} = \\sqrt[3]{31-2x}$", "key": "$2$"}, {"id": "G11_TB_?_92_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $3^{9x+10}=3^{6x-2}$", "key": "$x = -4$"}, {"id": "G11_TB_?_92_b", "current_skill": "G11_S01_03", "q": "Решите уравнение: $7^{x^{2}-3x+1} = \\dfrac{1}{7}$", "key": "$1; 2$"}, {"id": "G11_TB_§15_2_3", "current_skill": "G11_S01_03", "q": "Запишите решение простейшего показательного уравнения: $10^{x} = \\dfrac{1}{3}$", "key": "$x = \\lg \\dfrac{1}{3}$"}, {"id": "G11_TB_§15_3_2", "current_skill": "G11_S01_03", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $\\left(\\dfrac{1}{4}\\right)^{x}=15$.", "key": "$x = \\log_{\\frac{1}{4}} 15$"}, {"id": "G11_TB_§15_6_1", "current_skill": "G11_S01_03", "q": "Найдите: $x$ по его логарифму: $\\lg x = \\lg 5 - 2\\lg 3 + 3\\lg 2$.", "key": "$\\dfrac{40}{9}$"}, {"id": "G11_TB_§15_8_4", "current_skill": "G11_S01_03", "q": "Найдите: $x$, если: $\\log_{3} x = \\left(\\dfrac{1}{3}\\right) \\log_{3} 8 - 2 \\log_{3} 20 - 3 \\log_{3} 2$", "key": "$\\dfrac{1}{1600}$"}, {"id": "G11_TB_§16_16_20.1", "current_skill": "G11_S01_03", "q": "Найдите $x$, если $\\log_{2}x=\\log_{2}5+\\log_{2}3$.", "key": "$x=15$"}, {"id": "G11_TB_§16_16_20.2", "current_skill": "G11_S01_03", "q": "Найдите $x$, если $\\log_{5}x=2\\log_{5}3+\\log_{5}2$.", "key": "$x=18$"}, {"id": "G11_TB_§16_16_20.3", "current_skill": "G11_S01_03", "q": "Найдите $x$, если $\\log_{7}x=3\\log_{7}2-\\log_{7}4$.", "key": "$x=2$"}, {"id": "G11_TB_§16_16_25.1", "current_skill": "G11_S01_03", "q": "Решите уравнение $\\log_{5}(x^{2}-4x+1)=0$.", "key": "$x=0$ или $x=4$"}, {"id": "G11_TB_§16_16_25.2", "current_skill": "G11_S01_03", "q": "Решите уравнение $\\log_{0{,}5}(x^{2}+x-2)=-1$.", "key": "$x=\\dfrac{-1\\pm\\sqrt{17}}{2}$"}, {"id": "G11_TB_§19_13_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $4^{\\frac{1}{x}} - 1 = 3^{2x-1}$", "key": "$1$"}, {"id": "G11_TB_§19_15_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $3 \\cdot 2^{x+4} + 6 \\cdot 7^{x+1} = 3 \\cdot 5^{x+2} + 15$", "key": "$-1$; $0$; $1$"}, {"id": "G11_TB_§19_1_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{\\log_{x}(x^{2}-3)} = 2x$", "key": "$x = 3$"}, {"id": "G11_TB_§19_1_5a", "current_skill": "G11_S01_03", "q": "Решите уравнение $x^{x+2}=x^{6}$ при $x>0$", "key": "$x = 1$, $x = 4$"}, {"id": "G11_TB_§19_1_5b", "current_skill": "G11_S01_03", "q": "Решите уравнение $x^{x+2}=x^{6}$ при $x\\in\\mathbb{R}$", "key": "$x = 0$, $x = 1$, $x = 4$"}, {"id": "G11_TB_§20_10", "current_skill": "G11_S01_03", "q": "Найдите все значения параметра $a$, при которых уравнение $\\log_{3}(9^{x}+a)=x$ имеет единственный корень.", "key": "$a \\in (-\\infty; 0] \\cup \\left\\{\\dfrac{1}{4}\\right\\}$"}, {"id": "G11_TB_§20_1_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(\\dfrac{2}{5})^{x} + (\\dfrac{3}{5})^{x} = 1$", "key": "$x=1$"}, {"id": "G11_TB_§20_2_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(\\sqrt{4-\\sqrt{15}})^{x} + (\\sqrt{4+\\sqrt{15}})^{x} = 8$", "key": "$x=2$; $x=-2$"}, {"id": "G11_TB_§20_2_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(\\sqrt{3+\\sqrt{8}})^{x} + (\\sqrt{3-\\sqrt{8}})^{x} = 6$", "key": "$x=2$; $x=-2$"}, {"id": "G11_TB_§20_5_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{4^{x} - 6 \\cdot 2^{x} + 1} = 2^{x} - a$", "key": "$x=\\log_{2}\\left(\\dfrac{a^{2}-1}{2a-6}\\right)$ при $a\\in(-1, 3-2\\sqrt{2}]\\cup(3, 3+2\\sqrt{2}]$; при остальных $a$ решени"}, {"id": "G11_TB_10_2_10_2_а", "current_skill": "G11_S02_01", "q": "Определите множество: $M$, на котором равносильны уравнения: $\\dfrac{x^{2}+x-2}{x+2}=0$ и $x^{2}+x-2=0$", "key": "$x \\neq -2$"}, {"id": "G11_TB_10_2_10_3_а", "current_skill": "G11_S02_01", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\dfrac{f(x)}{g(x)}=\\varphi(x)$ и $f(x)=g(x)\\varphi(x)$?", "key": "$g(x) \\neq 0$"}, {"id": "G11_TB_10_2_10_3_и", "current_skill": "G11_S02_01", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\log_{a} f(x) - \\log_{a} g(x) = \\varphi(x)$ и $\\log_{a} \\left( \\dfrac{f(x)}{g(x)} \\right) = \\varphi(x)$?", "key": "$f(x) > 0$, $g(x) > 0$"}, {"id": "G11_TB_10_2_10_3_к", "current_skill": "G11_S02_01", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\dfrac{1}{\\log_{f(x)}a}=\\varphi(x)$ и $\\log_{a}f(x)=\\varphi(x)$?", "key": "$f(x) > 0$, $f(x) \\neq 1$"}, {"id": "G11_TB_10_2_10_3_о", "current_skill": "G11_S02_01", "q": "Какими условиями задаётся множество $M$, на котором равносильны $(a>0, a\\neq 1)$ уравнения: $\\dfrac{1-\\tg^{2}x}{1+\\tg^{2}x}=\\phi(x)$ и $\\cos 2x=\\phi(x)$?", "key": "$x \\neq \\dfrac{\\pi}{2} + \\pi k, k \\in \\mathbb{Z}$"}]