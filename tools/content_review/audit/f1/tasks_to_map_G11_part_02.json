[{"id": "G11_TB_27_2_11_2", "current_skill": "G11_S01_01", "q": "Решите уравнение: $\\cos 3x + \\sin 5x = \\sin x$", "key": "$x = (-1)^{k+1} \\cdot \\dfrac{\\pi}{12} + \\dfrac{\\pi k}{2}, k \\in \\mathbb{Z}; x = \\dfrac{\\pi}{6} + \\dfrac{\\pi n}{3}, n \\in"}, {"id": "G11_TB_27_2_12_2", "current_skill": "G11_S01_01", "q": "Решите уравнение: $\\sin x + \\sin 3x = 4 \\cos^{3} x$", "key": "$x = \\dfrac{\\pi}{2} + \\pi k$; $x = \\dfrac{\\pi}{4} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_14_2", "current_skill": "G11_S01_01", "q": "Решите уравнение: $\\sqrt{3} \\cos^{2}x - 0{,}5 \\cos\\left(\\dfrac{3\\pi}{2}+2x\\right) = 0$", "key": "$x = \\dfrac{\\pi}{2} + \\pi k$, $x = \\dfrac{\\pi}{3} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_15_2", "current_skill": "G11_S01_01", "q": "Найдите все решения уравнения $4\\sin^{4}x+\\sin^{2}2x=2\\operatorname{ctg}^{2}x$, которые удовлетворяют неравенству $\\cos x<-\\dfrac{1}{2}$", "key": "$x = \\dfrac{3\\pi}{4} + 2\\pi k; x = \\dfrac{5\\pi}{4} + 2\\pi k$"}, {"id": "G11_TB_27_2_36_4", "current_skill": "G11_S01_01", "q": "Решите неравенство: $\\dfrac{2x-1}{x-3} < x+3$", "key": "$x \\in (-2; 3) \\cup (4; +\\infty)$"}, {"id": "G11_TB_7_1_5", "current_skill": "G11_S01_01", "q": "Решим уравнение $(x^{2} - 8^{x} + 2^{x} - 1)^{7} = (x^{2} - 2^{x} - 1)^{7}$.", "key": "$0{,}5$"}, {"id": "G11_TB_7_2_7_2_1", "current_skill": "G11_S01_01", "q": "Докажите утверждение об извлечении корня нечётной степени из обеих частей уравнения: при нечётном $n$ уравнения $f(x) = g(x)$ и $\\sqrt[n]{f(x)} = \\sqrt[n]{g(x)}$ равносильны.", "key": "При нечётном $n$ функция $t \\mapsto \\sqrt[n]{t}$ определена и строго возрастает на всей прямой, поэтому $\\sqrt[n]{f(x_{0"}, {"id": "G11_TB_7_2_7_2_2", "current_skill": "G11_S01_01", "q": "Докажите утверждение: о логарифмировании показательного уравнения.", "key": "Если $a>0$, $a\\neq 1$, то уравнения $a^{f(x)}=a^{g(x)}$ и $f(x)=g(x)$ равносильны."}, {"id": "G11_TB_7_2_7_3_2", "current_skill": "G11_S01_01", "q": "Объясните, почему равносильны уравнения: $\\dfrac{1}{2}x^{2}+1=x^{3}-x$ и $x^{2}+2=2x^{3}-2x$", "key": "Умножение обеих частей уравнения на положительное число $2$."}, {"id": "G11_TB_7_2_7_3_4", "current_skill": "G11_S01_01", "q": "Объясните, почему равносильны уравнения: $x^{2}+x+2-x^{3}-x+1=0$ и $x^{2}-x^{3}+3=0$", "key": "Приведение подобных членов (применение тождеств)."}, {"id": "G11_TB_8_1_7_15_1", "current_skill": "G11_S01_01", "q": "Докажите утверждение о возведении неравенства в нечётную степень: при нечётном $n$ неравенства $f(x) > g(x)$ и $(f(x))^{n} > (g(x))^{n}$ равносильны.", "key": "При нечётном $n$ функция $t^{n}$ строго возрастает на всей прямой, поэтому для любых чисел $a > b \\Leftrightarrow a^{n} "}, {"id": "G11_TB_8_1_7_15_2", "current_skill": "G11_S01_01", "q": "Докажите утверждение об извлечении корня нечётной степени из обеих частей неравенства: при нечётном $n$ неравенства $f(x) > g(x)$ и $\\sqrt[n]{f(x)} > \\sqrt[n]{g(x)}$ равносильны.", "key": "При нечётном $n$ функция $t \\mapsto \\sqrt[n]{t}$ определена и строго возрастает на всей прямой, поэтому $a > b \\Leftrigh"}, {"id": "G11_TB_8_1_7_15_3", "current_skill": "G11_S01_01", "q": "Докажите утверждение: о логарифмировании показательного неравенства.", "key": "Если $a>0$, $a \\neq 1$, то неравенство $a^{f(x)}>a^{g(x)}$ равносильно: $f(x)>g(x)$ при $a>1$; $f(x)<g(x)$ при $0<a<1$."}, {"id": "G11_TB_8_1_7_16", "current_skill": "G11_S01_01", "q": "Докажите, что если число $a>0$, то неравенства $f(x)>g(x)$ и $a f(x)>a g(x)$ равносильны.", "key": "Пусть $a>0$. Если $f(x)>g(x)$, то, умножая обе части на положительное число $a$, получаем $a f(x)>a g(x)$. Обратно, если"}, {"id": "G11_TB_8_1_7_17", "current_skill": "G11_S01_01", "q": "Докажите, что если число $a<0$, то неравенства $f(x)>g(x)$ и $a f(x)<a g(x)$ равносильны.", "key": "Пусть $a < 0$. Если $f(x) > g(x)$, то умножим обе части на $a$ (отрицательное число), знак неравенства меняется: $a f(x)"}, {"id": "G11_TB_8_1_7_18_3", "current_skill": "G11_S01_01", "q": "Объясните, почему равносильны неравенства: $x^{2} < 2x + 1$ и $-x^{2} > -2x - 1$.", "key": "Неравенства равносильны, потому что второе получается из первого умножением обеих частей на $-1$ с изменением знака нера"}, {"id": "G11_TB_8_1_7_18_4", "current_skill": "G11_S01_01", "q": "Объясните, почему равносильны неравенства: $x^{2}-4x+4>0$ и $(x-2)^{2}>0$.", "key": "Неравенства равносильны, потому что выражение $x^{2}-4x+4$ тождественно равно $(x-2)^{2}$ (это формула квадрата разности"}, {"id": "G11_TB_8_1_7_18_5", "current_skill": "G11_S01_01", "q": "Объясните, почему равносильны неравенства: $x^{2}-4x+5+2x<0$ и $x^{2}-2x+5<0$.", "key": "Неравенства равносильны, потому что левая часть первого неравенства тождественно равна левой части второго: $x^{2}-4x+5+"}, {"id": "G11_TB_8_1_7_19_2", "current_skill": "G11_S01_01", "q": "Решите неравенство: $x^{3}-6x^{2}+9x>(x-3)^{3}$.", "key": "$x \\in (-\\infty; 3) \\cup (3; +\\infty)$"}, {"id": "G11_TB_8_1_7_19_3", "current_skill": "G11_S01_01", "q": "Решите неравенство: $x^{3}+5x^{2}-6x-2<3x^{2}-3x+4$.", "key": "$x \\in (-\\infty; -2) \\cup (-\\sqrt{3}; \\sqrt{3})$"}, {"id": "G11_TB_8_1_7_21_2", "current_skill": "G11_S01_01", "q": "Решите неравенство: $27^{x} + 9^{x} > 3^{x} + 6 + 27^{x}$.", "key": "$x > 1$"}, {"id": "G11_TB_8_1_7_22_2", "current_skill": "G11_S01_01", "q": "Решите неравенство: $\\sqrt[3]{5x^{3}-6x^{2}+3x+1} < \\sqrt[3]{4x^{3}-x^{2}-3x+1}$.", "key": "$x \\in (-\\infty; 0) \\cup (2; 3)$"}, {"id": "G11_TB_8_1_7_24_3", "current_skill": "G11_S01_01", "q": "Решите неравенство: $(x^{2}-5x)^{11} > (2x^{2}-7x)^{11}$.", "key": "$x \\in (0; 2)$"}, {"id": "G11_TB_8_1_7_25_1", "current_skill": "G11_S01_01", "q": "Решите неравенство: $(6\\sin^{2}x-5)^{13} < (2\\sin^{2}x-2)^{13}$.", "key": "$x \\in \\left(-\\dfrac{\\pi}{3} + \\pi k, \\dfrac{\\pi}{3} + \\pi k\\right), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_1_7_25_2", "current_skill": "G11_S01_01", "q": "Решите неравенство: $(6\\cos^{2}x-3)^{3} > (2\\cos^{2}x-1)^{3}$.", "key": "$x \\in \\left(-\\dfrac{\\pi}{4} + \\pi k, \\dfrac{\\pi}{4} + \\pi k\\right), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_1_7_25_4", "current_skill": "G11_S01_01", "q": "Решите неравенство: $(2 \\cdot 3^{x} - 1)^{51} < (3^{x} + 8)^{51}$.", "key": "$x \\in (-\\infty; 2)$"}, {"id": "G11_TB_8_1_7_27_1", "current_skill": "G11_S01_01", "q": "Решите неравенство: $4^{2x-7} > 2^{3x+1}$.", "key": "$x \\in (15; +\\infty)$"}, {"id": "G11_TB_8_1_7_27_4", "current_skill": "G11_S01_01", "q": "Решите неравенство: $8^{x+1} > 64^{x}$.", "key": "$x < 1$"}, {"id": "G11_TB_8_1_7_28_2", "current_skill": "G11_S01_01", "q": "Решите неравенство: $\\left(\\dfrac{2}{7}\\right)^{3-x} < \\left(\\dfrac{7}{2}\\right)^{3x-1}$.", "key": "$x \\in (-1; +\\infty)$"}, {"id": "G11_TB_8_1_7_28_3", "current_skill": "G11_S01_01", "q": "Решите неравенство: $\\left(\\dfrac{3}{4}\\right)^{1-2x} > \\left(\\dfrac{4}{3}\\right)^{x+5}$.", "key": "$x \\in (6; +\\infty)$"}, {"id": "G11_TB_8_1_7_28_4", "current_skill": "G11_S01_01", "q": "Решите неравенство: $\\left(\\dfrac{2}{3}\\right)^{3x-7} > \\left(\\dfrac{3}{2}\\right)^{4x+1}$.", "key": "$x \\in (-\\infty; \\dfrac{6}{7})$"}, {"id": "G11_TB_8_2_8_2", "current_skill": "G11_S01_01", "q": "Объясните, в результате какого преобразования переход от первого уравнения ко второму приводит к появлению посторонних корней. Подберите корень второго уравнения, посторонний для первого уравнения:\n$x=2$, $x^{2}=4$", "key": "Возведение в квадрат; $x=-2$"}, {"id": "G11_TB_8_3_8_6_b", "current_skill": "G11_S01_01", "q": "Докажите утверждение о возведении уравнения в чётную степень: если $2m$ ($m \\in \\mathbb{N}$) — чётное натуральное число, то следствием уравнения $f(x) = g(x)$ является уравнение $(f(x))^{2m} = (g(x))^{2m}$.", "key": "Если $x_{0}$ — корень уравнения $f(x) = g(x)$, то $f(x_{0})$ и $g(x_{0})$ — одно и то же число, а равные числа имеют рав"}, {"id": "G11_TB_8_5_8_21_2.1", "current_skill": "G11_S01_01", "q": "Какое доказательство верно? Докажите, что следствием уравнения $f(x)+\\varphi(x)-\\varphi(x)=0$ является уравнение $f(x)=0$.", "key": "Пусть $x_{0}$ — корень исходного уравнения. Тогда $\\varphi(x_{0})$ — число, поэтому из $f(x_{0})+\\varphi(x_{0})-\\varphi("}, {"id": "G11_TB_8_5_8_21_2.2", "current_skill": "G11_S01_01", "q": "Какое доказательство верно? Докажите, что следствием уравнения $\\dfrac{f(x)}{g(x)}=0$ является уравнение $f(x)=0$.", "key": "Пусть $x_{0}$ — корень исходного уравнения. Дробь $\\dfrac{f(x_{0})}{g(x_{0})}$ определена и равна нулю, значит, $f(x_{0}"}, {"id": "G11_TB_8_5_8_21_2.3", "current_skill": "G11_S01_01", "q": "Какое доказательство верно? Пусть левая часть формулы определена на множестве $M_{1}$, правая — на множестве $M_{2}$, $M_{1}\\subset M_{2}$. Докажите, что замена в уравнении левой части формулы правой даёт уравнение-следствие.", "key": "Пусть $x_{0}$ — корень исходного уравнения. Тогда левая часть формулы определена в $x_{0}$, то есть $x_{0}\\in M_{1}\\subs"}, {"id": "G11_TB_8_5_8_26", "current_skill": "G11_S01_01", "q": "Решите уравнение:\n$\\dfrac{\\sin 2x}{\\cos 2x} = \\dfrac{\\sin x}{\\cos x}$", "key": "$x = \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_2_9_2.1", "current_skill": "G11_S01_01", "q": "В каком случае две системы называют равносильными?", "key": "Если множества их решений совпадают"}, {"id": "G11_TB_9_2_9_2.2", "current_skill": "G11_S01_01", "q": "В каком случае уравнение (неравенство) называют равносильным системе?", "key": "Если множество его решений совпадает с множеством решений системы"}, {"id": "G11_TB_9_3_9_20_г", "current_skill": "G11_S01_01", "q": "Решите уравнение: $(\\ctg x - 1) \\sin x = 0$", "key": "$x = \\dfrac{\\pi}{4} + \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_4*_9_23_б", "current_skill": "G11_S01_01", "q": "Решите уравнение: $\\dfrac{\\sin 2x}{\\sin x} + \\dfrac{\\cos 2x}{\\cos x} = 0$", "key": "$x = \\pm\\dfrac{\\pi}{3} + \\pi n$, $n \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_4*_9_24_a", "current_skill": "G11_S01_01", "q": "Докажите, что равносильны уравнение $\\log_{a} f(x) + \\log_{a} g(x) = \\log_{a}(f(x) \\cdot g(x))$ и система $\\begin{cases} f(x) > 0 \\\\ g(x) > 0 \\end{cases}$, где $a > 0$, $a \\ne 1$.", "key": "Если $x_{0}$ — корень уравнения, то определены $\\log_{a} f(x_{0})$ и $\\log_{a} g(x_{0})$, т. е. $f(x_{0}) > 0$ и $g(x_{0"}, {"id": "G11_TB_9_6_9_50_а", "current_skill": "G11_S01_01", "q": "Решите неравенство: $9^{x} + 1 + \\operatorname{ctg}\\left(\\pi \\dfrac{x}{2}\\right) < 10 \\cdot 3^{x-1} + \\operatorname{ctg}\\left(\\pi \\dfrac{x}{2}\\right)$", "key": "$x \\in (-1; 0) \\cup (0; 1)$"}, {"id": "G11_TB_9_6_9_50_б", "current_skill": "G11_S01_01", "q": "Решите неравенство: $4^{x} + 2 + \\operatorname{tg}\\left(\\pi \\dfrac{x}{2}\\right) < 9 \\cdot 2^{x-1} + \\operatorname{tg}\\left(\\pi \\dfrac{x}{2}\\right)$", "key": "$x \\in (-1; 1) \\cup (1; 2)$"}, {"id": "G11_TB_9_7*_9_57_4", "current_skill": "G11_S01_01", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}25}(2-x)}{\\log_{4}(x-4)} < 0$", "key": "$\\varnothing$"}, {"id": "G11_TB_?_207_1", "current_skill": "G11_S01_01", "q": "Решите неравенство: $3 \\cdot 4^{\\sqrt{2-x}} + 3 < 10 \\cdot 2^{\\sqrt{2-x}}$", "key": "$x \\in (2 - (\\log_{2}3)^{2}; 2]$"}, {"id": "G11_TB_?_214_2", "current_skill": "G11_S01_01", "q": "Решите неравенство:\n$27^{x} + 24 \\geq 2(7 + \\sqrt{22})^{x} + 12(7 - \\sqrt{22})^{x}$", "key": "$x \\in (-\\infty; \\log_{7-\\sqrt{22}}(2)] \\cup [\\log_{7+\\sqrt{22}}(12); +\\infty)$"}, {"id": "G11_TB_?_214_3", "current_skill": "G11_S01_01", "q": "Решите неравенство: $x \\le \\log_{5}(16 \\cdot 15^{x} - 15^{1+2x}) - \\log_{3}(16 \\cdot 5^{x} - 3^{1+x} \\cdot 5^{1+2x})$", "key": "$x \\in (-\\infty; -1] \\cup [0; \\log_{15} 16 - 1)$"}, {"id": "G11_TB_?_215", "current_skill": "G11_S01_01", "q": "Решите неравенство: $2^{\\lg(x^{2}-1)} \\ge (x+1)^{\\lg 2}$", "key": "$x \\in [2; +\\infty)$"}, {"id": "G11_TB_?_34_1", "current_skill": "G11_S01_01", "q": "Первый, второй и четвёртый члены арифметической прогрессии одновременно являются соответственно первым, вторым и третьим членами некоторой геометрической прогрессии. Найдите все значения, которые может принимать знаменатель геометрической прогрессии.", "key": "$1; 2$"}, {"id": "G11_TB_?_34_2", "current_skill": "G11_S01_01", "q": "Первый, четвёртый и пятый члены арифметической прогрессии одновременно являются соответственно первым, вторым и третьим членами некоторой геометрической прогрессии. Найдите все значения, которые может принимать знаменатель геометрической прогрессии.", "key": "$1; \\dfrac{1}{3}$"}, {"id": "G11_TB_?_66", "current_skill": "G11_S01_01", "q": "Докажите, что при нечётных $p$ и $q$ уравнение $x^{2}+px+q=0$ не имеет рациональных корней.", "key": "Рациональный корень приведённого уравнения с целыми коэффициентами — целое число $r$, и $q = -r(r + p)$; но при нечётном"}, {"id": "G11_TB_?_67", "current_skill": "G11_S01_01", "q": "При каких целых значениях $k$ являются рациональными числами корни уравнения $kx^{2}-(1-2k)x+k-2=0$?", "key": "$k=n(n+1)$, $n\\in\\mathbb{Z}$ (то есть $k=0;\\ 2;\\ 6;\\ 12;\\ 20;\\ \\ldots$)"}, {"id": "G11_TB_§16_3", "current_skill": "G11_S01_01", "q": "Используя график функции $y=\\log_{a}{x}$ ($a>0$, $a\\neq 1$), охарактеризуйте её свойства.", "key": "Область определения: $x > 0$. Множество значений: $y \\in \\mathbb{R}$. При $a > 1$ функция возрастает, при $0 < a < 1$ уб"}, {"id": "G11_TB_§16_5", "current_skill": "G11_S01_01", "q": "Сравните с единицей положительное число: $a$, зная, что $\\log_{a}{6} < 0$", "key": "$0 < a < 1$"}, {"id": "G11_TB_§19_1", "current_skill": "G11_S01_01", "q": "Решите уравнение: $|x-3|^{3x^{2}-10x+3}=1$.", "key": "$\\dfrac{1}{3}; 2; 4$"}, {"id": "G11_TB_§19_15_1", "current_skill": "G11_S01_01", "q": "Решите уравнение: $3 \\cdot 2^{x+2} + 5^{x} = 8 \\cdot 3^{x} + 5$", "key": "$0$; $1$; $3$"}, {"id": "G11_TB_§19_15_2", "current_skill": "G11_S01_01", "q": "Решите уравнение: $3 \\cdot 2^{x} - 3^{x+1} + 4^{x} = 1$", "key": "$0$; $1$; $2$"}, {"id": "G11_TB_§19_1_1", "current_skill": "G11_S01_01", "q": "Решите уравнение: $x^{\\lg x} = x^{3}$", "key": "$x = 1$, $x = 1000$"}, {"id": "G11_TB_§19_1_9", "current_skill": "G11_S01_01", "q": "Решите уравнение: $2x^{2\\lg(x-1)} = 1 + (x-1)^{\\lg x}$", "key": "$x = 2$"}, {"id": "G11_TB_§19_3_1", "current_skill": "G11_S01_01", "q": "Решите неравенство: $(x^{2}-x+1)^{x^{2}-2{,}5x+1}<1$", "key": "$x \\in (0; 0{,}5) \\cup (1; 2)$"}, {"id": "G11_TB_§19_3_4", "current_skill": "G11_S01_01", "q": "Решите неравенство: $x^{\\log_{a} x + 4} < a^{4} x$", "key": "при $a>1$: $x\\in(a^{-4}; a)$; при $0<a<1$: $x\\in(0; a)\\cup(a^{-4}; +\\infty)$"}, {"id": "G11_TB_§19_3_5", "current_skill": "G11_S01_01", "q": "Решите неравенство: $x^{3+\\log_{a} x} > a^{2} x^{2}$", "key": "при $a>1$: $x\\in(0; a^{-2})\\cup(a; +\\infty)$; при $0<a<1$: $x\\in(a; a^{-2})$"}, {"id": "G11_TB_§19_4", "current_skill": "G11_S01_01", "q": "Решите неравенство $|x-4|^{\\lg(x-2)} \\geq |x-4|^{\\lg(6-x)}$.", "key": "$[3; 4] \\cup [5; 6)$"}, {"id": "G11_TB_§19_5", "current_skill": "G11_S01_01", "q": "Решите неравенство $x^{\\log_{a} x + 1} > a^{2} x$.", "key": "При $a>1$: $x \\in (0; a^{-\\sqrt{2}}) \\cup (a^{\\sqrt{2}}; +\\infty)$; при $0<a<1$: $x \\in (a^{\\sqrt{2}}; a^{-\\sqrt{2}})$"}, {"id": "G11_TB_§1_1_2.1", "current_skill": "G11_S01_01", "q": "Выпишите основные элементарные функции $f(x)$ и $g(x)$, с помощью которых задана сложная функция $f(g(x))=\\sqrt{\\lg x}$.", "key": "$f(x)=\\sqrt{x}$, $g(x)=\\lg x$"}, {"id": "G11_TB_§1_1_2.2", "current_skill": "G11_S01_01", "q": "Выпишите основные элементарные функции $f(x)$ и $g(x)$, с помощью которых задана сложная функция $f(g(x))=\\ln x^{4}$.", "key": "$f(x)=\\ln x$, $g(x)=x^{4}$"}, {"id": "G11_TB_§1_1_3.1", "current_skill": "G11_S01_01", "q": "Выпишите основные элементарные функции $f(x)$, $g(x)$ и $\\varphi(x)$, с помощью которых задана сложная функция $f(g(\\varphi(x)))=\\sin\\sqrt{x^{3}}$.", "key": "$\\varphi(x)=x^{3}$, $g(x)=\\sqrt{x}$, $f(x)=\\sin x$"}, {"id": "G11_TB_§1_1_3.2", "current_skill": "G11_S01_01", "q": "Выпишите основные элементарные функции $f(x)$, $g(x)$ и $\\varphi(x)$, с помощью которых задана сложная функция $f(g(\\varphi(x)))=\\left(\\sqrt{\\sin x}\\right)^{3}$.", "key": "$\\varphi(x)=\\sin x$, $g(x)=\\sqrt{x}$, $f(x)=x^{3}$"}, {"id": "G11_TB_§1_1_4_2", "current_skill": "G11_S01_01", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\varphi(x)=x^{2}$, $g(x)=\\log_{5}{x}$. Запишите сложную функцию:\n$\\varphi(g(x))$", "key": "$(\\log_{5}{x})^{2}$"}, {"id": "G11_TB_§20_3_3", "current_skill": "G11_S01_01", "q": "Решите уравнение: $2\\lg^{2}(2x-1) = \\lg^{2}(2x+1) - \\lg(2x-1)\\lg(2x+1)$", "key": "$1{,}5$; $\\dfrac{\\sqrt{2}}{2}$"}, {"id": "G11_TB_§2_5_3", "current_skill": "G11_S01_01", "q": "Решите неравенство методом интервалов: $\\dfrac{3x^{2}-2x-1}{\\sqrt{x-3}-1}<0$", "key": "$x \\in [3; 4)$"}, {"id": "G11_TB_10_4*_16_a", "current_skill": "G11_S01_02", "q": "Решите уравнение: $(x+1)(x^{2}+1)(x^{4}+1)(x^{8}+1)=\\dfrac{x^{16}+x^{2}-5x+3}{x-1}$", "key": "$4$"}, {"id": "G11_TB_10_4*_16_б", "current_skill": "G11_S01_02", "q": "Решите уравнение: $(x-1)(x^{2}+1)(x^{4}+1)(x^{8}+1)=\\dfrac{x^{16}+x^{2}+5x+3}{x+1}$", "key": "$-4$"}, {"id": "G11_TB_10_4*_17_б", "current_skill": "G11_S01_02", "q": "Решите уравнение: $(x+1)(x^{2}+1)(x^{4}+1)=x^{7}$", "key": "Нет действительных корней"}, {"id": "G11_TB_10_4*_18_г", "current_skill": "G11_S01_02", "q": "Решите уравнение: $$\\dfrac{\\sqrt{2x+4}-\\sqrt{x}}{\\sqrt{x^{2}+3}+\\sqrt{x}}=\\dfrac{\\sqrt{x^{2}+3}-\\sqrt{x}}{\\sqrt{2x+4}+\\sqrt{x}}$$", "key": "$1+\\sqrt{2}$"}, {"id": "G11_TB_10_4*_20_г", "current_skill": "G11_S01_02", "q": "Решите уравнение: $5^{2x-1} + 2^{2x} = 25^{x} - 4^{x+1}$", "key": "$x=1$"}, {"id": "G11_TB_10_4*_22_a", "current_skill": "G11_S01_02", "q": "Решите уравнение: $4\\cos x \\cos 2x = 1$", "key": "$x = \\pm\\dfrac{2\\pi}{3} + 2\\pi k$; $x = \\pm\\dfrac{\\pi}{5} + 2\\pi k$; $x = \\pm\\dfrac{3\\pi}{5} + 2\\pi k$, $k \\in \\mathbb{Z"}, {"id": "G11_TB_10_4*_22_б", "current_skill": "G11_S01_02", "q": "Решите уравнение: $4\\cos x \\cos 2x = -1$", "key": "$x = \\pm\\dfrac{\\pi}{3} + 2\\pi k$; $x = \\pm\\dfrac{2\\pi}{5} + 2\\pi k$; $x = \\pm\\dfrac{4\\pi}{5} + 2\\pi k$, $k \\in \\mathbb{Z"}, {"id": "G11_TB_10_6*_10_31_1", "current_skill": "G11_S01_02", "q": "Решите уравнение: $\\sqrt[3]{x^{2}+x\\sqrt{x}+7x+27\\sqrt{x}+24}=\\sqrt{x}+3$", "key": "$3$"}, {"id": "G11_TB_10_6*_10_33_1", "current_skill": "G11_S01_02", "q": "Решите уравнение:\n$\\sqrt{\\dfrac{x-3}{x+2}} + \\sqrt{\\dfrac{x+2}{x-3}} = \\dfrac{7}{\\sqrt{(x+2)(x-3)}}$", "key": "$-3; 4$"}, {"id": "G11_TB_11_1_10_49_a", "current_skill": "G11_S01_02", "q": "Найдите все решения уравнения: $\\sin^{2}{x} - \\sin{2x} - 3\\cos^{2}{x} = 0$, принадлежащие промежутку $(-\\dfrac{\\pi}{2}; \\dfrac{\\pi}{2})$.", "key": "$x = -\\dfrac{\\pi}{4}$; $x = \\operatorname{arctg} 3$"}, {"id": "G11_TB_11_1_10_52_a", "current_skill": "G11_S01_02", "q": "Найдите все решения уравнения $(x - \\log_{3}{75})(x - \\log_{2}{22}) = 0$, принадлежащие промежутку $[3; 4]$.", "key": "$\\log_{3} 75$"}, {"id": "G11_TB_11_5*_11_26_а", "current_skill": "G11_S01_02", "q": "Решите неравенство: $\\log_{3} 243 \\cdot \\log_{0{,}8}(3x-5) > 0$", "key": "$x \\in \\left(\\dfrac{5}{3}; 2\\right)$"}, {"id": "G11_TB_11_5*_11_30_а", "current_skill": "G11_S01_02", "q": "Решите неравенство: $(2\\sqrt{x}+1)^{2}>5x^{2}+4\\sqrt{x}-63$", "key": "$x \\in [0; 4)$"}, {"id": "G11_TB_11_6*_11_42*_б", "current_skill": "G11_S01_02", "q": "Решите неравенство: $2\\lg(x+3)<\\lg(x+5)$", "key": "$x \\in (-3; -1)$"}, {"id": "G11_TB_11_7*_11_49_1", "current_skill": "G11_S01_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $(x - \\log_{3}{75})(x - \\log_{2}{22}) > 0$, $[3; 4]$", "key": "$[3; \\log_{3}{75})$"}, {"id": "G11_TB_11_7*_11_49_2", "current_skill": "G11_S01_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $(x - \\log_{2}{17})(x - \\log_{2}{71}) < 0$, $[4; 5]$", "key": "$x \\in (\\log_{2}17; 5]$"}, {"id": "G11_TB_11_7*_11_51_1", "current_skill": "G11_S01_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $\\sin 2x + \\dfrac{\\sqrt{2}}{2} > \\cos x + \\sqrt{2} \\sin x$, $\\left[\\dfrac{2\\pi}{3}; \\dfrac{4\\pi}{3}\\right]$", "key": "$\\left(\\dfrac{5\\pi}{6}; \\dfrac{4\\pi}{3}\\right]$"}, {"id": "G11_TB_11_7*_11_52_2", "current_skill": "G11_S01_02", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $\\sin\\left(\\pi\\dfrac{x}{3}\\right) + \\sqrt{2}\\cos\\left(\\pi\\dfrac{x}{6}\\right) + \\sqrt{3}\\sin\\left(\\pi\\dfrac{x}{6}\\right) + \\dfrac{\\sqrt{6}}{2} < 0$, $[5; 13]$", "key": "$(5; 7) \\cup (7{,}5; 10{,}5)$"}, {"id": "G11_TB_12_1_11_59_a", "current_skill": "G11_S01_02", "q": "Решите неравенство: $0{,}0625 \\cdot 4^{x} \\leq 64^{\\frac{1}{x}}$", "key": "$x \\in (-\\infty; -1] \\cup (0; 3]$"}, {"id": "G11_TB_12_1_11_60_a", "current_skill": "G11_S01_02", "q": "Решите неравенство: $\\sqrt{27} \\cdot 3^{-6x^{2}} \\geq 9^{4x}$", "key": "$x \\in [-1{,}5; \\dfrac{1}{6}]$"}, {"id": "G11_TB_12_1_11_60_b", "current_skill": "G11_S01_02", "q": "Решите неравенство: $4 \\cdot \\left(\\dfrac{1}{2}\\right)^{5x^{2}} \\leq \\left(\\dfrac{1}{8}\\right)^{-3x}$", "key": "$x \\in (-\\infty; -2] \\cup [0{,}2; +\\infty)$"}, {"id": "G11_TB_12_1_11_60_v", "current_skill": "G11_S01_02", "q": "Решите неравенство: $\\sqrt{32} \\cdot 2^{-4x^{2}} \\geq 8^{3x}$", "key": "$x \\in [-2{,}5; 0{,}25]$"}, {"id": "G11_TB_13_3*_13_6_b", "current_skill": "G11_S01_02", "q": "Решите уравнение: $(\\log_{3}(x-2)-\\sin(\\pi\\dfrac{x}{2}))^{2}+(x-5)^{2}=0$", "key": "$5$"}, {"id": "G11_TB_14_1_14_2.1", "current_skill": "G11_S01_02", "q": "Является ли пара чисел $(1; 2)$ решением системы $\\begin{cases}x-y=-1,\\\\ x^{2}-xy=1?\\end{cases}$", "key": "нет"}, {"id": "G11_TB_14_1_14_2.2", "current_skill": "G11_S01_02", "q": "Является ли пара чисел $(1; 2)$ решением системы $\\begin{cases}xy+x^{2}=6,\\\\ 2x+y=4?\\end{cases}$", "key": "нет"}, {"id": "G11_TB_14_1_14_4", "current_skill": "G11_S01_02", "q": "Решите уравнение: $5^{x} - 2 \\cdot 5^{x-2} = 23$.", "key": "$2$"}, {"id": "G11_TB_14_1_2_1", "current_skill": "G11_S01_02", "q": "Решите уравнение: $\\dfrac{(0{,}2)^{x-0{,}5}}{\\sqrt{5}}=5 \\cdot (0{,}04)^{x-2}$", "key": "$5$"}, {"id": "G11_TB_14_2_14_11", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx + 2y = 13; \\\\\n2\\log_{4} x - \\log_{4}(2y - 1) = 0{,}5.\n\\end{cases}\n$$", "key": "$x = 4$, $y = 4{,}5$"}, {"id": "G11_TB_14_2_14_13", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx^{2} + xy + y^{2} = 13 \\\\\nx + y = 4\n\\end{cases}\n$$", "key": "$(1; 3)$, $(3; 1)$"}, {"id": "G11_TB_14_2_14_14", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n\n$$\n\\begin{cases}\n2x^{2} + y^{2} - 4x + 2y = 1 \\\\\n3x^{2} - 2y^{2} - 6x - 4y = 5\n\\end{cases}\n$$", "key": "$(1 + \\sqrt{2}; -1); (1 - \\sqrt{2}; -1)$"}, {"id": "G11_TB_14_2_14_15", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n3x^{2} + 2xy - 9x - 4y = -6 \\\\\n5x^{2} + 2xy - 12x - 4y = -4\n\\end{cases}\n$$", "key": "$(-\\dfrac{1}{2}; \\dfrac{9}{4})$, $(2; y)$, $y \\in \\mathbb{R}$"}, {"id": "G11_TB_14_2_14_2", "current_skill": "G11_S01_02", "q": "Решите уравнение $25^{x+\\frac{1}{2}}-10 \\cdot 5^{x-1}-3=0$.", "key": "$0$"}, {"id": "G11_TB_14_2_14_2_2", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\dfrac{x^{2}+y^{2}}{xy}=2,\\\\\n\\dfrac{x^{3}-y^{2}}{xy}=1.\n\\end{cases}\n$$", "key": "$(2; 2)$"}, {"id": "G11_TB_14_2_14_2_4", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n2^{\\log_{2}(xy)} = x^{2} y - 2,\\\\\n3x^{2} y^{2} = x^{2} y + 2.\n\\end{cases}\n$$", "key": "$\\left(\\dfrac{5}{2}; \\dfrac{8}{15}\\right)$"}, {"id": "G11_TB_14_2_14_2_5", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\sqrt{x^{2} 