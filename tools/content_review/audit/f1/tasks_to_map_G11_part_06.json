[{"id": "G11_TB_§16_16_6.2", "current_skill": "G11_S01_02", "q": "Сравните число $\\log_{0{,}5}0{,}6$ с единицей.", "key": "$\\log_{0{,}5}0{,}6<1$"}, {"id": "G11_TB_§16_16_6.3", "current_skill": "G11_S01_02", "q": "Сравните число $\\log_{0{,}3}0{,}2$ с единицей.", "key": "$\\log_{0{,}3}0{,}2>1$"}, {"id": "G11_TB_§16_4_10", "current_skill": "G11_S01_02", "q": "Сравните числа: $\\log_{\\frac{1}{4}}\\left(\\dfrac{1}{5}\\right)$ и $1$.", "key": "$\\log_{\\frac{1}{4}} \\left(\\dfrac{1}{5}\\right) > 1$"}, {"id": "G11_TB_§16_4_7", "current_skill": "G11_S01_02", "q": "Сравните числа: $\\log_{2}{3}$ и $0$.", "key": "$\\log_{2}{3} > 0$"}, {"id": "G11_TB_§16_4_8", "current_skill": "G11_S01_02", "q": "Сравните числа: $\\log_{7}\\left(\\dfrac{1}{3}\\right)$ и $0$.", "key": "$\\log_{7}\\left(\\dfrac{1}{3}\\right) < 0$"}, {"id": "G11_TB_§16_4_9", "current_skill": "G11_S01_02", "q": "Сравните числа: $\\log_{3}{4}$ и $1$.", "key": "$\\log_{3}{4} > 1$"}, {"id": "G11_TB_§19_17_3", "current_skill": "G11_S01_02", "q": "Сравните числа: $(\\lg5)^{3}$ и $3^{\\lg5}$", "key": "$(\\lg 5)^{3} < 3^{\\lg 5}$"}, {"id": "G11_TB_§19_1_2", "current_skill": "G11_S01_02", "q": "Решите уравнение: $x^{2\\lg x} - 10x = 0$", "key": "$x = 10$, $x = 10^{-\\frac{1}{2}}$"}, {"id": "G11_TB_§19_1_3", "current_skill": "G11_S01_02", "q": "Решите уравнение: $x^{2\\log_{16}x} = \\dfrac{64}{\\sqrt{x}}$", "key": "$x = \\dfrac{1}{16}$, $x = 8$"}, {"id": "G11_TB_§19_1_6", "current_skill": "G11_S01_02", "q": "Решите уравнение: $\\left|x-1\\right|^{x^{2}-1}=1$", "key": "$x = -1$, $x = 0$, $x = 2$"}, {"id": "G11_TB_§19_1_7", "current_skill": "G11_S01_02", "q": "Решите уравнение: $\\left(\\dfrac{1}{9}\\right)^{\\log_{3}\\sqrt{x+1}-\\dfrac{1}{2}\\log_{3}(x^{2}-1)}=\\sqrt{2(x-1)}$", "key": "$x = 3$"}, {"id": "G11_TB_§19_1_8", "current_skill": "G11_S01_02", "q": "Решите уравнение: $4^{\\log_{4}^{2}x} + x^{\\log_{4} x} = 8$", "key": "$x = \\dfrac{1}{4}$; $x = 4$"}, {"id": "G11_TB_§19_2_1", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx^{\\log_{5} y} + y^{\\log_{5} x} = 50, \\\\\n\\log_{25} x + \\log_{25} y = 1{,}5\n\\end{cases}\n$$", "key": "$(5; 25)$, $(25; 5)$"}, {"id": "G11_TB_§19_2_2", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx^{\\log_{2} y} + y^{\\log_{2} x} = 16, \\\\\n\\log_{2} x - \\log_{2} y = 2\n\\end{cases}\n$$", "key": "$(8; 2)$, $\\left(\\dfrac{1}{2}; \\dfrac{1}{8}\\right)$"}, {"id": "G11_TB_§19_3", "current_skill": "G11_S01_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nx^{\\log_{3} y} + y^{\\log_{3} x} = 18, \\\\\n\\log_{3} x + \\log_{3} y = 3.\n\\end{cases}\n$$", "key": "$x=3, y=9; x=9, y=3$"}, {"id": "G11_TB_§1_1_4_1", "current_skill": "G11_S01_02", "q": "Даны элементарные функции: $f(x)=7^{x}$, $\\varphi(x)=x^{2}$, $g(x)=\\log_{5}{x}$. Запишите сложную функцию:\n$f(\\varphi(x))$", "key": "$7^{x^{2}}$"}, {"id": "G11_TB_§20_1", "current_skill": "G11_S01_02", "q": "Решите уравнение $(\\sqrt{2-\\sqrt{3}})^{x}+(\\sqrt{2+\\sqrt{3}})^{x}=4$.", "key": "$-2; 2$"}, {"id": "G11_TB_§20_1_1", "current_skill": "G11_S01_02", "q": "Вычислите: $10\\log_{\\sqrt{2}}\\log_{\\sqrt{2}}\\sqrt{\\sqrt{\\sqrt{2}}}$", "key": "$-40$"}, {"id": "G11_TB_§20_1_3", "current_skill": "G11_S01_02", "q": "Решите уравнение: $3^{x}+4^{x}=5^{x}$", "key": "$x=2$"}, {"id": "G11_TB_§20_1_5", "current_skill": "G11_S01_02", "q": "Решите уравнение: $\\log_{3}(x+5)=\\log_{\\frac{1}{2}}x+4$", "key": "$x=4$"}, {"id": "G11_TB_§20_2", "current_skill": "G11_S01_02", "q": "Решите уравнение $4^{x} + \\left( \\dfrac{1}{4} \\right)^{x} + 2^{x} - \\left( \\dfrac{1}{2} \\right)^{x} - 4 = 0$.", "key": "$x = \\log_{2}\\dfrac{1+\\sqrt{5}}{2}$; $x = \\log_{2}(\\sqrt{2}-1)$"}, {"id": "G11_TB_§20_2_3", "current_skill": "G11_S01_02", "q": "Решите уравнение: $(\\sqrt{2-\\sqrt{3}})^{x} + (\\sqrt{2+\\sqrt{3}})^{x} = 2^{x}$", "key": "$x=2$"}, {"id": "G11_TB_§20_5", "current_skill": "G11_S01_02", "q": "Решите уравнение $\\lg^{2}(x+1)=\\lg(x+1)\\lg(x-1)+2\\lg^{2}(x-1)$.", "key": "$x = 3$; $x = \\sqrt{2}$"}, {"id": "G11_TB_§20_5_3", "current_skill": "G11_S01_02", "q": "Найдите: $\\log_{b^{6}}(a^{6}b^{6})$, если $\\log_{a}b = 6$.", "key": "$\\dfrac{7}{6}$"}, {"id": "G11_TB_§20_7_1", "current_skill": "G11_S01_02", "q": "Сравните значения данных числовых выражений: $\\log_{0{,}5}\\left(\\dfrac{7}{4}\\right)$ и $\\log_{0{,}125}\\left(\\dfrac{7}{164}\\right)$", "key": "$\\log_{0{,}5} \\left(\\dfrac{7}{4}\\right) < \\log_{0{,}125} \\left(\\dfrac{7}{164}\\right)$"}, {"id": "G11_TB_§20_7_2", "current_skill": "G11_S01_02", "q": "Сравните значения данных числовых выражений: $\\sqrt{15}$ и $8^{\\frac{1}{3}\\log_{2}\\left(1-\\frac{1}{32}\\right) \\cdot 2\\log_{27} 3}$", "key": "$\\sqrt{15} > 8^{\\frac{1}{3} \\log_{2} \\left(1 - \\frac{1}{32}\\right) \\cdot 2 \\log_{27} 3}$"}, {"id": "G11_TB_§20_8_1", "current_skill": "G11_S01_02", "q": "Сравните значения данных числовых выражений: $7^{\\log_{5} 2} - 0{,}1$ и $2^{\\log_{5} 7}$", "key": "$7^{\\log_{5} 2} - 0{,}1 < 2^{\\log_{5} 7}$"}, {"id": "G11_TB_§20_8_2", "current_skill": "G11_S01_02", "q": "Сравните значения данных числовых выражений: $5^{\\log_{3}7} + 0{,}1$ и $7^{\\log_{3}5}$", "key": "$5^{\\log_{3} 7} + 0{,}1 > 7^{\\log_{3} 5}$"}, {"id": "G11_TB_§20_8_3", "current_skill": "G11_S01_02", "q": "Сравните значения данных числовых выражений: $2^{\\log_{7}3} + 0{,}1$ и $3^{\\log_{7}2}$", "key": "$2^{\\log_{7}3} + 0{,}1 > 3^{\\log_{7}2}$"}, {"id": "G11_TB_10_1_2", "current_skill": "G11_S01_03", "q": "Решите уравнение $x^{7} - 42x^{2} - x + 42 = 0$.", "key": "$-1; 1; 2$"}, {"id": "G11_TB_10_3*_10_6_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[4]{x^{2}-5} = \\sqrt[4]{5x+9}$", "key": "$7$"}, {"id": "G11_TB_10_3*_10_6_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[4]{2x^{2}-1} = \\sqrt[4]{3x-2}$", "key": "$1$"}, {"id": "G11_TB_10_3*_10_7_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{x-1}=x-4$", "key": "$\\dfrac{9+\\sqrt{13}}{2}$"}, {"id": "G11_TB_10_3*_10_7_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{x+3}=x+2$", "key": "$\\dfrac{-3+\\sqrt{5}}{2}$"}, {"id": "G11_TB_10_3*_10_7_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{x} = x - 1$", "key": "$\\dfrac{3+\\sqrt{5}}{2}$"}, {"id": "G11_TB_10_3*_10_9*_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{2 - 2\\sin\\left(\\dfrac{x}{2}\\right)} = 1$", "key": "$x = \\dfrac{\\pi}{3} + 4\\pi k, k \\in \\mathbb{Z}; x = \\dfrac{5\\pi}{3} + 4\\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_3*_10_9*_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt{2\\cos(3x)+2}=1$", "key": "$x = \\dfrac{2\\pi}{9} + \\dfrac{2\\pi k}{3}, k \\in \\mathbb{Z}; x = \\dfrac{4\\pi}{9} + \\dfrac{2\\pi n}{3}, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_4*_17_a", "current_skill": "G11_S01_03", "q": "Решите уравнение: $(x-1)(x^{2}+1)(x^{4}+1)=x^{7}$", "key": "нет действительных корней"}, {"id": "G11_TB_10_4*_19_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{2\\sin x}{\\sqrt{3-2x-x^{2}}}=\\dfrac{\\sqrt{2}}{\\sqrt{3-2x-x^{2}}}$", "key": "$\\dfrac{\\pi}{4}$"}, {"id": "G11_TB_10_4*_20_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $6^{x} \\cdot 5^{x-2} = 9 \\cdot 2^{x}$", "key": "$2$"}, {"id": "G11_TB_10_4*_20_д", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{2^{x+1}+2\\cdot3^{x}}{2^{x}}=\\dfrac{3\\cdot2^{x}+3^{x+1}}{3^{x}}$", "key": "$x=1$"}, {"id": "G11_TB_10_4*_5", "current_skill": "G11_S01_03", "q": "Решим уравнение $$2\\operatorname{\\ctg}x = \\dfrac{1}{\\cos^{2}x}. \\tag{11}$$ Все решения уравнения (11) содержатся во множестве $M$ всех $x \\neq \\dfrac{\\pi k}{2}$, $k \\in \\mathbb{Z}$. Так как в каждой точке множества $M$ определены обе", "key": "$x = \\dfrac{\\pi}{4} + \\pi k, \\, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_5*_10_25_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2} x = \\log_{4} (x+2)$", "key": "$2$"}, {"id": "G11_TB_10_5*_10_25_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{9}(x+8) = \\log_{3}(x+2)$", "key": "$1$"}, {"id": "G11_TB_10_5*_10_25_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{25}(9x+7)=\\log_{5}(3+x)$", "key": "$1$; $2$"}, {"id": "G11_TB_10_5*_10_25_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{4}(x+9) = \\log_{2}(x-3)$", "key": "$7$"}, {"id": "G11_TB_10_5*_10_25_д", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(x+3) - \\log_{\\frac{1}{2}}(x+3) = 4$", "key": "$1$"}, {"id": "G11_TB_10_5*_10_25_е", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{3}(x+2) - \\log_{\\frac{1}{3}}(x+2) = 2$", "key": "$1$"}, {"id": "G11_TB_10_5*_10_26*_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{\\log_{\\sqrt{x}} 2x} = 4$", "key": "$\\varnothing$"}, {"id": "G11_TB_10_5*_10_26*_г", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{2 - \\lg^{2} x - \\lg x^{2}} - \\dfrac{1}{x} = 0$", "key": "$0{,}001$; $1$; $10$"}, {"id": "G11_TB_10_5*_10_27_в", "current_skill": "G11_S01_03", "q": "Решите уравнение: $x^{2} + \\log_{4}{x} = 7x + \\log_{4}{x}$", "key": "$7$"}, {"id": "G11_TB_10_5*_10_28_а", "current_skill": "G11_S01_03", "q": "Решите уравнение: $4^{\\log_{4}(2x+1)} = x^{2} + 3x - 5$", "key": "$2$"}, {"id": "G11_TB_10_5*_10_30*_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{1 - \\tg^{2} x}{1 + \\tg^{2} x} = \\cos x - 1$", "key": "$\\pm \\dfrac{\\pi}{3} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_5*_5", "current_skill": "G11_S01_03", "q": "Решим уравнение $\\sqrt{x-1}+x^{2+\\log_{2} x}=\\sqrt{x-1}+8.$", "key": "$2$"}, {"id": "G11_TB_10_6*_10_32_2", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$2\\sqrt{3x+7}=3\\sqrt{2x+2}+2$", "key": "$5-4\\sqrt{2}$"}, {"id": "G11_TB_10_6*_10_32_4", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$\\sqrt{2x-1} - \\sqrt{x} = 1$", "key": "$4+2\\sqrt{3}$"}, {"id": "G11_TB_10_6*_10_38_1", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$\\log_{2}{x} = 2\\log_{2}{(x-3)} + 2$", "key": "$x = 4$"}, {"id": "G11_TB_10_6*_10_38_2", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$\\log_{5}{x} = 2\\log_{5}{(6-x)} + 1$", "key": "$x = 5$"}, {"id": "G11_TB_10_6*_10_42_1", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$x^{\\log_{\\sqrt{x}} 2x} = 4$", "key": "нет решений"}, {"id": "G11_TB_10_6*_10_42_2", "current_skill": "G11_S01_03", "q": "Решите уравнение:\n$x^{2 - \\lg^{2} x - \\lg x^{2}} - \\dfrac{1}{x} = 0$", "key": "$0{,}001; 1; 10$"}, {"id": "G11_TB_11_1_10_48_b", "current_skill": "G11_S01_03", "q": "Найдите все решения уравнения: $\\sin 2x - 2\\sin x + \\sqrt{3}\\cos x = \\sqrt{3}$, принадлежащие промежутку $\\left[-\\dfrac{\\pi}{2}; \\dfrac{3\\pi}{2}\\right]$.", "key": "$0$; $-\\dfrac{\\pi}{3}$; $\\dfrac{4\\pi}{3}$"}, {"id": "G11_TB_11_1_10_52_b", "current_skill": "G11_S01_03", "q": "Найдите все решения уравнения $(x - \\log_{2}{17})(x - \\log_{2}{71}) = 0$, принадлежащие промежутку $[4; 5]$.", "key": "$\\log_{2}{17}$"}, {"id": "G11_TB_11_5*_11_29_б", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\tg x + x^{2} + 2x > \\tg x + 3$", "key": "$x \\in (-\\infty; -3) \\cup (1; +\\infty)$, $x \\neq \\dfrac{\\pi}{2} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_11_5*_11_29_г", "current_skill": "G11_S01_03", "q": "Решите неравенство: $\\tg x + x^{2} + x > \\tg x + 6$", "key": "$x \\in (-\\infty; -3) \\cup (2; +\\infty)$, $x \\neq \\dfrac{\\pi}{2} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_11_5*_11_32*_а", "current_skill": "G11_S01_03", "q": "Решите неравенство: $2^{\\log_{2}(3-2x)} < 4$", "key": "$x \\in \\left(-\\dfrac{1}{2}; \\dfrac{3}{2}\\right)$"}, {"id": "G11_TB_11_5*_11_32*_б", "current_skill": "G11_S01_03", "q": "Решите неравенство: $3^{\\log_{3}(7-4x)} > 27$", "key": "$x \\in (-\\infty; -5)$"}, {"id": "G11_TB_12_1_11_59_b", "current_skill": "G11_S01_03", "q": "Решите неравенство: $0{,}2 \\leq \\left(\\dfrac{1}{25}\\right)^{\\frac{1}{x}} \\cdot \\left(\\dfrac{1}{125}\\right)^{\\frac{1}{x^{2}}}$", "key": "$x \\in (-\\infty; -1] \\cup [3; +\\infty)$"}, {"id": "G11_TB_12_1_11_59_v", "current_skill": "G11_S01_03", "q": "Решите неравенство: $9 \\cdot 3 \\leq \\left(\\dfrac{1}{9}\\right) \\cdot \\left(\\dfrac{1}{27}\\right)^{\\frac{1}{x}}$", "key": "$x \\in \\left[\\dfrac{-3}{5}; 0\\right)$"}, {"id": "G11_TB_13_5*_13_28_б", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\sqrt[5]{9x+5} - \\sqrt[4]{25-3x} = 0$", "key": "$3$"}, {"id": "G11_TB_14_1_1_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $12^{x^{2}-4}=1$", "key": "$x = \\pm 2$"}, {"id": "G11_TB_14_1_1_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $7^{1-4x}=1$", "key": "$\\dfrac{1}{4}$"}, {"id": "G11_TB_14_1_1_5", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\left(\\dfrac{1}{2}\\right)^{x^{2}-x}=\\sqrt[4]{2}$", "key": "$x = \\dfrac{1}{2}$"}, {"id": "G11_TB_14_1_1_6", "current_skill": "G11_S01_03", "q": "Решите уравнение: $3^{x^{2}-4x}=9$", "key": "$x = 2 \\pm \\sqrt{6}$"}, {"id": "G11_TB_14_1_2_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $2^{x} \\cdot 3^{x} = \\left(\\dfrac{1}{6}\\right)^{2x-3}$", "key": "$1$"}, {"id": "G11_TB_14_1_3", "current_skill": "G11_S01_03", "q": "Решите уравнение $3^{2x+2} + 5 \\cdot 3^{2x-2} = 86$", "key": "$1$"}, {"id": "G11_TB_14_1_4", "current_skill": "G11_S01_03", "q": "Решите уравнение $\\left(1+b^{2}\\right)^{\\sqrt{x}}=\\left(1+b^{2}\\right)^{4-\\sqrt{x}}$", "key": "1) при $b=0$, $x \\in [0; +\\infty)$; 2) при $b \\neq 0$, $x=4$"}, {"id": "G11_TB_14_2_14_1", "current_skill": "G11_S01_03", "q": "Решите уравнение $\\dfrac{6}{3^{x}} - \\dfrac{4}{3^{x} + 1} = 1$.", "key": "$1$"}, {"id": "G11_TB_14_2_1_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{8}{5^{x}-3}-\\dfrac{6}{5^{x}+1}=3$", "key": "$x=1$"}, {"id": "G11_TB_14_2_1_5", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{6}{4^{x}-2}-\\dfrac{5}{4^{x}+1}=2$", "key": "$x=1$"}, {"id": "G11_TB_14_2_2_5", "current_skill": "G11_S01_03", "q": "Решите уравнение: $2^{x+1} + 4^{x} = 80$", "key": "$x = 3$"}, {"id": "G11_TB_14_2_2_6", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{3^{x}+3^{-x}}{3^{x}-3^{-x}}=2$", "key": "$x = \\dfrac{1}{2}$"}, {"id": "G11_TB_14_2_2_7", "current_skill": "G11_S01_03", "q": "Решите уравнение: $10^{1+x^{2}} - 10^{1-x^{2}} = 99$", "key": "$x=1$; $x=-1$"}, {"id": "G11_TB_14_2_3_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $5 \\cdot 3^{x} - 3 \\cdot 5^{x} = 0$", "key": "$x=1$"}, {"id": "G11_TB_14_2_3_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $2^{x+3} - 3^{x} = 3^{x+1} - 2^{x}$", "key": "$x=2$"}, {"id": "G11_TB_14_3_14_21_б", "current_skill": "G11_S01_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n\\sqrt{2x-3y}=1, \\\\\n\\sqrt{2y-3x+10}=y-2\n\\end{cases}\n$$", "key": "$x=5; y=3$"}, {"id": "G11_TB_14_3_14_24_г", "current_skill": "G11_S01_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n2^{x^{2}+xy}=1,\\\\\n2\\log_{2} y = \\log_{2} (x+6)\n\\end{cases}\n$$", "key": "$(-2; 2)$, $(0; \\sqrt{6})$"}, {"id": "G11_TB_14_3_14_25_б", "current_skill": "G11_S01_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n0.2^{1+\\log_{0.2}(y-x)} = 0.8, \\\\\n\\log_{2} y - 2\\log_{2} x = -1\n\\end{cases}\n$$", "key": "$x=4; y=8$"}, {"id": "G11_TB_14_3_14_3_1", "current_skill": "G11_S01_03", "q": "Решите неравенство: $2^{x-3} > 4$", "key": "$(5; +\\infty)$"}, {"id": "G11_TB_14_3_1_1", "current_skill": "G11_S01_03", "q": "Решите неравенство: $2^{x} > 1$", "key": "$x > 0$"}, {"id": "G11_TB_14_3_1_2", "current_skill": "G11_S01_03", "q": "Решите неравенство: $2^{x} > \\dfrac{1}{2}$", "key": "$x > -1$"}, {"id": "G11_TB_14_4*_14_28_2", "current_skill": "G11_S01_03", "q": "Решите систему уравнений:\n$x^{2} - y = 23$, $x^{2} y = 50$", "key": "$x=5;\\ y=2;\\ x=-5;\\ y=2$"}, {"id": "G11_TB_14_4*_14_28_3", "current_skill": "G11_S01_03", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\nxy^{2}=12,\\\\\nx+y^{2}=7\n\\end{cases}\n$$", "key": "$x=3$, $y=2$; $x=3$, $y=-2$; $x=4$, $y=\\sqrt{3}$; $x=4$, $y=-\\sqrt{3}$"}, {"id": "G11_TB_15_2*_15_1", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите уравнение:\n$(a-2)x = a^{2} - 4$", "key": "При $a=2$: $x \\in \\mathbb{R}$; при $a \\neq 2$: $x = a + 2$"}, {"id": "G11_TB_15_3*_15_10_1", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите неравенство: $(a-1)x > a^{2}-1$", "key": "Если $a>1$, то $x>a+1$; если $a<1$, то $x<a+1$; если $a=1$, то решений нет."}, {"id": "G11_TB_15_3*_15_10_2", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите неравенство: $(a+2)x > a^{2}-4$", "key": "Если $a < -2$, то $x < a - 2$; если $a = -2$, то решений нет; если $a > -2$, то $x > a - 2$"}, {"id": "G11_TB_15_3*_15_10_3", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите неравенство: $(a+3)x \\geq a^{2}-9$", "key": "Если $a < -3$, то $x \\leq a - 3$; если $a = -3$, то $x \\in \\mathbb{R}$; если $a > -3$, то $x \\geq a - 3$"}, {"id": "G11_TB_15_3*_15_10_4", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите неравенство: $(a-4)x \\le a^{2}-16$", "key": "Если $a>4$, то $x \\leq a+4$; если $a=4$, то $x \\in (-\\infty; +\\infty)$; если $a<4$, то $x \\geq a+4$"}, {"id": "G11_TB_15_4*_15_24_a", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a-1)y = a+1, \\\\\nx + y = a.\n\\end{cases}\n$$", "key": "При $a=1$: решений нет; при $a\\neq 1$: $x=\\dfrac{a^{2}-2a-1}{a-1}$; $y=\\dfrac{a+1}{a-1}$"}, {"id": "G11_TB_15_4*_15_24_b", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a+1)y = a+2,\\\\\nx + y = a.\n\\end{cases}\n$$", "key": "$a=-1$: нет решений; $a \\neq -1$: $x=\\dfrac{a^{2}-2}{a+1}$, $y=\\dfrac{a+2}{a+1}$"}, {"id": "G11_TB_15_4*_15_24_c", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a-1)y = a+3, \\\\\nx - y = a.\n\\end{cases}\n$$", "key": "$a = 1$: нет решений; $a \\neq 1$: $x = \\dfrac{a^{2}+3}{a-1}$, $y = \\dfrac{a+3}{a-1}$"}, {"id": "G11_TB_15_4*_15_24_d", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a+1)y = a+4, \\\\\nx - y = a.\n\\end{cases}\n$$", "key": "$a=-1$: нет решений; $a \\neq -1$: $x=\\dfrac{a^{2}+2a+4}{a+1}$, $y=\\dfrac{a+4}{a+1}$"}, {"id": "G11_TB_15_4*_15_25_a", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a-1)y = a^{2} - 1,\\\\\nx + y = a\n\\end{cases}\n$$", "key": "$a=1: x=1-y, y \\in \\mathbb{R}; a \\neq 1: x=-1, y=a+1$"}, {"id": "G11_TB_15_4*_15_25_b", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a+1)y = a^{2} - 1,\\\\\nx + y = a\n\\end{cases}\n$$", "key": "$a=-1$: $x=-1-y$, $y \\in \\mathbb{R}$; $a \\neq -1$: $x=1$, $y=a-1$"}, {"id": "G11_TB_15_4*_15_25_c", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a-1)y = a^{2} - 1, \\\\\nx - y = a\n\\end{cases}\n$$", "key": "$a=1: x=1+y, y \\in \\mathbb{R}; a \\neq 1: y=a+1, x=2a+1$"}, {"id": "G11_TB_15_4*_15_25_d", "current_skill": "G11_S01_03", "q": "Для каждого значения параметра $a$ решите систему уравнений:\n$$\n\\begin{cases}\n(a+1)y = a^{2} - 1,\\\\\nx - y = a\n\\end{cases}\n$$", "key": "$a=-1: x=y-1, y\\in\\mathbb{R}; a\\neq-1: x=2a-1, y=a-1$"}, {"id": "G11_TB_17_1_17_1_3", "current_skill": "G11_S01_03", "q": "Решите логарифмическое уравнение: $\\log_{2}{(x+1)} = 3 - \\log_{2}{(x+3)}$", "key": "$x = 1$"}, {"id": "G11_TB_17_1_2_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{3}(2x-1)=2$", "key": "$x = 5$"}, {"id": "G11_TB_17_1_2_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{\\frac{1}{3}}(5x-21)=-2$", "key": "$x = 6$"}, {"id": "G11_TB_17_1_2_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{5}(x^{2}+2x-2)=0$", "key": "$x = -3; x = 1$"}, {"id": "G11_TB_17_1_2_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\lg(3-x)=-1$", "key": "$x = 2{,}9$"}, {"id": "G11_TB_17_1_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\lg^{2} x - 2\\lg x - 3 = 0$.", "key": "$0{,}1; 1000$"}, {"id": "G11_TB_17_1_3_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\lg(x+9)+\\lg(2x+8)=2$", "key": "$x = 1$"}, {"id": "G11_TB_17_1_3_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{3}{(x+1)} + \\log_{3}{(x+3)} = 1$", "key": "$x = 0$"}, {"id": "G11_TB_17_1_3_3", "current_skill": "G11_S01_03", "q": "Решите уравнение: $2\\log_{2}{x} - \\log_{2}{(3x-4)} = 1$", "key": "$x = 2; x = 4$"}, {"id": "G11_TB_17_1_3_4", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{1}{2}\\log_{5}(x-4)+\\dfrac{1}{2}\\log_{5}(2x-1)=\\log_{5}3$", "key": "$x = 5$"}, {"id": "G11_TB_17_1_4_2", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\dfrac{1}{3 - \\lg x} + \\dfrac{1}{1 + \\lg x} = 1$", "key": "$10$"}, {"id": "G11_TB_17_1_5", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(x+1)=3-\\log_{2}(x+3)$.", "key": "$1$"}, {"id": "G11_TB_17_1_5_1", "current_skill": "G11_S01_03", "q": "Решите уравнение: $\\log_{2}(10-2^{x})=x+2$", "key": "$x = 1$"}]