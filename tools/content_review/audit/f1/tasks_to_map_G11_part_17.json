[{"id": "G11_TB_13_5*_13_33_б", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x^{5} + x^{3} + 10x + \\log_{2} x - 61 > 0$", "key": "$x > 2$"}, {"id": "G11_TB_13_5*_13_34_а", "current_skill": "G11_S05_02", "q": "Сколько действительных корней имеет уравнение $2x^{4} - 4x^{2} + 1 = 0$?", "key": "$4$"}, {"id": "G11_TB_13_5*_13_34_б", "current_skill": "G11_S05_02", "q": "Сколько действительных корней имеет уравнение $2x^{4} - 8x + 1 = 0$?", "key": "$2$"}, {"id": "G11_TB_14_1_13_38_b", "current_skill": "G11_S05_02", "q": "Решите неравенство: $3\\sin^{4}\\left(\\dfrac{x}{2}\\right) + 11\\cos^{6}2x + 16\\cos^{3}4x \\ge 30$", "key": "$x = \\pi + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_14_3_14_3_4", "current_skill": "G11_S05_02", "q": "Решите неравенство: $3^{x} + 4^{x} > 7$", "key": "$(1; +\\infty)$"}, {"id": "G11_TB_14_3_2", "current_skill": "G11_S05_02", "q": "Решите неравенство $3^{\\sqrt{x}} - 3^{2 - \\sqrt{x}} \\le 8$.", "key": "$[0; 4]$"}, {"id": "G11_TB_14_3_4", "current_skill": "G11_S05_02", "q": "Решите неравенство $(3^{x}-9)\\sqrt{x^{2}-2x-8}\\le 0$.", "key": "$(-\\infty; -2] \\cup \\{4\\}$"}, {"id": "G11_TB_14_3_4_4", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{2 \\cdot 5^{x+1} - 1} > 5^{x} + 2$", "key": "$(0, 1)$"}, {"id": "G11_TB_15_1*_14_38_a", "current_skill": "G11_S05_02", "q": "Решите систему уравнений:\n$$\n\\begin{cases}\n2x^{2}+1=y-|\\sin x|, \\\\\n\\tg^{2}x+y^{2}=1\n\\end{cases}\n$$", "key": "$x=0; y=1$"}, {"id": "G11_TB_15_2*_15_9", "current_skill": "G11_S05_02", "q": "Для каждого значения параметра $a$ определите, сколько корней имеет уравнение: $x^{3} - 3x^{2} + a = 0$", "key": "При $a<0$: $1$ корень; при $a=0$: $2$ корня; при $0<a<4$: $3$ корня; при $a=4$: $2$ корня; при $a>4$: $1$ корень"}, {"id": "G11_TB_15_4*_15_35_a", "current_skill": "G11_S05_02", "q": "При каких значениях параметра $a$ уравнение $\\sqrt{x+1}=x+a$ имеет единственный корень?", "key": "$a \\in (-\\infty; 1) \\cup \\{\\dfrac{5}{4}\\}$"}, {"id": "G11_TB_15_4*_15_35_b", "current_skill": "G11_S05_02", "q": "При каких значениях параметра $a$ уравнение $\\sqrt{x+a}=x+3$ имеет единственный корень?", "key": "$a \\in \\{\\dfrac{11}{4}\\} \\cup (3; +\\infty)$"}, {"id": "G11_TB_15_4*_15_38_a", "current_skill": "G11_S05_02", "q": "При каких значениях параметра $a$ все $x>3$ являются решениями неравенства $(a-2)x^{2}-2x-a>0$?", "key": "$a \\in [3; +\\infty)$"}, {"id": "G11_TB_15_4*_15_41", "current_skill": "G11_S05_02", "q": "Найдите все значения параметра $p$, при каждом из которых множество всех решений неравенства $(p-x)^{2}(p+x-2)<0$ не содержит ни одного решения неравенства $x^{2}\\leq 1$.", "key": "$p \\in [3; +\\infty)$"}, {"id": "G11_TB_15_4*_15_44_d", "current_skill": "G11_S05_02", "q": "При каких значениях параметра $a$ система уравнений\n$$\n\\begin{cases}\n2 + \\log_{2} y = \\log_{2} (x + 3y) \\\\\ny = x + 2a - 4 + 2(x - a)^{2}\n\\end{cases}\n$$\nимеет два различных решения?", "key": "$a \\in (1; 2)$"}, {"id": "G11_TB_15_4*_5", "current_skill": "G11_S05_02", "q": "Найдём все значения параметра $a$, при каждом из которых система неравенств \n$$\n\\begin{cases}x^{2}+2xy-7y^{2}\\ge\\dfrac{1-a}{1+a}\\\\3x^{2}+10xy-5y^{2}\\le-2\\end{cases}\n$$\nимеет хотя бы одно решение.", "key": "$a < -1$"}, {"id": "G11_TB_27_2_2_1", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{10-x}=4-x$", "key": "$1$"}, {"id": "G11_TB_27_2_2_10", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x(x+4)(x-3)}=6-x$", "key": "$x = \\sqrt[3]{36}$"}, {"id": "G11_TB_27_2_2_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x-1}=x-3$", "key": "$5$"}, {"id": "G11_TB_27_2_2_3", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{1+x}=2x-4$", "key": "$3$"}, {"id": "G11_TB_27_2_30_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $x^{2} - \\cos(2x^{2}) + 1 = 0$", "key": "$x=0$"}, {"id": "G11_TB_27_2_34_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x^{3} - 3x - 2 < 0$", "key": "$x \\in (-\\infty; -1) \\cup (-1; 2)$"}, {"id": "G11_TB_27_2_34_2", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x^{3} - 3x^{2} + 4 > 0$", "key": "$x \\in (-1; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_27_2_35_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{x^{2}-5x+6}{x^{2}+5x+6}<0$", "key": "$x \\in (-3; -2) \\cup (2; 3)$"}, {"id": "G11_TB_27_2_35_2", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{x^{2}-6x+18}{-x^{2}+8x-12}>0$", "key": "$x \\in (2; 6)$"}, {"id": "G11_TB_27_2_36_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{3}{x-2} \\geq x$", "key": "$x \\in (-\\infty; -1] \\cup (2; 3]$"}, {"id": "G11_TB_27_2_39_3", "current_skill": "G11_S05_02", "q": "Решите неравенство: $2-3x < \\sqrt{4+9x-9x^{2}}$", "key": "$x \\in (0; \\dfrac{4}{3}]$"}, {"id": "G11_TB_27_2_39_4", "current_skill": "G11_S05_02", "q": "Решите неравенство: $4-5x < \\sqrt{16+30x-25x^{2}}$", "key": "$x \\in (0; 1{,}6]$"}, {"id": "G11_TB_27_2_3_1", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{3x+3}=2x-3$", "key": "$\\dfrac{15+\\sqrt{129}}{8}$"}, {"id": "G11_TB_27_2_3_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{3x+2}=2x-4$", "key": "$\\dfrac{19+\\sqrt{137}}{8}$"}, {"id": "G11_TB_27_2_3_4", "current_skill": "G11_S05_02", "q": "Решите уравнение: $1 - \\sqrt{x - 2} = x - 1$", "key": "$2$"}, {"id": "G11_TB_27_2_5_1", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{3x-5}=3-2x$", "key": "нет решений"}, {"id": "G11_TB_27_2_5_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{4x^{2}+4x+1}=x^{2}+x-1$", "key": "$-3; 2$"}, {"id": "G11_TB_27_2_5_4", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[4]{629-x}+\\sqrt[4]{77+x}=8$", "key": "$x = 4$; $x = 548$"}, {"id": "G11_TB_27_2_69", "current_skill": "G11_S05_02", "q": "Найдите все значения параметра $a$, при каждом из которых уравнение $144^{-|2x-1|} - 2 \\cdot 12^{-|2x-1|} + 12a = 0$ имеет хотя бы один корень.", "key": "$a \\in (0; \\dfrac{1}{12}]$"}, {"id": "G11_TB_27_2_6_1", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{y-1}=6-y$", "key": "$y = \\dfrac{13 - \\sqrt{21}}{2}$"}, {"id": "G11_TB_27_2_6_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x+1}=4-x$", "key": "$\\dfrac{9 - \\sqrt{21}}{2}$"}, {"id": "G11_TB_27_2_70_2", "current_skill": "G11_S05_02", "q": "Для каждого значения параметра $a$ решите неравенство $3(2x-a)+5a\\sqrt{2x-a}-2a^{2}>0$.", "key": "При $a=0$: $x>0$; при $a>0$: $x\\geq\\dfrac{a}{2}$, $x>\\dfrac{a}{2}+\\dfrac{a^{2}}{18}$; при $a<0$: $x\\geq\\dfrac{a}{2}$, $x"}, {"id": "G11_TB_27_2_7_1", "current_skill": "G11_S05_02", "q": "Решите уравнение: $5\\sqrt{x-2}+3\\sqrt{x+1}+2x=17$", "key": "$3$"}, {"id": "G11_TB_27_2_7_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{3x-2}+2\\sqrt{x-1}+5x=14$", "key": "$2$"}, {"id": "G11_TB_5_2_2_2", "current_skill": "G11_S05_02", "q": "Сколько корней имеет уравнение: $x^{4} - 8x^{2} - 9 - a = 0$ в зависимости от значения параметра $a$?", "key": "при $a < -25$: $0$ корней; при $a = -25$ и $a > -9$: $2$ корня; при $a = -9$: $3$ корня; при $-25 < a < -9$: $4$ корня"}, {"id": "G11_TB_5_3_4_2", "current_skill": "G11_S05_02", "q": "Найдите наибольшее и наименьшее значения функции на заданном отрезке: $f(x)=2\\sqrt{x}-|x-3|$, $[1;4]$.", "key": "наибольшее $2\\sqrt{3}$, наименьшее $0$"}, {"id": "G11_TB_6_6_6_2", "current_skill": "G11_S05_02", "q": "Решите неравенство методом интервалов: $\\dfrac{x^{3}+2x^{2}-3x}{(x-1)(x-2)}\\leq 0$", "key": "$x \\in (-\\infty; -3] \\cup [0; 1) \\cup (1; 2)$"}, {"id": "G11_TB_6_6_6_4", "current_skill": "G11_S05_02", "q": "Решите неравенство методом интервалов: $\\sqrt{x^{2}-5x+4}>x-3$", "key": "$x \\in (-\\infty; 1] \\cup (5; +\\infty)$"}, {"id": "G11_TB_6_6_6_5", "current_skill": "G11_S05_02", "q": "Решите неравенство методом интервалов: $\\sqrt{x+2} - \\sqrt{x-1} > 1$", "key": "$x \\in [1; 2)$"}, {"id": "G11_TB_8_1_7_21_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $4^{x} + 2^{x} + x^{2} < x^{2} + 6$.", "key": "$x \\in (-\\infty; 1)$"}, {"id": "G11_TB_8_1_7_22_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt[3]{3x^{3}-3x^{2}-x+5} > \\sqrt[3]{2x^{3}-4x^{2}+x+5}$.", "key": "$x \\in (-2; 0) \\cup (1; +\\infty)$"}, {"id": "G11_TB_8_1_7_23_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x+1 > \\sqrt[3]{x^{3}+2x^{2}-3x-4}$.", "key": "$x \\in (-\\infty; -5) \\cup (-1; +\\infty)$"}, {"id": "G11_TB_8_1_7_23_2", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x + 2 < \\sqrt[3]{x^{3} + 5x^{2} + 7x + 2}$.", "key": "$x \\in (-3; -2)$"}, {"id": "G11_TB_8_3_8_10_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{1-\\cos x} = \\sin x$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}; x = \\dfrac{\\pi}{2} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_2_4", "current_skill": "G11_S05_02", "q": "Решим уравнение $\\log_{\\frac{1}{3}} \\cos\\left(x+\\dfrac{\\pi}{4}\\right) = \\log_{\\frac{1}{3}} \\dfrac{1+\\cos 2x - \\sin 2x}{2\\sqrt{2}}$.", "key": "$2\\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_4*_9_29_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $(\\sqrt{x+2} + \\sqrt{x-2} = \\sqrt{2x})$", "key": "$x = 2$"}, {"id": "G11_TB_9_4*_9_29_г", "current_skill": "G11_S05_02", "q": "Решите уравнение: $(\\sqrt{x+2} + \\sqrt{x-3} = \\sqrt{2x-1})$", "key": "$x = 3$"}, {"id": "G11_TB_9_4*_9_30_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $(\\sqrt{2^{x}-4}+\\sqrt{2^{x}-8}=\\sqrt{2^{x+1}-12})$", "key": "$x = 3$"}, {"id": "G11_TB_9_4*_9_30_г", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{\\log_{6} x - 1} + \\sqrt{3^{x} - 9} = \\sqrt{\\log_{6} x + 3^{x} - 10}$", "key": "$x = 6$"}, {"id": "G11_TB_9_5_9_40_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x^{2}-5}+\\sqrt[4]{x^{2}-3}=\\sqrt{x+1}+\\sqrt[4]{x+3}$", "key": "$x = 3$"}, {"id": "G11_TB_9_5_9_40_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{\\sin x-0{,}1}+\\sqrt[4]{\\sin x+0{,}9}=\\sqrt{\\cos x+0{,}9}+\\sqrt[4]{\\cos x+1{,}9}$", "key": "$x = \\dfrac{\\pi}{2} + 2\\pi k,\\ k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_5_9_40_г", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[4]{\\tg x} + \\sqrt{\\tg x + 1} = \\sqrt[4]{2 - \\ctg x} + \\sqrt{3 - \\ctg x}$", "key": "$x = \\dfrac{\\pi}{4} + \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_5_9_42_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $(\\dfrac{1}{2})^{\\sin x} - \\sqrt[5]{\\sin x} = (\\dfrac{1}{2})^{\\cos x} - \\sqrt[5]{\\cos x}$", "key": "$x = \\dfrac{\\pi}{4} + \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_5_9_42_г", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\left(\\dfrac{1}{3}\\right)^{\\sin x} - (\\sin x)^{2001} = \\left(\\dfrac{1}{3}\\right)^{\\sin^{2} x} - (\\sin x)^{4002}$", "key": "$x = \\pi k, k \\in \\mathbb{Z}; x = \\dfrac{\\pi}{2} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_6_9_45_а", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{2x-1} > x-2$", "key": "$x \\in [0{,}5; 5)$"}, {"id": "G11_TB_9_7*_9_53_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(1-x)\\lg(x+2)<0$", "key": "$x \\in (-2; -1) \\cup (1; +\\infty)$"}, {"id": "G11_TB_9_7*_9_53_3", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(x-3)\\log_{5}{(5-x)}<0$", "key": "$x \\in (-\\infty; 3) \\cup (4; 5)$"}, {"id": "G11_TB_9_7*_9_53_4", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(4+x) \\log_{0{,}2}(3-x) > 0$", "key": "$x \\in (-\\infty; -4) \\cup (2; 3)$"}, {"id": "G11_TB_9_7*_9_54_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(3 - \\sqrt{10 - x})(\\sqrt{x} - 2) < 0$", "key": "$x \\in (1; 4)$"}, {"id": "G11_TB_9_7*_9_54_2", "current_skill": "G11_S05_02", "q": "Решите неравенство: $(2 - \\sqrt{9 - x})(\\sqrt{x} - 1) > 0$", "key": "$x \\in [0; 1) \\cup (5; 9]$"}, {"id": "G11_TB_9_7*_9_56_1", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{(\\dfrac{1}{3})^{x} - 3}{3^{x} - 3} < 0$", "key": "$x \\in (-\\infty; -1) \\cup (1; +\\infty)$"}, {"id": "G11_TB_9_7*_9_56_2", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{(\\dfrac{1}{2})^{x} - 4}{2^{x} - 16} < 0$", "key": "$x \\in (-\\infty; -2) \\cup (4; +\\infty)$"}, {"id": "G11_TB_9_7*_9_56_3", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{2^{x}-8}{\\lg x}>0$", "key": "$x \\in (0; 1) \\cup (3; +\\infty)$"}, {"id": "G11_TB_9_7*_9_56_4", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{2^{x} - \\dfrac{1}{2}}{\\lg(3 - x)} < 0$", "key": "$x \\in (-\\infty; -1) \\cup (2; 3)$"}, {"id": "G11_TB_9_7*_9_62_4", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\log_{x}(17x+1) < \\log_{x}|18x-1|$", "key": "$x \\in \\left(0; \\dfrac{1}{18}\\right) \\cup \\left(\\dfrac{1}{18}; 1\\right) \\cup (2; +\\infty)$"}, {"id": "G11_TB_?_138_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{3x + 5} - \\dfrac{1}{\\sqrt{3x + 5}} = \\sqrt{5x - 3} - \\dfrac{1}{\\sqrt{5x - 3}}$", "key": "$4$"}, {"id": "G11_TB_?_162_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x^{3} - 3x - 2 < 0$", "key": "$x \\in (-\\infty; -1) \\cup (-1; 2)$"}, {"id": "G11_TB_?_162_b", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x^{3} - 3x^{2} + 4 > 0$", "key": "$x \\in (-1; 2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_?_164_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{x^{2}-5x+6}{x^{2}+5x+6}<0$", "key": "$x \\in (-3; -2) \\cup (2; 3)$"}, {"id": "G11_TB_?_164_b", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{x^{2}-6x+18}{-x^{2}+8x-12}>0$", "key": "$x \\in (2; 6)$"}, {"id": "G11_TB_?_165_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\dfrac{3}{x-2} \\ge x$", "key": "$x \\in (-\\infty; -1] \\cup (2; 3]$"}, {"id": "G11_TB_?_165_b", "current_skill": "G11_S05_02", "q": "Решите неравенство: $x \\ge \\dfrac{2}{x-1}$", "key": "$x \\in [-1; 1) \\cup [2; +\\infty)$"}, {"id": "G11_TB_?_171_b", "current_skill": "G11_S05_02", "q": "Решите неравенство: $2-3x<\\sqrt{4+9x-9x^{2}}$", "key": "$x \\in (0; \\dfrac{4}{3}]$"}, {"id": "G11_TB_?_171_r", "current_skill": "G11_S05_02", "q": "Решите неравенство: $4-5x<\\sqrt{16+30x-25x^{2}}$", "key": "$x \\in (0; \\dfrac{8}{5}]$"}, {"id": "G11_TB_?_172_a", "current_skill": "G11_S05_02", "q": "Решите неравенство: $\\sqrt{3-x} > x-2$", "key": "$x \\in (-\\infty; \\dfrac{3 + \\sqrt{5}}{2})$"}, {"id": "G11_TB_?_212_2", "current_skill": "G11_S05_02", "q": "Решите неравенство:\n$\\log_{2}(2^{x}-3) \\cdot \\log_{\\sqrt{2}}(4^{x+2} - 12 \\cdot 2^{x+3} + 144) < 32$", "key": "$x \\in (\\log_{2}(\\dfrac{49}{16}); \\log_{2}(7))$"}, {"id": "G11_TB_?_244", "current_skill": "G11_S05_02", "q": "Найдите все значения параметра $a$, при каждом из которых уравнение $x-1=\\sqrt{(1-a)x-1+3a+2a^{2}}$ на промежутке $(-\\infty;5]$ имеет только одно решение.", "key": "$[-2; -1) \\cup \\{\\dfrac{-1}{3}\\} \\cup (0; 3]$"}, {"id": "G11_TB_?_246", "current_skill": "G11_S05_02", "q": "Найдите все значения параметра $a$, при каждом из которых уравнение $144^{-|2x-1|} - 2 \\cdot 12^{-|2x-1|} + 12a = 0$ имеет хотя бы один корень.", "key": "$(0; \\dfrac{1}{12}]$"}, {"id": "G11_TB_?_248", "current_skill": "G11_S05_02", "q": "Для каждого значения параметра $a$ решите неравенство: $3(2x-a)+5a\\sqrt{2x-a}-2a^{2}>0$.", "key": "При $a<0$: $x \\in \\left(\\dfrac{a}{2} + 2a^{2}; +\\infty\\right)$; при $a=0$: $x \\in (0; +\\infty)$; при $a>0$: $x \\in \\left"}, {"id": "G11_TB_?_253", "current_skill": "G11_S05_02", "q": "Найдите все значения параметра $a$, при каждом из которых система неравенств имеет единственное решение: $x^{3} - (a+3)x^{2} + (3a+2)x - 2a \\geq 0$, $x^{3} - (a+3)x^{2} + 3ax \\leq 0$.", "key": "$a \\geq 3$"}, {"id": "G11_TB_?_45", "current_skill": "G11_S05_02", "q": "Постройте график функции. Для этого сначала упростите формулу, задающую функцию: $y = \\sqrt{1 - 4\\sin^{2} x \\cos^{2} x} - \\cos^{2} x + \\sin^{2} x.$", "key": "$y = |\\cos 2x| - \\cos 2x$"}, {"id": "G11_TB_?_78_ж", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x^{4} - 3x - 1} = x^{2} - 1$", "key": "$2$"}, {"id": "G11_TB_?_82_b", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{4x^{2}+4x+1}=x^{2}+x-1$", "key": "$-3; 2$"}, {"id": "G11_TB_?_84_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{y-1}=6-y$", "key": "$y = \\dfrac{13 - \\sqrt{21}}{2}$"}, {"id": "G11_TB_?_86_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $5\\sqrt{x-2} + 3\\sqrt{x+1} + 2x = 17$", "key": "$3$"}, {"id": "G11_TB_?_86_b", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{3x-2}+2\\sqrt{x-1}+5x=14$", "key": "$2$"}, {"id": "G11_TB_?_87_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{2x-12} + \\sqrt{30-5x} + 1{,}5x = 10$", "key": "нет решений"}, {"id": "G11_TB_?_88_b", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[3]{200+2x} + \\sqrt{300-x} = 20$", "key": "$-600; -100; 156$"}, {"id": "G11_TB_?_88_г", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[3]{192+4x} + \\sqrt{-32-x} = 4$", "key": "$-176;\\ -48;\\ -32$"}, {"id": "G11_TB_?_90_a", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt[3]{x-2} + \\sqrt[3]{x+5} = \\sqrt[3]{30-x}$", "key": "$3$"}, {"id": "G11_TB_?_91_b", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{x+2} + \\sqrt{8-x} = \\sqrt{15}$", "key": "$3-\\dfrac{5\\sqrt{3}}{2}$; $3+\\dfrac{5\\sqrt{3}}{2}$"}, {"id": "G11_TB_?_91_в", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\sqrt{4x-x^{2}}+\\sqrt{4x-x^{2}-3}=3+\\sqrt{2x-x^{2}}$", "key": "$x = 2$"}, {"id": "G11_TB_§12_10", "current_skill": "G11_S05_02", "q": "Найдите все значения $a$, при которых уравнение $4\\sin^{3}x = a + 7\\cos 2x$ не имеет корней.", "key": "$a \\in (-\\infty; -7) \\cup (11; +\\infty)$"}, {"id": "G11_TB_§12_11", "current_skill": "G11_S05_02", "q": "Найдите все значения $a$, при которых уравнение $3\\cos 2x + \\dfrac{2a}{\\sin x} = -17$ имеет хотя бы один корень.", "key": "$[-7; 0) \\cup (0; 7]$"}, {"id": "G11_TB_§19_13_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $4^{x} + 4^{1-x} = 1 + 3\\sin(\\pi x)$", "key": "$\\dfrac{1}{2}$"}, {"id": "G11_TB_§19_15_4", "current_skill": "G11_S05_02", "q": "Решите уравнение: $3^{x} + 3^{2-x} = 3(1 + \\cos 2\\pi x)$", "key": "$1$"}, {"id": "G11_TB_§19_17_1", "current_skill": "G11_S05_02", "q": "Сравните числа: $1000^{1001}$ и $1001^{1000}$", "key": "$1000^{1001} > 1001^{1000}$"}, {"id": "G11_TB_§1_1_14_г", "current_skill": "G11_S05_02", "q": "Имеет ли наибольшее (наименьшее) значение функция $y = 2^{\\sqrt{\\sin x}}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Наибольшее значение: $y=2$ при $x=\\dfrac{\\pi}{2}+2\\pi k$, $k \\in \\mathbb{Z}$; наименьшее значение: $y=1$ при $x=\\pi k$, "}, {"id": "G11_TB_§1_1_49_1", "current_skill": "G11_S05_02", "q": "Укажите промежутки знакопостоянства функции $y = x^{2} - 4$.", "key": "$y>0$ при $x\\in(-\\infty ; -2)\\cup(2; +\\infty )$; $y<0$ при $x\\in(-2; 2)$"}, {"id": "G11_TB_§1_1_49_2", "current_skill": "G11_S05_02", "q": "Укажите промежутки знакопостоянства функции $y = x^{2} - 4x$.", "key": "$y>0$ при $x \\in (-\\infty; 0) \\cup (4; +\\infty)$; $y<0$ при $x \\in (0; 4)$"}, {"id": "G11_TB_§1_1_49_5", "current_skill": "G11_S05_02", "q": "Укажите промежутки знакопостоянства функции $y = -2x^{2} - 3x + 5$.", "key": "$y>0$ при $x \\in (-2{,}5; 1)$; $y<0$ при $x \\in (-\\infty; -2{,}5) \\cup (1; +\\infty)$"}, {"id": "G11_TB_§1_1_49_6", "current_skill": "G11_S05_02", "q": "Укажите промежутки знакопостоянства функции $y=\\dfrac{4}{x+3}+1$.", "key": "$y>0$ при $x \\in (-\\infty; -7) \\cup (-3; +\\infty)$; $y<0$ при $x \\in (-7; -3)$"}, {"id": "G11_TB_§1_1_49_7", "current_skill": "G11_S05_02", "q": "Укажите промежутки знакопостоянства функции $y=\\dfrac{-2}{x-2}-1$.", "key": "$y>0$ при $x \\in (0; 2)$; $y<0$ при $x \\in (-\\infty; 0) \\cup (2; +\\infty)$"}, {"id": "G11_TB_§20_1_4", "current_skill": "G11_S05_02", "q": "Решите уравнение: $2^{x}+2^{-x}=2\\cos\\left(\\dfrac{x}{3}\\right)$", "key": "$0$"}, {"id": "G11_TB_§20_1_7", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\log_{2}|x| = 5 - x^{2}$", "key": "$x=2$; $x=-2$"}, {"id": "G11_TB_§20_1_9", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\log_{5} x = \\sqrt{1 - x^{2}}$", "key": "$x=1$"}, {"id": "G11_TB_§20_3", "current_skill": "G11_S05_02", "q": "Решите уравнение $4^{x} + \\dfrac{1}{4^{x}} = 2 \\cos 2x$.", "key": "$0$"}, {"id": "G11_TB_§20_3_1", "current_skill": "G11_S05_02", "q": "Решите уравнение: $\\log_{2}^{2}x + (x-1)\\log_{2}x = 6 - 2x$", "key": "$0{,}25; 2$"}, {"id": "G11_TB_§20_3_2", "current_skill": "G11_S05_02", "q": "Решите уравнение: $x^{2}+(x-3)\\log_{2} x=4x-3$", "key": "$1; 3$"}, {"id": "G11_TB_§20_6_2", "current_skill": "G11_S05_02", "q": "Решите систему уравнений: $\\log_{2} x - \\log_{2} y = y - x$, $x^{3} + y^{3} = 54$", "key": "$x=3$; $y=3$"}, {"id": "G11_TB_§20_9", "current_skill": "G11_S05_02", "q": "Найдите все значения параметра $a$, при которых уравнение $3^{x} + 3^{-x} = 2\\cos x + a + 4$ имеет единственный корень.", "key": "$a = -4$"}, {"id": "G11_TB_§2_5_1", "current_skill": "G11_S05_02", "q": "Решите неравенство методом интервалов: $(x^{2}-9)(\\sqrt{x-1}-1)\\leq 0$", "key": "$x \\in [2; 3]$"}]