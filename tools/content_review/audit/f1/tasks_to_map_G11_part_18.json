[{"id": "ds_llm_218ebe3e4497", "current_skill": "G11_S06_01", "q": "График функции $y = \\ln x$ подвергли следующей композиции преобразований: сдвиг вправо на $2$, сжатие к оси $Oy$ в $3$ раза, отражение относительно оси $Ox$, сдвиг вверх на $\\ln 3$. Найдите точку пересечения полученного графика с осью $Oy$ или докажите, что её нет.", "key": "пересечения с осью $Oy$ нет"}, {"id": "ds_llm_2746b4997e42", "current_skill": "G11_S06_01", "q": "График функции $y = \\sqrt{x}$ сначала сдвинули на $4$ единицы влево, затем на $1$ единицу вниз, а потом отразили относительно оси $Ox$. Запишите формулу полученной функции.", "key": "$y = -\\sqrt{x + 4} + 1$"}, {"id": "ds_llm_3857f69dc1b7", "current_skill": "G11_S06_01", "q": "Дан график функции $y = f(x)$. Постройте график функции $y = f(x + 2) - 3$. Какое преобразование необходимо выполнить?", "key": "Сдвиг на $2$ единицы влево и на $3$ единицы вниз"}, {"id": "ds_llm_4f8c879b530e", "current_skill": "G11_S06_01", "q": "График функции $y = \\sqrt{x}$ сдвинули на $4$ единицы вправо и на $1$ единицу вверх, а затем отразили относительно оси $Ox$. Запишите формулу полученной функции.", "key": "$y = -\\sqrt{x - 4} - 1$"}, {"id": "ds_llm_597893f5514d", "current_skill": "G11_S06_01", "q": "График функции $y = \\sin x$ подвергли следующей цепочке преобразований: сжатие вдоль оси $Ox$ в $3$ раза, сдвиг вправо на $\\dfrac{\\pi}{6}$, растяжение вдоль оси $Oy$ в $2$ раза и сдвиг вниз на $1$. Запишите формулу итоговой функции и укажите её наименьший положительный период.", "key": "$y = 2\\sin\\left(3x - \\dfrac{\\pi}{2}\\right) - 1, T = \\dfrac{2\\pi}{3}$"}, {"id": "ds_llm_6041bfaf5284", "current_skill": "G11_S06_01", "q": "График функции $y = f(x)$ сдвинули на $3$ единицы вправо и на $2$ единицы вверх. Запишите формулу полученной функции.", "key": "$y = f(x - 3) + 2$"}, {"id": "ds_llm_802ed73a8f48", "current_skill": "G11_S06_01", "q": "График функции $y = \\sqrt{x}$ сначала сдвинули на $4$ единицы влево, затем растянули от оси $Ox$ в $2$ раза, а потом сдвинули на $1$ единицу вниз. Запишите формулу полученной функции.", "key": "$y = 2\\sqrt{x + 4} - 1$"}, {"id": "ds_llm_c57d61e10d48", "current_skill": "G11_S06_01", "q": "График функции $y = \\ln x$ подвергли следующей цепочке преобразований: сжатие к оси $Oy$ в $2$ раза, сдвиг на $1$ единицу вправо, растяжение от оси $Ox$ в $3$ раза и сдвиг на $5$ единиц вниз. Найдите точку, в которую перейдёт точка $(e; 1)$ исходного графика.", "key": "$\\left(\\dfrac{e}{2} + 1; -2\\right)$"}, {"id": "G11_TB_§1_1_49_8", "current_skill": "G11_S07_01", "q": "Укажите промежутки знакопостоянства функции $y = -|x - 2| + 2$.", "key": "$y>0$ при $x \\in (0; 4)$; $y<0$ при $x \\in (-\\infty; 0) \\cup (4; +\\infty)$"}, {"id": "GEN_G11_S07_01_A_01", "current_skill": "G11_S07_01", "q": "Как построить график функции $y = f(|x|)$, если известен график функции $y = f(x)$?", "key": "часть графика при $x \\ge 0$ сохранить и отразить её симметрично относительно оси $Oy$"}, {"id": "GEN_G11_S07_01_B_01", "current_skill": "G11_S07_01", "q": "Сколько нулей имеет функция $y = x^{2} - 5|x| + 6$?", "key": "$4$"}, {"id": "GEN_G11_S07_01_C_01", "current_skill": "G11_S07_01", "q": "Найдите наименьшее значение функции $y = x^{2} - 4|x| + 3$.", "key": "$-1$"}, {"id": "G11_TB_11_3*_11_16_а", "current_skill": "G11_S07_02", "q": "Решите неравенство: $1+\\sin x>|\\cos x|$", "key": "$(2\\pi k; \\pi + 2\\pi k), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_11_6*_11_38_a", "current_skill": "G11_S07_02", "q": "Решите неравенство: $\\dfrac{|x^{2} - 5x + 4|}{|x^{2} - 4|} < 1$", "key": "$x \\in (0; 1{,}6) \\cup (2{,}5; +\\infty)$"}, {"id": "G11_TB_12_3_12_15_b", "current_skill": "G11_S07_02", "q": "Решите неравенство: $2|x-1|(x^{2}-4x+3)+(x-1)|x^{2}-4x+3|<0$", "key": "$(1; 3)$"}, {"id": "G11_TB_12_3_12_15_c", "current_skill": "G11_S07_02", "q": "Решите неравенство: $2|x|(x^{2}-5x+6)+x|x^{2}-5x+6| \\le 0$", "key": "$\\{0\\} \\cup [2; 3]$"}, {"id": "G11_TB_1_5_1_47_6", "current_skill": "G11_S07_02", "q": "Укажите промежутки строгой монотонности функции $y = |x^{2} - 3x + 2|$.", "key": "Нули подмодульного выражения: $x=1$, $x=2$. Вершина параболы $x=1{,}5$. Промежутки: убывает на $(-\\infty; 1]$ и $[1{,}5;"}, {"id": "G11_TB_10_3*_10_10*_а", "current_skill": "G11_S07_03", "q": "Решите уравнение: $1+\\cos x=|\\sin x|$", "key": "$x = \\dfrac{\\pi}{2} + 2\\pi k, k \\in \\mathbb{Z}; x = -\\dfrac{\\pi}{2} + 2\\pi n, n \\in \\mathbb{Z}; x = \\pi + 2\\pi m, m \\in "}, {"id": "G11_TB_10_3*_10_10*_б", "current_skill": "G11_S07_03", "q": "Решите уравнение: $1 - \\sin x = |\\cos x|$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}; x = \\dfrac{\\pi}{2} + 2\\pi n, n \\in \\mathbb{Z}; x = \\pi + 2\\pi m, m \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_3*_10_10*_в", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\sqrt{1-\\cos x}=|\\sin x|$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}; x = \\dfrac{\\pi}{2} + \\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_3*_10_10*_г", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\sqrt{1+\\sin x}=|\\cos x|$", "key": "$x = \\pi k, k \\in \\mathbb{Z}; x = -\\dfrac{\\pi}{2} + 2\\pi n, n \\in \\mathbb{Z}$"}, {"id": "G11_TB_10_3*_10_8_а", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\sqrt{-2x}=|x+1|$", "key": "$-2+\\sqrt{3}; -2-\\sqrt{3}$"}, {"id": "G11_TB_10_3*_10_8_б", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\sqrt{4x}=|x-2|$", "key": "$4+2\\sqrt{3}; 4-2\\sqrt{3}$"}, {"id": "G11_TB_10_3*_10_8_в", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\sqrt{2-x}=|x-3|$", "key": "нет решений"}, {"id": "G11_TB_10_3*_10_8_г", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\sqrt{5-x}=|x-2|$", "key": "$\\dfrac{3-\\sqrt{13}}{2}$; $\\dfrac{3+\\sqrt{13}}{2}$"}, {"id": "G11_TB_10_4*_18_a", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\dfrac{|x-2|-|x|}{|2x-1|+|x|}=\\dfrac{|2x-1|-|x|}{|x-2|+|x|}$", "key": "$x=1$; $x=-1$"}, {"id": "G11_TB_10_4*_18_б", "current_skill": "G11_S07_03", "q": "Решите уравнение: $\\dfrac{|2x-3|-|x|}{|3x-2|+|x|}=\\dfrac{|3x-2|-|x|}{|2x-3|+|x|}$", "key": "$x=-1$; $x=1$"}, {"id": "G11_TB_11_1_10_50_a", "current_skill": "G11_S07_03", "q": "Найдите все решения уравнения: $|x^{2}-3x+2|=2x-2$, принадлежащие промежутку $[3;5]$.", "key": "$x = 4$"}, {"id": "G11_TB_11_1_10_50_b", "current_skill": "G11_S07_03", "q": "Найдите все решения уравнения: $|x^{2}-2x-8|=x+2$, принадлежащие промежутку $[0; 4]$.", "key": "$x=3$"}, {"id": "G11_TB_11_3*_11_13_а", "current_skill": "G11_S07_03", "q": "Решите неравенство: $|3x+2| > |2x+3|$", "key": "$(-\\infty; -1) \\cup (1; +\\infty)$"}, {"id": "G11_TB_11_3*_11_13_б", "current_skill": "G11_S07_03", "q": "Решите неравенство: $|3x-4| < |x-4|$", "key": "$(0; 2)$"}, {"id": "G11_TB_11_3*_11_13_в", "current_skill": "G11_S07_03", "q": "Решите неравенство: $|3x-2| > |2x-\\dfrac{3}{4}|$", "key": "$(-\\infty; \\dfrac{11}{20}) \\cup (\\dfrac{5}{4}; +\\infty)$"}, {"id": "G11_TB_11_3*_11_13_г", "current_skill": "G11_S07_03", "q": "Решите неравенство: $|5x-3| > |x-3|$", "key": "$(-\\infty; 0) \\cup (1; +\\infty)$"}, {"id": "G11_TB_11_3*_11_14_б", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\sqrt{6+3x} > |2x+1|$", "key": "$(-1{,}25; 1)$"}, {"id": "G11_TB_11_3*_11_16_б", "current_skill": "G11_S07_03", "q": "Решите неравенство: $1-\\sin x<|\\cos x|$", "key": "$(2\\pi k; \\dfrac{\\pi}{2} + 2\\pi k) \\cup (\\dfrac{\\pi}{2} + 2\\pi k; \\pi + 2\\pi k), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_11_3*_11_16_в", "current_skill": "G11_S07_03", "q": "Решите неравенство: $1 - \\cos x > |\\sin x|$", "key": "$x \\in \\left(\\dfrac{\\pi}{2} + 2\\pi k; \\dfrac{3\\pi}{2} + 2\\pi k\\right), k \\in \\mathbb{Z}$"}, {"id": "G11_TB_11_3*_11_16_г", "current_skill": "G11_S07_03", "q": "Решите неравенство: $1+\\cos x < |\\sin x|$", "key": "$x \\in \\left(\\dfrac{\\pi}{2} + 2\\pi k; \\pi + 2\\pi k\\right) \\cup \\left(\\pi + 2\\pi k; \\dfrac{3\\pi}{2} + 2\\pi k\\right), k \\i"}, {"id": "G11_TB_11_4*_11_21_a", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{2|x-3|}{|x-5|} < \\dfrac{|x-5|}{|x-3|}$", "key": "$(1 - 2\\sqrt{2}; 1 + 2\\sqrt{2}) \\setminus \\{3\\}$"}, {"id": "G11_TB_11_4*_11_21_b", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{2|x+1|}{|x+3|+|x-1|} < \\dfrac{|x+3|-|x-1|}{|x+1|}$", "key": "$x \\in (-1; 3)$"}, {"id": "G11_TB_11_4*_11_21_в", "current_skill": "G11_S07_03", "q": "Решите неравенство:\n$\\dfrac{2|x+2|}{|x+3|} < \\dfrac{|x+3|}{|x+2|}$", "key": "$(-1 - \\sqrt{2}; -1 + \\sqrt{2}) \\setminus \\{-2\\}$"}, {"id": "G11_TB_11_4*_11_21_г", "current_skill": "G11_S07_03", "q": "Решите неравенство:\n$\\dfrac{2|x+5|}{|x+3|+|x+7|}<\\dfrac{|x+3|-|x+7|}{|x+5|}$", "key": "$(-9; -5)$"}, {"id": "G11_TB_11_6*_11_38_б", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{|x^{2} - 10x + 9|}{|x^{2} - 9|} > 1$", "key": "$x \\in (-\\infty; -3) \\cup (-3; 0) \\cup \\left(\\dfrac{9}{5}; 3\\right) \\cup (3; 5)$"}, {"id": "G11_TB_11_7*_11_54_1", "current_skill": "G11_S07_03", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $\\cos 3x > |\\cos x|$, $x \\in \\left[-\\dfrac{5\\pi}{6}; \\dfrac{5\\pi}{6}\\right]$.", "key": "$(-\\dfrac{3\\pi}{4}; -\\dfrac{\\pi}{2}) \\cup (\\dfrac{\\pi}{2}; \\dfrac{3\\pi}{4})$"}, {"id": "G11_TB_11_7*_11_54_2", "current_skill": "G11_S07_03", "q": "Найдите все решения неравенства, принадлежащие указанному промежутку: $\\sin 3x > |\\sin x|$, $x \\in \\left[-\\dfrac{3\\pi}{2}; \\dfrac{\\pi}{2}\\right]$", "key": "$\\left(-\\dfrac{5\\pi}{4}; -\\pi\\right) \\cup \\left(0; \\dfrac{\\pi}{4}\\right)$"}, {"id": "G11_TB_12_1_11_55_v", "current_skill": "G11_S07_03", "q": "Решите неравенство: $(x^{2}-2x-15)\\sqrt{x+4}\\leq 0$", "key": "$x \\in \\{-4\\} \\cup [-3; 5]$"}, {"id": "G11_TB_12_1_11_56_b", "current_skill": "G11_S07_03", "q": "Решите неравенство: $(x-4)\\sqrt{x^{2}-4}\\leq 0$", "key": "$x \\in (-\\infty; -2] \\cup [2; 4]$"}, {"id": "G11_TB_12_1_11_57_v", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{18-3x-x^{2}}}{x-2} \\le \\dfrac{\\sqrt{18-3x-x^{2}}}{2x+3}$", "key": "$x \\in [-6; -5] \\cup (-1{,}5; 2) \\cup \\{3\\}$"}, {"id": "G11_TB_12_1_11_62_a", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{11x+5}}{|x-20|} \\geq \\dfrac{\\sqrt{10x+13}}{|x-20|}$", "key": "$x \\in [8; 20) \\cup (20; +\\infty)$"}, {"id": "G11_TB_12_1_11_62_b", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{9x+19}}{|x+2|} \\leq \\dfrac{\\sqrt{11x+31}}{|x+2|}$", "key": "$x \\in \\left[-\\dfrac{19}{9}; -2\\right) \\cup (-2; +\\infty)$"}, {"id": "G11_TB_12_1_11_62_g", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{8x+21}}{|x+1|} \\leq \\dfrac{\\sqrt{10x+41}}{|x+1|}$", "key": "$x \\in [-2{,}625; -1) \\cup (-1; +\\infty)$"}, {"id": "G11_TB_12_1_11_62_v", "current_skill": "G11_S07_03", "q": "Решите неравенство: $\\dfrac{\\sqrt{10x+17}}{|x-1|} \\geq \\dfrac{\\sqrt{8x+11}}{|x-1|}$", "key": "$x \\in [-1{,}375; 1) \\cup (1; +\\infty)$"}, {"id": "G11_TB_12_1_305_1", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-1|+|x-2|+|x-3|=6$ на промежутке $[3; +\\infty)$.", "key": "$4$"}, {"id": "G11_TB_12_1_305_2", "current_skill": "G11_S07_03", "q": "Решите уравнение $(x+2) \\cdot 2^{2-|x-2|} - x = (x+1) |2^{x} - 1| + 2^{x} + 1$ на промежутке $(-\\infty; 0)$.", "key": "$-1$"}, {"id": "G11_TB_12_1_305_3", "current_skill": "G11_S07_03", "q": "Решите уравнение $(x+2) \\cdot 2^{2-|x-2|} - x = (x+1) |2^{x} - 1| + 2^{x} + 1$ на промежутке $[0; 2]$.", "key": "$[0; 2]$"}, {"id": "G11_TB_12_1_305_4", "current_skill": "G11_S07_03", "q": "Решите уравнение $(x+2) \\cdot 2^{2-|x-2|} - x = (x+1) |2^{x} - 1| + 2^{x} + 1$ на промежутке $(2; +\\infty)$.", "key": "нет корней"}, {"id": "G11_TB_12_1_305_5", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-1|=2|x|-4$.", "key": "$x = -5; x = 3$"}, {"id": "G11_TB_12_2_12_1_в", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-1|+|x+1|=4$", "key": "$-2; 2$"}, {"id": "G11_TB_12_2_12_1_г", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-3|+|x+3|=8$", "key": "$-4; 4$"}, {"id": "G11_TB_12_2_12_1_д", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-1|+|x-2|+|x-3|=2$", "key": "$2$"}, {"id": "G11_TB_12_2_12_1_е", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x+1|+|x-3|+|x-5|=7$", "key": "$2; 4$"}, {"id": "G11_TB_12_2_12_2_а", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-1| = x^{2} - 5x + 4$", "key": "$1; 5$"}, {"id": "G11_TB_12_2_12_2_б", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-2| = x^{2} - 4x - 2$", "key": "$-1; 5$"}, {"id": "G11_TB_12_2_12_2_в", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-3| = x^{2} - 6x + 3$", "key": "$0; 6$"}, {"id": "G11_TB_12_2_12_2_г", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x-4| = x^{2} - 2x - 2$", "key": "$-2; 3$"}, {"id": "G11_TB_12_2_12_3_а", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}+4x+2|=x+2$", "key": "$-1; 0$"}, {"id": "G11_TB_12_2_12_3_б", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}+6x+7|=-x-3$", "key": "$-5$; $-4$"}, {"id": "G11_TB_12_2_12_3_в", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}-2x-2|=-x+4$", "key": "$-2; 1; 2; 3$"}, {"id": "G11_TB_12_2_12_3_г", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}-4x+1|=x+1$", "key": "$0; 1; 2; 5$"}, {"id": "G11_TB_12_2_12_4_а", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}-x-1|=x^{2}+2x+1$", "key": "$\\dfrac{-2}{3}, 0, \\dfrac{-1}{2}$"}, {"id": "G11_TB_12_2_12_4_б", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}-2x-2|=x^{2}-4x+6$", "key": "$1$; $2$; $4$"}, {"id": "G11_TB_12_2_12_4_в", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}-2x-4|=x^{2}-4x+4$", "key": "$0, 3, 4$"}, {"id": "G11_TB_12_2_12_4_г", "current_skill": "G11_S07_03", "q": "Решите уравнение: $|x^{2}-4x+2|=x^{2}-6x+10$", "key": "$2, 3, 4$"}, {"id": "G11_TB_12_2_12_5_а", "current_skill": "G11_S07_03", "q