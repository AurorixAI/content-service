[{"id": "G10_TB_§4_4_1_8", "current_skill": "G10_S07_03", "q": "Равносильны ли уравнения: $x^{2}+2x+1=0$ и $x+1=0$?", "key": "да"}, {"id": "G10_TB_§4_4_1_9", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x^{2}-1}{x+1}=0$ и $x-1=0$?", "key": "да"}, {"id": "G10_TB_§4_4_2_1", "current_skill": "G10_S07_06", "q": "Равносильны ли уравнения: $x+6=10$ и $2x-1=7$?", "key": "да"}, {"id": "G10_TB_§4_4_2_2", "current_skill": "G10_S07_08", "q": "Равносильны ли уравнения: $x^{2}=x$ и $x=1$?", "key": "нет"}, {"id": "G10_TB_§4_4_2_3", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $x^{2}+1=0$ и $\\frac{3}{x-1}=0$?", "key": "да"}, {"id": "G10_TB_§4_4_2_4", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x+1}{x+1}=1$ и $\\frac{x^{2}+1}{x^{2}+1}=1$?", "key": "нет"}, {"id": "G10_TB_§4_4_2_5", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x-2}{x-2}=0$ и $2x^{2}+3=0$?", "key": "да"}, {"id": "G10_TB_§4_4_2_6", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $x^{2}+4x+4=0$ и $\\frac{x+2}{x-1}=0$?", "key": "да"}, {"id": "G10_TB_§4_4_2_7", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x^{2}-9}{x-3}=0$ и $x+3=0$?", "key": "да"}, {"id": "G10_TB_§4_4_2_8", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x+1}{x+1}=0$ и $\\frac{x^{2}-1}{x^{2}-1}=0$?", "key": "да"}, {"id": "G10_TB_§4_4_3_1", "current_skill": "G10_S07_06", "q": "Составьте какое-нибудь уравнение , равносильное данному: $|x|=1$.", "key": "$x^{2} = 1$"}, {"id": "G10_TB_§4_4_3_2", "current_skill": "G10_S07_04", "q": "Составьте какое-нибудь уравнение , равносильное данному: $x+6=x-2$.", "key": "$0x = -8$"}, {"id": "G10_TB_§4_4_3_3", "current_skill": "G10_S07_07", "q": "Составьте какое-нибудь уравнение, равносильное данному: $\\frac{x-1}{x-1}=1$.", "key": "$\\dfrac{2x-2}{x-1} = 2$"}, {"id": "G10_TB_§4_4_4_1", "current_skill": "G10_S07_04", "q": "Будет ли уравнение, полученное в результате указанного преобразования, равносильным данному: в уравнении $3(2x-1)-5(4x+2)=1$ раскрыть скобки и привести подобные слагаемые?", "key": "да"}, {"id": "G10_TB_§4_4_4_2", "current_skill": "G10_S07_07", "q": "Будет ли уравнение, полученное в результате указанного преобразования, равносильным данному: в уравнении $x^{2}+\\frac{1}{x-7}-\\frac{1}{x-7}=49$ разность $\\frac{1}{x-7}-\\frac{1}{x-7}$ заменить нулём?", "key": "нет"}, {"id": "G10_TB_§4_4_4_3", "current_skill": "G10_S07_05", "q": "Будет ли уравнение, полученное в результате указанного преобразования, равносильным данному: в уравнении $\\frac{x^{2}-1}{x-1}+3x-5=0$ сократить дробь?", "key": "нет"}, {"id": "G10_TB_§4_4_4_4", "current_skill": "G10_S07_07", "q": "Будет ли уравнение, полученное в результате указанного преобразования, равносильным данному: обе части уравнения $x^{3}=x$ разделить на $x$?", "key": "нет"}, {"id": "G10_TB_§4_4_4_5", "current_skill": "G10_S07_07", "q": "Будет ли уравнение, полученное в результате указанного преобразования, равносильным данному: обе части уравнения $(x+1)(x^{2}+4)=x^{2}+4$ разделить на $x^{2}+4$?", "key": "да"}, {"id": "G10_TB_§4_4_4_6", "current_skill": "G10_S07_07", "q": "Будет ли уравнение, полученное в результате указанного преобразования, равносильным данному: обе части уравнения $\\frac{x^{2}}{x}=2$ умножить на $x$?", "key": "нет"}, {"id": "G10_TB_§4_4_4_7", "current_skill": "G10_S07_07", "q": "Будет ли уравнение , полученное в результате указанного преобразования, равносильным данному: обе части уравнения $2x+1=5$ умножить на $x+1$?", "key": "нет"}, {"id": "G10_TB_§4_4_5_4", "current_skill": "G10_S09_02", "q": "Равносильны ли неравенства: $\\frac{1}{x}<1$ и $x>1$?", "key": "нет"}, {"id": "G10_TB_§4_4_5_5", "current_skill": "G10_S09_01", "q": "Равносильны ли неравенства: $x^{2} \\ge x$ и $x \\ge 1$?", "key": "нет"}, {"id": "G10_TB_§4_4_6_3", "current_skill": "G10_S09_02", "q": "Равносильны ли неравенства: $\\frac{x-2}{x-4}>0$ и $x-2>0$?", "key": "нет"}, {"id": "G10_TB_§4_4_7_1", "current_skill": "G10_S07_08", "q": "Какое из двух уравнений является следствием другого: $x^{2}=x$ и $x=1$?", "key": "Уравнение $x^{2}=x$ является следствием уравнения $x=1$."}, {"id": "G10_TB_§4_4_7_2", "current_skill": "G10_S07_07", "q": "Какое из двух уравнений является следствием другого: $\\frac{x}{x}=1$ и $0x=0$?", "key": "Уравнение $0x = 0$ является следствием $\\dfrac{x}{x} = 1$"}, {"id": "G10_TB_§4_4_7_3", "current_skill": "G10_S07_06", "q": "Какое из двух уравнений является следствием другого: $|x|=1$ и $x^{3}=1$?", "key": "Уравнение $|x|=1$ является следствием уравнения $x^{3}=1$"}, {"id": "G10_TB_§4_5", "current_skill": "G10_S09_01", "q": "Какие неравенства называют равносильными?", "key": "Неравенства, множества решений которых равны."}, {"id": "G10_TB_§4_6", "current_skill": "G10_S09_01", "q": "С помощью каких преобразований неравенства можно получить неравенство, равносильное данному?", "key": "Прибавление (вычитание) одного и того же числа к обеим частям; умножение (деление) обеих частей на одно и то же положите"}, {"id": "G10_TB_§4_7", "current_skill": "G10_S09_01", "q": "Какое неравенство называют следствием данного неравенства?", "key": "Неравенство, множество решений которого содержит множество решений данного неравенства."}, {"id": "G10_TB_§5_4_12_7", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x+5}{x+5} > \\frac{1}{2}$", "key": "$(-\\infty; -5) \\cup (-5; +\\infty)$"}, {"id": "G10_TB_§5_4_12_8", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}+1}{x^{2}}\\ge 0$", "key": "$(-\\infty; 0) \\cup (0; +\\infty)$"}, {"id": "G10_TB_§5_4_12_9", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}}{x^{2}+1}\\ge 0$", "key": "$(-\\infty; +\\infty)$"}, {"id": "G10_TB_§5_4_13_1", "current_skill": "G10_S09_01", "q": "Разложите на множители квадратный трёхчлен: $x^{2}+x-6$", "key": "$(x + 3)(x - 2)$"}, {"id": "G10_TB_§5_4_13_2", "current_skill": "G10_S09_01", "q": "Разложите на множители квадратный трёхчлен: $35-2x-x^{2}$", "key": "$-(x + 7)(x - 5)$"}, {"id": "G10_TB_§5_4_13_3", "current_skill": "G10_S09_01", "q": "Разложите на множители квадратный трёхчлен: $2x^{2}+9x-18$", "key": "$(2x - 3)(x + 6)$"}, {"id": "G10_TB_§5_5_12_1", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}+x-20}{x^{2}-6x+9}>0$", "key": "$x \\in (-\\infty; -5) \\cup (4; +\\infty)$"}, {"id": "G10_TB_§5_5_12_2", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{x^{2}+x-20}{x^{2}-6x+9}\\ge0$", "key": "$x \\in (-\\infty; -5] \\cup [4; +\\infty)$"}, {"id": "G10_TB_§5_5_12_3", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}+x-20}{x^{2}-6x+9}<0$", "key": "$x \\in (-5; 3) \\cup (3; 4)$"}, {"id": "G10_TB_§5_5_12_4", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{x^{2}+x-20}{x^{2}-6x+9}\\leq 0$", "key": "$x \\in [-5; 3) \\cup (3; 4]$"}, {"id": "G10_TB_§5_5_12_5", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}-2x+1}{x^{2}+2x-8}>0$", "key": "$x \\in (-\\infty; -4) \\cup (2; +\\infty)$"}, {"id": "G10_TB_§5_5_12_6", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}-2x+1}{x^{2}+2x-8}\\geqslant 0$", "key": "$x \\in (-\\infty; -4) \\cup \\{1\\} \\cup (2; +\\infty)$"}, {"id": "G10_TB_§5_5_12_7", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}-2x+1}{x^{2}+2x-8}<0$", "key": "$x \\in (-4; 1) \\cup (1; 2)$"}, {"id": "G10_TB_§5_5_12_8", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{x^{2}-2x+1}{x^{2}+2x-8}\\leq 0$", "key": "$x \\in (-4; 1] \\cup (1; 2)$"}, {"id": "G10_TB_§5_5_6_3", "current_skill": "G10_S09_02", "q": "Найдите множество решений неравенства: $\\dfrac{x^{2}-x-12}{x^{2}-36}\\le0$", "key": "$x \\in (-6; -3] \\cup [4; 6)$"}, {"id": "G10_TB_§5_5_6_4", "current_skill": "G10_S09_02", "q": "Найдите множество решений неравенства: $\\dfrac{3x^{2}+2x-1}{4x^{2}-x-3}\\ge0$", "key": "$x \\in (-\\infty; -1] \\cup \\left(-\\dfrac{3}{4}; \\dfrac{1}{3}\\right] \\cup (1; +\\infty)$"}, {"id": "G10_TB_§6_6_10", "current_skill": "G10_S13_02", "q": "Расположите в порядке возрастания значения выражений $(1{,}06)^{4}$, $(-0{,}48)^{4}$, $(-2{,}12)^{4}$, $(-3{,}25)^{4}$.", "key": "$(-0,48)^{4}$, $(1,06)^{4}$, $(-2,12)^{4}$, $(-3,25)^{4}$"}, {"id": "G10_TB_§6_6_13_1", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{8}$ на промежутке $[0; 2]$.", "key": "наименьшее $0$, наибольшее $256$"}, {"id": "G10_TB_§6_6_13_2", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{8}$ на промежутке $[-2; -1]$.", "key": "наименьшее $1$, наибольшее $256$"}, {"id": "G10_TB_§6_6_13_3", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{8}$ на промежутке $[-1; 1]$.", "key": "наименьшее $0$, наибольшее $1$"}, {"id": "G10_TB_§6_6_1_1", "current_skill": "G10_S01_04", "q": "Через какие из данных точек проходит график функции $y = x^{5}$: $A(-1$; $1)$?", "key": "нет"}, {"id": "G10_TB_§6_6_1_2", "current_skill": "G10_S01_04", "q": "Через какие из данных точек проходит график функции $y = x^{5}$: $B(2; 32)$?", "key": "да"}, {"id": "G10_TB_§6_6_1_3", "current_skill": "G10_S01_04", "q": "Через какие из данных точек проходит график функции $y = x^{5}$: $C(-3; -243)$?", "key": "да"}, {"id": "G10_TB_§6_6_2_1", "current_skill": "G10_S01_04", "q": "Через какие из данных точек проходит график функции $y = x^{4}$: $A(2; 16)$?", "key": "да"}, {"id": "G10_TB_§6_6_2_2", "current_skill": "G10_S01_04", "q": "Через какие из данных точек проходит график функции $y = x^{4}$: $B\\left(\\frac{-1}{3}; \\frac{1}{81}\\right)$?", "key": "да"}, {"id": "G10_TB_§6_6_2_3", "current_skill": "G10_S01_04", "q": "Через какие из данных точек проходит график функции $y = x^{4}$: $C(0{,}5; -0{,}0625)$?", "key": "нет"}, {"id": "G10_TB_§6_6_3_2", "current_skill": "G10_S05_02", "q": "Функция задана формулой $f(x)=x^{19}$. Сравните: $f(-7{,}6)$ и $f(-8{,}5)$.", "key": "$f(-7,6) > f(-8,5)$"}, {"id": "G10_TB_§6_6_3_3", "current_skill": "G10_S05_02", "q": "Функция задана формулой $f(x)=x^{19}$. Сравните: $f(-6{,}9)$ и $f(6{,}9)$.", "key": "$f(-6,9) < f(6,9)$"}, {"id": "G10_TB_§6_6_3_4", "current_skill": "G10_S05_02", "q": "Функция задана формулой $f(x)=x^{19}$. Сравните: $f(0,2)$ и $f(-12)$.", "key": "$f(0,2) > f(-12)$"}, {"id": "G10_TB_§6_6_4_1", "current_skill": "G10_S05_05", "q": "Функция задана формулой $f(x)=x^{21}$. Сравните: $f(20)$ и $f(17)$.", "key": "$f(20) > f(17)$"}, {"id": "G10_TB_§6_6_4_2", "current_skill": "G10_S05_02", "q": "Функция задана формулой $f(x)=x^{21}$. Сравните: $f(-44)$ и $f(1{,}5)$.", "key": "$f(-44) < f(1,5)$"}, {"id": "G10_TB_§6_6_4_3", "current_skill": "G10_S05_02", "q": "Функция задана формулой $f(x)=x^{21}$. Сравните: $f(-52)$ и $f(-45)$.", "key": "$f(-52) < f(-45)$"}, {"id": "G10_TB_§6_6_5_1", "current_skill": "G10_S05_08", "q": "Функция задана формулой $f(x)=x^{20}$. Сравните: $f(3{,}6)$ и $f(4{,}2)$.", "key": "$f(3,6) < f(4,2)$"}, {"id": "G10_TB_§6_6_5_2", "current_skill": "G10_S05_01", "q": "Функция задана формулой $f(x)=x^{20}$. Сравните: $f(-6{,}7)$ и $f(-5{,}8)$.", "key": "$f(-6,7) > f(-5,8)$"}, {"id": "G10_TB_§6_6_5_3", "current_skill": "G10_S05_01", "q": "Функция задана формулой $f(x)=x^{20}$. Сравните: $f(-2{,}4)$ и $f(2{,}4)$.", "key": "$f(-2,4) = f(2,4)$"}, {"id": "G10_TB_§6_6_5_4", "current_skill": "G10_S01_04", "q": "Функция задана формулой $f(x)=x^{20}$. Сравните: $f(-15)$ и $f(2)$.", "key": "$f(-15) > f(2)$"}, {"id": "G10_TB_§6_6_6_2", "current_skill": "G10_S05_01", "q": "Функция задана формулой $f(x)=x^{50}$. Сравните: $f(-1{,}1)$ и $f(-1{,}2)$.", "key": "$f(-1,1) < f(-1,2)$"}, {"id": "G10_TB_§6_6_6_3", "current_skill": "G10_S05_01", "q": "Функция задана формулой $f(x)=x^{50}$. Сравните: $f(19)$ и $f(-19)$.", "key": "$f(19) = f(-19)$"}, {"id": "G10_TB_§6_6_6_4", "current_skill": "G10_S05_01", "q": "Функция задана формулой $f(x)=x^{50}$. Сравните: $f(-7)$ и $f(9)$.", "key": "$f(-7) < f(9)$"}, {"id": "G10_TB_§6_6_7_1", "current_skill": "G10_S14_01", "q": "Решите уравнение: $x^{5}=32$.", "key": "$x = 2$"}, {"id": "G10_TB_§6_6_7_2", "current_skill": "G10_S07_06", "q": "Решите уравнение: $x^{3} = \\frac{-8}{27}$.", "key": "$x = \\dfrac{-2}{3}$"}, {"id": "G10_TB_§6_6_7_3", "current_skill": "G10_S07_06", "q": "Решите уравнение: $x^{4}=81$.", "key": "$x = -3; x = 3$"}, {"id": "G10_TB_§6_6_7_4", "current_skill": "G10_S11_05", "q": "Решите уравнение: $x^{4} = -16$.", "key": "нет корней"}, {"id": "G10_TB_§6_6_8_1", "current_skill": "G10_S07_06", "q": "Решите уравнение: $x^{3} = -27$.", "key": "$x = -3$"}, {"id": "G10_TB_§6_6_8_2", "current_skill": "G10_S14_01", "q": "Решите уравнение: $x^{5}=0,00032$.", "key": "$x = 0,2$"}, {"id": "G10_TB_§6_6_8_3", "current_skill": "G10_S14_01", "q": "Решите уравнение: $x^{6}=64$.", "key": "$x = -2; x = 2$"}, {"id": "G10_TB_§6_6_8_4", "current_skill": "G10_S11_05", "q": "Решите уравнение: $x^{8} = -1$.", "key": "нет корней"}, {"id": "G10_TB_§6_6_9", "current_skill": "G10_S01_04", "q": "Расположите в порядке убывания значения выражений $(\\frac{-3}{4})^{5}$, $(-2\\frac{1}{3})^{5}$, $(\\frac{-2}{3})^{5}$, $(-2\\frac{2}{5})^{5}$.", "key": "$(\\dfrac{-2}{3})^{5}, (\\dfrac{-3}{4})^{5}, (-2 \\dfrac{1}{3})^{5}, (-2 \\dfrac{2}{5})^{5}$"}, {"id": "G10_TB_§7_6_19_1", "current_skill": "G10_S07_06", "q": "Сколько корней в зависимости от значения $a$ имеет уравнение $x^{12}=a-6$?", "key": "при $a < 6$: $0$ корней; при $a = 6$: $1$ корень; при $a > 6$: $2$ корня"}, {"id": "G10_TB_§7_6_19_2", "current_skill": "G10_S07_06", "q": "Сколько корней в зависимости от значения $a$ имеет уравнение $x^{24}=a^{2}+7a-8$?", "key": "при $a \\in (-8; 1)$: $0$ корней; при $a = -8$ или $a = 1$: $1$ корень; при $a \\in (-\\infty; -8) \\cup (1; +\\infty)$: $2$ "}, {"id": "G10_TB_§7_6_20", "current_skill": "G10_S11_01", "q": "Сколько корней в зависимости от значения $a$ имеет уравнение $x^{8}=9a-a^{3}$?", "key": "при $a \\in (-3; 0) \\cup (3; +\\infty)$: $0$ корней; при $a = -3$, $a = 0$, $a = 3$: $1$ корень; при $a \\in (-\\infty; -3) "}, {"id": "G10_TB_§7_6_21_1", "current_skill": "G10_S05_01", "q": "Чётным или нечётным натуральным числом является показатель степени $n$ функции $f(x)=x^{n}$, если $f(-4)>f(-2)$?", "key": "чётным"}, {"id": "G10_TB_§7_6_21_2", "current_skill": "G10_S05_01", "q": "Чётным или нечётным натуральным числом является показатель степени $n$ функции $f(x)=x^{n}$, если $f(-4)<f(2)$?", "key": "нечётным"}, {"id": "G10_TB_§7_6_21_3", "current_skill": "G10_S05_01", "q": "Чётным или нечётным натуральным числом является показатель степени $n$ функции $f(x)=x^{n}$, если $f(-4)<f(-2)$?", "key": "нечётным"}, {"id": "G10_TB_§7_6_21_5", "current_skill": "G10_S05_01", "q": "Чётным или нечётным натуральным числом является показатель степени $n$ функции $f(x)=x^{n}$, если $f(-4)>f(2)$?", "key": "чётным"}, {"id": "G10_TB_§7_6_21_6", "current_skill": "G10_S05_01", "q": "Чётным или нечётным натуральным числом является показатель степени $n$ функции $f(x)=x^{n}$, если $f(4)>f(-2)$?", "key": "и чётным, и нечётным"}, {"id": "G10_TB_§7_6_22_2", "current_skill": "G10_S14_01", "q": "Вычислите значение выражения: $(\\frac{2}{7})^{-1} + (-2{,}3)^{0} - 5^{-2}$", "key": "$4\\dfrac{23}{50}$"}, {"id": "G10_TB_§7_6_22_6", "current_skill": "G10_S01_04", "q": "Вычислите значение выражения: $(2^{-1} - 8^{-1} \\cdot 16)^{-1}$", "key": "$\\dfrac{-2}{3}$"}, {"id": "G10_TB_§7_6_23_1", "current_skill": "G10_S01_05", "q": "Представьте в виде дроби выражение: $a^{-2} + a^{-3}$", "key": "$\\dfrac{a+1}{a^{3}}$"}, {"id": "G10_TB_§7_6_23_2", "current_skill": "G10_S03_01", "q": "Представьте в виде дроби выражение: $mn^{-4} + m^{-4}n$", "key": "$\\dfrac{m^{5} + n^{5}}{m^{4} n^{4}}$"}, {"id": "G10_TB_§7_6_23_3", "current_skill": "G10_S07_04", "q": "Представьте в виде дроби выражение: $(c^{-1}-d^{-1})(c-d)^{-2}$", "key": "$-1/(cd(c-d))$"}, {"id": "G10_TB_§7_7_14_1", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{-6}$ на промежутке $\\left[\\frac{1}{2}; 1\\right]$.", "key": "наибольшее $64$, наименьшее $1$"}, {"id": "G10_TB_§7_7_14_2", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{-6}$ на промежутке $[-1; \\frac{-1}{2}]$.", "key": "наибольшее $64$, наименьшее $1$"}, {"id": "G10_TB_§7_7_14_3", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{-6}$ на промежутке $[1; +\\infty)$.", "key": "наибольшее $1$, наименьшего нет"}, {"id": "G10_TB_§7_7_15_1", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения функции: $f(x)=x^{-3}$ на промежутке $\\left[\\frac{1}{3}; 2\\right]$.", "key": "наибольшее $27$, наименьшее $\\dfrac{1}{8}$"}, {"id": "G10_TB_§7_7_1_1", "current_skill": "G10_S01_04", "q": "Проходит ли график функции $y = x^{-4}$ через точку $A(2; \\frac{1}{16})$?", "key": "да"}, {"id": "G10_TB_§7_7_1_2", "current_skill": "G10_S01_04", "q": "Проходит ли график функции $y = x^{-4}$ через точку $B(-2; \\frac{1}{8})$?", "key": "нет"}, {"id": "G10_TB_§7_7_1_3", "current_skill": "G10_S02_05", "q": "Проходит ли график функции $y = x^{-4}$ через точку $C\\left(\\frac{1}{3}; 81\\right)$?", "key": "да"}, {"id": "G10_TB_§7_7_1_4", "current_skill": "G10_S02_05", "q": "Проходит ли график функции $y = x^{-4}$ через точку $D(\\sqrt{2}; -\\frac{1}{4})$?", "key": "нет"}, {"id": "G10_TB_§7_7_2_1", "current_skill": "G10_S02_07", "q": "Проходит ли график функции $y = x^{-5}$ через точку $A(0; 0)$?", "key": "нет"}, {"id": "G10_TB_§7_7_2_2", "current_skill": "G10_S01_04", "q": "Проходит ли график функции $y = x^{-5}$ через точку $B(-1; -1)$?", "key": "да"}, {"id": "G10_TB_§7_7_2_3", "current_skill": "G10_S02_05", "q": "Проходит ли график функции $y = x^{-5}$ через точку $C\\left(\\frac{1}{2}; 32\\right)$?", "key": "да"}, {"id": "G10_TB_§7_7_2_4", "current_skill": "G10_S01_04", "q": "Проходит ли график функции $y = x^{-5}$ через точ