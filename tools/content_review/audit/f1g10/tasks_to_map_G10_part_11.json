key": "$1$"}, {"id": "G10_TB_§23_23_1", "current_skill": "G10_S24_01", "q": "Представьте в виде произведения выражение: $1+\\cos 4\\alpha$", "key": "$2cos^{2} 2α$"}, {"id": "G10_TB_§23_23_10", "current_skill": "G10_S24_01", "q": "Найдите: $\\cos 2α$, если $\\sin α = \\frac{-1}{4}$.", "key": "$\\dfrac{7}{8}$"}, {"id": "G10_TB_§23_23_11_1", "current_skill": "G10_S24_04", "q": "Найдите: $\\tg 2α$, если $\\tg α = 4$.", "key": "$\\dfrac{-8}{15}$"}, {"id": "G10_TB_§23_23_1_1", "current_skill": "G10_S24_01", "q": "Примените формулы двойного угла к выражению: $\\cosα$", "key": "$cos^{2}(α/2) - sin^{2}(α/2)$"}, {"id": "G10_TB_§23_23_1_2", "current_skill": "G10_S24_01", "q": "Примените формулы двойного угла к выражению: $\\sin 3α$", "key": "$2 sin(3α/2) cos(3α/2)$"}, {"id": "G10_TB_§23_23_1_3", "current_skill": "G10_S24_04", "q": "Примените формулы двойного угла к выражению: $tan(2x-\\pi/6)$", "key": "$2 tan(x - π/12) / (1 - tan^{2}(x - π/12))$"}, {"id": "G10_TB_§23_23_1_4", "current_skill": "G10_S24_01", "q": "Примените формулы двойного угла к выражению: $\\cos 8α$", "key": "$cos^{2} 4α - sin^{2} 4α$"}, {"id": "G10_TB_§23_23_1_5", "current_skill": "G10_S24_01", "q": "Примените формулы двойного угла к выражению: $\\sin(2x-\\pi/6)$", "key": "$2 sin(x - π/12) cos(x - π/12)$"}, {"id": "G10_TB_§23_23_1_6", "current_skill": "G10_S24_04", "q": "Примените формулы двойного угла к выражению: $\\tg 7α$", "key": "$2 tg(7α/2) / (1 - tg^{2}(7α/2))$"}, {"id": "G10_TB_§23_23_1_7", "current_skill": "G10_S24_01", "q": "Примените формулы двойного угла к выражению: $\\sin(α-β)$", "key": "$2 sin(\\dfrac{α-β}{2}) cos(\\dfrac{α-β}{2})$"}, {"id": "G10_TB_§23_23_1_8", "current_skill": "G10_S24_04", "q": "Примените формулы двойного угла к выражению: $\\tg 3$", "key": "$\\dfrac{2 \\tg{1{,}5}}{1 - \\tg^{2}{1{,}5}}$"}, {"id": "G10_TB_§23_23_2", "current_skill": "G10_S24_01", "q": "Представьте в виде произведения выражение: $1-\\cos 6\\alpha$", "key": "$2sin^{2} 3α$"}, {"id": "G10_TB_§23_23_2_1", "curren