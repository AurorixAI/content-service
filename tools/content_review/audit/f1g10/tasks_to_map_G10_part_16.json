[{"id": "G10_TB_§40_40_9_1", "current_skill": "G10_S05_07", "q": "Найдите наибольшее и наименьшее значения функции: $f$ на указанном промежутке: $f(x)=2\\sin 2x+\\cos 4x$, $[0; \\frac{\\pi}{3}]$", "key": "Наибольшее: $\\dfrac{3}{2}$, наименьшее: $1$"}, {"id": "G10_TB_§40_40_9_2", "current_skill": "G10_S05_07", "q": "Найдите наибольшее и наименьшее значения функции: $f$ на указанном промежутке: $f(x)=\\sqrt{3}\\sin 2x+\\cos 2x-5$, $[0; \\frac{\\pi}{3}]$", "key": "Наибольшее: $-3$, наименьшее: $-4$"}, {"id": "G10_TB_§40_40_9_3", "current_skill": "G10_S24_05", "q": "Найдите наибольшее и наименьшее значения функции: $f$ на указанном промежутке: $f(x)=2\\sin x+\\sin 2x$, $[0; \\frac{3\\pi}{2}]$", "key": "Наибольшее: $\\dfrac{3\\sqrt{3}}{2}$, наименьшее: $-2$"}, {"id": "G10_TB_§42_42_15_6", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\ \\frac{x^{3}-4x^{2}+3x}{x^{2}-5x+6}>0$", "key": "$x \\in (0; 1) \\cup (2; 3) \\cup (3; +\\infty)$"}, {"id": "G10_TB_§42_42_16_1", "current_skill": "G10_S09_02", "q": "Найдите множество решений неравенства: $\\frac{(x^{2}-9)\\sqrt{2-x}}{2x+3} \\geq 0$", "key": "$x \\in [-3; -1{,}5) \\cup \\{2\\}$"}, {"id": "G10_TB_§42_42_16_2", "current_skill": "G10_S09_02", "q": "Найдите множество решений неравенства: $\\frac{(x+1)^{2} \\sqrt{x+3}}{16-x^{2}} \\leq 0$", "key": "$x \\in \\{-3; -1\\} \\cup (4; +\\infty)$"}, {"id": "G10_TB_§42_42_17_1", "current_skill": "G10_S11_05", "q": "Найдите значение выражения: $4(-\\sqrt[7]{5})^{7} - 0{,}6\\sqrt[3]{1000} + \\left(\\dfrac{1}{2}\\sqrt[4]{640}\\right)^{4}$", "key": "$14$"}, {"id": "G10_TB_§42_42_17_2", "current_skill": "G10_S11_05", "q": "Найдите значение выражения: $\\sqrt[4]{5\\frac{1}{16}} \\cdot \\sqrt[5]{\\frac{-32}{243}} + (-3\\sqrt[3]{6})^3$", "key": "$-163$"}, {"id": "G10_TB_§42_42_17_3", "current_skill": "G10_S17_02", "q": "Найдите значение выражения: $⁵√2/⁵√486+⁶√(3⁴·7)·⁶√(3²·7⁵)$", "key": "$21 \\dfrac{1}{3}$"}, {"id": "G10_TB_§42_42_17_4", "current_skill": "G10_S11_05", "q": "Найдите значение выражения: $\\sqrt[3]{10+\\sqrt{73}} \\cdot \\sqrt[3]{10-\\sqrt{73}}$", "key": "$3$"}, {"id": "G10_TB_§42_42_17_6", "current_skill": "G10_S11_05", "q": "Найдите значение выражения: $\\sqrt[3]{\\sqrt{2} - \\sqrt[4]{12}} \\cdot \\sqrt[3]{2 + 2\\sqrt{3}} \\cdot \\sqrt[3]{\\sqrt[4]{12} + \\sqrt{2}}$", "key": "$-2$"}, {"id": "G10_TB_§42_42_18_1", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y = \\sqrt[4]{3x - 5}$", "key": "$x \\ge \\dfrac{5}{3}$"}, {"id": "G10_TB_§42_42_18_2", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y=^{6}√(-x)$", "key": "$x ≤ 0$"}, {"id": "G10_TB_§42_42_18_3", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y = \\sqrt[5]{x-4}$", "key": "$x \\in \\mathbb{R}$"}, {"id": "G10_TB_§42_42_18_4", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y = \\sqrt[8]{6x - x^2}$", "key": "$x \\in [0; 6]$"}, {"id": "G10_TB_§42_42_19_1", "current_skill": "G10_S01_04", "q": "Упростите выражение: $\\sqrt[6]{a^6}$, если $a \\geq 0$", "key": "$a$"}, {"id": "G10_TB_§42_42_19_2", "current_skill": "G10_S11_01", "q": "Упростите выражение: $\\sqrt[4]{b^4}$, если $b \\leq 0$", "key": "$-b$"}, {"id": "G10_TB_§42_42_19_3", "current_skill": "G10_S01_04", "q": "Упростите выражение: $\\sqrt[7]{c^7}$", "key": "$c$"}, {"id": "G10_TB_§42_42_19_4", "current_skill": "G10_S17_02", "q": "Упростите выражение: $^{4}√(81m^{8}n^{20}p^{4})$, если $n\\leq 0$, $p\\geq 0$", "key": "$-3m^{2}n^{5}p$"}, {"id": "G10_TB_§42_42_19_5", "current_skill": "G10_S11_05", "q": "Упростите выражение: $1{,}4x\\sqrt[8]{256x^{24}}$, если $x\\leq 0$", "key": "$-2.8x⁴$"}, {"id": "G10_TB_§42_42_19_6", "current_skill": "G10_S17_02", "q": "Упростите выражение: $\\dfrac{\\sqrt[12]{a^{12} b^{24} c^{36}}}{abc}$, если $a<0$, $c<0$", "key": "$b c^{2}$"}, {"id": "G10_TB_§42_42_1_1", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $f(x)=\\sqrt{x-5}$", "key": "$x \\ge 5$"}, {"id": "G10_TB_§42_42_1_11", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $f(x)=\\sqrt{x-2}+\\sqrt{2-x}$", "key": "$x = 2$"}, {"id": "G10_TB_§42_42_1_15", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $f(x)=\\sqrt{-x^{2}-8x+9}$", "key": "$-9 \\le x \\le 1$"}, {"id": "G10_TB_§42_42_1_9", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $f(x)=\\sqrt{x+5}+\\sqrt{3-x}$", "key": "$-5 \\le x \\le 3$"}, {"id": "G10_TB_§42_42_21_1", "current_skill": "G10_S11_01", "q": "Упростите выражение: $\\sqrt[4]{((2-\\sqrt{7})^4)}-\\sqrt{7}$", "key": "$-2$"}, {"id": "G10_TB_§42_42_21_2", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[5]{((7-\\sqrt{35})^5)} - \\sqrt[6]{((\\sqrt{35}-6)^6)}$", "key": "$1$"}, {"id": "G10_TB_§42_42_22_1", "current_skill": "G10_S11_05", "q": "Вынесите множитель из-под знака корня: $^{4}√a^{11}$", "key": "$a² ⁴√a³$"}, {"id": "G10_TB_§42_42_22_2", "current_skill": "G10_S11_05", "q": "Вынесите множитель из-под знака корня: $\\sqrt[3]{-b^{16}}$", "key": "$-b^{5} \\sqrt[3]{b}$"}, {"id": "G10_TB_§42_42_22_3", "current_skill": "G10_S17_02", "q": "Вынесите множитель из-под знака корня: $^{4}√(162m^{10}n^{7})$", "key": "$3m^{2} n \\sqrt[4]{2m^{2} n^{3}}$"}, {"id": "G10_TB_§42_42_22_4", "current_skill": "G10_S17_02", "q": "Вынесите множитель из-под знака корня: $^{5}√(96x^{12}y^{16})$", "key": "$2x^{2} y^{3} \\sqrt[5]{3x^{2} y}$"}, {"id": "G10_TB_§42_42_22_5", "current_skill": "G10_S11_05", "q": "Вынесите множитель из-под знака корня: $^{4}√(-243y^{5})$", "key": "Нет действительного значения"}, {"id": "G10_TB_§42_42_22_6", "current_skill": "G10_S11_05", "q": "Вынесите множитель из-под знака корня: $^{6}√(a^{14}b^{9})$", "key": "$a²b ⁶√(a²b³)$"}, {"id": "G10_TB_§42_42_23_1", "current_skill": "G10_S11_05", "q": "Освободитесь от иррациональности в знаменателе дроби $: 1)5/∛4$", "key": "$\\dfrac{5\\sqrt[3]{2}}{2}$"}, {"id": "G10_TB_§42_42_23_2", "current_skill": "G10_S11_01", "q": "Освободитесь от иррациональности в знаменателе дроби $: 2)12/^{4}√27$", "key": "$4 ⁴√3$"}, {"id": "G10_TB_§42_42_23_3", "current_skill": "G10_S11_05", "q": "Освободитесь от иррациональности в знаменателе дроби: $\\frac{6}{\\sqrt[3]{8}}$", "key": "$3$"}, {"id": "G10_TB_§42_42_23_4", "current_skill": "G10_S11_05", "q": "Освободитесь от иррациональности в знаменателе дроби $: 4)14/∛(-49)$", "key": "$-2∛7$"}, {"id": "G10_TB_§42_42_23_5", "current_skill": "G10_S11_01", "q": "Освободитесь от иррациональности в знаменателе дроби: $\\ \\frac{9}{4-\\sqrt{7}}$", "key": "$4 + \\sqrt{7}$"}, {"id": "G10_TB_§42_42_23_7", "current_skill": "G10_S11_05", "q": "Освободитесь от иррациональности в знаменателе дроби: $\\ \\frac{6}{2-\\sqrt[3]{5}}$", "key": "$8 + 4\\sqrt[3]{5} + 2\\sqrt[3]{25}$"}, {"id": "G10_TB_§42_42_23_8", "current_skill": "G10_S11_05", "q": "Освободитесь от иррациональности в знаменателе дроби: $\\ \\frac{8}{\\sqrt[3]{25} - \\sqrt[3]{5} + 1}$", "key": "$\\dfrac{4(\\sqrt[3]{5} + 1)}{3}$"}, {"id": "G10_TB_§42_42_24_1", "current_skill": "G10_S11_01", "q": "Упростите выражение: $\\sqrt{a\\sqrt{a}}$", "key": "$a^{\\frac{3}{4}}$"}, {"id": "G10_TB_§42_42_24_2", "current_skill": "G10_S17_02", "q": "Упростите выражение: $\\sqrt[3]{b \\sqrt[3]{b^2}}$", "key": "$b^{\\frac{5}{9}}$"}, {"id": "G10_TB_§42_42_2_1", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $f(x)=\\sqrt{x}+1$", "key": "$[1; +\\infty)$"}, {"id": "G10_TB_§42_42_2_10", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $f(x)=\\frac{1}{x^{2}+1}$", "key": "$(0; 1]$"}, {"id": "G10_TB_§42_42_2_2", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $f(x)=\\sqrt{x}-2$", "key": "$[-2; +\\infty)$"}, {"id": "G10_TB_§42_42_2_3", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $g(x)=3-x^{2}$", "key": "$(-\\infty; 3]$"}, {"id": "G10_TB_§42_42_2_5", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $\\varphi(x)=5+|x|$", "key": "$[5; +\\infty)$"}, {"id": "G10_TB_§42_42_2_7", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $f(x)=\\sqrt{-x^{2}}$", "key": "$\\{0\\}$"}, {"id": "G10_TB_§42_42_2_8", "current_skill": "G10_S02_02", "q": "Найдите область значений функции: $f(x) = \\sqrt{x - 3} - \\sqrt{3 - x}$", "key": "$\\{0\\}$"}, {"id": "G10_TB_§42_42_2_9", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $f(x)=\\sqrt{1-x^{2}}$", "key": "$[0; 1]$"}, {"id": "G10_TB_§42_42_32_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\frac{4-x}{2+\\sqrt{x}}=8-x$", "key": "$9$"}, {"id": "G10_TB_§42_42_33_1", "current_skill": "G10_S02_05", "q": "При каких значениях $a$ возможно равенство: $\\cos x = a + 4$", "key": "$a \\in [-5; -3]$"}, {"id": "G10_TB_§42_42_33_2", "current_skill": "G10_S24_01", "q": "При каких значениях $a$ возможно равенство: $\\sin x = 6a - a^{2} - 10$", "key": "$a=3$"}, {"id": "G10_TB_§42_42_34_1", "current_skill": "G10_S22_06", "q": "Сравните с нулём значение выражения: $\\sin 168^\\circ\\cos 126^\\circ$", "key": "$<0$"}, {"id": "G10_TB_§42_42_34_2", "current_skill": "G10_S22_02", "q": "Сравните с нулём значение выражения: $\\operatorname{\\tg } 206^\\circ \\cos(-223^\\circ)$", "key": "$<0$"}, {"id": "G10_TB_§42_42_34_3", "current_skill": "G10_S22_06", "q": "Сравните с нулём значение выражения: $\\cos 4 \\operatorname{\\tg } 3$", "key": "$>0$"}, {"id": "G10_TB_§42_42_35_1", "current_skill": "G10_S22_01", "q": "Найдите значение выражения: $\\sin 780^\\circ$", "key": "$\\dfrac{\\sqrt{3}}{2}$"}, {"id": "G10_TB_§42_42_35_2", "current_skill": "G10_S22_01", "q": "Найдите значение выражения: $\\operatorname{\\tg } 900^\\circ$", "key": "$0$"}, {"id": "G10_TB_§42_42_35_4", "current_skill": "G10_S22_02", "q": "Найдите значение выражения: $\\operatorname{\\ctg }(-585^\\circ)$", "key": "$-1$"}, {"id": "G10_TB_§42_42_35_5", "current_skill": "G10_S22_01", "q": "Найдите значение выражения: $\\cos\\frac{11\\pi}{6}$", "key": "$\\dfrac{\\sqrt{3}}{2}$"}, {"id": "G10_TB_§42_42_35_6", "current_skill": "G10_S22_02", "q": "Найдите значение выражения: $\\sin\\left(-\\frac{17\\pi}{3}\\right)$", "key": "$\\dfrac{\\sqrt{3}}{2}$"}, {"id": "G10_TB_§42_42_38_1", "current_skill": "G10_S22_01", "q": "Вычислите: $\\operatorname{\\ctg}\\alpha$, если $\\sin\\alpha=-\\frac{5}{\\sqrt{34}}$, $\\frac{3\\pi}{2}<\\alpha<2\\pi$", "key": "$\\dfrac{-3}{5}$"}, {"id": "G10_TB_§42_42_38_2", "current_skill": "G10_S22_01", "q": "Вычислите: $\\sin\\alpha$, если $\\operatorname{\\tg }\\alpha=3$, $\\pi<\\alpha<\\frac{3\\pi}{2}$", "key": "$-\\dfrac{3}{\\sqrt{10}}$"}, {"id": "G10_TB_§42_42_39_1", "current_skill": "G10_S22_02", "q": "Упростите выражение: $\\sin^{3}\\alpha + \\cos^{3}\\alpha \\operatorname{\\tg }\\alpha$", "key": "$\\sin \\alpha$"}, {"id": "G10_TB_§42_42_39_2", "current_skill": null, "q": "Упростите выражение: $\\cos^{2}\\alpha - \\operatorname{\\ctg }^{2}\\alpha \\sin^{4}\\alpha$", "key": "$\\cos^4 \\alpha$"}, {"id": "G10_TB_§42_42_39_3", "current_skill": "G10_S22_05", "q": "Упростите выражение: $(\\sin^{2}\\alpha + \\operatorname{\\tg }^{2}\\alpha \\sin^{2}\\alpha) \\operatorname{\\ctg }\\alpha$", "key": "$\\tg α$"}, {"id": "G10_TB_§42_42_39_4", "current_skill": "G10_S24_04", "q": "Упростите выражение: $\\frac{1-(\\sin\\alpha+\\cos\\alpha)^{2}}{\\sin\\alpha\\cos\\alpha-\\operatorname{\\ctg }\\alpha}$", "key": "$2\\operatorname{tg}^{2}\\alpha$"}, {"id": "G10_TB_§42_42_40_1", "current_skill": "G10_S05_06", "q": "Найдите наибольшее и наименьшее значения выражения: $2\\cos^{2}\\alpha - 3\\sin^{2}\\alpha$", "key": "$\\max = 2$, $\\min = -3$"}, {"id": "G10_TB_§42_42_40_2", "current_skill": "G10_S02_05", "q": "Найдите наибольшее и наименьшее значения выражения: $4\\cos^{2}\\alpha - \\operatorname{\\tg }\\alpha \\operatorname{\\ctg }\\alpha$", "key": "Наибольшего и наименьшего значений не существует"}, {"id": "G10_TB_§42_42_41_1", "current_skill": "G10_S22_02", "q": "Упростите выражение: $\\sin\\left(\\frac{\\pi}{2}-\\alpha\\right)+\\cos(\\pi-\\alpha)+\\operatorname{\\tg }\\left(\\frac{3\\pi}{2}+\\alpha\\right)+\\operatorname{\\ctg }(\\pi+\\alpha)$", "key": "$0$"}, {"id": "G10_TB_§42_42_41_2", "current_skill": "G10_S24_01", "q": "Упростите выражение: $\\sin\\left(\\alpha+\\frac{\\pi}{2}\\right) \\sin(\\pi-\\alpha) + \\cos\\left(\\alpha+\\frac{\\pi}{2}\\right) \\cos(2\\pi-\\alpha)$", "key": "$0$"}, {"id": "G10_TB_§42_42_41_3", "current_skill": "G10_S22_02", "q": "Упростите выражение: $\\frac{\\sin(2\\pi-\\alpha) \\operatorname{\\tg }\\left(\\frac{3\\pi}{2}-\\alpha\\right) \\operatorname{\\ctg }\\left(\\frac{\\pi}{2}+\\alpha\\right)}{\\cos(2\\pi+\\alpha) \\operatorname{\\tg }(\\pi+\\alpha)}$", "key": "$1$"}, {"id": "G10_TB_§42_42_41_4", "current_skill": "G10_S24_04", "q": "Упростите выражение: $\\frac{\\operatorname{\\ctg}\\left(\\alpha-\\frac{3\\pi}{2}\\right)}{1-\\operatorname{\\tg}^{2}(\\alpha-3\\pi)}\\cdot\\frac{\\operatorname{\\ctg}^{2}(5\\pi-\\alpha)-1}{\\operatorname{\\tg}\\left(\\frac{\\pi}{2}+\\alpha\\right)}$", "key": "$1$"}, {"id": "G10_TB_§42_42_42", "current_skill": "G10_S24_01", "q": "Дано: $\\sin\\alpha=-0{,}8$, $\\cos\\beta=0{,}6$, $\\pi<\\alpha<\\frac{3\\pi}{2}$, $\\frac{3\\pi}{2}<\\beta<2\\pi$. Найдите $\\cos(\\alpha+\\beta)$.", "key": "$-1$"}, {"id": "G10_TB_§42_42_43_1", "current_skill": "G10_S24_04", "q": "Докажите тождество: $\\sin\\alpha \\sin\\beta (\\operatorname{\\ctg }\\alpha + \\operatorname{\\ctg }\\beta) = \\sin(\\alpha + \\beta)$", "key": "$\\sin\\alpha\\sin\\beta(\\operatorname{ctg}\\alpha + \\operatorname{ctg}\\beta) = \\sin\\alpha\\sin\\beta \\cdot \\dfrac{\\cos\\alpha\\s"}, {"id": "G10_TB_§42_42_43_2", "current_skill": "G10_S24_04", "q": "Докажите тождество: $\\frac{2\\sin\\alpha\\cos\\beta-\\sin(\\alpha-\\beta)}{\\cos(\\alpha-\\beta)-2\\sin\\alpha\\sin\\beta}=\\operatorname{\\tg }(\\alpha+\\beta)$", "key": "Числитель $2\\sin\\alpha\\cos\\beta - (\\sin\\alpha\\cos\\beta - \\cos\\alpha\\sin\\beta) = \\sin(\\alpha + \\beta)$, знаменатель $(\\co"}, {"id": "G10_TB_§42_42_43_3", "current_skill": "G10_S24_04", "q": "Докажите тождество: $\\frac{\\sqrt{2}\\cos\\alpha-2\\cos\\left(\\frac{\\pi}{4}+\\alpha\\right)}{2\\sin\\left(\\frac{\\pi}{4}+\\alpha\\right)-\\sqrt{2}\\sin\\alpha}=\\operatorname{\\tg }\\alpha$", "key": "Числитель $\\sqrt{2}\\cos\\alpha - 2\\left(\\dfrac{\\sqrt{2}}{2}\\cos\\alpha - \\dfrac{\\sqrt{2}}{2}\\sin\\alpha\\right) = \\sqrt{2}\\s"}, {"id": "G10_TB_§42_42_44", "current_skill": "G10_S05_07", "q": "Найдите наибольшее значение выражения $\\cos\\alpha+\\sin\\alpha$.", "key": "$√2$"}, {"id": "G10_TB_§42_42_45_1", "current_skill": "G10_S24_04", "q": "Упростите выражение: $\\frac{\\sin 2\\alpha}{1+\\cos 2\\alpha}$", "key": "$\\operatorname{tg} \\alpha$"}, {"id": "G10_TB_§42_42_4_1", "current_skill": "G10_S02_02", "q": "Найдите нули функции: $f(x)=\\sqrt{x+7}$", "key": "$x = -7$"}, {"id": "G10_TB_§42_42_4_2", "current_skill": "G10_S07_07", "q": "Найдите нули функции: $f(x)=\\frac{x^{2}+4x-5}{x-1}$", "key": "$x = -5$"}, {"id": "G10_TB_§42_42_4_3", "current_skill": "G10_S11_01", "q": "Найдите нули функции: $f(x)=\\sqrt{x^{2}-6}$", "key": "$x = \\pm \\sqrt{6}$"}, {"id": "G10_TB_§42_42_4_4", "current_skill": "G10_S02_02", "q": "Найдите нули функции: $f(x)=(x-3)\\sqrt{x-4}$", "key": "$x = 4$"}, {"id": "G10_TB_§42_42_54_13", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\sin x+\\sin 5x=0$", "key": "$x = \\dfrac{\\pi k}{3}$; $x = \\dfrac{\\pi}{4} + \\dfrac{\\pi k}{2}$, $k \\in \\mathbb{Z}$"}, {"id": "G10_TB_§42_42_54_15", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\cos 2x + \\cos 6x = 3 \\cos 4x$", "key": "$x = \\dfrac{\\pi}{8} + \\dfrac{\\pi n}{4}$, $n \\in \\mathbb{Z}$"}, {"id": "G10_TB_§42_42_54_16", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\cos x - \\cos 3x = \\sqrt{2} \\sin 2x$", "key": "$x = \\dfrac{\\pi k}{2}$; $x = (-1)^{k}\\dfrac{\\pi}{4} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G10_TB_§42_42_54_6", "current_skill": "G10_S24_04", "q": "Решите уравнение $: 2\\tan x+3\\tan x=5$", "key": "$x = π/4 + πk, k ∈ Z$"}, {"id": "G10_TB_§42_42_54_7", "current_skill": "G10_S24_02", "q": "Решите уравнение $: \\sin x+2\\cos x=0$", "key": "$x = -\\arctg 2 + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G10_TB_§42_42_6_1", "current_skill": "G10_S02_07", "q": "Задайте формулой какую-нибудь функцию, область определения которой состоит из одного числа", "key": "$√(x-5)+√(5-x)$"}, {"id": "G10_TB_§42_42_6_2", "current_skill": "G10_S02_07", "q": "Задайте формулой какую-нибудь функцию, область определения которой состоит из двух чисел", "key": "$y = \\sqrt{x-1} + \\sqrt{3-x}$"}, {"id": "G10_TB_§42_42_6_3", "current_skill": "G10_S02_07", "q": "Задайте формулой какую-нибудь функцию, область определения которой — промежуток $[0; 1]$", "key": "$\\sqrt{x-x^{2}}$"}, {"id": "G10_TB_§42_42_7_1", "current_skill": "G10_S02_05", "q": "Задайте формулой какую-нибудь функцию, область значений которой состоит из одного числа", "key": "$5$"}, {"id": "G10_TB_§42_42_7_2", "current_skill": "G10_S02_05", "q": "Задайте формулой какую-нибудь функцию, область значений которой состоит из двух чисел", "key": "$(-1)^{x}$"}, {"id": "G10_TB_§42_42_7_3", "current_skill": "G10_S02_05", "q": "Выберите функцию, область значений которой — интервал $(1;2)$. Для каждого варианта используйте указанную рядом область определения.", "key": "$f(x)=1+\\dfrac{1}{1+x^{2}},\\quad x\\in\\mathbb{R}\\setminus\\{0\\}$"}, {"id": "G10_TB_§4_1", "current_skill": "G10_S02_07", "q": "Что называют областью определения уравнения $f(x)=g(x)$?", "key": "Множество всех значений переменной $x$, при которых обе части уравнения имеют смысл."}, {"id": "G10_TB_§4_2", "current_skill": "G10_S07_08", "q": "Какие уравнения называют равносильными?", "key": "Уравнения, имеющие одно и то же множество корней."}, {"id": "G10_TB_§4_3_12", "current_skill": "G10_S04_05", "q": "Докажите, что функция , обратная к линейной функции: $y=kx+b$ при $k\\neq 0$, также является линейной.", "key": "Из $y = kx + b$ при $k \\ne 0$ получаем $x = \\dfrac{1}{k}y - \\dfrac{b}{k}$, т. е. обратная функция $y = \\dfrac{1}{k}x - \\"}, {"id": "G10_TB_§4_3_13", "current_skill": "G10_S04_07", "q": "Докажите, что функция , обратная к нечётной функции, также является нечётной.", "key": "Множество значений нечётной функции $f$ симметрично относительно нуля, и если $y = f(x)$, то $-y = f(-x)$; поэтому $f^{-"}, {"id": "G10_TB_§4_3_14", "current_skill": "G10_S07_01", "q": "Через первую трубу бассейн можно наполнить водой за $9$ ч, а через вторую — за $12$ ч. Сначала $3$ ч была открыта первая труба, потом её закрыли, но открыли вторую. За сколько часов был наполнен бассейн?", "key": "$11$"}, {"id": "G10_TB_§4_3_15", "current_skill": "G10_S07_06", "q": "Две бригады, работая вместе, вспахали поле за $8$ ч. За сколько часов может вспахать поле каждая бригада, работая самостоятельно, если одной бригаде для этого требуется на $12$ ч больше, чем другой?", "key": "$12 и 24$"}, {"id": "G10_TB_§4_3_16_1", "current_skill": "G10_S01_01", "q": "Равны ли множества $A$ и $B$, если: $A = \\{1, 2\\}$, $B = \\{2, 1\\}$?", "key": "да"}, {"id": "G10_TB_§4_3_16_2", "current_skill": "G10_S09_01", "q": "Равны ли множества $A$ и $B$, если: $A=[-1; 2), B=(-1; 2]$?", "key": "нет"}, {"id": "G10_TB_§4_3_16_3", "current_skill": "G10_S09_01", "q": "Равны ли множества $A$ и $B$, если: $A$ — множество корней уравнения $|x|=x$, $B=[0; +\\infty )?$", "key": "да"}, {"id": "G10_TB_§4_3_17", "current_skill": "G10_S01_01", "q": "Запишите все подмножества множества $\\{-1, 0, 2\\}$.", "key": "$∅, \\{-1\\}, \\{0\\}, \\{2\\}, \\{-1, 0\\}, \\{-1, 2\\}, \\{0, 2\\}, \\{-1, 0, 2\\}$"}, {"id": "G10_TB_§4_3_18_1", "current_skill": "G10_S09_01", "q": "Какие из следующих множеств являются подмножествами множества $A=[-3; +\\infty ): B=[2; +\\infty )?$", "key": "да"}, {"id": "G10_TB_§4_3_18_2", "current_skill": "G10_S09_01", "q": "Какие из следующих множеств являются подмножествами множества $A=[-3; +\\infty ): C=[-3,5; +\\infty )?$", "key": "нет"}, {"id": "G10_TB_§4_3_18_3", "current_skill": "G10_S09_01", "q": "Какие из следующих множеств являются подмножествами множества $A=[-3; +\\infty ): D=(-1; 2]$?", "key": "да"}, {"id": "G10_TB_§4_4", "current_skill": "G10_S07_08", "q": "Какое уравнение называют следствием данного уравнения?", "key": "Уравнение, множество корней которого содержит все корни данного уравнения."}, {"id": "G10_TB_§4_4_1_1", "current_skill": "G10_S07_06", "q": "Равносильны ли уравнения: $-2x=-6$ и $\\frac{1}{3}x=1$?", "key": "да"}, {"id": "G10_TB_§4_4_1_10", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x^{2}-9}{x+2}=0$ и $x^{2}-9=0$?", "key": "да"}, {"id": "G10_TB_§4_4_1_2", "current_skill": "G10_S07_08", "q": "Равносильны ли уравнения: $x-5=0$ и $x(x-5)=0$?", "key": "нет"}, {"id": "G10_TB_§4_4_1_3", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{6}{x}=0$ и $x^{2}=-4$?", "key": "да"}, {"id": "G10_TB_§4_4_1_4", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $x+1=1+x$ и $\\frac{x^{2}+1}{x^{2}+1}=1$?", "key": "да"}, {"id": "G10_TB_§4_4_1_5", "current_skill": "G10_S07_06", "q": "Равносильны ли уравнения: $x^{3}=1$ и $|x|=1$?", "key": "нет"}, {"id": "G10_TB_§4_4_1_6", "current_skill": "G10_S14_01", "q": "Равносильны ли уравнения: $x^{100}=1$ и $x^{1000}=1$?", "key": "да"}, {"id": "G10_TB_§4_4_1_7", "current_skill": "G10_S07_07", "q": "Равносильны ли уравнения: $\\frac{x}{x}=1$ и $x=x$?", "key": "нет"}]