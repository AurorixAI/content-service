[{"id": "G10_TB_1_7_7_a", "current_skill": "G10_S05_07", "q": "Зулайхо получила заказ на пошив рубашек. Если она сошьёт $x$ рубашек за один день, то заработает $P(x) = -x^{2} + 20x$ (тысяч) сумов. a) Сколько рубашек она должна сшить, чтобы получить максимальную прибыль?", "key": "$10$"}, {"id": "G10_TB_1_7_7_b", "current_skill": "G10_S05_07", "q": "Зулайхо получила заказ на пошив рубашек. Если она сошьёт $x$ рубашек за один день, то заработает $P(x) = -x^{2} + 20x$ (тысяч) сумов. b) Каким может быть её наибольший доход?", "key": "$100$"}, {"id": "G10_TB_1_7_8", "current_skill": "G10_S01_04", "q": "В $2005$ году население Зарафшана составляло около $55000$ человек. В то время население росло со скоростью около $2000$ человек в год. Постройте линейную модель, чтобы найти население Зарафшана для любого года. Какова была численность населения Зарафшана в $2010$ году? Определите численность населения Зарафшана в $2025$ году.", "key": "$P(t) = 55000 + 2000(t - 2005); 65000; 95000$"}, {"id": "G10_TB_1_8_1", "current_skill": "G10_S02_05", "q": "Найдите множество значений функции: $y = x^{2} + 2$", "key": "$[2; \\infty)$"}, {"id": "G10_TB_1_8_1_b", "current_skill": "G10_S01_02", "q": "Напишите соответствующую историю для графика, не соответствующего ни одной истории.", "key": "Пример истории: Утром я достала мясо из морозилки и сразу поставила его в духовку. Через некоторое время я выключила дух"}, {"id": "G10_TB_1_8_4", "current_skill": "G10_S02_05", "q": "Найдите множество значений функции: $y = 3 - 4x^{2}$", "key": "$(-\\infty; 3]$"}, {"id": "G10_TB_1_9_1", "current_skill": "G10_S05_07", "q": "Определите значение: $x$, при котором функция принимает своё наибольшее (или наименьшее) значение. Вычислите значение функции. $y = x^{2} + 9x + 34$", "key": "$x = \\dfrac{-9}{2}; y = \\dfrac{55}{4}$"}, {"id": "G10_TB_1_9_2", "current_skill": "G10_S05_07", "q": "Определите значение $x$, при котором функция принимает своё наибольшее (или наименьшее) значение. Вычислите значение функции. $y = -9x^{2} - 3x + 7$", "key": "$x = -\\dfrac{1}{6}; y = \\dfrac{29}{4}$"}, {"id": "G10_TB_1_9_3", "current_skill": "G10_S05_07", "q": "Определите значение $x$, при котором функция принимает своё наибольшее (или наименьшее) значение. Вычислите значение функции. $y = -2x^{2} - 5x + 1$", "key": "$x = \\dfrac{-5}{4}; y = \\dfrac{33}{8}$"}, {"id": "G10_TB_2_1", "current_skill": "G10_S09_01", "q": "Решить неравенство $x^{2}-5x+6<0$.", "key": "$(2; 3)$"}, {"id": "G10_TB_2_10_a", "current_skill": "G10_S09_01", "q": "Решите неравенство графиком квадратичной функции: $2x^{2}+5x-3>0$", "key": "$(-\\infty; -3) \\cup (\\dfrac{1}{2}; \\infty)$"}, {"id": "G10_TB_2_10_b", "current_skill": "G10_S09_01", "q": "Решите неравенство графиком квадратичной функции: $4x^{2}-9x-90>0$", "key": "$(-\\infty; -\\dfrac{15}{4}) \\cup (6; \\infty)$"}, {"id": "G10_TB_2_12_a", "current_skill": "G10_S09_01", "q": "Найдите сумму всех целых чисел, удовлетворяющих неравенству: $2x^{2}-9x+4<0$", "key": "$6$"}, {"id": "G10_TB_2_12_b", "current_skill": "G10_S09_01", "q": "Найдите сумму всех целых чисел, удовлетворяющих неравенству: $\\frac{x-1}{4}+\\frac{3-2x}{2}>\\frac{3x+x^{2}}{8}$", "key": "$-45$"}, {"id": "G10_TB_2_13", "current_skill": "G10_S09_01", "q": "Сколько целых чисел из отрезка $[0;9]$ удовлетворяют неравенству $3x(x-2)-2x(x+4)-(x-16)\\leq 0$?", "key": "$8$"}, {"id": "G10_TB_2_1_10", "current_skill": "G10_S07_07", "q": "Найдите корни уравнения: $\\frac{-2x-4}{x^{2}-4} = \\frac{x+5}{x-2}$.", "key": "$x = -7$"}, {"id": "G10_TB_2_1_11", "current_skill": "G10_S07_07", "q": "Решите уравнение $\\left( \\frac{(x^{2} - x - 56)(x - 3)}{x^{2} + 5x + 6} = 0 \\right)$.", "key": "$x_1 = 8; x_2 = -7; x_3 = 3$"}, {"id": "G10_TB_2_1_12", "current_skill": "G10_S07_07", "q": "Найдите корни уравнения: $\\frac{2}{(x-2)(x+2)} - \\frac{1}{x(x-2)} = \\frac{4-x}{x(x+2)}$.", "key": "$x = 3$"}, {"id": "G10_TB_2_1_14", "current_skill": "G10_S07_06", "q": "Вертолёт пролетел $120$ км по ветру и затем вернулся. Он потратил на это $6$ часов времени. Найдите скорость ветра, если скорость вертолета в безветренную погоду $45$ км $/$ ч.", "key": "$15$"}, {"id": "G10_TB_2_1_8", "current_skill": "G10_S07_06", "q": "Найдите корни уравнения $\\frac{2x+3}{x-1}=0$.", "key": "$x = -1.5$"}, {"id": "G10_TB_2_1_9", "current_skill": "G10_S07_04", "q": "Решите уравнение: $(\\frac{4x+4}{3(x+2)-3}=0)$.", "key": "нет корней"}, {"id": "G10_TB_2_2_30", "current_skill": "G10_S08_01", "q": "Решите систему уравнений: $$ \\begin{cases} xy = 6, \\\\ yz = 15, \\\\ zx = 10 \\end{cases} $$", "key": "$x=2$, $y=3$, $z=5$; $x=-2$, $y=-3$, $z=-5$"}, {"id": "G10_TB_2_2_a", "current_skill": "G10_S09_02", "q": "Решите неравенство приведением в систему линейных неравенств: $(x+4)(2x-3)>0$", "key": "$(-\\infty; -4) \\cup (1.5; \\infty)$"}, {"id": "G10_TB_2_2_b", "current_skill": "G10_S09_01", "q": "Решите неравенство приведением в систему линейных неравенств: $x^{2}+10x-11<0$", "key": "$(-11; 1)$"}, {"id": "G10_TB_2_2_c", "current_skill": "G10_S09_02", "q": "Решите неравенство приведением в систему линейных неравенств: $(5x-2)(4x+3)\\leq 0$", "key": "$[-0.75; 0.4]$"}, {"id": "G10_TB_2_2_d", "current_skill": "G10_S09_01", "q": "Решите неравенство приведением в систему линейных неравенств: $2x^{2} - 5x + 2 \\geq 0$", "key": "$(-\\infty; 0.5] \\cup [2; \\infty)$"}, {"id": "G10_TB_2_3_1", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x+4}{(x+5)x}<0$", "key": "$x \\in (-\\infty; -5) \\cup (-4; 0)$"}, {"id": "G10_TB_2_3_10", "current_skill": "G10_S09_02", "q": "Найдите сумму всех целых чисел, удовлетворяющих неравенству: $\\frac{x-4}{2x+6}\\leq 0$", "key": "$7$"}, {"id": "G10_TB_2_3_12", "current_skill": "G10_S09_02", "q": "Найдите разность между наибольшим и наименьшим отрицательными значениями целых чисел, входящих в решение неравенства $\\frac{(x+3)(x-5)}{x+1}\\geq 0$", "key": "$1$"}, {"id": "G10_TB_2_3_13", "current_skill": "G10_S09_02", "q": "Сколько целых чисел, входящих в решение неравенства $\\frac{(x+4)^{2}-8x-25}{(x-6)^{2}}\\geq 0$, расположены в отрезке $[-5; 6]$?", "key": "$6$"}, {"id": "G10_TB_2_3_15", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{5}{-6x + 3} + \\dfrac{6x}{1 - 2x} \\geq 0$", "key": "$[-\\dfrac{5}{18}; \\dfrac{1}{2})$"}, {"id": "G10_TB_2_3_16", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{x^{2} + 3x}{49x^{2} + 70x + 25} \\leq 0$", "key": "$[-3; \\dfrac{-5}{7}) \\cup (\\dfrac{-5}{7}; 0]$"}, {"id": "G10_TB_2_3_18", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{6}{-4x + 2} - \\dfrac{5x}{1 - 2x} \\leq 0$", "key": "$(\\dfrac{1}{2}; \\dfrac{3}{5}]$"}, {"id": "G10_TB_2_3_19", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{49x^{2} - 70x + 25}{x^{2} - 3x} \\leq 0$", "key": "$(0; 3)$"}, {"id": "G10_TB_2_3_2", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x-4}{(x-3)x}<0$", "key": "$x \\in (-\\infty; 0) \\cup (3; 4)$"}, {"id": "G10_TB_2_3_23", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\dfrac{6}{-4x - x^{2}} - \\dfrac{2}{x^{2} - 4x} + \\dfrac{x}{x^{2} - 16} \\geq 0$", "key": "$(-4; 0) \\cup (4; +\\infty)$"}, {"id": "G10_TB_2_3_25", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\left(\\dfrac{x^{2} + 2x + 4}{4x^{2} - 1} \\cdot \\dfrac{2x^{2} - x}{-x^{3} + 8} - \\dfrac{2 - x}{2x^{2} + x}\\right) : \\dfrac{4}{x^{2} - 2x} \\geq \\dfrac{4 - x}{x + 2x^{2}}$", "key": "$(-\\frac{1}{2}; 0)$"}, {"id": "G10_TB_2_3_3", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{5+4x}{(x-2)(x+1)}\\geq 0$", "key": "$x \\in \\left[-\\dfrac{5}{4}; -1\\right) \\cup (2; \\infty)$"}, {"id": "G10_TB_2_3_4", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{4-3x}{(x+2)(x-1)}\\geq 0$", "key": "$x \\in (-\\infty; -2) \\cup \\left(1; \\dfrac{4}{3}\\right]$"}, {"id": "G10_TB_2_3_7", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{25-16x^{2}}{x^{2}+4x+4}>0$", "key": "$x \\in \\left(-\\dfrac{5}{4}; \\dfrac{5}{4}\\right) \\setminus \\{-2\\}$"}, {"id": "G10_TB_2_3_8", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{16-25x^{2}}{x^{2}-4x+4}>0$", "key": "$x \\in (-\\dfrac{4}{5}; \\dfrac{4}{5}) \\setminus \\{2\\}$"}, {"id": "G10_TB_2_3_a", "current_skill": "G10_S09_01", "q": "Равносильны ли неравенства? $5x^{2}>2x$ и $5x>2$", "key": "нет"}, {"id": "G10_TB_2_3_c", "current_skill": "G10_S09_02", "q": "Равносильны ли неравенства? $\\frac{x^{2}-1}{x}>0$ и $(x^{2}-x)(x+1)>0$", "key": "да"}, {"id": "G10_TB_2_4_1_a", "current_skill": "G10_S10_01", "q": "Найдите все целые числа, входящие в решение системы неравенств: $0{,}2x > -1$; $\\dfrac{-x}{3} \\geq 1$", "key": "$x \\in \\{-4, -3\\}$"}, {"id": "G10_TB_2_4_1_c", "current_skill": "G10_S10_01", "q": "Найдите все целые числа, входящие в решение системы неравенств: $\\begin{cases} 1-\\frac{x}{4}>x; \\\\ x-\\frac{x-4}{5}>1 \\end{cases}$", "key": "$x \\in \\varnothing$"}, {"id": "G10_TB_2_4_1_d", "current_skill": "G10_S10_01", "q": "Найдите все целые числа, входящие в решение системы неравенств: $\\begin{cases} x-\\frac{x}{4}\\geq 2; \\\\ \\frac{x-1}{2}+\\frac{x-2}{3}>1 \\end{cases}$", "key": "$x \\in \\{3; 4; 5; \\dots\\}$"}, {"id": "G10_TB_2_4_2_a", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\frac{x-1}{2}-\\frac{x-2}{3}\\geq\\frac{x-3}{4}-x$; $1-x>0{,}5x-4$", "key": "$x \\in [-1; \\dfrac{10}{3})$"}, {"id": "G10_TB_2_4_2_b", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\frac{5x+7}{6} - \\frac{3x}{4} < \\frac{11x-7}{12} \\\\ \\frac{1-3x}{2} - \\frac{1-4x}{3} \\geq \\frac{x}{6} - 1 \\end{cases}$", "key": "$x \\in (2.1; 3.5]$"}, {"id": "G10_TB_2_4_2_c", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\dfrac{2x-1}{6}+\\dfrac{x+2}{3}-\\dfrac{x-8}{2}>x-1, \\\\ 2-2x>0{,}5+0{,}5 \\end{cases}$", "key": "$x \\in (-\\infty; 0,5)$"}, {"id": "G10_TB_2_4_2_d", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\frac{8x+1}{3} > \\frac{4x+9}{2} - \\frac{x-1}{3} \\\\ \\frac{5x-2}{3} < \\frac{2x+13}{2} - \\frac{x+2}{3} \\end{cases}$", "key": "$x \\in \\left(\\dfrac{9}{2}; \\dfrac{13}{2}\\right)$"}, {"id": "G10_TB_2_4_3_a", "current_skill": "G10_S10_03", "q": "Найдите область определения выражения: $√((x-3)(x-5))+√((1-x)(7-x))$", "key": "$x ∈ (-∞; 1] ∪ [7; ∞)$"}, {"id": "G10_TB_2_4_3_b", "current_skill": "G10_S10_01", "q": "Найдите область определения выражения: $\\sqrt{\\frac{3x+2}{5-x}}+\\sqrt{\\frac{4-x}{7-2x}}$", "key": "$x \\in \\left[-\\dfrac{2}{3}; \\dfrac{7}{2}\\right) \\cup [4; 5)$"}, {"id": "G10_TB_2_4_3_c", "current_skill": "G10_S10_03", "q": "Найдите область определения выражения: $√((x-2)(x-3))+√((5-x)(6-x))$", "key": "$x ∈ (-∞; 2] ∪ [3; 5] ∪ [6; ∞)$"}, {"id": "G10_TB_2_4_3_d", "current_skill": "G10_S10_01", "q": "Найдите область определения выражения: $\\sqrt{\\frac{4x+1}{x+2}}+\\sqrt{\\frac{2x+1}{x-7}}$", "key": "$x \\in (-\\infty; -2) \\cup (7; \\infty)$"}, {"id": "G10_TB_2_4_4_a", "current_skill": "G10_S10_01", "q": "Найдите область определения функции: $y = \\sqrt{12 - 3x} + \\sqrt{x + 2}$", "key": "$x \\in [-2; 4]$"}, {"id": "G10_TB_2_4_4_b", "current_skill": "G10_S10_03", "q": "Найдите область определения функции: $y=\\sqrt{\\frac{3-5x-2x^2}{10x}}$", "key": "$x \\in (-\\infty; -3] \\cup (0; 0{,}5]$"}, {"id": "G10_TB_2_4_4_c", "current_skill": "G10_S10_01", "q": "Найдите область определения функции: $y = \\sqrt{15 - 3x} + \\sqrt{4 + x}$", "key": "$x \\in [-4; 5]$"}, {"id": "G10_TB_2_4_4_d", "current_skill": "G10_S10_03", "q": "Найдите область определения функции: $y = \\sqrt{\\frac{-3x^2 + 12}{1 - 5x}}$", "key": "$x \\in [-2; 0{,}2) \\cup [2; +\\infty)$"}, {"id": "G10_TB_2_4_5_a", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\frac{2x+1}{x-2}<1 \\\\ \\frac{3x+2}{2x-3}>2 \\end{cases}$", "key": "$x \\in (1.5; 2)$"}, {"id": "G10_TB_2_4_5_b", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\frac{7-3x}{2-5x} \\leq 2; \\\\ \\frac{2x+1}{3x-3} > 4 \\end{cases}$", "key": "$x \\in (1; 1{,}3)$"}, {"id": "G10_TB_2_4_5_c", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\frac{3x-2}{x-2}<2; \\\\ \\frac{5x+1}{4x-5}\\geq 3 \\end{cases}$", "key": "$x \\in \\left(\\dfrac{5}{4}; 2\\right)$"}, {"id": "G10_TB_2_4_5_d", "current_skill": "G10_S10_01", "q": "Решите систему неравенств: $\\begin{cases} \\frac{x+3}{3x-1} \\leq 1; \\\\ \\frac{2x+5}{x-4} \\geq 2 \\end{cases}$", "key": "$x \\in (4; +\\infty)$"}, {"id": "G10_TB_2_4_6_a", "current_skill": "G10_S10_03", "q": "Решите систему неравенств: $\\begin{cases} x^2 \\leq 9 \\\\ x > 0 \\end{cases}$", "key": "$x \\in (0; 3]$"}, {"id": "G10_TB_2_4_6_b", "current_skill": "G10_S10_03", "q": "Решите систему неравенств: $\\begin{cases} 3x^2+7x-6 \\leq 0 \\\\ 6(x+4)-3(4-3x) < 2 \\end{cases}$", "key": "$x \\in [-3; -\\dfrac{2}{3})$"}, {"id": "G10_TB_2_4_6_c", "current_skill": "G10_S10_03", "q": "Решите систему неравенств: $\\begin{cases} 5x^2 - 2x + 1 \\leq 0 \\\\ 2(x+3) - (x-8) < 4 \\end{cases}$", "key": "$x \\in \\varnothing$"}, {"id": "G10_TB_2_4_6_d", "current_skill": "G10_S10_03", "q": "Решите систему неравенств: $\\begin{cases} -2x^2+3x-2<0 \\\\ -3(6x-1)-2x<x \\end{cases}$", "key": "$x \\in \\left(\\dfrac{1}{7}; \\infty\\right)$"}, {"id": "G10_TB_2_4_6_e", "current_skill": "G10_S10_03", "q": "Решите систему неравенств: $\\begin{cases} 12(x+2)-5(5-4x)<2; \\\\ 9x^2-6x-8\\leq 0 \\end{cases}$", "key": "$x \\in \\left[\\dfrac{-2}{3}; \\dfrac{3}{32}\\right)$"}, {"id": "G10_TB_2_4_6_f", "current_skill": "G10_S10_03", "q": "Решите систему неравенств: $\\begin{cases} 3x-1<0; \\\\ x^2-3x+2 \\geq 0 \\end{cases}$", "key": "$x \\in (-\\infty; \\dfrac{1}{3})$"}, {"id": "G10_TB_2_4_7_a", "current_skill": "G10_S10_03", "q": "Найдите сумму всех целых чисел, входящих в решение системы: $\\begin{cases} \\frac{9-x^2}{x} \\geq 0 \\\\ 2x-1 \\geq 0 \\end{cases}$", "key": "$6$"}, {"id": "G10_TB_2_4_7_d", "current_skill": "G10_S1