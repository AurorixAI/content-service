[{"id": "G11_TB_?_89_a", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ∛(3x+20)+∛(5x+4)=∛(2x+19)+∛(6x+5)$", "key": "$x=-3; x=-1; x=5$"}, {"id": "G11_TB_?_89_b", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ∛(x+6)+∛(7x+10)=∛(2x+15)+∛(6x+1)$", "key": "$x=-9; x=-2; x=1$"}, {"id": "G11_TB_?_89_в", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ∛(2x+5)+∛(5x+16)=∛(x+8)+∛(6x+13)$", "key": "$x=-3; x=-2; x=3$"}, {"id": "G11_TB_?_89_г", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ∛(4x+6)+∛(5x+12)=∛(3x+10)+∛(6x+8)$", "key": "$x = -2; x = -1; x = 4$"}, {"id": "G11_TB_?_90_a", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ∛(x-2)+∛(x+5)=∛(30-x)$", "key": "$3$"}, {"id": "G11_TB_?_90_b", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ∛(x-1)+∛(2x+4)=∛(31-2x)$", "key": "$2$"}, {"id": "G11_TB_§15_15_12", "current_skill": "G10_S16_01", "q": "Вычислите: $3 \\cdot \\left( \\frac{1}{3} \\right)^{\\log_{\\frac{1}{3}} 2}$", "key": "$6$"}, {"id": "G11_TB_§15_1_1", "current_skill": "G10_S16_01", "q": "Проверьте, верно ли равенство: $\\log_2 16 = 4$.", "key": "верно"}, {"id": "G11_TB_§15_1_2", "current_skill": "G10_S16_01", "q": "Проверьте, верно ли равенство: $\\log_2 27 = 3$.", "key": "неверно"}, {"id": "G11_TB_§15_1_3", "current_skill": "G10_S16_01", "q": "Проверьте, верно ли равенство: $\\log_2\\left(\\frac{1}{4}\\right) = -2$.", "key": "верно"}, {"id": "G11_TB_§15_1_4", "current_skill": "G10_S16_01", "q": "Проверьте, верно ли равенство: $\\log_{\\sqrt{2}}4=4$.", "key": "верно"}, {"id": "G11_TB_§15_1_5", "current_skill": "G10_S16_01", "q": "Проверьте, верно ли равенство: $\\log_{\\frac{1}{2}}8=-3$.", "key": "верно"}, {"id": "G11_TB_§15_1_6", "current_skill": "G10_S16_01", "q": "Проверьте, верно ли равенство: $\\log_{0{,}2}0{,}008=3$.", "key": "верно"}, {"id": "G11_TB_§15_2_1", "current_skill": "G10_S16_01", "q": "Запишите решение простейшего показательного уравнения: $5^{x}=3$", "key": "$x = \\log_5 3$"}, {"id": "G11_TB_§15_2_2", "current_skill": "G10_S16_01", "q": "Запишите решение простейшего показательного уравнения: $(\\frac{1}{3})^{x}=10$", "key": "$x = \\log_{\\frac{1}{3}} 10$"}, {"id": "G11_TB_§15_2_3", "current_skill": "G10_S16_01", "q": "Запишите решение простейшего показательного уравнения: $10^{x} = \\frac{1}{3}$", "key": "$x = \\lg \\dfrac{1}{3}$"}, {"id": "G11_TB_§15_3_1", "current_skill": "G10_S16_01", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $4^{x}=9$.", "key": "$x = \\log_4 9$"}, {"id": "G11_TB_§15_3_2", "current_skill": "G10_S16_01", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $(\\frac{1}{4})^{x}=15$.", "key": "$x = \\log_{\\frac{1}{4}} 15$"}, {"id": "G11_TB_§15_3_3", "current_skill": "G10_S16_01", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $10^{x}=11$.", "key": "$x = \\lg 11$"}, {"id": "G11_TB_§15_3_4", "current_skill": "G10_S16_01", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $5^{x}=19$.", "key": "$x = \\log_5 19$"}, {"id": "G11_TB_§15_3_5", "current_skill": "G10_S16_01", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $0{,}2^{x}=0{,}7$.", "key": "$x = \\log_{0.2} 0.7$"}, {"id": "G11_TB_§15_3_6", "current_skill": "G10_S16_01", "q": "Пользуясь определением логарифма, запишите решение простейшего показательного уравнения: $e^{x}=3$.", "key": "$x = \\ln 3$"}, {"id": "G11_TB_§15_4_1", "current_skill": "G10_S16_01", "q": "Пользуясь основным логарифмическим тождеством, упростите выражение: $5^{\\log_5 7}$.", "key": "$7$"}, {"id": "G11_TB_§15_4_2", "current_skill": "G10_S16_01", "q": "Пользуясь основным логарифмическим тождеством, упростите выражение: $3^{\\log_3 4}$.", "key": "$4$"}, {"id": "G11_TB_§15_4_3", "current_skill": "G10_S16_01", "q": "Пользуясь основным логарифмическим тождеством, упростите выражение: $\\sqrt{3}^{\\log_{\\sqrt{3}}\\left(\\frac{1}{3}\\right)}$.", "key": "$\\dfrac{1}{3}$"}, {"id": "G11_TB_§15_4_4", "current_skill": "G10_S16_01", "q": "Пользуясь основным логарифмическим тождеством, упростите выражение: $3{,}5^{\\log_{3{,}5} 13}$.", "key": "$13$"}, {"id": "G11_TB_§15_4_5", "current_skill": "G10_S16_01", "q": "Пользуясь основным логарифмическим тождеством, упростите выражение: $7^{1+\\log_7 2}$.", "key": "$14$"}, {"id": "G11_TB_§15_4_6", "current_skill": "G10_S16_01", "q": "Пользуясь основным логарифмическим тождеством, упростите выражение: $(\\frac{1}{3})^{\\log_{\\frac{1}{3}}6-2}$.", "key": "$54$"}, {"id": "G11_TB_§16_16_15.1", "current_skill": "G10_S20_01", "q": "Решите неравенство $\\log_{0{,}5}x<-2$.", "key": "$x>4$"}, {"id": "G11_TB_§16_16_15.2", "current_skill": "G10_S20_01", "q": "Решите неравенство $\\log_{\\frac{1}{2}}(x+1)\\ge-1$.", "key": "$-1<x\\le1$"}, {"id": "G11_TB_§16_16_16.1", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{2}16$.", "key": "$4$"}, {"id": "G11_TB_§16_16_16.2", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{5}125$.", "key": "$3$"}, {"id": "G11_TB_§16_16_16.3", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{7}49$.", "key": "$2$"}, {"id": "G11_TB_§16_16_17.1", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{2}\\dfrac{1}{8}$.", "key": "$-3$"}, {"id": "G11_TB_§16_16_17.2", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{5}0{,}2$.", "key": "$-1$"}, {"id": "G11_TB_§16_16_17.3", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{0{,}5}4$.", "key": "$-2$"}, {"id": "G11_TB_§16_16_18.2", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $2\\log_{5}25+3\\log_{2}64$.", "key": "$22$"}, {"id": "G11_TB_§16_16_18.3", "current_skill": "G10_S16_01", "q": "Найдите значение выражения $\\log_{2}\\log_{2}16$.", "key": "$2$"}, {"id": "G11_TB_§16_16_26.1", "current_skill": "G10_S20_01", "q": "Решите неравенство $\\log_{0{,}5}(x^{2}-3x)\\ge-2$.", "key": "$[-1;\\,0)\\cup(3;\\,4]$"}, {"id": "G11_TB_§16_16_26.2", "current_skill": "G10_S20_01", "q": "Решите неравенство $\\log_{2}(x^{2}-2x)\\le3$.", "key": "$[-2;\\,0)\\cup(2;\\,4]$"}, {"id": "G11_TB_§16_16_30.1", "current_skill": "G10_S20_01", "q": "Решите неравенство $\\log_{\\frac{1}{2}}(x+2)+\\log_{\\frac{1}{2}}(x-2)<-2$.", "key": "$x>2\\sqrt{2}$"}, {"id": "G11_TB_§16_16_30.2", "current_skill": "G10_S20_01", "q": "Решите неравенство $\\log_{0{,}5}(x+1)+\\log_{0{,}5}(x-1)\\ge-1$.", "key": "$1<x\\le\\sqrt{3}$"}, {"id": "G11_TB_§16_1_10", "current_skill": "G10_S16_03", "q": "Найдите область определения функции: $y = \\log_x(2x - x^{2})$.", "key": "$x \\in (0; 1) \\cup (1; 2)$"}, {"id": "G11_TB_§16_1_11", "current_skill": "G10_S16_03", "q": "Найдите область определения функции: $y = \\log_{2x-3}(5x - x^{2})$.", "key": "$x \\in (1{,}5; 2) \\cup (2; 5)$"}, {"id": "G11_TB_§19_1", "current_skill": "G10_S14_01", "q": "Решите уравнение: $|x-3|^{3x^{2}-10x+3}=1$.", "key": "$\\dfrac{1}{3}; 2; 4$"}, {"id": "G11_TB_§19_1_5a", "current_skill": "G10_S14_01", "q": "Решите уравнение $x^{x+2}=x^{6}$ при $x>0$", "key": "$x = 1$, $x = 4$"}, {"id": "G11_TB_§19_1_5b", "current_skill": "G10_S14_01", "q": "Решите уравнение $x^{x+2}=x^{6}$ при $x\\in\\mathbb{R}$", "key": "$x = 0$, $x = 1$, $x = 4$"}, {"id": "G11_TB_§19_1_6", "current_skill": "G10_S14_01", "q": "Решите уравнение: $\\left|x-1\\right|^{x^{2}-1}=1$", "key": "$x = -1$, $x = 0$, $x = 2$"}, {"id": "G11_TB_§1_1_10_а", "current_skill": "G10_S02_05", "q": "Найдите область изменения функции: $y=√(1-x^{2})$", "key": "$[0; 1]$"}, {"id": "G11_TB_§1_1_14_a", "current_skill": "G10_S02_05", "q": "Имеет ли наибольшее (наименьшее) значение функция $y = \\sqrt{x-1}$? Если имеет, то укажите точку (точки), в которой оно достигается.", "key": "Наименьшее значение: $y=0$ при $x=1$; наибольшего значения нет."}, {"id": "G11_TB_§1_1_8_а", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y=√(x-1)$", "key": "$[1; +∞)$"}, {"id": "G11_TB_§1_1_8_б", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y=∛(x+1)$", "key": "$(-∞; +∞)$"}, {"id": "G11_TB_§1_1_8_в", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y=√(x^{2}-1)$", "key": "$(-∞; -1] ∪ [1; +∞)$"}, {"id": "G11_TB_§20_1_1", "current_skill": "G10_S16_01", "q": "Вычислите: $10\\log_{\\sqrt{2}}\\log_{\\sqrt{2}}\\sqrt{\\sqrt{\\sqrt{2}}}$", "key": "$-40$"}, {"id": "G11_TB_§2_5_3", "current_skill": "G10_S09_02", "q": "Решите неравенство методом интервалов: $\\frac{3x^{2}-2x-1}{\\sqrt{x-3}-1}<0$", "key": "$x \\in [3; 4)$"}, {"id": "G11_TB_§2_6_3", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y = \\sqrt{(x^{4} - 4x^{2} + 3)|2x - 3|}$", "key": "$x \\in (-\\infty; -\\sqrt{3}] \\cup [-1; 1] \\cup \\{1.5\\} \\cup [\\sqrt{3}; \\infty)$"}, {"id": "G11_TB_§3_10_2", "current_skill": "G10_S02_02", "q": "Найдите область определения функции: $y = \\sqrt{2x + 6}$", "key": "$x \\ge -3$"}, {"id": "GEN_G10_S01_02_A_01", "current_skill": "G10_S01_02", "q": "Какое из множеств точек задаёт функцию $y = f(x)$?", "key": "$\\{(1; 2),\\ (2; 3),\\ (3; 2)\\}$", "no_toc": true}, {"id": "GEN_G10_S01_02_A_02", "current_skill": "G10_S01_02", "q": "Какая из линий не является графиком функции $y = f(x)$?", "key": "прямая $x = 3$", "no_toc": true}, {"id": "GEN_G10_S01_02_B_01", "current_skill": "G10_S01_02", "q": "Является ли окружность $x^{2} + y^{2} = 4$ графиком некоторой функции $y = f(x)$?", "key": "нет", "no_toc": true}, {"id": "GEN_G10_S06_04_A_01", "current_skill": "G10_S06_04", "q": "Как получить график функции $y = 2f(x)$ из графика функции $y = f(x)$?", "key": "растяжением от оси $Ox$ в $2$ раза", "no_toc": true}, {"id": "GEN_G10_S06_05_B_01", "current_skill": "G10_S06_05", "q": "Точка $(4; 5)$ лежит на графике функции $y = f(x)$. Какая точка обязательно лежит на графике функции $y = f(2x)$?", "key": "$(2; 5)$", "no_toc": true}, {"id": "GEN_G10_S06_09_A_01", "current_skill": "G10_S06_09", "q": "График функции $g$ получен из графика функции $f(x) = x^{2}$ сдвигом на $4$ единицы вправо. Задайте функцию $g$ формулой.", "key": "$g(x) = (x - 4)^{2}$", "no_toc": true}, {"id": "GEN_G10_S06_09_B_01", "current_skill": "G10_S06_09", "q": "График функции $g$ получен из графика функции $f(x) = |x|$ отражением относительно оси $Ox$ и последующим сдвигом вверх на $1$. Задайте функцию $g$ формулой.", "key": "$g(x) = -|x| + 1$", "no_toc": true}, {"id": "GEN_G10_S06_09_C_01", "current_skill": "G10_S06_09", "q": "С помощью каких преобразований график функции $g(x) = \\sqrt{-x} + 3$ получается из графика функции $f(x) = \\sqrt{x}$?", "key": "отражением относительно оси $Oy$ и сдвигом вверх на $3$", "no_toc": true}, {"id": "GEN_G10_S06_10_A_01", "current_skill": "G10_S06_10", "q": "Как из графика функции $y = \\sqrt{x}$ получить график функции $y = \\sqrt{x - 3} + 2$?", "key": "сдвинуть на $3$ единицы вправо и на $2$ единицы вверх", "no_toc": true}, {"id": "GEN_G10_S06_10_B_01", "current_skill": "G10_S06_10", "q": "Найдите множество значений функции $y = \\sqrt{x - 3} + 2$.", "key": "$[2; +\\infty)$", "no_toc": true}, {"id": "GEN_G10_S12_04_A_01", "current_skill": "G10_S12_04", "q": "Решите уравнение $\\sqrt{x^{2}} = 3$.", "key": "$x = \\pm 3$", "no_toc": true}, {"id": "GEN_G10_S12_04_B_01", "current_skill": "G10_S12_04", "q": "Решите систему уравнений $$\\begin{cases} \\sqrt{x^{2}} = 3, \\\\ y + x = 5. \\end{cases}$$", "key": "$(3; 2)$, $(-3; 8)$", "no_toc": true}, {"id": "GEN_G10_S12_04_C_01", "current_skill": "G10_S12_04", "q": "Упростите выражение $\\sqrt{(x - 2)^{2}}$ при $x < 2$.", "key": "$2 - x$", "no_toc": true}, {"id": "GEN_G10_S13_03_A_01", "current_skill": "G10_S13_03", "q": "График функции $y = a^{x}$ проходит через точку $(2; 9)$. Найдите $a$.", "key": "$3$", "no_toc": true}, {"id": "GEN_G10_S13_03_B_01", "current_skill": "G10_S13_03", "q": "График функции $y = a^{x}$ проходит через точку $\\left(-1; \\dfrac{1}{4}\\right)$. Найдите $a$.", "key": "$4$", "no_toc": true}, {"id": "GEN_G10_S13_03_C_01", "current_skill": "G10_S13_03", "q": "Показательная функция $y = a^{x}$ убывает, а её график проходит через точку $(-2; 16)$. Найдите $a$.", "key": "$\\dfrac{1}{4}$", "no_toc": true}, {"id": "GEN_G10_S23_06_A_01", "current_skill": "G10_S23_06", "q": "Вычислите $\\arcsin\\dfrac{1}{3} + \\arccos\\dfrac{1}{3}$.", "key": "$\\dfrac{\\pi}{2}$", "no_toc": true}, {"id": "GEN_G10_S23_06_B_01", "current_skill": "G10_S23_06", "q": "Вычислите $\\arcsin(-0{,}4) + \\arccos(-0{,}4)$.", "key": "$\\dfrac{\\pi}{2}$", "no_toc": true}, {"id": "GEN_G10_S23_06_C_01", "current_skill": "G10_S23_06", "q": "Решите уравнение $\\arcsin x = \\arccos x$.", "key": "$x = \\dfrac{\\sqrt{2}}{2}$", "no_toc": true}, {"id": "ds_llm_00aa3bd37b39", "current_skill": "G10_S28_05", "q": "В классе $25$ учеников. Известно, что $12$ учеников занимаются в математическом кружке, $8$ — в физическом, а $5$ учеников посещают оба кружка. Найдите вероятность того, что случайно выбранный ученик занимается хотя бы в одном из этих двух кружков.", "key": "$\\frac{3}{5}$", "no_toc": true}, {"id": "ds_llm_098452deb558", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\sin\\left(\\arccos\\left(-\\frac{3}{5}\\right)+\\arcsin\\frac{12}{13}\\right)$", "key": "$-\\dfrac{16}{65}$", "no_toc": true}, {"id": "ds_llm_170ed896d723", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\arcsin\\left(\\sin\\left(\\frac{7\\pi}{5}\\right)\\right)+\\arctg\\left(\\tg\\left(\\frac{4\\pi}{3}\\right)\\right)$", "key": "$-\\dfrac{\\pi}{15}$", "no_toc": true}, {"id": "ds_llm_185be0fff593", "current_skill": "G10_S28_05", "q": "Из колоды в $36$ карт наудачу извлекают одну карту. Событие $A$ — $«$ вытянут туза $»$, событие $B$ — $«$ вытянут карту пиковой масти $»$, событие $C$ — $«$ вытянут даму $»$. Найдите вероятность события $(A\\cup B)\\cap\\overline{C}$, где $\\overline{C}$ — дополнение события $C$. Ответ округлите до тысячных.", "key": "$0{,}306$", "no_toc": true}, {"id": "ds_llm_1e06341bc4cc", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\arcsin\\left(\\sin\\frac{5\\pi}{6}\\right)$", "key": "$\\dfrac{\\pi}{6}$", "no_toc": true}, {"id": "ds_llm_258485d1588b", "current_skill": "G10_S08_04", "q": "Решите систему уравнений, предварительно домножив первое уравнение на $2$: $\\begin{cases}x+y=5\\\\2x-y=1\\end{cases}$", "key": "$(2; 3)$", "no_toc": true}, {"id": "ds_llm_347e46a11fb7", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\arccos\\left(\\cos\\left(\\frac{17\\pi}{5}\\right)\\right)+\\arcsin\\left(\\sin\\left(\\frac{17\\pi}{5}\\right)\\right)$", "key": "$\\dfrac{\\pi}{5}$", "no_toc": true}, {"id": "ds_llm_380a9a54f9ee", "current_skill": "G10_S28_05", "q": "Из колоды в $36$ карт наугад вытягивают одну карту. Событие $A$ — вытянута карта пиковой масти. Событие $B$ — вытянута карта с числом (от $6$ до $10$ включительно). Найдите $P(A\\cup B)$, если события $A$ и $B$ независимы.", "key": "$\\dfrac{2}{3}$", "no_toc": true}, {"id": "ds_llm_42740e4f75a0", "current_skill": "G10_S08_04", "q": "Решите систему уравнений, домножив первое уравнение на $2$, второе — на $3$, а затем сложив их: $\\begin{cases}2x-3y=4\\\\3x+2y=19\\end{cases}$", "key": "$(5; 2)$", "no_toc": true}, {"id": "ds_llm_52ca0a1ee1de", "current_skill": "G10_S08_04", "q": "Решите систему уравнений, введя новые переменные $u=\\dfrac{1}{x+y}$ и $v=\\dfrac{1}{x-y}$: $\\begin{cases}\\frac{2}{x+y}+\\frac{1}{x-y}=3\\frac{1}{x+y}-\\frac{2}{x-y}=-1\\end{cases}$", "key": "$(1; 0)$", "no_toc": true}, {"id": "ds_llm_53b796be1b36", "current_skill": "G10_S28_05", "q": "В коробке лежат $15$ красных, $10$ синих и $5$ зелёных шаров. Наугад достают один шар. Найдите вероятность того, что шар окажется красным или синим.", "key": "$\\frac{5}{6}$", "no_toc": true}, {"id": "ds_llm_5b92b70a85b7", "current_skill": "G10_S28_05", "q": "Вероятность того, что в течение дня в банкомате закончатся купюры номиналом $1000$ рублей, равна $0{,}15$. Вероятность того, что закончатся купюры номиналом $500$ рублей, равна $0{,}1$. Вероятность того, что закончатся купюры обоих номиналов, равна $0{,}03$. Найдите вероятность того, что к вечеру в банкомате закончится хотя бы один из этих номиналов.", "key": "$0{,}22$", "no_toc": true}, {"id": "ds_llm_61a2154592a1", "current_skill": "G10_S08_04", "q": "Решите систему уравнений, предварительно домножив первое уравнение на $2$ и сложив со вторым: $\\begin{cases}x+2y=7\\\\3x-4y=1\\end{cases}$", "key": "$(3; 2)$", "no_toc": true}, {"id": "ds_llm_633809483a41", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\arcsin\\left(\\frac{\\sqrt{3}}{2}\\right)+\\arccos\\left(\\frac{1}{2}\\right)$", "key": "$\\dfrac{2\\pi}{3}$", "no_toc": true}, {"id": "ds_llm_7946ee331269", "current_skill": "G10_S08_04", "q": "Решите систему уравнений, предварительно домножив второе уравнение на $3$ и сложив с первым: $\\begin{cases}x+3y=7\\\\2x-y=0\\end{cases}$", "key": "$(1; 2)$", "no_toc": true}, {"id": "ds_llm_8fff4352d1ef", "current_skill": "G10_S28_05", "q": "Вероятность того, что в течение дня в банкомате закончатся купюры номиналом $1000$ рублей, равна $0{,}12$, а номиналом $500$ рублей — $0{,}18$. Вероятность того, что закончатся оба вида купюр, равна $0{,}05$. Найдите вероятность того, что к вечеру в банкомате закончится хотя бы один из этих видов купюр.", "key": "$0{,}25$", "no_toc": true}, {"id": "ds_llm_91bd5dbd240a", "current_skill": "G10_S28_05", "q": "Вероятность того, что в течение дня в магазине будет продан хотя бы один ноутбук, равна $0{,}7$. Вероятность того, что будет продан хотя бы один планшет, равна $0{,}5$. Вероятность того, что продадут и ноутбук, и планшет, равна $0{,}3$. Найдите вероятность того, что в течение дня будет продан хотя бы один ноутбук или хотя бы один планшет.", "key": "$0{,}9$", "no_toc": true}, {"id": "ds_llm_af073955f00a", "current_skill": "G10_S23_07", "q": "Решите уравнение $: \\arcsin x+\\arcsin(x\\sqrt{3})=\\frac{\\pi}{2}$", "key": "$\\frac{1}{2}$", "no_toc": true}, {"id": "ds_llm_b7f6cacbdf86", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\arcsin\\left(\\frac{4}{5}\\right)+\\arcsin\\left(\\frac{5}{13}\\right)+\\arcsin\\left(\\frac{16}{65}\\right)$", "key": "$\\frac{\\pi}{2}$", "no_toc": true}, {"id": "ds_llm_c68039e390b7", "current_skill": "G10_S08_04", "q": "Решите систему уравнений, введя новые переменные $u=\\dfrac{1}{x+y}$ и $v=\\dfrac{1}{x-y}$: $\\begin{cases}\\frac{2}{x+y}+\\frac{1}{x-y}=3\\frac{3}{x+y}-\\frac{2}{x-y}=1\\end{cases}$", "key": "$(1; 0)$", "no_toc": true}, {"id": "ds_llm_ecd39e67f5a4", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\arctg\\left(\\frac{1}{2}\\right)+\\arctg\\left(\\frac{1}{3}\\right)+\\arctg\\left(\\frac{1}{7}\\right)+\\arctg\\left(\\frac{1}{18}\\right)$", "key": "$\\arctg\\dfrac{3}{2}$", "no_toc": true}, {"id": "ds_llm_f44501d4e05a", "current_skill": "G10_S28_05", "q": "Игральный кубик бросают дважды. Событие $A$ — $«$ в первый раз выпало чётное число очков $»$, событие $B$ — $«$ во второй раз выпало число очков, кратное $3»$. Найдите вероятность события $A\\cup B$.", "key": "$\\frac{2}{3}$", "no_toc": true}, {"id": "ds_llm_fcc78c3ab9f7", "current_skill": "G10_S23_07", "q": "Вычислите значение выражения: $\\sin\\left(\\arctan\\left(\\frac{3}{4}\\right)+\\arcsin\\left(\\frac{4}{5}\\right)\\right)$", "key": "$1$", "no_toc": true}]