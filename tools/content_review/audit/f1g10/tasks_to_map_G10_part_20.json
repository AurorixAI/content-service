]$"}, {"id": "G11_TB_12_1_11_61_v", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log_{\\frac{1}{9}}(x+8) + \\log_{\\frac{1}{9}} x \\geq -1$", "key": "$x \\in (0; 1]$"}, {"id": "G11_TB_13_1*_12_18_a", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{(x-2)(x^{2}-2x+11)}{x-7}>0$", "key": "$(-\\infty; 2) \\cup (7; +\\infty)$"}, {"id": "G11_TB_13_1*_12_18_b", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{(x-3)(x^{2}-5x+8)}{x+1}<0$", "key": "$(-1; 3)$"}, {"id": "G11_TB_13_1*_12_18_в", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{(x-3)(x^{2}-\\pi x+5)}{x-4}>0$", "key": "$(-\\infty; 3) \\cup (4; +\\infty)$"}, {"id": "G11_TB_13_1*_12_18_г", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{(x+1)(x^{2}-ex+4)}{x+5}<0$", "key": "$(-5; -1)$"}, {"id": "G11_TB_13_1*_12_22_a", "current_skill": "G10_S15_03", "q": "Решите неравенство: $\\left(\\frac{2^{x-1}+6\\cdot4^{x}+1}{3\\cdot4^{x}-10\\cdot2^{x-1}-28}\\ge-1\\right)$", "key": "$(-\\infty; 1] \\cup (2; +\\infty)$"}, {"id": "G11_TB_13_1*_12_22_б", "current_skill": "G10_S15_03", "q": "Решите неравенство: $\\left(\\dfrac{5\\cdot2^{x-1}-2\\cdot4^{x}-26}{3\\cdot4^{x}-7\\cdot2^{x-1}-34}\\ge1\\right)$", "key": "$[1; 2)$"}, {"id": "G11_TB_13_5*_13_28_а", "current_skill": "G10_S11_03", "q": "Решите уравнение $: ∛(3x-1)-∜(19-x)=0$", "key": "$3$"}, {"id": "G11_TB_13_5*_13_28_б", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt[5]{9x+5} - \\sqrt[4]{25-3x} = 0$", "key": "$3$"}, {"id": "G11_TB_14_1_1_5", "current_skill": "G10_S14_01", "q": "Решите уравнение: $\\left(\\frac{1}{2}\\right)^{x^{2}-x}=\\sqrt[4]{2}$", "key": "$x = \\dfrac{1}{2}$"}, {"id": "G11_TB_14_1_1_7", "current_skill": "G10_S14_01", "q": "Решите уравнение: $4^{x}=2^{6+x-x^{2}}$", "key": "$x=-3$ или $x=2$"}, {"id": "G11_TB_14_1_2_1", "current_skill": "G10_S14_01", "q": "Решите уравнение: $\\frac{(0{,}2)^{x-0{,}5}}{\\sqrt{5}}=5\\cdot(0{,}04)^{x-2}$", "key": "$5$"}, {"id": "G11_TB_14_1