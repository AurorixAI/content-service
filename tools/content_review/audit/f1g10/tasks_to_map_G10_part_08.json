[{"id": "G10_TB_§15_8", "current_skill": "G10_S22_01", "q": "Чему равен $\\tg(α+\\pi n)$, где $n∈Z$? $\\ctg(α+\\pi n)$, где $n∈Z$?", "key": "$tg(α + πn) = tg α, ctg(α + πn) = ctg α$"}, {"id": "G10_TB_§16_15_19_1", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $y = \\frac{2}{3 - \\cos x}$", "key": "$[\\frac{1}{2}; 1]$"}, {"id": "G10_TB_§16_15_19_2", "current_skill": "G10_S02_05", "q": "Найдите область значений функции: $y = \\frac{1}{\\sin x + 1}$", "key": "$[\\dfrac{1}{2}; +\\infty)$"}, {"id": "G10_TB_§16_15_20", "current_skill": "G10_S22_02", "q": "Докажите, что $\\sin\\alpha=-\\cos\\left(\\frac{\\pi}{2}+\\alpha\\right)$.", "key": "$-\\cos\\left(\\dfrac{\\pi}{2} + \\alpha\\right) = -\\left(\\cos\\dfrac{\\pi}{2}\\cos\\alpha - \\sin\\dfrac{\\pi}{2}\\sin\\alpha\\right) ="}, {"id": "G10_TB_§16_15_21", "current_skill": "G10_S22_02", "q": "Докажите, что $\\cos\\alpha=-\\cos(\\pi+\\alpha)$.", "key": "$-\\cos(\\pi + \\alpha) = -(\\cos\\pi\\cos\\alpha - \\sin\\pi\\sin\\alpha) = -(-\\cos\\alpha - 0) = \\cos\\alpha$."}, {"id": "G10_TB_§16_15_22_1", "current_skill": "G10_S22_02", "q": "Сравните с нулём координаты точки $A(x; y)$, если эта точка лежит в $I$ координатной четверти.", "key": "$x > 0$, $y > 0$"}, {"id": "G10_TB_§16_15_22_2", "current_skill": "G10_S22_02", "q": "Сравните с нулём координаты точки $A(x; y)$, если эта точка лежит во $II$ координатной четверти.", "key": "$x < 0, y > 0$"}, {"id": "G10_TB_§16_15_22_3", "current_skill": "G10_S22_02", "q": "Сравните с нулём координаты точки $A(x; y)$, если эта точка лежит в $III$ координатной четверти.", "key": "$x < 0, y < 0$"}, {"id": "G10_TB_§16_15_22_4", "current_skill": "G10_S22_02", "q": "Сравните с нулём координаты точки $A(x; y)$, если эта точка лежит в $IV$ координатной четверти.", "key": "$x > 0$, $y < 0$"}, {"id": "G10_TB_§16_15_23_3", "current_skill": "G10_S05_01", "q": "Чётной или нечётной является функция $: f(x)=\\sqrt[3]{x^{2}}?$", "key": "чётная"}, {"id": "G10_TB_§16_15_23_4", "curr