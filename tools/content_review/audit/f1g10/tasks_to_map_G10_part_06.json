[{"id": "G10_TB_§10_10_8_3", "current_skill": "G10_S02_07", "q": "Найдите область определения функции: $y = (x^{2} - x - 30)^{\\frac{4}{15}}$", "key": "$x \\in (-\\infty; -5] \\cup [6; +\\infty)$"}, {"id": "G10_TB_§10_10_9_1", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $3^{1{,}8} \\cdot 3^{-2{,}6} \\cdot 3^{2{,}8}$", "key": "$9$"}, {"id": "G10_TB_§10_10_9_2", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $(5^{-0{,}8})^{6} \\cdot 5^{4{,}8}$", "key": "$1$"}, {"id": "G10_TB_§10_10_9_3", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\left(25^{\\frac{2}{3}}\\right)^{\\frac{9}{4}}$", "key": "$125$"}, {"id": "G10_TB_§10_10_9_4", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\left(\\frac{1}{49}\\right)^{-1{,}5}$", "key": "$343$"}, {"id": "G10_TB_§10_10_9_5", "current_skill": "G10_S13_02", "q": "Найдите значение выражения: $\\left(\\frac{5}{6}\\right)^{4{,}5} \\cdot 1{,}2^{4{,}5}$", "key": "$1$"}, {"id": "G10_TB_§10_10_9_6", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\left(\\frac{7}{10}\\right)^{-\\frac{1}{3}} \\cdot \\left(\\frac{1}{700}\\right)^{-\\frac{1}{3}}$", "key": "$10$"}, {"id": "G10_TB_§10_10_9_7", "current_skill": "G10_S13_02", "q": "Найдите значение выражения: $\\frac{8^{\\frac{1}{2}}}{\\frac{1}{2^{\\frac{1}{2}}}}$", "key": "$4$"}, {"id": "G10_TB_§10_10_9_8", "current_skill": "G10_S13_02", "q": "Найдите значение выражения: $36^{0{,}4} \\cdot 6^{1{,}2}$", "key": "$36$"}, {"id": "G10_TB_§10_10_9_9", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\left(4^{-\\frac{1}{8}}\\right)^{1{,}6} \\cdot 16^{0{,}6}$", "key": "$4$"}, {"id": "G10_TB_§10_9_52_2", "current_skill": "G10_S01_04", "q": "Найдите значение выражения: $3^{-3} \\cdot \\left(\\frac{2}{3}\\right)^{-3}$", "key": "$\\dfrac{1}{8}$"}, {"id": "G10_TB_§10_9_52_3", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\frac{14^{-5}}{7^{-5}}$", "key": "$\\dfrac{1}{32}$"}, {"id": "G10_TB_§10_9_52_4", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $9^{-4} \\cdot 27^{2}$", "key": "$\\dfrac{1}{9}$"}, {"id": "G10_TB_§10_9_52_5", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\left(2\\frac{7}{9}\\right)^{-7}\\cdot\\left(\\left(\\frac{3}{5}\\right)^{-3}\\right)^{5}$", "key": "$1\\dfrac{2}{3}$"}, {"id": "G10_TB_§10_9_52_6", "current_skill": "G10_S14_01", "q": "Найдите значение выражения: $\\frac{22^{6} \\cdot 2^{-8}}{44^{-3} \\cdot 11^{9}}$", "key": "$16$"}, {"id": "G10_TB_§11_1", "current_skill": "G10_S11_01", "q": "Какое уравнение называют иррациональным?", "key": "Иррациональным называют уравнение, в котором переменная содержится под знаком корня (или в дробной степени)."}, {"id": "G10_TB_§11_11_1", "current_skill": "G10_S11_05", "q": "Решите уравнение $∛(2x+1)=-3.$", "key": "$-14$"}, {"id": "G10_TB_§11_11_1_1", "current_skill": "G10_S11_01", "q": "Объясните, почему не имеет корней уравнение $: √(x-2)+1=0$", "key": "При всех допустимых $x$ ($x \\ge 2$) имеем $\\sqrt{x - 2} \\ge 0$, поэтому $\\sqrt{x - 2} + 1 \\ge 1 > 0$, и левая часть не м"}, {"id": "G10_TB_§11_11_2", "current_skill": "G10_S11_05", "q": "Решите уравнение $\\sqrt[3]{x^2 - 2} = \\sqrt[3]{x}$.", "key": "$-1; 2$"}, {"id": "G10_TB_§11_11_2_1", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\sqrt[4]{2x-2}=2$", "key": "$x = 9$"}, {"id": "G10_TB_§11_11_2_2", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\sqrt[3]{x-4}=2$", "key": "$x = 12$"}, {"id": "G10_TB_§11_11_2_3", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ^{5}√(x-6)=-3$", "key": "$x = -237$"}, {"id": "G10_TB_§11_11_2_4", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\sqrt[3]{x^3 - 2x + 3} = x$", "key": "$x = 1.5$"}, {"id": "G10_TB_§11_11_2_5", "current_skill": "G10_S11_01", "q": "Решите уравнение $: √(7+^{3}√(x^{2}+7))=3$", "key": "$x = ±1$"}, {"id": "G10_TB_§11_11_2_6", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ³√(x²+15)=2³√(x+1)$", "key": "$x = 1; x = 7$"}, {"id": "G10_TB_§11_11_3", "current_skill": "G10_S11_03", "q": "Решите уравнение $(\\sqrt{3x+4})^2 = (\\sqrt{x-2})^2$.", "key": "корней нет"}, {"id": "G10_TB_§11_11_3_1", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{x-3}=4$", "key": "$x = 19$"}, {"id": "G10_TB_§11_11_3_2", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{3x^2 - x - 15} = 3$", "key": "$x = \\dfrac{-8}{3}; x = 3$"}, {"id": "G10_TB_§11_11_3_3", "current_skill": "G10_S11_05", "q": "Решите уравнение $: ^{3}√(25+√(x^{2}+3))=3$", "key": "$x = ±1$"}, {"id": "G10_TB_§11_11_4", "current_skill": "G10_S11_02", "q": "Решите уравнение $√(4+3x)=x.$", "key": "$4$"}, {"id": "G10_TB_§11_11_4_1", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\sqrt[7]{2x-1} = \\sqrt[7]{3-x}$", "key": "$x = \\dfrac{4}{3}$"}, {"id": "G10_TB_§11_11_4_2", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{2x-1} = \\sqrt{1-2x}$", "key": "$x = \\dfrac{1}{2}$"}, {"id": "G10_TB_§11_11_4_3", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\sqrt{2x-1} = \\sqrt{x-3}$", "key": "корней нет"}, {"id": "G10_TB_§11_11_4_4", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(2x-1)=√(x^{2}+4x-16)$", "key": "$x = 3$"}, {"id": "G10_TB_§11_11_5_1", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt[4]{x+3} = \\sqrt[4]{2x-3}$", "key": "$x = 6$"}, {"id": "G10_TB_§11_11_5_2", "current_skill": "G10_S11_03", "q": "Решите уравнение $: ^{4}√(4x-5)=√(1-x)$", "key": "Нет решений"}, {"id": "G10_TB_§11_11_5_3", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\sqrt[5]{x^2 - 25} = \\sqrt[5]{2x + 10}$", "key": "$x = -5; x = 7$"}, {"id": "G10_TB_§11_11_5_4", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(x^{2}-36)=√(2x-1)$", "key": "$x = 7$"}, {"id": "G10_TB_§11_11_6_1", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(2-x)=x$", "key": "$x = 1$"}, {"id": "G10_TB_§11_11_6_2", "current_skill": null, "q": "Решите уравнение: $\\sqrt{x+1}=x-1$", "key": "$x = 3$"}, {"id": "G10_TB_§11_11_6_3", "current_skill": null, "q": "Решите уравнение: $\\sqrt{3x-2}=x$", "key": "$x = 1; x = 2$"}, {"id": "G10_TB_§11_11_6_4", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(2x^{2}-3x-10)=x$", "key": "$x = 5$"}, {"id": "G10_TB_§11_11_6_5", "current_skill": "G10_S11_02", "q": "Решите уравнение: $2\\sqrt{x+5}=x+2$", "key": "$x = 4$"}, {"id": "G10_TB_§11_11_6_6", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{15-3x}-1=x$", "key": "$x = 2$"}, {"id": "G10_TB_§11_11_6_7", "current_skill": "G10_S11_02", "q": "Решите уравнение $: x-√(2x^{2}+x-21)=3$", "key": "$x = 3$"}, {"id": "G10_TB_§11_11_6_8", "current_skill": "G10_S11_02", "q": "Решите уравнение $: x+2+√(8-3x-x^{2})=0$", "key": "$x = -4$"}, {"id": "G10_TB_§11_11_7_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{10-3x} = -x$", "key": "$x = -5$"}, {"id": "G10_TB_§11_11_7_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $x = \\sqrt{x + 5} + 1$", "key": "$x = 4$"}, {"id": "G10_TB_§11_11_7_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x^2+5x+4}=2x+2$", "key": "$x = 0$"}, {"id": "G10_TB_§11_11_7_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $3\\sqrt{x+10} - 11 = 2x$", "key": "$x = -1$"}, {"id": "G10_TB_§11_11_7_5", "current_skill": "G10_S11_02", "q": "Решите уравнение: $x - \\sqrt{3x^2 - 11x - 20} = 5$", "key": "$5$"}, {"id": "G10_TB_§11_11_8_1", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √((2x+3)(x-4))=x-4$", "key": "$x = 4$"}, {"id": "G10_TB_§11_11_8_2", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √((x-2)(2x-5))+2=x$", "key": "$x = 2; x = 3$"}, {"id": "G10_TB_§11_11_8_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $(x+2)\\sqrt{x^2-x-20}=6x+12$", "key": "$-7$; $8$"}, {"id": "G10_TB_§11_11_8_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $(x+1)\\sqrt{x^2-5x+5}=x+1$", "key": "$x = -1$; $x = 1$; $x = 4$"}, {"id": "G10_TB_§11_11_9_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{(3x-1)(4x+3)} = 3x-1$", "key": "$\\dfrac{1}{3}$"}, {"id": "G10_TB_§11_11_9_2", "current_skill": "G10_S11_02", "q": "Решите уравнение $: (x-1)√(x^{2}-3x-3)=5x-5$", "key": "$x = 7; x = -4$"}, {"id": "G10_TB_§11_2", "current_skill": "G10_S11_05", "q": "Обе части уравнения возвели в нечётную степень. Будут ли исходное и полученное уравнения равносильными?", "key": "Да, будут равносильными"}, {"id": "G10_TB_§11_3", "current_skill": "G10_S11_01", "q": "Обе части уравнения возвели в чётную степень. Будут ли исходное и полученное уравнения равносильными?", "key": "Нет, не будут"}, {"id": "G10_TB_§11_4", "current_skill": "G10_S11_02", "q": "Как можно выявить посторонние корни уравнения?", "key": "Подставить каждый найденный корень в исходное уравнение и проверить, выполняется ли равенство, а также удовлетворяет ли "}, {"id": "G10_TB_§12_11_24", "current_skill": "G10_S01_04", "q": "Задайте формулой линейную функцию $f$, если $f(-2)=5$, $f(2)=-3$.", "key": "$f(x) = -2x + 1$"}, {"id": "G10_TB_§12_12_1_1", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{x-1} \\cdot \\sqrt{x+4} = 6$", "key": "$5$"}, {"id": "G10_TB_§12_12_1_2", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{2x+3}\\cdot\\sqrt{x-2}=3$", "key": "$3$"}, {"id": "G10_TB_§12_12_1_3", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{x+1} \\cdot \\sqrt{x+2} = 4$", "key": "$\\dfrac{-3 + \\sqrt{65}}{2}$"}, {"id": "G10_TB_§12_12_1_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x} \\cdot \\sqrt{1-x} = x$", "key": "$0; \\dfrac{1}{2}$"}, {"id": "G10_TB_§12_12_1_5", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\frac{x-2}{\\sqrt{2x-7}}=\\sqrt{x-4}$", "key": "$8$"}, {"id": "G10_TB_§12_12_2_1", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{x+2} \\cdot \\sqrt{x+8} = 4$", "key": "$0$"}, {"id": "G10_TB_§12_12_2_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\frac{x+3}{\\sqrt{x-1}}=\\sqrt{3x+1}$", "key": "$5$"}, {"id": "G10_TB_§12_12_3_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{4+2x-x^{2}}=x-2$", "key": "$3$"}, {"id": "G10_TB_§12_12_3_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{6-4x-x^{2}}=x+4$", "key": "$-1$"}, {"id": "G10_TB_§12_12_3_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^{2}+8}=2x+1$", "key": "$1$"}, {"id": "G10_TB_§12_12_3_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x^{2}-7x+5}=1-x$", "key": "$1$"}, {"id": "G10_TB_§12_12_3_5", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x}=x-1$", "key": "$\\dfrac{3 + \\sqrt{5}}{2}$"}, {"id": "G10_TB_§12_12_3_6", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^{2}-1}=3-2x$", "key": "$\\dfrac{6 - \\sqrt{6}}{3}$"}, {"id": "G10_TB_§12_12_4_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^{2}-4x+13}=\\frac{1}{2}x+2$", "key": "$2; 6$"}, {"id": "G10_TB_§12_12_4_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x^{2}+8x+7}-2=x$", "key": "$-1$"}, {"id": "G10_TB_§12_12_4_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x+2}=1-x$", "key": "$\\dfrac{3 - \\sqrt{13}}{2}$"}, {"id": "G10_TB_§12_12_5_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x+5}=8-\\sqrt{x-1}$", "key": "$10$"}, {"id": "G10_TB_§13_13_1_1", "current_skill": "G10_S09_01", "q": "Решите неравенство: $\\sqrt{x-1} > 4$", "key": "$x > 17$"}, {"id": "G10_TB_§13_13_1_2", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(x-1)<4$", "key": "$1 ≤ x < 17$"}, {"id": "G10_TB_§13_13_1_3", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(x-1)>-4$", "key": "$x ≥ 1$"}, {"id": "G10_TB_§13_13_1_4", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(x-1)<-4$", "key": "нет решений"}, {"id": "G10_TB_§13_13_2_1", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(2x-4)\\geq√(5-x)$", "key": "$3 ≤ x ≤ 5$"}, {"id": "G10_TB_§13_13_2_2", "current_skill": "G10_S11_03", "q": "Решите неравенство: $√x<√(x+1)$", "key": "$x ≥ 0$"}, {"id": "G10_TB_§13_13_2_3", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(x^{2}+x)<√(x^{2}+1)$", "key": "$x ∈ (-∞; -1] ∪ [0; 1)$"}, {"id": "G10_TB_§13_13_2_4", "current_skill": "G10_S11_03", "q": "Решите неравенство: $√(x^{2}-3x+1)>√(2x-3)$", "key": "$x > 4$"}, {"id": "G10_TB_§13_13_2_5", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(8-5x)\\geq√(x²-16)$", "key": "$-8 ≤ x ≤ -4$"}, {"id": "G10_TB_§13_13_2_6", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(x^{2}-3x+2)<√(2x^{2}-3x+1)$", "key": "$x<-1$ или $x\\geq 2$"}, {"id": "G10_TB_§13_13_3_1", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(3x-2)<√(x+6)$", "key": "$\\dfrac{2}{3} ≤ x < 4$"}, {"id": "G10_TB_§13_13_3_2", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(2x²+6x-3)\\geq√(x²+4x)$", "key": "$x\\leq-4$ или $x\\geq 1$"}, {"id": "G10_TB_§13_13_3_3", "current_skill": "G10_S11_03", "q": "Решите неравенство: $√(x^{2}+3x-10)<√(x-2)$", "key": "нет решений"}, {"id": "G10_TB_§13_13_4_1", "current_skill": "G10_S11_02", "q": "Решите неравенство: $x>√(24-5x)$", "key": "$3 < x ≤ 4.8$"}, {"id": "G10_TB_§13_13_4_2", "current_skill": "G10_S11_02", "q": "Решите неравенство: $√(2x+7)\\leq x+2$", "key": "$x ≥ 1$"}, {"id": "G10_TB_§13_13_4_3", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(3x-x^{2})<4-x$", "key": "$0 ≤ x ≤ 3$"}, {"id": "G10_TB_§13_13_4_4", "current_skill": "G10_S11_02", "q": "Решите неравенство: $3-x>3√(1-x^{2})$", "key": "$-1 \\le x < 0$ или $0{,}6 < x \\le 1$"}, {"id": "G10_TB_§13_13_4_5", "current_skill": "G10_S11_02", "q": "Решите неравенство: $√(x^{2}+3x+3)<2x+1$", "key": "$x > \\dfrac{2}{3}$"}, {"id": "G10_TB_§13_13_4_6", "current_skill": "G10_S11_02", "q": "Решите неравенство: $√(7x-x^{2}-6)<2x+3$", "key": "$1 ≤ x ≤ 6$"}, {"id": "G10_TB_§13_13_5_1", "current_skill": "G10_S09_01", "q": "Решите неравенство: $√(9x-20)<x$", "key": "$[\\dfrac{20}{9}; 4) ∪ (5; +∞)$"}, {"id": "G10_TB_§13_13_5_2", "current_skill": "G10_S11_02", "q": "Решите неравенство: $\\sqrt{x+61} < x+5$", "key": "$x > 3$"}, {"id": "G10_TB_§13_13_5_3", "current_skill": "G10_S11_02", "q": "Решите неравенство: $2√(4-x^{2})\\leq x+4$", "key": "$[-2; -1.6] ∪ [0; 2]$"}, {"id": "G10_TB_§13_13_5_4", "current_skill": "G10_S11_02", "q": "Решите неравенство: $√(x^{2}+4x-5)<x-3$", "key": "нет решений"}, {"id": "G10_TB_§14_14_1.1", "current_skill": "G10_S22_01", "q": "Выразите в радианной мере величину угла $45^{\\circ}$.", "key": "$\\dfrac{\\pi}{4}$"}, {"id": "G10_TB_§14_14_1.2", "current_skill": "G10_S22_01", "q": "Выразите в радианной мере величину угла $120^{\\circ}$.", "key": "$\\dfrac{2\\pi}{3}$"}, {"id": "G10_TB_§14_14_1.3", "current_skill": "G10_S22_01", "q": "Выразите в радианной мере величину угла $150^{\\circ}$.", "key": "$\\dfrac{5\\pi}{6}$"}, {"id": "G10_TB_§14_14_10", "current_skill": "G10_S22_01", "q": "Найдите градусную меру углов равнобедренного треугольника, если угол при вершине равен $\\pi/9$.", "key": "$20°; 80°; 80°$"}, {"id": "G10_TB_§14_14_15.1", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, смежного с углом $30^{\\circ}$.", "key": "$\\dfrac{5\\pi}{6}$"}, {"id": "G10_TB_§14_14_15.2", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, смежного с углом $45^{\\circ}$.", "key": "$\\dfrac{3\\pi}{4}$"}, {"id": "G10_TB_§14_14_15.3", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, смежного с углом $60^{\\circ}$.", "key": "$\\dfrac{2\\pi}{3}$"}, {"id": "G10_TB_§14_14_16.1", "current_skill": "G10_S22_01", "q": "Найдите градусную меру угла, смежного с углом $\\dfrac{\\pi}{6}$.", "key": "$150^{\\circ}$"}, {"id": "G10_TB_§14_14_16.2", "current_skill": "G10_S22_01", "q": "Найдите градусную меру угла, смежного с углом $\\dfrac{\\pi}{4}$.", "key": "$135^{\\circ}$"}, {"id": "G10_TB_§14_14_16.3", "current_skill": "G10_S22_01", "q": "Найдите градусную меру угла, смежного с углом $\\dfrac{\\pi}{3}$.", "key": "$120^{\\circ}$"}, {"id": "G10_TB_§14_14_17", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, который на $30^{\\circ}$ меньше смежного с ним.", "key": "$\\dfrac{5\\pi}{12}$"}, {"id": "G10_TB_§14_14_18", "current_skill": "G10_S22_01", "q": "Найдите градусную меру угла, который на $\\pi/6$ меньше смежного с ним.", "key": "$75°$"}, {"id": "G10_TB_§14_14_19", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, который в $2$ раза больше смежного с ним.", "key": "$2π/3$"}, {"id": "G10_TB_§14_14_1_1", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, равного $25^{\\circ}$.", "key": "$\\dfrac{5\\pi}{36}$"}, {"id": "G10_TB_§14_14_1_2", "current_skill": "G10_S22_01", "q": "Найдите радианную меру угла, равного $40^{\\circ}$.", "key": "$\\dfrac{2\\pi}{9}$"}]