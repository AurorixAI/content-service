[{"id": "G11_TB_22_2_5", "current_skill": "G10_S27_03", "q": "Для эксперимента с бросанием кубика укажите, какие из приведенных событий являются попарно несовместными: $A$ — выпало четное число очков, $B$ — выпало нечетное число очков, $C$ — выпало $3$ очка, $D$ — выпало меньше $3$ очков, $K$ — выпало число очков, кратное $3$, $M$ — выпало $6$ очков, $T$ — выпало больше $4$ очков, $F$ — выпало число очков, меньшее $7$.", "key": "$A и B; A и C; B и M; C и D; C и M; C и T; D и K; D и M; D и T$"}, {"id": "G11_TB_22_2_6", "current_skill": "G10_S27_03", "q": "Для эксперимента по вытягиванию карт из колоды укажите, какие из приведённых событий являются попарно несовместными: $A$ — вытянули карту червовой масти, $B$ — вытянули карту бубновой масти, $C$ — вытянули короля, $D$ — вытянули даму, $K$ — вытянули карту старше валета, $M$ — вытянули карту с числовым обозначением.", "key": "$A$ и $B$; $C$ и $D$; $C$ и $M$; $D$ и $M$; $K$ и $M$"}, {"id": "G11_TB_22_3_6_1", "current_skill": "G10_S28_05", "q": "В лесопарке растёт $1000$ деревьев: $420$ сосен, $90$ елей, $290$ дубов, $160$ берёз и $40$ осин. Найдите вероятность того, что выбранное наугад дерево будет сосной или дубом.", "key": "$0.71$"}, {"id": "G11_TB_22_3_6_2", "current_skill": "G10_S28_05", "q": "В лесопарке растёт $1000$ деревьев: $420$ сосен, $90$ елей, $290$ дубов, $160$ берёз и $40$ осин. Найдите вероятность того, что выбранное наугад дерево будет не дубом.", "key": "$0.71$"}, {"id": "G11_TB_22_3_6_3", "current_skill": "G10_S28_05", "q": "В лесопарке растёт $1000$ деревьев: $420$ сосен, $90$ елей, $290$ дубов, $160$ берёз и $40$ осин. Найдите вероятность того, что выбранное наугад дерево будет хвойным.", "key": "$0.51$"}, {"id": "G11_TB_22_3_6_4", "current_skill": "G10_S28_05", "q": "В лесопарке растёт $1000$ деревьев: $420$ сосен, $90$ елей, $290$ дубов, $160$ берёз и $40$ осин. Найдите вероятность того, что выбранное наугад дерево будет лиственным.", "key": "$0.49$"}, {"id": "G11_TB_22_3_6_5", "current_skill": "G10_S28_05", "q": "В лесопарке растёт $1000$ деревьев: $420$ сосен, $90$ елей, $290$ дубов, $160$ берёз и $40$ осин. Найдите вероятность того, что выбранное наугад дерево будет не осиной.", "key": "$0.96$"}, {"id": "G11_TB_22_3_6_6", "current_skill": "G10_S28_05", "q": "В лесопарке растёт $1000$ деревьев: $420$ сосен, $90$ елей, $290$ дубов, $160$ берёз и $40$ осин. Найдите вероятность того, что выбранное наугад дерево будет хвойным или лиственным.", "key": "$1$"}, {"id": "G11_TB_22_3_7_1", "current_skill": "G10_S28_05", "q": "В городе $23\\%$ жителей — брюнеты, $24\\%$ — блондины, $43\\%$ — шатены и $10\\%$ — рыжие. Найдите вероятность того, что выбранный наугад житель этого города будет шатеном или рыжим.", "key": "$0.53$"}, {"id": "G11_TB_22_3_7_2", "current_skill": "G10_S28_05", "q": "В городе $23\\%$ жителей — брюнеты, $24\\%$ — блондины, $43\\%$ — шатены и $10\\%$ — рыжие. Найдите вероятность того, что выбранный наугад житель этого города будет не рыжим.", "key": "$0.9$"}, {"id": "G11_TB_22_3_7_3", "current_skill": "G10_S28_05", "q": "В городе $23\\%$ жителей — брюнеты, $24\\%$ — блондины, $43\\%$ — шатены и $10\\%$ — рыжие. Найдите вероятность того, что выбранный наугад житель этого города будет брюнетом или блондином.", "key": "$0.47$"}, {"id": "G11_TB_22_3_7_4", "current_skill": "G10_S28_05", "q": "В городе $23\\%$ жителей — брюнеты, $24\\%$ — блондины, $43\\%$ — шатены и $10\\%$ — рыжие. Найдите вероятность того, что выбранный наугад житель этого города будет не блондином.", "key": "$0.76$"}, {"id": "G11_TB_27_2_11_1", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\sin 4x + \\sqrt{3} \\sin 3x + \\sin 2x = 0$", "key": "$x = \\frac{\\pi k}{3}; x = \\pm\\frac{5\\pi}{6} + 2\\pi k$"}, {"id": "G11_TB_27_2_11_2", "current_skill": "G10_S25_04", "q": "Решите уравнение $: \\cos 3x+\\sin 5x=\\sin x$", "key": "$x = (-1)^{k+1} * \\frac{\\pi}{12} + \\frac{\\pi k}{2}, k \\in \\mathbb{Z}; x = \\frac{\\pi}{6} + \\frac{\\pi n}{3}, n \\in \\mathbb"}, {"id": "G11_TB_27_2_12_2", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\sin x + \\sin 3x = 4 \\cos^{3} x$", "key": "$x = \\dfrac{\\pi}{2} + \\pi k$; $x = \\dfrac{\\pi}{4} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_14_1", "current_skill": "G10_S24_02", "q": "Решите уравнение: $\\sqrt{3} \\sin^{2}x + 0{,}5 \\sin(\\pi + 2x) = 0$", "key": "$x = \\pi k$, $x = \\dfrac{\\pi}{6} + \\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_15_1", "current_skill": "G10_S24_05", "q": "Найдите все решения уравнения $\\cos 2x = 2 \\operatorname{\\tg }^{2} x - \\cos^{2} x$, которые удовлетворяют неравенству $\\cos x < \\frac{1}{2}$", "key": "$x = \\pm \\arccos\\left(-\\dfrac{\\sqrt{6}}{3}\\right) + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_15_2", "current_skill": "G10_S24_05", "q": "Найдите все решения уравнения $4\\sin^{4}x+\\sin^{2}2x=2\\operatorname{\\ctg }^{2}x$, которые удовлетворяют неравенству $\\cos x<-\\frac{1}{2}$", "key": "$x = \\dfrac{3\\pi}{4} + 2\\pi k; x = \\dfrac{5\\pi}{4} + 2\\pi k$"}, {"id": "G11_TB_27_2_16_1", "current_skill": "G10_S25_04", "q": "Найдите все решения уравнения $\\cos x+\\cos 5x-\\cos 2x=0$, которые принадлежат отрезку $[-\\pi; \\pi]$", "key": "$x=-\\frac{7\\pi}{9}; x=-\\frac{3\\pi}{4}; x=-\\frac{5\\pi}{9}; x=-\\frac{\\pi}{4}; x=-\\frac{\\pi}{9}; x=\\frac{\\pi}{9}; x=\\frac{\\"}, {"id": "G11_TB_27_2_1_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $x = \\sqrt{10x + 24}$", "key": "$12$"}, {"id": "G11_TB_27_2_26_1", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(2x-7)\\sqrt{3x^{2}-5x-2}=0$", "key": "$-\\dfrac{1}{3}$; $2$; $3{,}5$"}, {"id": "G11_TB_27_2_26_2", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(2x-3)\\sqrt{4x^{2}-5x-9}=0$", "key": "$-1$; $2{,}25$"}, {"id": "G11_TB_27_2_26_3", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(3x^{2}-8x-11)\\sqrt{3x-5}=0$", "key": "$\\dfrac{5}{3}$; $\\dfrac{11}{3}$"}, {"id": "G11_TB_27_2_26_4", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(4x^{2}+3x-22)\\sqrt{3x-15}=0$", "key": "$5$"}, {"id": "G11_TB_27_2_27_1", "current_skill": "G10_S24_01", "q": "Решите уравнение: $(7\\sin x - 4\\sqrt{3})(7\\sin x - 5\\sqrt{2}) = 0$", "key": "$x = (-1)^{n}\\arcsin\\dfrac{4\\sqrt{3}}{7} + \\pi n$, $n \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_27_2", "current_skill": "G10_S24_01", "q": "Решите уравнение $: (5\\cos x-3√3)(5\\cos x-2√6)=0$", "key": "$x = \\pm \\arccos\\left(\\frac{2\\sqrt{6}}{5}\\right) + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_29_1", "current_skill": "G10_S24_04", "q": "Решите уравнение: $(2\\sin^{2}x-3\\sin x+1)\\sqrt{\\tg x}=0$", "key": "$x = \\pi k, \\ x = \\dfrac{\\pi}{6} + 2\\pi k, \\ k \\in \\mathbb{Z}$"}, {"id": "G11_TB_27_2_29_3", "current_skill": "G10_S07_07", "q": "Решите уравнение: $\\sqrt{4x-x^{2}-3}\\left(\\sqrt{2}\\cos x-\\sqrt{1+\\cos 2x}\\right)=0$", "key": "$x \\in \\left[1; \\dfrac{\\pi}{2}\\right] \\cup \\{3\\}$"}, {"id": "G11_TB_27_2_2_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{10-x}=4-x$", "key": "$1$"}, {"id": "G11_TB_27_2_2_10", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x(x+4)(x-3)}=6-x$", "key": "$x = \\sqrt[3]{36}$"}, {"id": "G11_TB_27_2_2_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x-1}=x-3$", "key": "$5$"}, {"id": "G11_TB_27_2_2_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{1+x}=2x-4$", "key": "$3$"}, {"id": "G11_TB_27_2_2_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x+7}=4x-5$", "key": "$2$"}, {"id": "G11_TB_27_2_2_5", "current_skill": "G10_S11_02", "q": "Решите уравнение: $x + 3\\sqrt{x - 5} = 5$", "key": "$5$"}, {"id": "G11_TB_27_2_2_7", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^{4}-3x-1}=x^{2}-1$", "key": "$2$"}, {"id": "G11_TB_27_2_2_8", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^{4}+x-9}=x^{2}-1$", "key": "$-2.5; 2$"}, {"id": "G11_TB_27_2_2_9", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x(x-2)(x+3)} = 3 - x$", "key": "$x = \\sqrt[3]{9}$"}, {"id": "G11_TB_27_2_35_1", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}-5x+6}{x^{2}+5x+6}<0$", "key": "$x \\in (-3; -2) \\cup (2; 3)$"}, {"id": "G11_TB_27_2_35_2", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}-6x+18}{-x^{2}+8x-12}>0$", "key": "$x \\in (2; 6)$"}, {"id": "G11_TB_27_2_36_2", "current_skill": "G10_S09_02", "q": "Решите неравенство: $x \\geq \\frac{2}{x-1}$", "key": "$x \\in [-1; 1) \\cup [2; +\\infty)$"}, {"id": "G11_TB_27_2_36_3", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{x^{2}-1}{x+5}<1$", "key": "$x \\in (-\\infty; -5) \\cup (-2; 3)$"}, {"id": "G11_TB_27_2_36_4", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{2x-1}{x-3} < x+3$", "key": "$x \\in (-2; 3) \\cup (4; +\\infty)$"}, {"id": "G11_TB_27_2_37_1", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{5}{2-x} > 1 + \\frac{3}{x+2}$", "key": "$x \\in (-8; -2) \\cup (0; 2)$"}, {"id": "G11_TB_27_2_37_2", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{5}{x+4} < 1 + \\frac{1}{4-x}$", "key": "$x \\in (-\\infty; -4) \\cup (0; 4) \\cup (6; +\\infty)$"}, {"id": "G11_TB_27_2_37_3", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{2}{3-x}>1-\\frac{3}{x+2}$", "key": "$x \\in (-2; 3)$"}, {"id": "G11_TB_27_2_37_4", "current_skill": "G10_S09_02", "q": "Решите неравенство: $\\frac{7}{x+5} < 1 + \\frac{2}{5-x}$", "key": "$x \\in (-\\infty; -5) \\cup (0; 5) \\cup (9; +\\infty)$"}, {"id": "G11_TB_27_2_3_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3x+3}=2x-3$", "key": "$\\dfrac{15+\\sqrt{129}}{8}$"}, {"id": "G11_TB_27_2_3_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3x+2}=2x-4$", "key": "$\\dfrac{19+\\sqrt{137}}{8}$"}, {"id": "G11_TB_27_2_3_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $x+1=2-\\sqrt{x-1}$", "key": "$1$"}, {"id": "G11_TB_27_2_3_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $1 - \\sqrt{x - 2} = x - 1$", "key": "$2$"}, {"id": "G11_TB_27_2_4_1", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}-13x+30=\\left(\\sqrt{3x-18}\\right)^{2}$", "key": "$12$"}, {"id": "G11_TB_27_2_4_2", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}-9x+13=\\left(\\sqrt{5x-35}\\right)^{2}$", "key": "$8$"}, {"id": "G11_TB_27_2_4_3", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}-8x+10=\\left(\\sqrt{7x-40}\\right)^{2}$", "key": "$10$"}, {"id": "G11_TB_27_2_4_4", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}-15x+55=\\left(\\sqrt{x-8}\\right)^{2}$", "key": "$9$"}, {"id": "G11_TB_27_2_5_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3x-5}=3-2x$", "key": "нет решений"}, {"id": "G11_TB_27_2_5_2", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{4x^{2}+4x+1}=x^{2}+x-1$", "key": "$-3; 2$"}, {"id": "G11_TB_27_2_6_1", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{y-1}=6-y$", "key": "$y = \\dfrac{13 - \\sqrt{21}}{2}$"}, {"id": "G11_TB_27_2_6_2", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x+1}=4-x$", "key": "$\\dfrac{9 - \\sqrt{21}}{2}$"}, {"id": "G11_TB_27_2_6_3", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x^{2}-8x+5}=x-2$", "key": "$2+\\sqrt{3}$"}, {"id": "G11_TB_27_2_6_4", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x^{2}-8x+6}=x-2$", "key": "$2 + \\sqrt{2}$"}, {"id": "G11_TB_27_2_9_1", "current_skill": "G10_S24_05", "q": "Решите уравнение: $\\sin 2x + \\sqrt{2} \\sin x = 0$. Укажите все корни, которые принадлежат отрезку $\\left[-\\frac{3\\pi}{2}; \\frac{3\\pi}{2}\\right]$.", "key": "$-\\dfrac{5\\pi}{4}$; $-\\pi$; $-\\dfrac{3\\pi}{4}$; $0$; $\\dfrac{3\\pi}{4}$; $\\pi$; $\\dfrac{5\\pi}{4}$"}, {"id": "G11_TB_27_2_9_2", "current_skill": "G10_S24_05", "q": "Решите уравнение: $\\sin 2x + \\sqrt{3} \\cos x = 0$. Укажите все корни, которые принадлежат отрезку $[-\\pi; 2\\pi]$.", "key": "$-\\dfrac{2\\pi}{3}, -\\dfrac{\\pi}{2}, -\\dfrac{\\pi}{3}, \\dfrac{\\pi}{2}, \\dfrac{4\\pi}{3}, \\dfrac{3\\pi}{2}, \\dfrac{5\\pi}{3}$"}, {"id": "G11_TB_4_1_3_18", "current_skill": "G10_S23_06", "q": "Докажите, что для любого $x \\in \\mathbb{R}$ справедливо равенство $\\operatorname{\\arctg } x + \\operatorname{\\arcctg } x = \\frac{\\pi}{2}$.", "key": "Пусть $\\alpha = \\operatorname{arctg} x \\in \\left(-\\dfrac{\\pi}{2}; \\dfrac{\\pi}{2}\\right)$; тогда $\\dfrac{\\pi}{2} - \\alpha"}, {"id": "G11_TB_5_3_6_3", "current_skill": "G10_S22_03", "q": "Найдите область значений функции $f(x)=2\\sin x-\\cos2x$ при $x\\in\\mathbb R$.", "key": "$[-3/2;3]$"}, {"id": "G11_TB_5_3_6_4", "current_skill": "G10_S22_03", "q": "Найдите область значений функции $f(x)=\\cos^2x-\\cos x$ при $x\\in\\mathbb R$.", "key": "$[-1/4;2]$"}, {"id": "G11_TB_6_6_6_2", "current_skill": "G10_S09_02", "q": "Решите неравенство методом интервалов: $\\frac{x^{3}+2x^{2}-3x}{(x-1)(x-2)}\\leq 0$", "key": "$x \\in (-\\infty; -3] \\cup [0; 1) \\cup (1; 2)$"}, {"id": "G11_TB_6_6_6_3", "current_skill": "G10_S09_02", "q": "Решите неравенство методом интервалов: $\\frac{x^{2}-x-6}{\\sqrt{12+x-x^{2}}} \\geq 0$", "key": "$x \\in (-3; -2] \\cup [3; 4)$"}, {"id": "G11_TB_7_1_2", "current_skill": "G10_S11_05", "q": "Решим уравнение $\\sqrt[3]{12x^{2}-28x+8}=2-x$.", "key": "$-8; 0; 2$"}, {"id": "G11_TB_7_1_4", "current_skill": "G10_S14_01", "q": "Решим уравнение $5^{x^{2}-2x}=5^{x-2}$.", "key": "$1; 2$"}, {"id": "G11_TB_8_1_7_21_1", "current_skill": "G10_S15_03", "q": "Решите неравенство: $4^{x} + 2^{x} + x^{2} < x^{2} + 6$.", "key": "$x \\in (-\\infty; 1)$"}, {"id": "G11_TB_8_3_8_10_а", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(\\log _{2}^{2}x+3)=\\log _{2}x-1$", "key": "нет решений"}, {"id": "G11_TB_8_3_8_10_б", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{4^{x+1} - 2^{x+1} - 3} = 2^{x} + 1$", "key": "$x = 1$"}, {"id": "G11_TB_8_3_8_10_г", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{\\log_3^2 x + 5} = 1 - \\log_3 x$", "key": "$x = \\dfrac{1}{9}$"}, {"id": "G11_TB_8_3_8_10_д", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3 \\cdot 4^{x} - 2^{x} + 2} = 2^{x} + 1$", "key": "$-1$; $0$"}, {"id": "G11_TB_8_3_8_10_е", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(1+\\sin x)=\\cos x$", "key": "$x = 2πk, k ∈ Z; x = -π/2 + 2πk, k ∈ Z$"}, {"id": "G11_TB_8_3_8_6_в", "current_skill": "G10_S11_01", "q": "Какое уравнение называют иррациональным? Как можно решать иррациональное уравнение $?$", "key": "Иррациональным называют уравнение , в котором переменная содержится под знаком корня (или в дробной степени). Основной м"}, {"id": "G11_TB_8_3_8_7_а", "current_skill": "G10_S11_01", "q": "Возведите уравнение во вторую степень, решите полученное уравнение, проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $\\sqrt{x}=x-2$", "key": "$x = 4$"}, {"id": "G11_TB_8_3_8_7_б", "current_skill": "G10_S11_02", "q": "Возведите уравнение во вторую степень, решите полученное уравнение, проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $\\sqrt{3x}=2x-3$", "key": "$x = 3$"}, {"id": "G11_TB_8_3_8_7_в", "current_skill": "G10_S11_02", "q": "Возведите уравнение во вторую степень, решите полученное уравнение, проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $\\sqrt{2x-1}=x$", "key": "$x = 1$"}, {"id": "G11_TB_8_3_8_7_г", "current_skill": "G10_S11_01", "q": "Возведите уравнение во вторую степень, решите полученное уравнение , проверьте, являются ли корни уравнения-следствия корнями исходного уравнения: $√(3x-2)=x$", "key": "$x = 1; x = 2$"}, {"id": "G11_TB_8_3_8_8_а", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{x^2-4x+1} = \\sqrt{3x+1}$", "key": "$x = 0$; $x = 7$"}, {"id": "G11_TB_8_3_8_8_б", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(2x^{2}-4x+5)=√(3x^{2}-x+1)$", "key": "$x = 1; x = -4$"}, {"id": "G11_TB_8_3_8_8_в", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{x^2 - 3x} = \\sqrt{4x - 10}$", "key": "$x = 5$"}, {"id": "G11_TB_8_3_8_8_г", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(x^{2}-3x-3)=√(2x^{2}-2x-9)$", "key": "$x = -3$"}, {"id": "G11_TB_8_3_8_9_а", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{5x+2}=x\\sqrt{3}$", "key": "$x = 2$"}, {"id": "G11_TB_8_3_8_9_б", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3x+2}=x\\sqrt{2}$", "key": "$x = 2$"}, {"id": "G11_TB_8_3_8_9_в", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x+5}=x+1$", "key": "$x = 2$"}, {"id": "G11_TB_8_3_8_9_г", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3x+7}=2x+3$", "key": "$-0{,}25$"}, {"id": "G11_TB_8_3_8_9_д", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(2x^{2}-4x+1)=x+1$", "key": "$x = 0; x = 6$"}, {"id": "G11_TB_8_3_8_9_е", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{3x^2 - 4x + 1} = x - 1$", "key": "$1$"}, {"id": "G11_TB_8_4_6", "current_skill": "G10_S24_04", "q": "Решите уравнение $$\\dfrac{2\\tan x}{1+\\tan^2x}=\\sin^2(2x).$$ Укажите все действительные решения.", "key": "$x=\\pi k$ или $x=\\dfrac\\pi4+\\pi n,\\quad k,n\\in\\mathbb Z$"}, {"id": "G11_TB_8_5_8_25", "current_skill": "G10_S07_05", "q": "Решите уравнение: $\\frac{x-1}{x^{2}+x-2}=-3$", "key": "$\\dfrac{-7}{3}$"}, {"id": "G11_TB_8_5_8_26", "current_skill": "G10_S24_04", "q": "Решите уравнение: $\\frac{\\sin 2x}{\\cos 2x} = \\frac{\\sin x}{\\cos x}$", "key": "$x = \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_8_5_8_27", "current_skill": "G10_S24_04", "q": "Решите уравнение: $\\operatorname{\\tg } 3x = \\operatorname{\\tg } 5x$", "key": "$x = \\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_1_8_34_a", "current_skill": "G10_S07_07", "q": "Решите уравнение $: √(x^{2}+3)+\\log _{2}x=2+\\log _{2}x$", "key": "$1$"}, {"id": "G11_TB_9_1_8_35_a", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{\\frac{x-1}{x-2}+\\sqrt{x}} = \\sqrt{\\frac{2x-2}{x-6}+\\sqrt{x}}$", "key": "$1$"}, {"id": "G11_TB_9_1_8_35_b", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{\\frac{x+3}{x-3}+\\sqrt{x}} = \\sqrt{\\frac{2x-6}{x-4}+\\sqrt{x}}$", "key": "$5; 6$"}, {"id": "G11_TB_9_1_8_35_c", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{\\frac{x+1}{x-3}+3} \\cdot \\tan\\left(\\pi\\frac{x}{4}\\right) = \\sqrt{\\frac{x+4}{3x-8}+3} \\cdot \\tan\\left(\\pi\\frac{x}{4}\\right)$", "key": "$x = 1$; $x = 4k$, $k \\in \\mathbb{Z}$"}, {"id": "G11_TB_9_1_8_35_d", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{\\frac{x-3}{x+2} - \\tan\\left(\\pi \\frac{x}{4}\\right)} = \\sqrt{\\frac{x-3}{2x+3} - \\tan\\left(\\pi \\frac{x}{4}\\right)}$", "key": "$3$"}, {"id": "G11_TB_9_1_8_37_a", "current_skill": "G10_S11_01", "q": "Решите уравнение $: √(x-5)*√(x-6)=√(x-2)$", "key": "$8$"}, {"id": "G11_TB_9_1_8_37_b", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{x-3} \\cdot \\sqrt{x-7} = \\sqrt{x+3}$", "key": "$9$"}, {"id": "G11_TB_9_1_8_37_c", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\dfrac{\\sqrt{7x-21}}{\\sqrt{x+2}} = \\dfrac{\\sqrt{5x-17}}{2}$", "key": "$5$"}, {"id": "G11_TB_9_1_8_37_d", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(3x-7)/√(x+3)=√(3-4x)$", "key": "нет решений"}, {"id": "G11_TB_9_3_9_10_a", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{x^2-1} = \\sqrt{-2x}$", "key": "$-1 - \\sqrt{2}$"}, {"id": "G11_TB_9_3_9_10_б", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{x^2+3x} = \\sqrt{x+1}$", "key": "$\\sqrt{2}-1$"}, {"id": "G11_TB_9_3_9_10_в", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{x^2-7} = \\sqrt{-2x-6}$", "key": "нет решений"}, {"id": "G11_TB_9_3_9_10_г", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(x^{2}+x)=√(1-x)$", "key": "$-1 - \\sqrt{2}; -1 + \\sqrt{2}$"}, {"id": "G11_TB_9_3_9_11_a", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(x^{3}-5x^{2}+7x-17)=√(x^{3}-4x^{2}-3x+4)$", "key": "$7$"}, {"id": "G11_TB_9_3_9_11_б", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(x^{3}-8x^{2}-7x+2)=√(x^{3}-7x^{2}-18x+20)$", "key": "$9$"}, {"id": "G11_TB_9_3_9_12_a", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(\\log _{3}x+1)=√(\\log _{3}^{2}x-5)$", "key": "$27$"}, {"id": "G11_TB_9_3_9_12_б", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{2\\log_4 x} = \\sqrt{\\log_4^2 x - 8}$", "key": "$256$"}, {"id": "G11_TB_9_3_9_12_в", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{1-4\\log_{\\frac{1}{2}}x} = \\sqrt{6-\\log_{\\frac{1}{2}}^2 x}$", "key": "$2$"}, {"id": "G11_TB_9_3_9_12_г", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{2 - \\log_{\\frac{1}{3}} x} = \\sqrt{\\log_{\\frac{1}{3}}^2 x - 4}$", "key": "$\\dfrac{1}{9}$; $27$"}, {"id": "G11_TB_9_3_9_14_б", "current_skill": "G10_S07_07", "q": "Решите уравнение $: √(x^{2}-9)+\\lg(x^{2}+3x)=1+√(x^{2}-9)$", "key": "$-5$"}, {"id": "G11_TB_9_3_9_16_a", "current_skill": "G10_S11_03", "q": "Решите уравнение $: (√(36x^{2}+7)-√(35x^{2}+16))√(2-x)=0$", "key": "$-3; 2$"}, {"id": "G11_TB_9_3_9_16_б", "current_skill": "G10_S11_03", "q": "Решите уравнение: $(\\sqrt{26x^2+1} - \\sqrt{25x^2+17})\\sqrt{3-x} = 0$", "key": "$-4$; $3$"}]