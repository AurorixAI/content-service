[{"id": "G10_TB_§9_9_23_3", "current_skill": "G10_S11_05", "q": "При каких значениях $a$ и $b$ выполняется равенство: $\\sqrt[5]{ab}=\\sqrt[5]{a}\\cdot\\sqrt[5]{b}$?", "key": "$a \\in \\mathbb{R}, b \\in \\mathbb{R}$"}, {"id": "G10_TB_§9_9_23_4", "current_skill": "G10_S11_05", "q": "При каких значениях $a$ и $b$ выполняется равенство: $\\sqrt[5]{ab}=\\sqrt[5]{-a}\\cdot\\sqrt[5]{-b}$?", "key": "$a \\in \\mathbb{R}, b \\in \\mathbb{R}$"}, {"id": "G10_TB_§9_9_24_1", "current_skill": "G10_S11_03", "q": "При каких значениях $x$ выполняется равенство: $\\sqrt[4]{x^{2}-4}=\\sqrt[4]{x-2}\\cdot\\sqrt[4]{x+2}$?", "key": "$x \\ge 2$"}, {"id": "G10_TB_§9_9_24_2", "current_skill": "G10_S11_03", "q": "При каких значениях $x$ выполняется равенство: $\\sqrt[8]{(x-3)(7-x)} = \\sqrt[8]{x-3} \\cdot \\sqrt[8]{7-x}$?", "key": "$3 \\le x \\le 7$"}, {"id": "G10_TB_§9_9_24_3", "current_skill": "G10_S11_05", "q": "При каких значениях $x$ выполняется равенство: $\\sqrt[3]{(x-6)(x-10)}=\\sqrt[3]{x-6}\\cdot\\sqrt[3]{x-10}$?", "key": "$x \\in \\mathbb{R}$"}, {"id": "G10_TB_§9_9_25_1", "current_skill": "G10_S01_04", "q": "Упростите выражение: $\\sqrt[6]{m^{6}}$, если $m \\ge 0$", "key": "$m$"}, {"id": "G10_TB_§9_9_25_2", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[4]{n^{4}}$, если $n \\le 0$", "key": "$-n$"}, {"id": "G10_TB_§9_9_25_3", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[8]{256k^{8}}$, если $k \\le 0$", "key": "$-2k$"}, {"id": "G10_TB_§9_9_25_6", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[4]{81x^{8}y^{4}}$, если $y \\ge 0$", "key": "$3x^{2}|y|$"}, {"id": "G10_TB_§9_9_25_7", "current_skill": "G10_S11_01", "q": "Упростите выражение: $\\sqrt{0{,}01a^{6}b^{10}}$, если $a \\le 0$, $b \\ge 0$", "key": "$-0,1a^{3}b^{5}$"}, {"id": "G10_TB_§9_9_25_8", "current_skill": "G10_S11_05", "q": "Упростите выражение: $-1{,}2x\\sqrt[6]{64x^{30}}$, если $x\\leq 0$", "key": "$2,4x^{6}$"}, {"id": "G10_TB_§9_9_26_1", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[4]{625a^{24}}$", "key": "$5a^{6}$"}, {"id": "G10_TB_§9_9_26_2", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[4]{0,0001b^{20}}$, если $b \\ge 0$", "key": "$0{,}1b^{5}$"}, {"id": "G10_TB_§9_9_26_3", "current_skill": "G10_S11_01", "q": "Упростите выражение: $-5\\sqrt{4x^{2}}$, если $x\\leq 0$", "key": "$10x$"}, {"id": "G10_TB_§9_9_26_4", "current_skill": "G10_S01_04", "q": "Упростите выражение: $\\sqrt[10]{p^{30}q^{40}}$, если $p \\ge 0$", "key": "$p^{3}q^{4}$"}, {"id": "G10_TB_§9_9_26_5", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[12]{m^{36}n^{60}}$, если $m \\le 0$, $n \\le 0$", "key": "$m^{3} n^{5}$"}, {"id": "G10_TB_§9_9_26_6", "current_skill": "G10_S11_05", "q": "Упростите выражение: $ab^{2}\\sqrt[4]{a^{48}b^{36}c^{44}}$, если $b \\ge 0$, $c \\le 0$", "key": "$-a^{13}b^{11}c^{11}$"}, {"id": "G10_TB_§9_9_27_1", "current_skill": "G10_S11_05", "q": "Вычислите значение выражения: $\\left(5\\sqrt[3]{4}+0{,}5\\sqrt[3]{108}-\\sqrt[3]{500}\\right)\\sqrt[3]{2}$", "key": "$3$"}, {"id": "G10_TB_§9_9_27_2", "current_skill": "G10_S11_05", "q": "Вычислите значение выражения: $\\left(2\\sqrt[3]{2}-2\\sqrt[3]{5}+\\sqrt[3]{100}\\right)\\left(\\sqrt[3]{10}+\\sqrt[3]{4}\\right)$", "key": "$14$"}, {"id": "G10_TB_§9_9_27_3", "current_skill": "G10_S11_05", "q": "Вычислите значение выражения: $\\frac{\\sqrt[3]{9}-6\\sqrt[3]{72}+2\\sqrt[3]{1125}}{\\sqrt[3]{9}}$", "key": "$-1$"}, {"id": "G10_TB_§9_9_27_4", "current_skill": "G10_S11_01", "q": "Вычислите значение выражения: $\\frac{\\left(\\sqrt[4]{2}+\\sqrt[4]{8}\\right)^{2}}{4+3\\sqrt{2}}$", "key": "$1$"}, {"id": "G10_TB_§9_9_28_1", "current_skill": "G10_S11_05", "q": "Вычислите значение выражения: $\\frac{5\\sqrt[3]{2} - \\sqrt[3]{54} + \\sqrt[3]{250}}{\\sqrt[3]{2}}$", "key": "$7$"}, {"id": "G10_TB_§9_9_2_1", "current_skill": "G10_S11_05", "q": "Вычислите: $\\sqrt[3]{0{,}064 \\cdot 343}$", "key": "$2.8$"}, {"id": "G10_TB_§9_9_2_2", "current_skill": "G10_S11_01", "q": "Вычислите: $\\sqrt[4]{0{,}0081 \\cdot 11^{4}}$", "key": "$3.3$"}, {"id": "G10_TB_§9_9_2_3", "current_skill": "G10_S01_04", "q": "Вычислите: $\\sqrt[5]{\\frac{7^{5}}{2^{10}}}$", "key": "$\\dfrac{7}{4}$"}, {"id": "G10_TB_§9_9_2_4", "current_skill": "G10_S11_01", "q": "Вычислите: $\\sqrt[8]{\\frac{2^{24} \\cdot 3^{16}}{5^{16}}}$", "key": "$\\dfrac{2^{3} \\cdot 3^{2}}{5^{2}}$"}, {"id": "G10_TB_§9_9_3_1", "current_skill": "G10_S11_05", "q": "Найдите: $\\sqrt[4]{2}\\cdot\\sqrt[4]{8}$", "key": "$2$"}, {"id": "G10_TB_§9_9_3_2", "current_skill": "G10_S11_05", "q": "Найдите: $\\sqrt[3]{0{,}054} \\cdot \\sqrt[3]{4}$", "key": "$0.6$"}, {"id": "G10_TB_§9_9_3_3", "current_skill": "G10_S11_05", "q": "Найдите: $\\sqrt[5]{\\sqrt[3]{128}}$", "key": "$\\sqrt[15]{128}$"}, {"id": "G10_TB_§9_9_3_4", "current_skill": "G10_S11_05", "q": "Найдите: $\\sqrt[8]{\\frac{2^{30}\\cdot7^{12}}{8\\sqrt[26]{2^{6}}\\cdot7^{4}}}$", "key": "$7 \\cdot 2^{\\frac{87}{26}}$"}, {"id": "G10_TB_§9_9_3_5", "current_skill": "G10_S11_05", "q": "Найдите: $\\sqrt[3]{6\\sqrt{3}+10}\\cdot\\sqrt[3]{6\\sqrt{3}-10}$", "key": "$2$"}, {"id": "G10_TB_§9_9_3_6", "current_skill": "G10_S11_05", "q": "Найдите: $\\sqrt[4]{3}\\cdot\\sqrt[3]{3}\\cdot\\sqrt[4]{27}\\cdot\\sqrt[3]{-9}$", "key": "$-9$"}, {"id": "G10_TB_§9_9_43_1", "current_skill": "G10_S11_05", "q": "Найдите значение выражения: $\\sqrt[3]{\\sqrt{10}-3}\\cdot\\sqrt[6]{19+6\\sqrt{10}}$", "key": "1"}, {"id": "G10_TB_§9_9_43_2", "current_skill": "G10_S11_01", "q": "Найдите значение выражения: $\\sqrt{4+2\\sqrt{2}}\\cdot\\sqrt[4]{6-4\\sqrt{2}}$", "key": "$2$"}, {"id": "G10_TB_§9_9_44_1", "current_skill": "G10_S11_05", "q": "Найдите значение выражения: $\\sqrt[6]{7-4\\sqrt{3}}\\cdot\\sqrt[3]{2+\\sqrt{3}}$", "key": "$1$"}, {"id": "G10_TB_§9_9_44_2", "current_skill": "G10_S11_01", "q": "Найдите значение выражения: $\\sqrt{2\\sqrt{6}-1}\\cdot\\sqrt[4]{25+4\\sqrt{6}}$", "key": "$\\sqrt{23}$"}, {"id": "G10_TB_§9_9_45_3", "current_skill": "G10_S11_01", "q": "Упростите выражение: $\\left(\\frac{\\sqrt[4]{a^{3}} - \\sqrt[4]{b^{3}}}{\\sqrt{a} - \\sqrt{b}} - \\sqrt[4]{a} - \\sqrt[4]{b}\\right) \\left(\\sqrt[4]{\\frac{a}{b}} + 1\\right)$", "key": "$-\\sqrt[4]{a}$"}, {"id": "G10_TB_§9_9_4_1", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[3]{25} \\cdot \\sqrt[3]{5}$", "key": "$5$"}, {"id": "G10_TB_§9_9_4_2", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[14]{(8-y)^{14}}$", "key": "$|8 - y|$"}, {"id": "G10_TB_§9_9_4_3", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[5]{2\\sqrt{17}+10}\\cdot\\sqrt[5]{2\\sqrt{17}-10}$", "key": "$\\sqrt[5]{-32}$"}, {"id": "G10_TB_§9_9_4_5", "current_skill": "G10_S01_04", "q": "Упростите выражение: $\\sqrt[5]{729a^{54}b^{18}}$", "key": "$3a^{10}b^{3}\\sqrt[5]{3a^{4}b^{3}}$"}, {"id": "G10_TB_§9_9_4_6", "current_skill": "G10_S11_01", "q": "Упростите выражение: $\\sqrt[4]{80}$", "key": "$2\\sqrt[4]{5}$"}, {"id": "G10_TB_§9_9_4_7", "current_skill": "G10_S01_04", "q": "Упростите выражение: $\\sqrt[6]{729a^{54}b^{18}}$", "key": "$3|a|^{9}|b|^{3}$"}, {"id": "G10_TB_§9_9_5_1", "current_skill": "G10_S11_05", "q": "Представьте выражение в виде одночлена, если $a \\ge 0$ и $b \\ge 0$: $\\sqrt[3]{27b^{9}}$", "key": "$3b^{3}$"}, {"id": "G10_TB_§9_9_5_2", "current_skill": "G10_S11_05", "q": "Представьте выражение в виде одночлена, если $a \\ge 0$ и $b \\ge 0$: $\\sqrt[4]{625a^{12}b^{4}}$", "key": "$5a^{3}b$"}, {"id": "G10_TB_§9_9_5_3", "current_skill": "G10_S11_05", "q": "Представьте выражение в виде одночлена, если $a \\ge 0$ и $b \\ge 0$: $\\sqrt[6]{729a^{54}b^{18}}$", "key": "$3a^{9}b^{3}$"}, {"id": "G10_TB_§9_9_6_1", "current_skill": "G10_S11_05", "q": "Представьте выражение в виде одночлена, если $m \\ge 0$ и $n \\ge 0$: $\\sqrt[3]{125 n^{15}}$", "key": "$5n^{5}$"}, {"id": "G10_TB_§9_9_6_2", "current_skill": "G10_S11_05", "q": "Представьте выражение в виде одночлена, если $m \\ge 0$ и $n \\ge 0$: $\\sqrt[6]{0{,}000064 m^{30} n^{42}}$", "key": "$0.2m^{5}n^{7}$"}, {"id": "G10_TB_§9_9_6_3", "current_skill": "G10_S11_05", "q": "Представьте выражение в виде одночлена, если $m \\ge 0$ и $n \\ge 0$: $\\sqrt[8]{m^{72} n^{24}}$", "key": "$m^{9}n^{3}$"}, {"id": "G10_TB_§9_9_7_1", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt{\\sqrt[5]{a}}$", "key": "$\\sqrt[10]{a}$"}, {"id": "G10_TB_§9_9_7_3", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[15]{c^{6}}$", "key": "$\\sqrt[5]{c^{2}}$"}, {"id": "G10_TB_§9_9_7_4", "current_skill": "G10_S17_02", "q": "Упростите выражение: $\\sqrt[18]{a^{8} b^{24}}$", "key": "$\\sqrt[9]{a^{4} b^{12}}$"}, {"id": "G10_TB_§9_9_7_5", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[12]{81}$", "key": "$\\sqrt[3]{3}$"}, {"id": "G10_TB_§9_9_8_1", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[6]{\\sqrt{x}}$", "key": "$\\sqrt[12]{x}$"}, {"id": "G10_TB_§9_9_8_3", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[12]{a^{3}}$", "key": "$\\sqrt[4]{a}$"}, {"id": "G10_TB_§9_9_8_4", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[21]{a^{14}b^{7}}$", "key": "$\\sqrt[3]{a^{2}b}$"}, {"id": "G10_TB_§9_9_8_5", "current_skill": "G10_S11_05", "q": "Упростите выражение: $\\sqrt[9]{64}$", "key": "$\\sqrt[3]{4}$"}, {"id": "G10_TB_§9_9_9_1", "current_skill": "G10_S11_05", "q": "Представьте выражение $\\sqrt{a}$ в виде корня четвёртой степени", "key": "$\\sqrt[4]{a^{2}}$"}, {"id": "G10_TB_§9_9_9_2", "current_skill": "G10_S11_01", "q": "Представьте выражение $\\sqrt{a}$ в виде корня шестой степени", "key": "$\\sqrt[6]{a^{3}}$"}, {"id": "G10_TB_§9_9_9_3", "current_skill": "G10_S11_05", "q": "Представьте выражение $\\sqrt{a}$ в виде корня четырнадцатой степени", "key": "$\\sqrt[14]{a^{7}}$"}, {"id": "G10_TB_§9_9_9_4", "current_skill": "G10_S11_05", "q": "Представьте выражение $\\sqrt{a}$ в виде корня восемнадцатой степени", "key": "$\\sqrt[18]{a^{9}}$"}, {"id": "G10_TB_•_13_6_1", "current_skill": "G10_S11_02", "q": "Решите не