6}); \\log_2(7))$"}, {"id": "G11_TB_?_214_2", "current_skill": "G10_S15_03", "q": "Решите неравенство: $27^{x} + 24 \\ge 2(7 + \\sqrt{22})^{x} + 12(7 - \\sqrt{22})^{x}$", "key": "$x \\in (-\\infty; \\log_{7-\\sqrt{22}}(2)] \\cup [\\log_{7+\\sqrt{22}}(12); +\\infty)$"}, {"id": "G11_TB_?_214_3", "current_skill": "G10_S20_01", "q": "Решите неравенство: $x \\le \\log_{5}(16 \\cdot 15^{x} - 15^{1+2x}) - \\log_{3}(16 \\cdot 5^{x} - 3^{1+x} \\cdot 5^{1+2x})$", "key": "$x \\in (-\\infty; -1] \\cup [0; \\log_{15} 16 - 1)$"}, {"id": "G11_TB_?_215", "current_skill": "G10_S20_01", "q": "Решите неравенство: $2^{\\lg(x^{2}-1)} \\ge (x+1)^{\\lg 2}$", "key": "$x \\in [2; +\\infty)$"}, {"id": "G11_TB_?_219", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log_2 \\log_{\\frac{1}{2}} \\frac{3x+4}{4x+8} \\le 0$", "key": "$x \\in (-\\infty; -4) \\cup [0; +\\infty)$"}, {"id": "G11_TB_?_22_1", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\frac{(x-a)(x-b)}{(c-a)(c-b)}+\\frac{(x-c)(x-b)}{(a-c)(a-b)}+\\frac{(x-c)(x-a)}{(b-c)(b-a)}$.", "key": "$1$"}, {"id": "G11_TB_?_22_2", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\left(\\frac{4(a+b)^{2}}{ab}-16\\right) \\cdot \\frac{(a+b)^{2}-ab}{ab} : \\left(\\frac{a^{3}-b^{3}}{11ab} \\cdot \\frac{44(a-b)}{ab}\\right)$.", "key": "$1$"}, {"id": "G11_TB_?_22_3", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\frac{\\frac{1}{a}+\\frac{1}{b+c}}{\\frac{1}{a}-\\frac{1}{b+c}} \\cdot \\frac{bc}{(a+b+c)^{2}} \\cdot \\left(1+\\frac{b^{2}+c^{2}-a^{2}}{2bc}\\right)$.", "key": "$\\dfrac{1}{2}$"}, {"id": "G11_TB_?_22_4", "current_skill": "G10_S07_04", "q": "Упростите выражение: $2\\left(\\frac{a^{-1}}{a^{-1}-b^{-1}}-\\frac{b^{-1}}{a^{-1}+b^{-1}}\\right)(a^{-1}-b^{-1})(a^{-2}+b^{-2})^{-1}\\cdot\\frac{a+b}{ab}$.", "key": "$2$"}, {"id": "G11_TB_?_22_5", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\frac{a^{-2}+b^{-2}}{a^{-1}+b^{-1}} \\cdot \\left(\\frac{a^{2}+b^{2}}{ab}\\right)^{-1} - (a+b)^{-1}$.", "key": "$0$"}, {"id": "G11_TB_?_23", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\left(\\frac{(a+2)^{2}-a^{2}}{4a^{2}-4}-\\frac{3}{a^{2}-a}\\right) : \\frac{a-3}{a^{3}-1}$ и найдите его значение при $a=\\frac{1}{3}$.", "key": "$\\dfrac{13}{3}$"}, {"id": "G11_TB_?_25_1", "current_skill": "G10_S07_05", "q": "Сократите дробь и вычислите значение полученного выражения при $x=3$: $\\frac{x^{3}+4x^{2}-9x-36}{x^{3}+2x^{2}-11x-12}$.", "key": "$\\dfrac{3}{2}$"}, {"id": "G11_TB_?_25_2", "current_skill": "G10_S07_05", "q": "Сократите дробь и вычислите значение полученного выражения при $x = -2$: $\\frac{x^{3} + 7x^{2} + 16x + 12}{x^{3} + 5x^{2} + 8x + 4}$.", "key": "$-1$"}, {"id": "G11_TB_?_26_2", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\frac{a-a^{-1}}{1+a^{-1}}-\\frac{a-a^{-1}}{1-a^{-1}}$.", "key": "$-2$"}, {"id": "G11_TB_?_27", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\left(\\frac{1}{a^{2}-\\sqrt{x+a^{4}}}+\\frac{1}{a^{2}+\\sqrt{x+a^{4}}}\\right)^{-1}+\\left(\\frac{2a^{2}+a^{4}}{x+a^{4}}+\\frac{1}{1+a^{4}x^{-1}}-1\\right)^{-1}$.", "key": "$\\dfrac{a^{2}}{2}$"}, {"id": "G11_TB_?_49_а", "current_skill": "G10_S02_02", "q": "Укажите область определения функции: $y=\\sqrt{\\cos x-1}$", "key": "$x = 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_?_49_б", "current_skill": "G10_S02_02", "q": "Укажите область определения функции: $y=\\sqrt{\\sin x-1}$", "key": "$x = \\dfrac{\\pi}{2} + 2\\pi k, k \\in \\mathbb{Z}$"}, {"id": "G11_TB_?_52_б", "current_skill": "G10_S02_02", "q": "Укажите область определения функции: $y=\\sqrt{(x^{4}-11x^{2}+18)\\cdot|2x-5|}$", "key": "$x \\in (-\\infty; -3] \\cup [-\\sqrt{2}; \\sqrt{2}] \\cup \\{2.5\\} \\cup [3; \\infty)$"}, {"id": "G11_TB_?_56_а", "current_skill": "G10_S11_02", "q": "Найдите координаты общих точек графиков функции: $y=\\sqrt{x+7}$ и $y-x-1=0$", "key": "$(2, 3)$"}, {"id": "G11_TB_?_56_б", "current_skill": "G10_S11_02", "q": "Найдите координаты общих точек графиков функции: $y=\\sqrt{x-4}$ и $y-2x+9=0$", "key": "$(5, 1)$"}, {"id": "G11_TB_?_60_а", "current_skill": "G10_S04_10", "q": "Пусть $f(x)$ — периодическая функция с периодом $8$, такая, что $f(x)=8x-x^{2}$ при $x\\in[0; 8). Решите уравнение f(2x+16)+23=5f(x).$", "key": "$x=1+8k$; $x=7+8k$, $k\\in\\mathbb{Z}$"}, {"id": "G11_TB_?_60_б", "current_skill": "G10_S04_10", "q": "Пусть $f(x)$ — периодическая функция с периодом $1$, такая, что $f(x)=x^{2}$ при $x\\in[0; 1). Решите уравнение f(2x+5)+2f(x)=1.$", "key": "$x = n + \\dfrac{1}{\\sqrt{6}}, n \\in \\mathbb{Z}; x = m + \\dfrac{2}{3}, m \\in \\mathbb{Z}$"}, {"id": "G11_TB_?_63", "current_skill": "G10_S07_06", "q": "Решите уравнение: $(2-3x)^{2}+(1+4x)^{2}=(5x+1)(5x-1)$", "key": "$1{,}5$"}, {"id": "G11_TB_?_78_ж", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^4 - 3x - 1} = x^2 - 1$", "key": "$2$"}, {"id": "G11_TB_?_78_з", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(x(x-2)(x+3))=3-x$", "key": "$x = ∛9$"}, {"id": "G11_TB_?_78_и", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(x(x+4)(x-3))=6-x$", "key": "$x = ∛36$"}, {"id": "G11_TB_?_81_a", "current_skill": "G10_S11_01", "q": "Решите уравнение $: x^{2}-13x+30=(√(3x-18))^{2}$", "key": "$12$"}, {"id": "G11_TB_?_81_b", "current_skill": "G10_S11_01", "q": "Решите уравнение $: x^{2}-9x+13=(√(5x-35))^{2}$", "key": "$8$"}, {"id": "G11_TB_?_81_в", "current_skill": "G10_S11_01", "q": "Решите уравнение $: x^{2}-8x+10=(√(7x-40))^{2}$", "key": "$10$"}, {"id": "G11_TB_?_81_г", "current_skill": "G10_S11_01", "q": "Решите уравнение $: x^{2}-15x+55=(√(x-8))^{2}$", "key": "$9$"}, {"id": "G11_TB_?_82_a", "current_skill": "G10_S11_02", "q": "Решите уравнение $: √(3x-5)=3-2x$", "key": "нет решений"}, {"id": "G11_TB_?_82_b", "current_skill": "G10_S11_01", "q": "Решите уравнение $: √(4x^{2}+4x+1)=x^{2}+x-1$", "key": "$-3; 2$"}, {"id": "G11_TB_?_83_в", "current_skill": "G10_S11_03", "q": "Решите уравнение $: √(x^{3}-4x^{2}+20x-81)=√(x^{3}-3x^{2}+6x-41)$", "key": "$10$"}, {"i