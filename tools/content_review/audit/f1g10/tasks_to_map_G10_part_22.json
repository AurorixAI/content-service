енство: $\\log_{2}(x^{2}-5x-34) > \\log_{2}(x+6)$", "key": "$x ∈ (-6; -4) ∪ (10; +∞)$"}, {"id": "G11_TB_9_6_9_48_б", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log _{0}$.$_{5}(x^{2}-16)>\\log _{0}$.$_{5}(3x+38)$", "key": "$x ∈ (-6; -4) ∪ (4; 9)$"}, {"id": "G11_TB_9_6_9_48_в", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log_{3}(x^{2}-4) < \\log_{3}(44-2x)$", "key": "$x ∈ (-8; -2) ∪ (2; 6)$"}, {"id": "G11_TB_9_6_9_48_г", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log _{0}$.$_{5}(x^{2}-22)<\\log _{0}$.$_{5}(3x+18)$", "key": "$x \\in (-6; -5) \\cup (8; +\\infty)$"}, {"id": "G11_TB_9_6_9_49_а", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log _{2}(x-2)+√(3-x)<3+√(3-x)$", "key": "$x ∈ (2; 3]$"}, {"id": "G11_TB_9_6_9_49_б", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\log _{2}(x-2)+√(3-x)<\\log _{2}(x-2)+2$", "key": "$x ∈ (2; 3]$"}, {"id": "G11_TB_9_6_9_50_а", "current_skill": "G10_S15_03", "q": "Решите неравенство: $9^x + 1 + \\cot\\left(\\pi \\frac{x}{2}\\right) < 10 \\cdot 3^{x-1} + \\cot\\left(\\pi \\frac{x}{2}\\right)$", "key": "$x \\in (-1; 0) \\cup (0; 1)$"}, {"id": "G11_TB_9_6_9_50_б", "current_skill": "G10_S15_03", "q": "Решите неравенство: $4^x + 2 + \\tan\\left(\\pi \\frac{x}{2}\\right) < 9 \\cdot 2^{x-1} + \\tan\\left(\\pi \\frac{x}{2}\\right)$", "key": "$x \\in (-1; 1) \\cup (1; 2)$"}, {"id": "G11_TB_9_7*_9_51", "current_skill": "G10_S09_02", "q": "Пусть $f(x)$ и $g(x)$ определены. Какое условие равносильно $\\dfrac{f(x)}{g(x)}>0$?", "key": "Оба значения строго положительны или оба строго отрицательны"}, {"id": "G11_TB_9_7*_9_53_1", "current_skill": "G10_S20_01", "q": "Решите неравенство: $(1-x)\\lg(x+2)<0$", "key": "$x ∈ (-2; -1) ∪ (1; +∞)$"}, {"id": "G11_TB_9_7*_9_53_2", "current_skill": "G10_S20_01", "q": "Решите неравенство: $(2-x)\\log_{0{,}5}(x+3)>0$", "key": "$x \\in (-3; -2) \\cup (2; +\\infty)$"}, {"id": "G11_TB_9_7*_9_53_3", "current_skill": "G10_S20_01", "q": "Решите неравенство: $(x-3)\\log_5(5-x)<0$", "key": "$x ∈ (-∞; 3) ∪ (4; 5)$"}, {"id": "G11_TB_9_7*_9_53_4", "current_skill": "G10_S20_01", "q": "Решите неравенство: $(4+x) \\log_{0{,}2}(3-x) > 0$", "key": "$x \\in (-\\infty; -4) \\cup (2; 3)$"}, {"id": "G11_TB_9_7*_9_54_4", "current_skill": "G10_S20_01", "q": "Решите неравенство: $(√x-1)\\lg(3-x)<0$", "key": "$x ∈ [0; 1) ∪ (2; 3)$"}, {"id": "G11_TB_9_7*_9_56_3", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\frac{2^{x}-8}{\\lg x}>0$", "key": "$x \\in (0; 1) \\cup (3; +\\infty)$"}, {"id": "G11_TB_9_7*_9_56_4", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\frac{2^{x} - \\frac{1}{2}}{\\lg(3 - x)} < 0$", "key": "$x \\in (-\\infty; -1) \\cup (2; 3)$"}, {"id": "G11_TB_9_7*_9_57_1", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\dfrac{\\log_{2}(x-3)}{\\log_{0{,}5}(x+2)} > 0$", "key": "$x \\in (3; 4)$"}, {"id": "G11_TB_9_7*_9_57_2", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}3}(x-3)}{\\lg(x+4)} > 0$", "key": "$x \\in (3; 4)$"}, {"id": "G11_TB_9_7*_9_57_3", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}2}(x+2)}{\\log_{5}(3-x)} > 0$", "key": "$x \\in (-2; -1) \\cup (2; 3)$"}, {"id": "G11_TB_9_7*_9_57_4", "current_skill": "G10_S20_01", "q": "Решите неравенство: $\\dfrac{\\log_{0{,}25}(2-x)}{\\log_{4}(x-4)} < 0$", "key": "$∅$"}, {"id": "G11_TB_?_130_a", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(2x - 7)\\sqrt{3x^2 - 5x - 2} = 0$", "key": "$-\\dfrac{1}{3}$; $2$; $3{,}5$"}, {"id": "G11_TB_?_130_b", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(2x - 3)\\sqrt{4x^{2} - 5x - 9} = 0$", "key": "$-1$; $\\dfrac{9}{4}$"}, {"id": "G11_TB_?_130_g", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(3x^{2} - 8x - 11)\\sqrt{3x - 5} = 0$", "key": "$\\dfrac{5}{3}; \\dfrac{11}{3}$"}, {"id": "G11_TB_?_130_h", "current_skill": "G10_S07_07", "q": "Решите уравнение: $(4x^{2} + 3x - 22) \\sqrt{3x - 15} = 0$", "key": "$5$"}, {"i