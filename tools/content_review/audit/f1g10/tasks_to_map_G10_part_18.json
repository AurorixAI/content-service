[{"id": "G10_TB_§7_7_6_4", "current_skill": "G10_S05_01", "q": "Функция задана формулой $f(x)=x^{-40}$. Сравните $f(-8)$ и $f(6)$.", "key": "$f(-8) < f(6)$"}, {"id": "G10_TB_§7_7_8_1", "current_skill": "G10_S07_06", "q": "Найдите точки пересечения графиков функций: $y = x$ и $y = x^{-3}$.", "key": "$(1; 1), (-1; -1)$"}, {"id": "G10_TB_§7_7_8_2", "current_skill": "G10_S07_06", "q": "Найдите точки пересечения графиков функций: $y = x^{-2}$ и $y = \\left(\\frac{1}{8}\\right)x$.", "key": "$(2; \\dfrac{1}{4})$"}, {"id": "G10_TB_§7_7_9", "current_skill": "G10_S07_06", "q": "Найдите точки пересечения графиков функций: $y = x^{-4}$ и $y = \\left(\\frac{1}{32}\\right)x$.", "key": "$(2; \\dfrac{1}{16})$"}, {"id": "G10_TB_§8_1", "current_skill": "G10_S11_01", "q": "Что называют корнем $n$-й степени из числа $a$, где $n \\in \\mathbb{N}$, $n > 1$?", "key": "Корнем $n-$ й степени из числа $a$ называют такое число, $n-$ я степень которого равна $a.$"}, {"id": "G10_TB_§8_2", "current_skill": "G10_S02_02", "q": "При каких значениях $a$ имеет смысл выражение корень $(2k+1)$-й степени из $a$, $k \\in \\mathbb{N}$?", "key": "При любых значениях $a$."}, {"id": "G10_TB_§8_3", "current_skill": "G10_S11_01", "q": "Что называют арифметическим корнем $n$-й степени из неотрицательного числа $a$, где $n \\in \\mathbb{N}$, $n > 1$?", "key": "Арифметическим корнем $n-$ й степени из неотрицательного числа $a$ называют такое неотрицательное число, $n-$ я степень "}, {"id": "G10_TB_§8_4", "current_skill": "G10_S02_02", "q": "При каких значениях $a$ имеет смысл выражение корень $(2k)$-й степени из $a$, $k \\in \\mathbb{N}$?", "key": "При $a\\geq 0$."}, {"id": "G10_TB_§8_5", "current_skill": "G10_S05_02", "q": "Какими свойствами обладает функция $y=$ корень $(2k+1)-$ й степени из $x$, $k∈ℕ$?", "key": "Область определения: $ℝ$. Область значений: $ℝ$. Функция нечетная, возрастает на всей области определения."}, {"id": "G10_TB_§8_7", "current_skill": "G10_S05_01", "q": "Какими свойствами обладает функция $y=$ корень $(2k)-$ й степени из $x$, $k∈ℕ$?", "key": "Область определения: $[0; +\\infty )$. Область значений: [0; +\\infty ). Функция ни четная, ни нечетная, возрастает на все"}, {"id": "G10_TB_§8_7_19_1", "current_skill": "G10_S01_04", "q": "Найдите значение выражения: $5\\sqrt{4}-\\sqrt{25}$", "key": "$5$"}, {"id": "G10_TB_§8_7_19_2", "current_skill": "G10_S11_01", "q": "Найдите значение выражения: $\\frac{1}{3}\\sqrt{0{,}09}-2$", "key": "$-1.9$"}, {"id": "G10_TB_§8_7_19_3", "current_skill": "G10_S11_01", "q": "Найдите значение выражения: $\\left(\\sqrt{13}\\right)^{2}-3\\cdot\\left(\\sqrt{8}\\right)^{2}$", "key": "$-11$"}, {"id": "G10_TB_§8_7_20_1", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}=25$", "key": "$x=-5$; $x=5$"}, {"id": "G10_TB_§8_7_20_2", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}=0,49$", "key": "$x = -0.7; x = 0.7$"}, {"id": "G10_TB_§8_7_20_3", "current_skill": "G10_S11_01", "q": "Решите уравнение: $x^{2}=3$", "key": "$x = -\\sqrt{3}; x = \\sqrt{3}$"}, {"id": "G10_TB_§8_7_20_4", "current_skill": "G10_S11_05", "q": "Решите уравнение: $x^{2} = -25$", "key": "нет корней"}, {"id": "G10_TB_§8_7_21_1", "current_skill": "G10_S02_02", "q": "При каких значениях $x$ имеет смысл выражение: $\\sqrt{-x}$", "key": "$x \\le 0$"}, {"id": "G10_TB_§8_7_21_2", "current_skill": "G10_S02_02", "q": "При каких значениях $x$ имеет смысл выражение: $\\sqrt{x^{2}}$", "key": "$x \\in \\mathbb{R}$"}, {"id": "G10_TB_§8_7_21_3", "current_skill": "G10_S02_02", "q": "При каких значениях $x$ имеет смысл выражение: $\\sqrt{-x^{2}}$", "key": "$x = 0$"}, {"id": "G10_TB_§8_7_21_4", "current_skill": "G10_S02_02", "q": "При каких значениях $x$ имеет смысл выражение: $\\sqrt{x-8}$", "key": "$x \\ge 8$"}, {"id": "G10_TB_§8_7_21_5", "current_skill": "G10_S02_02", "q": "При каких значениях $x$ имеет смысл выражение: $\\sqrt{x^{2}+8}$", "key": "$x \\in \\mathbb{R}$"}, {"id": "G10_TB_§8_7_21_6", "current_skill": "G10_S02_02", "q": "При каких значениях $x$ имеет смысл выражение: $\\sqrt{(x-8)^{2}}$", "key": "$x \\in \\mathbb{R}$"}, {"id": "G10_TB_§8_7_22_1", "current_skill": "G10_S11_03", "q": "Сравните числа: $\\sqrt{\\frac{1}{3}}$ и $\\sqrt{\\frac{1}{5}}$", "key": "$\\sqrt{\\dfrac{1}{3}} > \\sqrt{\\dfrac{1}{5}}$"}, {"id": "G10_TB_§8_7_22_2", "current_skill": "G10_S11_03", "q": "Сравните числа: $\\sqrt{32}$ и $\\sqrt{26}$", "key": "$\\sqrt{32} > \\sqrt{26}$"}, {"id": "G10_TB_§8_7_22_3", "current_skill": "G10_S11_01", "q": "Сравните числа: $\\sqrt{33}$ и $6$", "key": "$\\sqrt{33} < 6$"}, {"id": "G10_TB_§8_7_22_4", "current_skill": "G10_S11_01", "q": "Сравните числа: $3\\sqrt{5}$ и $\\sqrt{42}$", "key": "$3\\sqrt{5} > \\sqrt{42}$"}, {"id": "G10_TB_§8_7_22_5", "current_skill": "G10_S11_01", "q": "Сравните числа: $\\sqrt{30}$ и $2\\sqrt{7}$", "key": "$\\sqrt{30} > 2\\sqrt{7}$"}, {"id": "G10_TB_§8_7_22_6", "current_skill": "G10_S11_01", "q": "Сравните числа: $7\\sqrt{\\frac{1}{7}}$ и $\\frac{1}{2}\\sqrt{20}$", "key": "$7\\sqrt{\\dfrac{1}{7}} > \\dfrac{1}{2}\\sqrt{20}$"}, {"id": "G10_TB_§8_8_1_1", "current_skill": "G10_S11_05", "q": "Имеет ли смысл запись: $\\sqrt[3]{2}$?", "key": "да"}, {"id": "G10_TB_§8_8_1_2", "current_skill": "G10_S01_04", "q": "Имеет ли смысл запись: $∛(-2)$?", "key": "да"}, {"id": "G10_TB_§8_8_1_3", "current_skill": "G10_S11_05", "q": "Имеет ли смысл запись: корень $4-$ й степени из $2$?", "key": "да"}, {"id": "G10_TB_§8_8_1_4", "current_skill": "G10_S11_05", "q": "Имеет ли смысл запись: корень $6-$ й степени из $0$?", "key": "да"}, {"id": "G10_TB_§8_8_1_5", "current_skill": "G10_S11_05", "q": "Имеет ли смысл запись: корень $6-$ й степени из $-1$?", "key": "нет"}, {"id": "G10_TB_§8_8_2_1", "current_skill": "G10_S11_05", "q": "Верно ли равенство (ответ обоснуйте): $∛27=3$?", "key": "верно , так как $3^{3}=27$"}, {"id": "G10_TB_§8_8_2_2", "current_skill": "G10_S11_05", "q": "Верно ли равенство (ответ обоснуйте): $∛343=-3$?", "key": "неверно , так как $(-3)^{3}=-27$, а не $343$"}, {"id": "G10_TB_§8_8_