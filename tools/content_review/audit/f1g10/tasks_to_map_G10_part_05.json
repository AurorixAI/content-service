[{"id": "G10_TB_4_1_3_f", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y = \\tan(10|x|)$", "key": "чётная"}, {"id": "G10_TB_4_1_3_g", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y=\\frac{x^{2}+\\cos x}{2}$", "key": "чётная"}, {"id": "G10_TB_4_1_3_h", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y=\\frac{\\sin x+\\cos x}{x+5}$", "key": "ни чётная, ни нечётная"}, {"id": "G10_TB_4_1_7_a", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y=\\frac{\\cos 2x - \\sin^{2} x}{x^{2}}$", "key": "чётная"}, {"id": "G10_TB_4_1_7_b", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y = \\ctg 3x + 5 \\sin x$", "key": "нечётная"}, {"id": "G10_TB_4_1_7_c", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y = \\sin 5x$", "key": "нечётная"}, {"id": "G10_TB_4_1_7_d", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y = 2 \\sin^{2} x$", "key": "чётная"}, {"id": "G10_TB_4_1_7_e", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y = \\sin^{2} x + \\sin x$", "key": "ни чётная, ни нечётная"}, {"id": "G10_TB_4_1_7_f", "current_skill": "G10_S22_02", "q": "Определите чётность или нечётность функции: $y = 5\\sin^{3} x + 2\\sin x$", "key": "нечётная"}, {"id": "G10_TB_4_1_8_a", "current_skill": "G10_S05_01", "q": "Пусть функция $f(x)$ определена на интервале $(-\\infty$ ; $\\infty$ ). Покажите, что функция $f(x)+f(-x)$ — чётная.", "key": "Доказательство : $g(x)=f(x)+f(-x)$; $g(-x)=f(-x)+f(x)=g(x)=>$ чётная ."}, {"id": "G10_TB_4_1_8_b", "current_skill": "G10_S05_02", "q": "Пусть функция $f(x)$ определена на интервале $(-\\infty$ ; $\\infty$ ). Покажите, что функция $f(x)-f(-x)$ — нечётная.", "key": "Доказательство : $h(x)=f(x)-f(-x)$; $h(-x)=f(-x)-f(x)=-h(x)=>$ нечётная ."}, {"id": "G10_TB_4_1_9_a", "current_skill": "G10_S22_01", "q": "Найдите наименьший положительный период функции: $f(x)=\\cos(3x+1)$", "key": "$\\frac{2\\pi}{3}$"}, {"id": "G10_TB_4_1_9_b", "current_skill": "G10_S22_01", "q": "Найдите наименьший положительный период функции: $f(x)=\\sin\\left(\\frac{x}{4}-3\\right)$", "key": "$8\\pi$"}, {"id": "G10_TB_4_2", "current_skill": "G10_S01_04", "q": "Последовательность $2$, $6$, $10$, $14$, $18$, ... составляет арифметическую прогрессию. Напишите формулу её $n-$ члена.", "key": "$a_n = 4n - 2$"}, {"id": "G10_TB_4_20", "current_skill": "G10_S01_04", "q": "Найдите сумму первых $25$ натуральных чисел.", "key": "$325$"}, {"id": "G10_TB_4_21", "current_skill": "G10_S01_04", "q": "Если $a_3+a_7=5$ и $a_4=1$ в арифметической прогрессии ( $a_n$ ), найдите сумму её первых десяти членов.", "key": "$32.5$"}, {"id": "G10_TB_4_22", "current_skill": "G10_S01_04", "q": "Начиная с какого номера все члены арифметической прогрессии будут положительными, если $a_1 = -20{,}7$, $d = 1{,}8$?", "key": "$13$"}, {"id": "G10_TB_4_23", "current_skill": "G10_S01_04", "q": "Если $a_{12} + a_{15} = 20$ в арифметической прогрессии, найдите $S_{26}$.", "key": "$260$"}, {"id": "G10_TB_4_24", "current_skill": "G10_S01_04", "q": "Если $a_2 + a_6 = 44$, $a_5 - a_1 = 20$ в арифметической прогрессии, найдите $a_{100}$.", "key": "$502$"}, {"id": "G10_TB_4_25", "current_skill": "G10_S01_04", "q": "Сумма третьего и девятого членов арифметической прогрессии равна $8$. Найдите сумму первых одиннадцати её членов.", "key": "$44$"}, {"id": "G10_TB_4_26", "current_skill": "G10_S01_04", "q": "Если $S_n = 3n^{2} + n$ в арифметической прогрессии, найдите $a_1$ и $d$.", "key": "$a_1 = 4$, $d = 6$"}, {"id": "G10_TB_4_27", "current_skill": "G10_S14_01", "q": "Если $b_{12}=4 \\cdot b_{10}$ и $b_3=6$ в возрастающей геометрической прогрессии, найдите $b_7$.", "key": "$96$"}, {"id": "G10_TB_4_28", "current_skill": "G10_S01_04", "q": "$b_5 = \\sqrt[3]{2}$ в геометрической прогрессии. Найдите произведение первых девяти её членов.", "key": "$8$"}, {"id": "G10_TB_4_29", "current_skill": "G10_S14_01", "q": "Если $S_4 = 10\\frac{5}{8}$, $S_5 = 42\\frac{5}{8}$, $b_1 = \\frac{1}{8}$ в геометрической прогрессии, найдите $q$.", "key": "$4$"}, {"id": "G10_TB_4_31", "current_skill": "G10_S01_01", "q": "Три числа $x$, $y$ и $12$ образуют убывающую геометрическую прогрессию. Если $12$ заменить на $9$, то полученная тройка чисел образует арифметическую прогрессию. Найдите $x+y$ .", "key": "$45$"}, {"id": "G10_TB_4_3_a", "current_skill": "G10_S01_04", "q": "В арифметической прогрессии найдите $a_1$ и $d$, если $a_7=-5$, $a_{32}=70$.", "key": "$a_1 = -23$, $d = 3$"}, {"id": "G10_TB_4_3_b", "current_skill": "G10_S01_04", "q": "В арифметической прогрессии найдите $a_7$, если $a_3=2$, $a_{40}=142$.", "key": "$\\dfrac{634}{37}$"}, {"id": "G10_TB_4_3_c", "current_skill": "G10_S01_04", "q": "В арифметической прогрессии найдите $a_{13}$, если $a_{14}=5$, $a_{12}=1$.", "key": "$3$"}, {"id": "G10_TB_4_3_d", "current_skill": "G10_S01_04", "q": "В арифметической прогрессии найдите $a_{10}$, если $a_{25} - a_{20} = 10$, $a_{16} = 13$.", "key": "$1$"}, {"id": "G10_TB_4_4", "current_skill": "G10_S14_01", "q": "Если $b_2=4$ и $b_3=6$ в геометрической прогрессии, найдите $b_7$.", "key": "$30.375$"}, {"id": "G10_TB_4_5", "current_skill": "G10_S01_04", "q": "Если $b_1=3$ и $q=-2$ в геометрической прогрессии, найдите $b_8$.", "key": "$-384$"}, {"id": "G10_TB_4_6_a", "current_skill": "G10_S01_04", "q": "В геометрической прогрессии если $b_1=18$, $q=\\frac{1}{9}$, найдите $b_2$.", "key": "$2$"}, {"id": "G10_TB_4_6_c", "current_skill": "G10_S14_01", "q": "В геометрической прогрессии если $b_4=8$, $b_8=128$, найдите $b_1$ и $q$.", "key": "$b_1=1$, $q=2$ или $b_1=-1$, $q=-2$"}, {"id": "G10_TB_4_6_d", "current_skill": "G10_S01_04", "q": "В геометрической прогрессии если $b_0=-1$, $q=-1$, найдите $b_1$ и $b_{17}$.", "key": "$b_1 = 1$, $b_{17} = 1$"}, {"id": "G10_TB_4_7", "current_skill": "G10_S01_04", "q": "Если $b_3=3$, $q=2$ в геометрической прогрессии, найдите $S_6$.", "key": "$\\dfrac{189}{4}$"}, {"id": "G10_TB_4_8", "current_skill": "G10_S01_04", "q": "Если $b_2=6$, $q=3$ в геометрической прогрессии, найдите $S_8$.", "key": "$6560$"}, {"id": "G10_TB_4_9", "current_skill": "G10_S01_04", "q": "В геометрической прогрессии $b_1=4$, $q=\\frac{1}{2}$. Найдите сумму её первых $10$ членов.", "key": "$\\dfrac{1023}{128}$"}, {"id": "G10_TB_5_1_1", "current_skill": "G10_S24_01", "q": "Решите уравнение: $\\sin x = \\frac{1}{2}$.", "key": "$x = (-1)^{n} \\dfrac{\\pi}{6} + \\pi n, n \\in \\mathbb{Z}$"}, {"id": "G10_TB_5_1_2", "current_skill": "G10_S24_02", "q": "Решите уравнение: $\\cos x = \\dfrac{\\sqrt{2}}{2}$.", "key": "$x = \\pm \\frac{\\pi}{4} + 2\\pi n, n \\in \\mathbb{Z}$"}, {"id": "G10_TB_5_2_25", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\cos 3x \\cos 2x = \\sin 3x \\sin 2x$", "key": "$x = \\dfrac{\\pi}{10} + \\dfrac{\\pi k}{5}$, $k \\in \\mathbb{Z}$"}, {"id": "G10_TB_5_2_26", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\sin 5x \\cos 4x - \\cos 5x \\sin 4x = \\frac{\\sqrt{3}}{2}$", "key": "$x = \\dfrac{\\pi}{3} + 2\\pi k; x = \\dfrac{2\\pi}{3} + 2\\pi k$"}, {"id": "G10_TB_5_2_27", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\cos 9x - \\cos 7x + \\cos 3x - \\cos x = 0$", "key": "$x = \\dfrac{\\pi}{6} + \\dfrac{\\pi k}{3}$; $x = \\dfrac{\\pi k}{5}$, $k \\in \\mathbb{Z}$"}, {"id": "G10_TB_5_2_28", "current_skill": "G10_S25_04", "q": "Решите уравнение $: \\cos 7x+\\sin 8x=\\cos 3x-\\sin 2x$", "key": "$x = \\frac{\\pi k}{5}; x = \\frac{\\pi}{2} + \\pi n; x = \\frac{\\pi}{10} + \\frac{2\\pi m}{5}$"}, {"id": "G10_TB_5_2_29", "current_skill": "G10_S25_04", "q": "Решите уравнение: $\\sin 3x + \\sin 5x = \\sin 4x$", "key": "$x = \\dfrac{\\pi k}{4}$; $x = \\pm\\dfrac{\\pi}{3} + 2\\pi k$, $k \\in \\mathbb{Z}$"}, {"id": "G10_TB_5_2_44", "current_skill": "G10_S25_04", "q": "Решите уравнение $: \\sin 9x=2\\sin 3x$", "key": "$x = \\frac{\\pi k}{3}; x = \\pm \\frac{\\pi}{18} + \\frac{\\pi k}{3}$"}, {"id": "G10_TB_6_1_2", "current_skill": "G10_S27_01", "q": "При подбрасывании монеты выпадение орла исключает выпадение решки. Какое утверждение о событиях «выпадение орла» и «выпадение решки» верно?", "key": "События $«$ выпадение орла $»$ и $«$ выпадение решки $»$ являются несовместными, так как при одном подбрасывании монеты "}, {"id": "G10_TB_6_1_3", "current_skill": "G10_S27_03", "q": "Монету подбрасывают дважды. Вероятность выпадения решки при первом броске (событие $A)$ не зависит от того, выпадет ли решка при втором броске (событие $B)$. С другой стороны, вероятность выпадения орла во втором испытании не зависит от результата первого эксперимента. Таким образом, события $A$ и $B$ независимы.", "key": "События $A$ и $B$ независимы, так как вероятность выпадения решки во втором броске не зависит от результата первого брос"}, {"id": "G10_TB_6_1_4", "current_skill": "G10_S27_03", "q": "При бросаниях монеты и игральной кости пусть $A–$ событие выпадения орла, а $B–$ выпадение чётного очка. Здесь $A$ и $B–$ независимые события.", "key": "События $A$ и $B$ независимы , так как $P(A∩B)=P(A)·P(B)=(\\dfrac{1}{2})·(\\dfrac{1}{2})=\\dfrac{1}{4}.$"}, {"id": "G10_TB_6_1_5", "current_skill": "G10_S27_03", "q": "При бросании двух игральных костей пусть $A–$ выпадение в первой кости, а $B–$ выпадение во второй кости чётного очка. $A$ и $B–$ независимые события.", "key": "События $A$ и $B$ независимы , так как $P(A∩B)=P(A)·P(B)=(\\dfrac{1}{2})·(\\dfrac{1}{2})=\\dfrac{1}{4}.$"}, {"id": "G10_TB_6_1_6", "current_skill": "G10_S27_03", "q": "Монету подбросили $3$ раза. Пусть $A$, $B$, $C–$ события падений орла в первой, второй и третьей попытках, соответственно. Ясно, что никакие два рассматриваемых событий (т. е. $(A$ и $B)$, $(A$ и $C)$, $(B$ и $C))$ независимы. Таким образом, события $A$, $B$ и $C$ попарно независимы.", "key": "Утверждение верно . События $A$, $B$ и $C$ попарно независимы , так как для любых двух из них вероятность пересечения ра"}, {"id": "G10_TB_6_1_8", "current_skill": "G10_S27_01", "q": "В коробке $80$ белых и $20$ чёрных шаров. Один шар вынимается наугад и не может быть возвращен в коробку. Если выход белого шара в первой попытке является событием $A$, то событие $B$ выхода белого шара во второй попытке зависит от события $A$. То есть события $A$ и $B$ зависимы.", "key": "Да , события $A$ и $B$ зависимы , так как вероятность события $B$ меняется в зависимости от того , произошло ли событие "}, {"id": "G10_TB_6_2_12", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{2x^{2}+8x+7}-2=x$", "key": "$x = -1$"}, {"id": "G10_TB_6_2_29", "current_skill": "G10_S11_03", "q": "Решите уравнение: $\\sqrt{4-x}+\\sqrt{x-4}=0$", "key": "$x = 4$"}, {"id": "G10_TB_6_2_39", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{\\left(x^{2}+8x\\right)^{2}}=x^{2}+8x$", "key": "$x \\in (-\\infty; -8] \\cup [0; +\\infty)$"}, {"id": "G10_TB_6_2_40", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{4x^{2}-5x^{2}}=5x-4x^{2}$", "key": "$x = 0$"}, {"id": "G10_TB_6_2_42", "current_skill": "G10_S11_02", "q": "Решите уравнение: $\\sqrt{x^{2} + \\frac{1}{x^{2}} - 2} = x - \\frac{1}{x}$", "key": "$x \\in [-1; 0) \\cup [1; +\\infty)$"}, {"id": "G10_TB_6_2_46", "current_skill": "G10_S11_05", "q": "Решите уравнение: $\\frac{\\sqrt[4]{x^{4}-16}+\\sqrt[6]{x^{3}-8}}{3x-x^{2}-2}=0$", "key": "нет решений"}, {"id": "G10_TB_§10_10_10_1", "current_skill": "G10_S14_01", "q": "Чему равно значение выражения: $5^{3{,}4} \\cdot 5^{-1{,}8} \\cdot 5^{-2{,}6}$?", "key": "$\\frac{1}{5}$"}, {"id": "G10_TB_§10_10_10_2", "current_skill": "G10_S14_01", "q": "Чему равно значение выражения: $(7^{-0,7})^{8} : 7^{-7,6}$?", "key": "$49$"}, {"id": "G10_TB_§10_10_10_3", "current_skill": "G10_S14_01", "q": "Чему равно значение выражения: $\\left(9^{\\frac{3}{7}}\\right)^{4\\frac{2}{3}}$?", "key": "$81$"}, {"id": "G10_TB_§10_10_10_4", "current_skill": "G10_S14_01", "q": "Чему равно значение выражения: $\\left(\\frac{1}{16}\\right)^{-0{,}25}$?", "key": "$2$"}, {"id": "G10_TB_§10_10_10_5", "current_skill": "G10_S14_01", "q": "Чему равно значение выражения: $\\left(2\\frac{6}{7}\\right)^{2{,}5} \\cdot 1{,}4^{2{,}5}$?", "key": "$32$"}, {"id": "G10_TB_§10_10_10_6", "current_skill": "G10_S14_01", "q": "Чему равно значение выражения: $\\frac{81^{\\frac{1}{3}}}{\\frac{1}{3^{\\frac{1}{3}}}}$?", "key": "$3^{\\frac{5}{3}}$"}, {"id": "G10_TB_§10_10_11_1", "current_skill": "G10_S01_04", "q": "Известно, что $a$ — положительное число. Представьте $a$ в виде квадрата.", "key": "$(a^{\\frac{1}{2}})^{2}$"}, {"id": "G10_TB_§10_10_11_2", "current_skill": "G10_S01_04", "q": "Известно, что $a$ — положительное число. Представьте $a$ в виде куба.", "key": "$(a^{\\frac{1}{3}})^{3}$"}, {"id": "G10_TB_§10_10_11_3", "current_skill": "G10_S14_01", "q": "Известно, что $a$ — положительное число. Представьте $a$ в виде шестой степени.", "key": "$(a^{\\frac{1}{6}})^{6}$"}, {"id": "G10_TB_§10_10_11_4", "current_skill": "G10_S01_04", "q": "Известно, что $a$ — положительное число. Представьте $a$ в виде восьмой степени.", "key": "$(a^{\\frac{1}{8}})^{8}$"}, {"id": "G10_TB_§10_10_12_1", "current_skill": "G10_S01_04", "q": "Известно, что $b$ — положительное число. Представьте в виде куба выражение: $b^{2}$", "key": "$(b^{\\frac{2}{3}})^{3}$"}, {"id": "G10_TB_§10_10_12_2", "current_skill": "G10_S01_04", "q": "Известно, что $b$ — положительное число. Представьте в виде куба выражение: $b^{\\frac{1}{2}}$", "key": "$(b^{\\frac{1}{6}})^{3}$"}, {"id": "G10_TB_§10_10_12_3", "current_skill": "G10_S01_04", "q": "Известно, что $b$ — положительное число. Представьте в виде куба выражение: $b^{\\frac{1}{3}}$", "key": "$(b^{\\frac{1}{9}})^{3}$"}, {"id": "G10_TB_§10_10_12_4", "current_skill": "G10_S01_04", "q": "Известно, что $b$ — положительное число. Представьте в виде куба выражение: $b^{-1,8}$", "key": "$(b^{-0,6})^{3}$"}, {"id": "G10_TB_§10_10_12_5", "current_skill": "G10_S01_04", "q": "Известно, что $b$ — положительное число. Представьте в виде куба выражение: $b^{\\frac{7}{11}}$", "key": "$(b^{\\frac{7}{33}})^{3}$"}, {"id": "G10_TB_§10_10_1_1", "current_skill": "G10_S13_03", "q": "Представьте степень с дробным показателем в виде корня: $5^{\\frac{1}{3}}$", "key": "$\\sqrt[3]{5}$"}, {"id": "G10_TB_§10_10_1_2", "current_skill": "G10_S01_04", "q": "Представьте степень с дробным показателем в виде корня: $b^{-\\frac{1}{7}}$", "key": "$\\dfrac{1}{\\sqrt[7]{b}}$"}, {"id": "G10_TB_§10_10_1_3", "current_skill": null, "q": "Представьте степень с дробным показателем в виде корня: $(ab)^{\\frac{4}{7}}$", "key": "$\\sqrt[7]{(ab)^{4}}$"}, {"id": "G10_TB_§10_10_1_4", "current_skill": "G10_S01_04", "q": "Представьте степень с дробным показателем в виде корня: $(m+n)^{2{,}5}$", "key": "$\\sqrt{(m+n)^{5}}$"}, {"id": "G10_TB_§10_10_25_1", "current_skill": "G10_S07_03", "q": "Упростите выражение: $\\frac{a-b}{a^{0{,}5}-b^{0{,}5}}-\\frac{a^{1{,}5}-b^{1{,}5}}{a-b}$", "key": "$\\dfrac{a^{0.5}b^{0.5}}{a^{0.5} + b^{0.5}}$"}, {"id": "G10_TB_§10_10_25_2", "current_skill": "G10_S03_07", "q": "Упростите выражение: $\\dfrac{a^{0{,}5}-b^{0{,}5}}{a^{0{,}5}+b^{0{,}5}}+\\dfrac{a^{0{,}5}+b^{0{,}5}}{a^{0{,}5}-b^{0{,}5}}$", "key": "$\\dfrac{2(a+b)}{a-b}$"}, {"id": "G10_TB_§10_10_25_3", "current_skill": "G10_S17_02", "q": "Упростите выражение: $\\frac{a^{\\frac{1}{2}}+2a^{\\frac{1}{4}}b^{\\frac{1}{4}}+b^{\\frac{1}{2}}}{a^{\\frac{7}{6}}b^{\\frac{5}{6}}-a^{\\frac{5}{6}}b^{\\frac{7}{6}}}\\cdot\\frac{a-a^{\\frac{1}{3}}b^{\\frac{2}{3}}}{a^{\\frac{1}{4}}b^{\\frac{1}{4}}+b^{\\frac{1}{2}}}$", "key": "$a^{\\frac{1}{12}}b^{-\\frac{13}{12}} + a^{-\\frac{1}{4}}b^{-\\frac{3}{4}} + a^{-\\frac{1}{6}}b^{-\\frac{5}{6}} + a^{-\\frac{1}"}, {"id": "G10_TB_§10_10_25_4", "current_skill": "G10_S07_04", "q": "Упростите выражение: $\\frac{a^{\\frac{3}{2}}+b^{\\frac{3}{2}}}{(a^{2}-ab)^{\\frac{2}{3}}} : \\frac{a^{\\frac{2}{3}}(a-b)^{\\frac{1}{3}}}{a^{\\frac{3}{2}}-b^{\\frac{3}{2}}}$", "key": "$\\dfrac{a^{2} + ab + b^{2}}{a^{\\frac{4}{3}}}$"}, {"id": "G10_TB_§10_10_26_1", "current_skill": "G10_S07_01", "q": "Упростите выражение: $\\frac{m-n}{m^{\\frac{1}{3}}-n^{\\frac{1}{3}}}-\\frac{m+n}{m^{\\frac{1}{3}}+n^{\\frac{1}{3}}}$", "key": "$2 m^{\\frac{1}{3}} n^{\\frac{1}{3}}$"}, {"id": "G10_TB_§10_10_26_2", "current_skill": null, "q": "Упростите выражение: $\\left(1-a^{\\frac{1}{36}}\\right)\\left(1+a^{\\frac{1}{36}}+a^{\\frac{1}{18}}\\right)+\\frac{4-a^{\\frac{1}{6}}}{2-a^{\\frac{1}{12}}}$", "key": "$3$"}, {"id": "G10_TB_§10_10_26_3", "current_skill": "G10_S03_07", "q": "Упростите выражение: $\\left(a^{\\frac{1}{4}}-b^{\\frac{1}{4}}\\right) : \\left(\\frac{b^{\\frac{5}{4}}}{a} - \\frac{b}{a^{\\frac{3}{4}}}\\right)$", "key": "$\\dfrac{-a}{b}$"}, {"id": "G10_TB_§10_10_26_4", "current_skill": "G10_S07_03", "q": "Упростите выражение: $\\frac{m^{\\frac{5}{2}}-m^{\\frac{3}{2}}}{m^{3}-m^{\\frac{5}{2}}}-\\frac{m^{\\frac{1}{2}}+m}{m^{2}+m^{\\frac{3}{2}}}$", "key": "$m^{-\\frac{1}{2}}$"}, {"id": "G10_TB_§10_10_27_2", "current_skill": "G10_S17_02", "q": "Докажите тождество: $\\frac{(a-b)^{2}}{a^{\\frac{3}{2}}-b^{\\frac{3}{2}}}+\\frac{a^{2}-b^{2}}{\\left(a^{\\frac{1}{2}}+b^{\\frac{1}{2}}\\right)\\left(a+a^{\\frac{1}{2}}b^{\\frac{1}{2}}+b\\right)}=2a^{\\frac{1}{2}}-2b^{\\frac{1}{2}}$", "key": "При $x = a^{\\frac{1}{2}}$, $y = b^{\\frac{1}{2}}$ ($x \\ne y$) первое слагаемое равно $\\dfrac{(x - y)(x + y)^{2}}{x^{2} + "}, {"id": "G10_TB_§10_10_28_1", "current_skill": "G10_S17_02", "q": "Докажите тождество: $\\left(\\frac{m^{2}+n^{2}}{m^{\\frac{3}{2}}+mn^{\\frac{1}{2}}}-\\frac{m+n}{m^{\\frac{1}{2}}+n^{\\frac{1}{2}}}\\right)\\cdot\\frac{m}{n}=n^{\\frac{1}{2}}-m^{\\frac{1}{2}}$", "key": "При $x = m^{\\frac{1}{2}}$, $y = n^{\\frac{1}{2}}$ разность в скобках равна $\\dfrac{x^{4} + y^{4}}{x^{2}(x + y)} - \\dfrac{"}, {"id": "G10_TB_§10_10_29_5", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\frac{22}{\\sqrt{x+3}}=11$", "key": "$1$"}, {"id": "G10_TB_§10_10_29_6", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{x^{2}-64}=6$", "key": "$x = -10; x = 10$"}, {"id": "G10_TB_§10_10_29_7", "current_skill": "G10_S11_01", "q": "Решите уравнение: $\\sqrt{1+\\sqrt{3+x}}=4$", "key": "$222$"}, {"id": "G10_TB_§10_10_29_9", "current_skill": "G10_S11_02", "q": "Решите уравнение: $(x-2)\\sqrt{x+2}=0$", "key": "$x = -2; x = 2$"}, {"id": "G10_TB_§10_10_2_1", "current_skill": "G10_S11_05", "q": "Замените степень с дробным показателем корнем: $3^{-\\frac{1}{9}}$", "key": "$\\dfrac{1}{\\sqrt[9]{3}}$"}, {"id": "G10_TB_§10_10_2_2", "current_skill": "G10_S01_04", "q": "Замените степень с дробным показателем корнем: $c^{0{,}2}$", "key": "корень пятой степени из $c$"}, {"id": "G10_TB_§10_10_2_3", "current_skill": "G10_S11_01", "q": "Замените степень с дробным показателем корнем: $x^{\\frac{6}{7}}$", "key": "$\\sqrt[7]{x^{6}}$"}, {"id": "G10_TB_§10_10_2_4", "current_skill": "G10_S11_01", "q": "Замените степень с дробным показателем корнем: $(a-2b)^{\\frac{9}{16}}$", "key": "$\\sqrt[16]{(a-2b)^{9}}$"}, {"id": "G10_TB_§10_10_3_1", "current_skill": "G10_S11_01", "q": "Представьте корень в виде степени с дробным показателем: $\\sqrt{x}$", "key": "$x^{\\frac{1}{2}}$"}, {"id": "G10_TB_§10_10_3_2", "current_skill": "G10_S11_05", "q": "Представьте корень в виде степени с дробным показателем: $\\sqrt[7]{6^{5}}$", "key": "$6^{\\frac{5}{7}}$"}, {"id": "G10_TB_§10_10_3_3", "current_skill": "G10_S01_04", "q": "Представьте корень в виде степени с дробным показателем: $\\sqrt[5]{2^{-2}}$", "key": "$2^{-\\frac{2}{5}}$"}, {"id": "G10_TB_§10_10_3_4", "current_skill": "G10_S11_05", "q": "Представьте корень в виде степени с дробным показателем: $\\sqrt[8]{a^{7}-b^{7}}$", "key": "$(a^{7} - b^{7})^{\\frac{1}{8}}$"}, {"id": "G10_TB_§10_10_4_1", "current_skill": "G10_S11_01", "q": "Замените корень степенью с дробным показателем: $\\sqrt[7]{a^{3}}$", "key": "$a^{\\frac{3}{7}}$"}, {"id": "G10_TB_§10_10_4_2", "current_skill": "G10_S01_04", "q": "Замените корень степенью с дробным показателем: $\\sqrt[14]{m^{-9}}$", "key": "$m^{-\